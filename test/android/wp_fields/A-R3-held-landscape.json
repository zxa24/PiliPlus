{
  "id": "A-R3-held-landscape",
  "about": "design §6.4 R3 横着拿着退出 (only with 横屏适配 on, §2 R3 手机上): in native fullscreen the phone is turned landscape (host user_rotation 1, the test waits for the host), then fullscreen is left: fullMode follows the held orientation, the page stays landscape at the fullscreen size; frames 3 s after the exit (F0: whether and when the layout lets go). Then the phone upright again. Control: the layout before / after that last turn",
  "platform": "android",
  "mutants": "none",
  "check": "wpSteps",
  "report": "A-R3-held-landscape.json",
  "type": "recording",
  "batch": null,
  "network": true,
  "run": {
    "args": [
      "--wp-open",
      "bili:https://www.bilibili.com/video/BV1wbxr6REXk",
      "--wp-steps",
      "host:rotate:0;pause;settle;read:start;fs:native@landscape;host:rotate:1;wait:1500;read:held;fsexit@landscape;read:end;host:rotate:0;waitfor:portrait@10000;require:portrait;settle;read:back"
    ],
    "prefs": [
      "horizontalScreen:bool=true",
      "fullScreenMode:int=0"
    ],
    "planPrefs": true,
    "profile": "fresh",
    "asr": false,
    "minutes": 8
  },
  "measured": "measured",
