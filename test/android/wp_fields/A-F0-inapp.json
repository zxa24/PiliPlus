  "mutants": "none",
  "check": "wpSteps",
  "report": "A-F0-inapp.json",
  "type": "recording",
  "batch": null,
  "network": true,
  "run": {
    "args": [
      "--wp-open",
      "bili:https://www.bilibili.com/video/BV1wbxr6REXk",
      "--wp-steps",
      "host:rotate:0;pause;settle;read:start;fs:inapp@landscape;fsexit@portrait;read:end"
