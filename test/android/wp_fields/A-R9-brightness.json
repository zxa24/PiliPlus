{
  "id": "A-R9-brightness",
  "about": "design §6.3 R9 的亮度恢复: a plain page pushed over the watch page and popped, first with the app's brightness untouched, then after a brightness swipe to 0.2 (setbrightness: what PLVideoPlayer.setBrightness does): covered it is reset (didPushNext), back it is the page's 0.2 again (didPopNext). Control: back unchanged vs back changed",
  "platform": "android",
  "mutants": "none",
  "check": "wpSteps",
  "report": "A-R9-brightness.json",
  "type": "recording",
  "batch": null,
  "network": true,
  "run": {
    "args": [
      "--wp-open",
      "bili:https://www.bilibili.com/video/BV1wbxr6REXk",
      "--wp-steps",
      "host:rotate:0;pause;settle;brightness:start;push:blank;wait:800;brightness:coveredUnchanged;pop;settle;brightness:backUnchanged;setbrightness:0.2;brightness:set;push:blank;wait:800;brightness:covered;pop;settle;brightness:back;read:end"
    ],
    "prefs": [
      "horizontalScreen:bool=true",
      "setSystemBrightness:bool=false"
    ],
    "planPrefs": true,
    "profile": "fresh",
    "asr": false,
    "minutes": 8
  },
