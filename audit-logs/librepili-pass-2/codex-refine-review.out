  799:   static const _maxSegmentRepairs = 2;
  800: 
  801:   /// Checks every durl segment (size against the play URL's byte count,
  802:   /// structure via [Mp4Remuxer.checkSegment]) and downloads damaged or
  803:   /// missing ones again, up to [_maxSegmentRepairs] rounds; throws
  804:   /// [FormatException] if segments are still damaged after that.
  805:   Future<void> _repairSegments(
  806:     int cid,
  807:     List<String> inputs,
  808:     List<Type1Segment> segments,
  809:   ) async {
  810:     for (var round = 0; ; round++) {
  811:       final bad = <int>[];
  812:       final short = <int>{};
  813:       for (var i = 0; i < inputs.length && i < segments.length; i++) {
  814:         final file = File(inputs[i]);
  815:         final expected = segments[i].bytes;
  816:         final input = inputs[i];
  817:         if (!file.existsSync() ||
  818:             (expected > 0 && file.lengthSync() < expected)) {
  819:           // missing, or the transfer stopped early: resume what is there
  820:           bad.add(i);
  821:           short.add(i);
  822:         } else if (!await Isolate.run(() => Mp4Remuxer.checkSegment(input))) {
  823:           bad.add(i);
  824:         }
  825:       }
  826:       if (bad.isEmpty) return;
  827:       if (round >= _maxSegmentRepairs) {
  828:         throw FormatException('damaged segments after re-download: $bad');
  829:       }
  830:       if (kDebugMode) debugPrint('re-downloading damaged segments $bad');
  831:       for (final i in bad) {
  832:         await _redownloadSegment(
  833:           cid,
  834:           segments[i],
  835:           inputs[i],
  836:           resume: short.contains(i),
  837:         );
  838:       }
  839:     }
  840:   }
  841: 
  842:   /// Segment re-downloads in flight, by cid. Kept apart from the queue's
  843:   /// [_downloadManager]: the merge runs outside [_lock], so the queue may
  844:   /// start another entry meanwhile and must neither cancel nor replace it.
  845:   /// Deleting the entry cancels it.
  846:   final _repairManagers = <int, DownloadManager>{};
  847: 
  848:   /// Fetches [segment] again. [resume]: the file is only short, so the
  849:   /// transfer continues in place (bytes are only appended). Otherwise a
  850:   /// fresh copy goes to `<file>.redl` and replaces [file] only once it is
  851:   /// complete: a failed re-download never loses the bytes that were there.
  852:   Future<void> _redownloadSegment(
  853:     int cid,
  854:     Type1Segment segment,
  855:     String file, {
  856:     required bool resume,
  857:   }) async {
  858:     final target = resume ? file : '$file.redl';
  859:     if (!resume) await File(target).tryDel();
  860:     final done = Completer<Object?>();
  861:     final manager = DownloadManager(
  862:       url: segment.url,
  863:       backupUrls: segment.backupUrls,
  864:       path: target,
  865:       onReceiveProgress: null,
  866:       onDone: ([error]) {
  867:         if (!done.isCompleted) done.complete(error);
  868:       },
  869:     );
  870:     _repairManagers[cid] = manager;
  995:   /// as opposed to the older flat layout.
  996:   static bool _isOwnFolder(String file) =>
  997:       path.basename(path.dirname(file)) == path.basenameWithoutExtension(file);
