  110:     private fun pick(result: MethodChannel.Result, requestCode: Int, intent: () -> Intent) {
  111:         if (pendingPick != null) {
  112:             result.error("BUSY", "a picker is already open", null)
  113:             return
  114:         }
  115:         pendingPick = result
  116:         try {
  117:             startActivityForResult(
  118:                 intent().addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION),
  119:                 requestCode,
  120:             )
  121:         } catch (e: Exception) {
  122:             pendingPick = null
  123:             result.error("PICKER", e.message, null)
  124:         }
  125:     }
  126: 
  127:     private fun background(result: MethodChannel.Result, work: () -> Any?) {
  128:         io().execute {
  129:             try {
  130:                 val value = work()
  131:                 mainHandler.post { result.success(value) }
  132:             } catch (e: Exception) {
  133:                 mainHandler.post { result.error("IO", e.message, null) }
  134:             }
  135:         }
  136:     }
