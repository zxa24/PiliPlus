 1052:   static final _illegalFileChars = RegExp(r'[\\/:*?"<>|\x00-\x1F]');
 1053: 
 1054:   /// Export folders a merge is currently writing into.
 1055:   static final _mergeFolders = <String>{};
 1056: 
 1057:   /// Names of the internal page folders in the download root: `<avid>` and
 1058:   /// `s_<seasonId>` (case-insensitive: Windows folder names are).
 1059:   static final _internalPageName = RegExp(r'^(s_)?\d+$', caseSensitive: false);
 1060: 
 1061:   /// On desktop exports share the download root with the internal page
 1062:   /// folders, so an export named like one (a title such as "114514") would
 1063:   /// be the same directory as that video's download. Such names get a
 1064:   /// suffix; no internal folder is ever named like the result.
 1065:   @visibleForTesting
 1066:   static String exportFolderName(String name) =>
 1067:       _internalPageName.hasMatch(name) ? '$name (视频)' : name;
 1068: 
 1069:   /// Internal page folders hold only entry folders; a folder with files at
 1070:   /// its top level is an export (or the user's own) that happens to carry
 1071:   /// the page folder's name.
 1072:   static bool _isForeignFolder(Directory dir) => dir.listSync().any(
 1073:     (e) => e is File && !_isOsClutter(path.basename(e.path)),
 1074:   );
 1075: 
 1076:   /// Files the OS / file managers drop into folders on their own.
 1077:   static bool _isOsClutter(String name) {
 1078:     final lower = name.toLowerCase();
 1079:     return name.startsWith('.') || // .DS_Store, ._*, .nomedia ...
 1080:         lower == 'desktop.ini' ||
 1081:         lower == 'thumbs.db' ||
 1082:         lower == 'ehthumbs.db';
 1083:   }
