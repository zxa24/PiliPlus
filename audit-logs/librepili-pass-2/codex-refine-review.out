    9: /// LibrePili privacy model: incognito by default, login is opt-in, and even
   10: /// in login mode the account is attached only to requests that need it.
   11: ///
   12: /// In login mode the home "推荐" feed (and its "不感兴趣" feedback) uses the
   13: /// account assigned to the recommend role, so the feed is personalised; with
   14: /// that role left anonymous it stays anonymous. Everything else (search,
   15: /// other home tabs, video info, comments, spaces...) is sent anonymously so
   16: /// it cannot be tied to the account. Incognito: everything is anonymous.
   17: abstract final class LoginPolicy {
   18:   /// Opt-in switch. Off: every account role is anonymous (stored accounts
   19:   /// stay dormant). On: see [requiresAccount].
   20:   static bool get loginMode => Pref.loginMode;
   21: 
   22:   /// Account-private reads, app-API writes (signed with access_key instead of
   23:   /// csrf), login-flow calls and stream URLs (high quality needs an account).
   24:   static const Set<String> _accountApis = {
   25:     // stream (1080P+ / VIP quality)
   65:     Api.qrcodeConfirm, Api.logout, Api.activateBuvidApi,
   66:   };
   67: 
   68:   /// The home "推荐" feed and its dislike feedback (user decision: not
   69:   /// anonymous in login mode). Bound to the recommend role's account (see
   70:   /// ApiType), which may itself be anonymous.
   71:   static const Set<String> _recommendApis = {
   72:     Api.recommendListApp,
   73:     Api.recommendListWeb,
   74:     Api.feedDislike,
   75:     Api.feedDislikeCancel,
   76:   };
   77: 
   78:   static const Set<String> _grpcAccountApis = {
   79:     GrpcUrl.dynRed,
   80:     GrpcUrl.audioPlayUrl,
   81:     GrpcUrl.audioThumbUp,
   82:     GrpcUrl.audioTripleLike,
   83:     GrpcUrl.audioCoinAdd,
   84:   };
   85: 
   86:   static const List<String> _grpcAccountPrefixes = [GrpcUrl.im, GrpcUrl.im2];
   87: 
   88:   static const _csrfKeys = {'csrf', 'biliCSRF', 'csrf_token'};
   89:   static const _selfKeys = ['mid', 'vmid', 'up_mid'];
   90: 
   91:   /// Whether UI that writes (comments, replies, danmaku, live chat) is
   92:   /// shown: it needs a logged-in account and the "hide interaction" switch
   93:   /// off. Existing comments and danmaku are displayed either way.
   94:   static bool get canInteract => Accounts.main.isLogin && !Pref.hideInteraction;
   95: 
   96:   /// The account [options] goes out with: [account] is the one its role
   97:   /// resolved to (see ApiType), kept only when login mode is on and the
   98:   /// request needs it; otherwise anonymous. [loginMode] defaults to the
   99:   /// setting (tests pass it).
  100:   static Account bind(
  101:     Account account,
  102:     RequestOptions options, {
  103:     bool? loginMode,
  104:   }) {
  105:     if (account is LoginAccount &&
  106:         (!(loginMode ?? LoginPolicy.loginMode) || !requiresAccount(options))) {
  107:       return AnonymousAccount();
  108:     }
  109:     return account;
  110:   }
  111: 
  112:   /// Whether [options] may carry the logged-in account. False means it is
  113:   /// sent anonymously even in login mode.
  114:   static bool requiresAccount(RequestOptions options) {
  115:     final path = options.path;
  116:     // gRPC requests are sent as `appBaseUrl + GrpcUrl.x`
  117:     final grpcPath = path.startsWith(HttpString.appBaseUrl)
  118:         ? path.substring(HttpString.appBaseUrl.length)
  119:         : path;
  120:     if (_accountApis.contains(path) ||
  121:         _recommendApis.contains(path) ||
  122:         _grpcAccountApis.contains(grpcPath) ||
  123:         _grpcAccountPrefixes.any(grpcPath.startsWith)) {
  124:       return true;
  125:     }

