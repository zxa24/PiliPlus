  999:   Future<void> _deleteMerged(BiliDownloadEntryInfo entry) async {
 1000:     if (entry.mergedPath case final merged?) {
 1001:       if (_isOwnFolder(merged)) {
 1002:         final folder = Directory(path.dirname(merged));
 1003:         final contents = folder.existsSync()
 1004:             ? folder.listSync()
 1005:             : const <FileSystemEntity>[];
 1006:         bool isDownload(FileSystemEntity e) =>
 1007:             e is Directory && File(path.join(e.path, _entryFile)).existsSync();
 1008:         if (contents.any(isDownload)) {
 1009:           // also a page folder holding downloads (made before exports
 1010:           // avoided internal names): remove only the export's own files
 1011:           for (final e in contents) {
 1012:             if (!isDownload(e)) await e.tryDel(recursive: true);
 1013:           }
 1014:         } else {
 1015:           await folder.tryDel(recursive: true);
 1016:         }
 1017:       } else {
 1018:         await File(merged).tryDel();
 1019:       }
 1020:     }
 1021:   }
 1022: 
 1023:   /// Where complete videos are written. Android: the public
 1024:   /// `Download/<app name>` folder so galleries and file managers see them;
 1025:   /// elsewhere: the (user-configurable) download folder.
 1026:   static Future<String> _exportDir() async {
 1027:     // the self test exports into its own download folder
 1028:     if (Platform.isAndroid && !isSelfTestProfile) {
 1029:       // downloadPath is `<storage root>/Android/data/<package>/files/download`
 1030:       final i = downloadPath.indexOf('/Android/data/');
 1031:       if (i != -1 &&
 1032:           (DeviceUtils.sdkInt >= 30 ||
 1033:               await Permission.storage.request().isGranted)) {
 1034:         final dir = Directory(
 1035:           path.join(
 1036:             downloadPath.substring(0, i),
 1037:             'Download',
 1038:             Constants.appName,
 1039:           ),
 1040:         );
 1041:         try {
 1042:           await dir.create(recursive: true);
 1043:           return dir.path;
 1044:         } catch (e) {
 1045:           if (kDebugMode) debugPrint('public download dir error: $e');
 1046:         }
 1047:       }
 1048:     }
 1049:     return _getDownloadPath();
 1050:   }
