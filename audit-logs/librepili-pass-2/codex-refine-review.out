 1085:   static Future<String> _exportFilePath(BiliDownloadEntryInfo entry) async {
 1086:     final dir = await _exportDir();
 1087:     final parts = <String>[entry.title];
 1088:     if (entry.ep case final ep?) {
 1089:       parts.add(ep.showTitle ?? '${ep.index} ${ep.indexTitle}');
 1090:     } else if (entry.pageData case final page?) {
 1091:       final part = page.part;
 1092:       if (part != null && part.isNotEmpty && part != entry.title) {
 1093:         parts.add('P${page.page} $part');
 1094:       }
 1095:     }
 1096:     var name = parts
 1097:         .join(' - ')
 1098:         .replaceAll(_illegalFileChars, '_')
 1099:         .replaceAll(RegExp(r'\s+'), ' ')
 1100:         .trim();
 1101:     // cut by code point (never half an emoji); the name is used twice in
 1102:     // the path (folder and file), so keep it short for Windows' 260 limit
 1103:     if (name.runes.length > 80) {
 1104:       name = String.fromCharCodes(name.runes.take(80)).trim();
 1105:     }
 1106:     if (entry.qualityPithyDescription.isNotEmpty) {
 1107:       name +=
 1108:           ' [${entry.qualityPithyDescription.replaceAll(_illegalFileChars, '_')}]';
 1109:     }
 1110:     name = exportFolderName(name);
 1111:     // one folder per video: the mp4 plus danmaku / subtitles / comments
 1112:     // a folder holding only a half-written `.part` (app killed mid-merge) is
 1113:     // left over from an earlier attempt: reuse it instead of orphaning it
 1114:     // (not one another merge is writing into right now)
 1115:     bool isLeftover(Directory d) =>
 1116:         !_mergeFolders.contains(d.path) &&
 1117:         d.listSync().every((e) => e is File && e.path.endsWith('.part'));
 1118:     var base = name;
 1119:     for (
 1120:       var i = 2;
 1121:       Directory(path.join(dir, base)).existsSync() &&
 1122:           !isLeftover(Directory(path.join(dir, base)));
 1123:       i++
 1124:     ) {
 1125:       base = '$name ($i)';
 1126:     }
 1127:     final folder = Directory(path.join(dir, base));
 1128:     // claimed before the first await, so an overlapping merge with the same
 1129:     // name cannot pick (and write into) the same folder
 1130:     _mergeFolders.add(folder.path);
 1131:     try {
 1132:       if (folder.existsSync()) {
 1133:         for (final part in folder.listSync()) {
 1134:           await File(part.path).tryDel();
 1135:         }
 1136:       }
 1137:       await folder.create(recursive: true);
 1138:     } catch (_) {
 1139:       _mergeFolders.remove(folder.path);
 1140:       rethrow;
 1160:     if (removeList) {
 1161:       downloadList.remove(entry);
 1162:     }
 1163:     if (removeQueue) {
 1164:       waitDownloadQueue.remove(entry);
 1165:     }
 1166:     if (_mergingCids.contains(entry.cid)) {
 1167:       _mergeDeletedCids.add(entry.cid);
 1168:     }
 1169:     await _repairManagers[entry.cid]?.cancel(isDelete: true);
 1170:     if (curDownload.value?.cid == entry.cid) {
 1171:       await cancelDownload(
 1172:         isDelete: true,
 1173:         downloadNext: downloadNext,
 1174:       );
 1175:     }

