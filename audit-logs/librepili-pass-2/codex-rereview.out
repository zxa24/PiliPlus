  284:   void _editDialog({
  285:     required ProfileType type,
  286:     required String title,
  287:     required String text,
  288:   }) {
  289:     _textController.text = text;
  290:     final lines = type == ProfileType.uname ? 1 : 4;
  291:     showDialog(
  292:       context: context,
  293:       builder: (BuildContext context) {
  294:         final theme = Theme.of(context);
  295:         return AlertDialog(
  296:           title: Text('修改$title'),
  297:           content: TextField(
  298:             controller: _textController,
  299:             minLines: lines,
  300:             maxLines: lines,
  301:             autofocus: true,
  302:             style: const TextStyle(fontSize: 14),
  303:             textInputAction: type == ProfileType.sign
  304:                 ? TextInputAction.newline
  305:                 : null,
  306:             inputFormatters: [
  307:               LengthLimitingTextInputFormatter(
  308:                 type == ProfileType.uname ? 16 : 70,
  309:               ),
  310:             ],
  311:             decoration: InputDecoration(
  312:               hintText: text,
  313:               hintStyle: TextStyle(
  314:                 fontSize: 14,
  315:                 color: theme.colorScheme.outline,
  316:               ),
  317:             ),
  318:           ),
  319:           actions: [
  320:             TextButton(
  321:               onPressed: Get.back,
  322:               child: Text(
  323:                 '取消',
  324:                 style: TextStyle(color: theme.colorScheme.outline),
  325:               ),
  326:             ),
  327:             TextButton(
  328:               onPressed: () {
  329:                 if (_textController.text == text) {
  330:                   SmartDialog.showToast('与原$title相同');
  331:                 } else {
  332:                   _update(type: type);
  333:                 }
  334:               },
  335:               child: const Text('确定'),
  336:             ),
  337:           ],
  338:         );
  339:       },
  340:     ).whenComplete(_textController.clear);
  341:   }
  342: 
  343:   Future<void> _update({
  344:     required ProfileType type,
  345:     dynamic datum,
  346:   }) async {
  347:     final accessKey = Accounts.main.accessKey;
  348:     if (accessKey == null || accessKey.isEmpty) {
  349:       SmartDialog.showToast('请退出账号后重新登录');
  350:       return;
  351:     }
  352:     final data = <String, String>{
  353:       'access_key': accessKey,
  354:       'build': '2001100',
  355:       'c_locale': 'zh_CN',
  356:       'channel': 'master',
  357:       'mobi_app': 'android_hd',
  358:       'platform': 'android',
  359:       's_locale': 'zh_CN',
  360:       'statistics': Constants.statistics,
  361:       if (type == ProfileType.uname)
  362:         'uname': _textController.text
  363:       else if (type == ProfileType.sign)
  364:         'user_sign': _textController.text
  365:       else if (type == ProfileType.birthday)
  366:         'birthday': datum
  367:       else if (type == ProfileType.sex)
  368:         'sex': datum.toString(),
  369:     };
  370:     AppSign.appSign(data);
  371:     Request()
  372:         .post(
  373:           '/x/member/app/${type.name}/update',
  374:           data: data,
  375:           options: Options(
  376:             contentType: Headers.formUrlEncodedContentType,
  377:           ),
  378:         )
  379:         .then((res) {
  380:           if (res.data['code'] == 0) {
  381:             AccountMyInfoData data = _loadingState.data;
  382:             if (type == ProfileType.uname) {
  383:               data
  384:                 ..name = _textController.text
  385:                 ..coins = data.coins! - 6;
  386:               try {
  387:                 UserInfoData userInfo = Pref.userInfoCache!
  388:                   ..uname = _textController.text;
  389:                 GStorage.userInfo.put('userInfoCache', userInfo);
  390:               } catch (_) {}

