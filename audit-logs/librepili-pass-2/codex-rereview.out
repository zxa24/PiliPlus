  119:     }
  120:   }
  121: 
  122:   g_autoptr(GError) error = nullptr;
  123:   if (!g_application_register(application, nullptr, &error)) {
  124:     g_warning("Failed to register: %s", error->message);
  125:     *exit_status = 1;
  126:     return TRUE;
  127:   }
  128: 
  129:   g_application_activate(application);
  130:   *exit_status = 0;
  131: 
  132:   return FALSE;
  133: }
