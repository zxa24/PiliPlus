   38: class DownloadService extends GetxService {
   39:   static const _entryFile = 'entry.json';
   40:   static const _indexFile = 'index.json';
   41:   static const _maxDanmakuConcurrency = 4;
   42: 
   43:   final _lock = Lock();
   44: 
   45:   final flagNotifier = SetNotifier();
   46:   final waitDownloadQueue = RxList<BiliDownloadEntryInfo>();
   47:   final downloadList = <BiliDownloadEntryInfo>[];
   48: 
   49:   int? _curCid;
   50:   int? get curCid => _curCid;
   51:   final curDownload = Rxn<BiliDownloadEntryInfo>();
   52:   void _updateCurStatus(DownloadStatus status) {
   53:     if (curDownload.value != null) {
   54:       curDownload
   55:         ..value!.status = status
   56:         ..refresh();
   57:     }
   58:   }
   59: 
   60:   DownloadManager? _downloadManager;
   61:   DownloadManager? _audioDownloadManager;
   62: 
   63:   late Future<void> waitForInitialization;
   64: 
   65:   @override
   66:   void onInit() {
   67:     super.onInit();
   68:     initDownloadList();
   69:   }
   70: 
   71:   void initDownloadList() {
   72:     waitForInitialization = _readDownloadList();
   73:   }
   74: 
   75:   Future<void> _readDownloadList() async {
   76:     downloadList.clear();
   77:     final downloadDir = Directory(await _getDownloadPath());
   78:     await for (final dir in downloadDir.list()) {
   79:       if (dir is Directory) {
   80:         downloadList.addAll(await _readDownloadDirectory(dir));
   81:       }
   82:     }
   83:     downloadList.sort((a, b) => b.timeUpdateStamp.compareTo(a.timeUpdateStamp));
   84:   }
   85: 
   86:   @pragma('vm:notify-debugger-on-exception')
   87:   Future<List<BiliDownloadEntryInfo>> _readDownloadDirectory(
   88:     Directory pageDir,
   89:   ) async {
   90:     final result = <BiliDownloadEntryInfo>[];
   91: 
   92:     if (!pageDir.existsSync()) {
   93:       return result;
   94:     }
   95: 
   96:     await for (final entryDir in pageDir.list()) {
   97:       if (entryDir is Directory) {
   98:         final entryFile = File(path.join(entryDir.path, _entryFile));
   99:         if (entryFile.existsSync()) {
  100:           try {
  101:             final entryJson = await entryFile.readAsString();
  102:             final entry = BiliDownloadEntryInfo.fromJson(jsonDecode(entryJson))
  103:               ..pageDirPath = pageDir.path
  104:               ..entryDirPath = entryDir.path;
  105:             if (entry.isCompleted) {
  106:               result.add(entry);
  107:             } else {
  108:               waitDownloadQueue.add(entry..status = DownloadStatus.wait);
  109:             }
  110:           } catch (_) {}
  111:         }
  112:       }
  113:     }
  114: 
  115:     return result;
  116:   }
  117: 
  118:   void downloadVideo(
  119:     Part page,
  120:     VideoDetailData? videoDetail,
  540:               : status,
  541:         );
  542:       }
  543:     }
  544:   }
  545: 
  546:   Future<void> _completeDownload() async {
  547:     final entry = curDownload.value;
  548:     if (entry == null) {
  549:       return;
  550:     }
  551:     _downloadManager = null;
  552:     _audioDownloadManager = null;
  553:     entry.downloadedBytes = entry.totalBytes;
  554:     final cid = entry.cid;
  555:     _mergingCids.add(cid);
  556:     _mergeDeletedCids.remove(cid);
  557:     _updateCurStatus(DownloadStatus.merging);
  558:     final (:output, :inputs) = await _mergeDownload(entry);
  559:     _mergingCids.remove(cid);
  560:     final deleted = _mergeDeletedCids.remove(cid);
  561:     if (deleted || !Directory(entry.entryDirPath).existsSync()) {
  562:       // deleted while merging (the merge may have kept files open, so the
  563:       // delete may not have removed everything)
  564:       await _deleteMerged(entry);
  565:       await Directory(entry.entryDirPath).tryDel(recursive: true);
  566:       waitDownloadQueue.remove(entry);
  567:       if (curDownload.value == null) nextDownload();
  568:       return;
  569:     }
  570:     // record completion before removing the stream files, so a crash here
  571:     // cannot turn the entry back into an incomplete one
  572:     entry.isCompleted = true;
  573:     await _updateBiliDownloadEntryJson(entry);
  574:     if (output != null) {
  575:       for (final input in inputs) {
  576:         await File(input).tryDel();
  577:       }
  578:       if (Platform.isAndroid) {
  579:         for (final part in _exportedParts(output)) {
  580:           await _scanMedia(part);
  581:         }
  582:       }
  583:     }
  584:     waitDownloadQueue.remove(entry);
  585:     downloadList.insert(0, entry);
  586:     flagNotifier.refresh();
  587:     if (curDownload.value?.cid == entry.cid) {
  588:       _curCid = null;
  589:       curDownload.value = null;
  590:       nextDownload();
  591:     }
  592:     // comments / subtitles etc. can take many requests: do not hold the
  593:     // queue for them
  594:     if (output != null) _queueExtras(entry, output);
  595:   }
  596: 
  597:   /// Extras exports run one at a time (each can be hundreds of requests).
  598:   Future<void> _extrasQueue = Future.value();
  599: 
  600:   /// Pending or running extras export per cid.
  601:   final _extrasJobs = <int, Future<void>>{};
  602: 
  603:   /// cids whose export must stop (entry deleted).
  604:   final _extrasCancelled = <int>{};
  605: 
  606:   /// cid whose export is running now.
  607:   int? _extrasRunningCid;
  608: 
  609:   /// The extras export of [cid], if one is pending or running.
  610:   Future<void>? extrasDone(int cid) => _extrasJobs[cid];
  611: 
  612:   void _queueExtras(BiliDownloadEntryInfo entry, String output) {
  613:     final cid = entry.cid;
  614:     _extrasCancelled.remove(cid);
  615:     final job = _extrasQueue = _extrasQueue.then((_) async {
  616:       if (_extrasCancelled.contains(cid)) return;
  617:       _extrasRunningCid = cid;
  618:       try {
  619:         await DownloadExtras.export(
  620:           entry: entry,
  621:           folder: path.dirname(output),
  622:           base: path.basenameWithoutExtension(output),
  623:           cancelled: () => _extrasCancelled.contains(cid),
  624:         );
  625:       } catch (e) {
  626:         if (kDebugMode) debugPrint('download extras: $e');
  627:       } finally {
  628:         _extrasRunningCid = null;
  629:       }
  630:     });
  631:     _extrasJobs[cid] = job;
  632:     job.whenComplete(() {
  633:       if (identical(_extrasJobs[cid], job)) {
  634:         _extrasJobs.remove(cid);
  635:         _extrasCancelled.remove(cid);
  636:       }
  637:     });
  638:   }
  639: 
  640:   /// Stops the extras export of a deleted entry; a running one is awaited so
  641:   /// it cannot write into (or recreate) a folder that is being removed.
  642:   Future<void> _cancelExtras(int cid) async {
  643:     if (!_extrasJobs.containsKey(cid)) return;
  644:     _extrasCancelled.add(cid);
  645:     if (_extrasRunningCid == cid) await _extrasJobs[cid];
  646:   }
  647: 
  648:   /// cids of the entries being merged (a deleted entry's merge can overlap
  649:   /// the next one's); pause/start requests for them are ignored.
  650:   final _mergingCids = <int>{};
  651: 
  652:   /// cids of entries deleted while they were being merged.
  653:   final _mergeDeletedCids = <int>{};
  654: 
  655:   /// Turns the downloaded streams into one complete video file in the export
  656:   /// directory. Returns the file (null on failure) and the stream files the
  657:   /// caller removes once completion is saved. On failure the stream files
  658:   /// are kept, so the entry still plays in-app as before.
  659:   Future<({String? output, List<String> inputs})> _mergeDownload(
  660:     BiliDownloadEntryInfo entry,
  661:   ) async {
  662:     final videoDir = path.join(entry.entryDirPath, entry.typeTag);
  663:     final List<String> inputs;
  664:     if (entry.mediaType == 1) {
  665:       // the segment count of the play URL this download used; segments on
  666:       // disk beyond it are left over from an earlier attempt
  667:       int? count;
  668:       try {
  669:         final index = File(path.join(videoDir, _indexFile));
  670:         count = (jsonDecode(await index.readAsString())['segment_list'] as List)
  671:             .length;
  672:       } catch (_) {}
  673:       inputs = [
  674:         for (
  675:           var i = 0;
  676:           (count == null || i < count) &&
  677:               File(
  678:                 path.join(videoDir, PathUtils.segmentNameType1(i)),
  679:               ).existsSync();
  680:           i++
  681:         )
  682:           path.join(videoDir, PathUtils.segmentNameType1(i)),
  683:       ];
  684:       if (count != null) {
  685:         for (
  686:           var i = count;
  687:           File(path.join(videoDir, PathUtils.segmentNameType1(i))).existsSync();
  688:           i++
  689:         ) {
  690:           await File(path.join(videoDir, PathUtils.segmentNameType1(i)))
  691:               .tryDel();
  692:         }
  693:       }
  694:       if (inputs.isEmpty) {
  695:         inputs.add(path.join(videoDir, PathUtils.videoNameType1));
  696:       }
  697:     } else {
  698:       final audio = path.join(videoDir, PathUtils.audioNameType2);
  699:       inputs = [
  700:         path.join(videoDir, PathUtils.videoNameType2),
  701:         if (entry.hasDashAudio && File(audio).existsSync()) audio,
  702:       ];
  703:     }
  704:     String? output;
  705:     try {
  706:       output = await _exportFilePath(entry);
  707:       if (entry.mediaType == 1) {
  708:         output = await _exportType1(inputs, output);
  709:       } else {
  710:         await _remuxInBackground(inputs, output);
  711:       }
  712:       entry.mergedPath = output;
  713:       return (output: output, inputs: inputs);
  714:     } catch (e) {
  715:       if (output != null) {
  716:         await File(output).tryDel();
  717:         final folder = Directory(path.dirname(output));
  718:         if (_isOwnFolder(output) && folder.listSync().isEmpty) {
  719:           await folder.tryDel();
  720:         }
  721:       }
  722:       entry.status = DownloadStatus.failMerge;
  723:       SmartDialog.showToast('合并音视频失败，已保留分离的音视频文件');
  724:       if (kDebugMode) debugPrint('merge download error: $e');
  725:       return (output: null, inputs: inputs);
  726:     } finally {
  727:       if (output != null) _mergeFolders.remove(path.dirname(output));
  728:     }
  729:   }
  730: 
  731:   /// Old single-URL (durl) streams. FLV with H.264 + AAC is remuxed into a
  732:   /// real mp4 and MP4 segments are joined, all segments in timeline order; a
  733:   /// single mp4 segment is moved as is. When that is not possible (other
  734:   /// codecs, segments with differing codec configuration) the original data
  735:   /// is kept with its own extension (several segments: `<base>.flv`,
  736:   /// `<base>.2.flv`, ...). Returns the (first) exported file.
  737:   static Future<String> _exportType1(List<String> inputs, String output) async {
  738:     final isFlv = Mp4Remuxer.isFlv(inputs.first);
  739:     if (!isFlv && inputs.length == 1) {
  740:       final kept = '${path.withoutExtension(output)}${_sniffExt(inputs.first)}';
  741:       await _moveFile(inputs.first, kept);
  742:       return kept;
  743:     }
  744:     if (isFlv || inputs.every(Mp4Remuxer.isMp4)) {
  745:       try {
  746:         await Isolate.run(
  747:           () => isFlv
  748:               ? Mp4Remuxer.remuxFlv(inputs: inputs, output: output)
  749:               : Mp4Remuxer.joinMp4(inputs: inputs, output: output),
  750:         );
  751:         return output;
  752:       } catch (e) {
  753:         // unsupported codecs, but also a corrupt / truncated segment: the
  754:         // data is still worth keeping as it is
  755:         await File(output).tryDel();
  756:         if (kDebugMode) debugPrint('segments kept as they are: $e');
  757:       }
  758:     }
  759:     final base = path.withoutExtension(output);
  760:     String? first;
  761:     for (var i = 0; i < inputs.length; i++) {
  762:       final ext = _sniffExt(inputs[i]);
  763:       final to = i == 0 ? '$base$ext' : '$base.${i + 1}$ext';
  764:       await _moveFile(inputs[i], to);
  765:       first ??= to;
  766:     }
  767:     if (inputs.length > 1) {
  768:       SmartDialog.showToast('分段无法合并，已按原格式分为${inputs.length}个文件保存');
  769:     }
  770:     return first!;
  771:   }
  772: 
  773:   /// Extension for stream data kept as it is, from its content.
  774:   static String _sniffExt(String file) {
  775:     if (Mp4Remuxer.isFlv(file)) return '.flv';
  776:     if (Mp4Remuxer.isMp4(file)) return '.mp4';
  777:     try {
  778:       final raf = File(file).openSync();
  779:       try {
  780:         final head = raf.readSync(189);
  781:         // MPEG-TS: 188-byte packets starting with the 0x47 sync byte
  782:         if (head.length == 189 && head[0] == 0x47 && head[188] == 0x47) {
  783:           return '.ts';
  784:         }
  785:       } finally {
  786:         raf.closeSync();
  787:       }
  788:     } catch (_) {}
  789:     return '.bin';
  790:   }
  791: 
  792:   /// [output] and, when segments were kept apart, its other parts
  793:   /// (`<base>.2.flv`, ...).
  794:   static List<String> _exportedParts(String output) {
  795:     final base = RegExp.escape(path.basenameWithoutExtension(output));
  796:     final part = RegExp('^$base\\.\\d+\\.\\w+\$');
  797:     return [
  798:       output,
  799:       for (final f in Directory(path.dirname(output)).listSync())
  800:         if (f is File && part.hasMatch(path.basename(f.path))) f.path,
  801:     ];
  802:   }
  803: 
  804:   static const _mediaChannel = MethodChannel('librepili/media');
  805: 
  806:   /// Adds the file to the Android media library so galleries and video
  807:   /// players list it (files written by path are not indexed automatically).
  808:   static Future<void> _scanMedia(String path) async {
  809:     try {
  810:       await _mediaChannel.invokeMethod<String>('scanFile', {
  811:         'path': path,
  812:         'mimeType': path.endsWith('.flv')
  813:             ? 'video/x-flv'
  814:             : path.endsWith('.ts')
  815:             ? 'video/mp2t'
  816:             : path.endsWith('.bin')
  817:             ? 'application/octet-stream'
  818:             : 'video/mp4',
  819:       });
  820:     } catch (e) {
  821:       if (kDebugMode) debugPrint('media scan failed: $e');
  822:     }
  823:   }
  824: 
  825:   // Static so the isolate closure only captures the two arguments.
  826:   static Future<void> _remuxInBackground(List<String> inputs, String output) =>
  827:       Isolate.run(() => Mp4Remuxer.remux(inputs: inputs, output: output));
  828: 
  829:   static Future<void> _moveFile(String from, String to) async {
  830:     try {
  831:       await File(from).rename(to);
  832:     } on FileSystemException {
  833:       // across volumes
  834:       await File(from).copy(to);
  835:       await File(from).tryDel();
  836:     }
  837:   }
  838: 
  839:   /// Whether [file] lives in its own per-video folder (named like the file),
  840:   /// as opposed to the older flat layout.
  841:   static bool _isOwnFolder(String file) =>
  842:       path.basename(path.dirname(file)) == path.basenameWithoutExtension(file);
  843: 
  844:   Future<void> _deleteMerged(BiliDownloadEntryInfo entry) async {
  845:     if (entry.mergedPath case final merged?) {
  846:       if (_isOwnFolder(merged)) {
  847:         await Directory(path.dirname(merged)).tryDel(recursive: true);
  848:       } else {
  849:         await File(merged).tryDel();
  850:       }
  851:     }
  852:   }
  853: 
  854:   /// Where complete videos are written. Android: the public
  855:   /// `Download/<app name>` folder so galleries and file managers see them;
  856:   /// elsewhere: the (user-configurable) download folder.
  857:   static Future<String> _exportDir() async {
  858:     // the self test exports into its own download folder
  859:     if (Platform.isAndroid && !isSelfTestProfile) {
  860:       // downloadPath is `<storage root>/Android/data/<package>/files/download`
  861:       final i = downloadPath.indexOf('/Android/data/');
  862:       if (i != -1 &&
  863:           (DeviceUtils.sdkInt >= 30 ||
  864:               await Permission.storage.request().isGranted)) {
  865:         final dir = Directory(
  866:           path.join(
  867:             downloadPath.substring(0, i),
  868:             'Download',
  869:             Constants.appName,
  870:           ),
  871:         );
  872:         try {
  873:           await dir.create(recursive: true);
  874:           return dir.path;
  875:         } catch (e) {
  876:           if (kDebugMode) debugPrint('public download dir error: $e');
  877:         }
  878:       }
  879:     }
  880:     return _getDownloadPath();
  881:   }
  882: 
  883:   static final _illegalFileChars = RegExp(r'[\\/:*?"<>|\x00-\x1F]');
  884: 
  885:   /// Export folders a merge is currently writing into.
  886:   static final _mergeFolders = <String>{};
  887: 
  888:   static Future<String> _exportFilePath(BiliDownloadEntryInfo entry) async {
  889:     final dir = await _exportDir();
  890:     final parts = <String>[entry.title];
  891:     if (entry.ep case final ep?) {
  892:       parts.add(ep.showTitle ?? '${ep.index} ${ep.indexTitle}');
  893:     } else if (entry.pageData case final page?) {
  894:       final part = page.part;
  895:       if (part != null && part.isNotEmpty && part != entry.title) {
  896:         parts.add('P${page.page} $part');
  897:       }
  898:     }
  899:     var name = parts
  900:         .join(' - ')
  901:         .replaceAll(_illegalFileChars, '_')
  902:         .replaceAll(RegExp(r'\s+'), ' ')
  903:         .trim();
  904:     // cut by code point (never half an emoji); the name is used twice in
  905:     // the path (folder and file), so keep it short for Windows' 260 limit
  906:     if (name.runes.length > 80) {
  907:       name = String.fromCharCodes(name.runes.take(80)).trim();
  908:     }
  909:     if (entry.qualityPithyDescription.isNotEmpty) {
  910:       name +=
  911:           ' [${entry.qualityPithyDescription.replaceAll(_illegalFileChars, '_')}]';
  912:     }
  913:     // one folder per video: the mp4 plus danmaku / subtitles / comments
  914:     // a folder holding only a half-written `.part` (app killed mid-merge) is
  915:     // left over from an earlier attempt: reuse it instead of orphaning it
  916:     // (not one another merge is writing into right now)
  917:     bool isLeftover(Directory d) =>
  918:         !_mergeFolders.contains(d.path) &&
  919:         d.listSync().every((e) => e is File && e.path.endsWith('.part'));
  920:     var base = name;
  921:     for (
  922:       var i = 2;
  923:       Directory(path.join(dir, base)).existsSync() &&
  924:           !isLeftover(Directory(path.join(dir, base)));
  925:       i++
  926:     ) {
  927:       base = '$name ($i)';
  928:     }
  929:     final folder = Directory(path.join(dir, base));
  930:     if (folder.existsSync()) {
  931:       for (final part in folder.listSync()) {
  932:         await File(part.path).tryDel();
  933:       }
  934:     }
  935:     await folder.create(recursive: true);
  936:     _mergeFolders.add(folder.path);
  937:     return path.join(folder.path, '$base.mp4');
  938:   }
  939: 
  940:   void nextDownload() {
  941:     if (waitDownloadQueue.isNotEmpty) {
  942:       startDownload(waitDownloadQueue.first);
  943:     }
  944:   }
  945: 
  946:   Future<void> deleteDownload({
  947:     required BiliDownloadEntryInfo entry,
  948:     bool removeList = false,
  949:     bool removeQueue = false,
  950:     bool refresh = true,
  951:     bool downloadNext = true,
  952:     // the exported video folder is the user's own copy: kept unless asked
  953:     bool deleteExported = false,
  954:   }) async {
  955:     if (removeList) {
  956:       downloadList.remove(entry);
  957:     }
  958:     if (removeQueue) {
  959:       waitDownloadQueue.remove(entry);
  960:     }
  961:     if (_mergingCids.contains(entry.cid)) {
  962:       _mergeDeletedCids.add(entry.cid);
  963:     }
  964:     if (curDownload.value?.cid == entry.cid) {
  965:       await cancelDownload(
  966:         isDelete: true,
  967:         downloadNext: downloadNext,
  968:       );
  969:     }
  970:     await _cancelExtras(entry.cid);
  971:     if (deleteExported) await _deleteMerged(entry);
  972:     final downloadDir = Directory(entry.pageDirPath);
  973:     if (downloadDir.existsSync()) {
  974:       if (!await downloadDir.lengthGte(2)) {
  975:         await downloadDir.tryDel(recursive: true);
  976:       } else {
  977:         final entryDir = Directory(entry.entryDirPath);
  978:         if (entryDir.existsSync()) {
  979:           await entryDir.tryDel(recursive: true);
  980:         }
  981:       }
  982:     }
  983:     if (refresh) {
  984:       flagNotifier.refresh();
  985:     }
  986:   }
  987: 
  988:   Future<void> deletePage({
  989:     required String pageDirPath,
  990:     bool refresh = true,
  991:     bool deleteExported = false,
  992:   }) async {
  993:     for (final entry in downloadList.toList()) {
  994:       if (entry.pageDirPath != pageDirPath) continue;
  995:       await _cancelExtras(entry.cid);
  996:       if (deleteExported) await _deleteMerged(entry);
  997:     }
  998:     await Directory(pageDirPath).tryDel(recursive: true);
  999:     downloadList.removeWhere((e) => e.pageDirPath == pageDirPath);
 1000:     if (refresh) {
 1001:       flagNotifier.refresh();
 1002:     }
 1003:   }
