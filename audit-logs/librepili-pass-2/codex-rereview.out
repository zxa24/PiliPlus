   21: abstract final class LoginUtils {
   22:   static FutureOr setWebCookie([Account? account]) {
   23:     if (Platform.isLinux) return null;
   24:     final cookies = (account ?? Accounts.main).cookieJar.toList();
   25:     final webManager = web.CookieManager.instance(
   26:       webViewEnvironment: webViewEnvironment,
   27:     );
   28:     return Future.wait(
   29:       cookies.map(
   30:         (cookie) => webManager.setCookie(
   31:           url: web.WebUri(
   32:             '${Platform.isWindows ? 'https://' : ''}${cookie.domain}',
   33:           ),
   34:           name: cookie.name,
   35:           value: cookie.value,
   36:           path: cookie.path ?? '/',
   37:           domain: cookie.domain,
   38:           isSecure: cookie.secure,
   39:           isHttpOnly: cookie.httpOnly,
   40:         ),
   41:       ),
   42:     );
   43:   }
   44: 
   45:   /// LibrePili: pages in the in-app WebView are anonymous. Removes the stored
   46:   /// accounts' cookies (e.g. installed by an older build) and installs the
   47:   /// anonymous jar; account cookies go in only for explicit account flows
   48:   /// (the "reset cookie" menu, taking notes).
   49:   static FutureOr setAnonymousWebCookie() async {
   50:     if (Platform.isLinux) return null;
   51:     final webManager = web.CookieManager.instance(
   52:       webViewEnvironment: webViewEnvironment,
   53:     );
   54:     await Future.wait([
   55:       for (final account in Accounts.account.values)
   56:         for (final cookie in account.cookieJar.toList())
   57:           webManager.deleteCookie(
   58:             url: web.WebUri(
   59:               '${Platform.isWindows ? 'https://' : ''}${cookie.domain}',
   60:             ),
   61:             name: cookie.name,
   62:             path: cookie.path ?? '/',
   63:             domain: cookie.domain,
   64:           ),
   65:     ]);
   66:     return setWebCookie(AnonymousAccount());
   67:   }
   68: 
   69:   static Future<void> onLoginMain() async {
   70:     final account = Accounts.main;
   71:     final res = await UserHttp.userInfo();
   72:     if (res case Success(:final response)) {
   73:       setAnonymousWebCookie();
   74:       RequestUtils.syncHistoryStatus();
   75:       if (response.isLogin == true) {
   76:         final accountService = Get.find<AccountService>()
   77:           ..face.value = response.face!;
   78: 
   79:         if (accountService.isLogin.value) {
   80:           accountService.isLogin.refresh();
   81:         } else {
   82:           accountService.isLogin.value = true;
   83:         }
   84: 
   85:         SmartDialog.showToast('main登录成功');
   86:         if (response != Pref.userInfoCache) {
   87:           await GStorage.userInfo.put('userInfoCache', response);
   88:         }
   89:       }
   90:     } else {
   91:       // 获取用户信息失败
   92:       final errMsg = res.toString();
   93:       if (errMsg == '账号未登录') {
   94:         await Accounts.deleteAll({account});
   95:         SmartDialog.showNotify(
   96:           msg: '登录失败，请检查cookie是否正确，$errMsg',
   97:           notifyType: .warning,
   98:         );
   99:       } else {
  100:         SmartDialog.showToast(errMsg);
  101:       }
  102:     }
  103:   }
  104: 
  105:   static Future<void> onLogoutMain() {
  106:     Get.find<AccountService>()
  107:       ..face.value = ''
  108:       ..isLogin.value = false;
  109: 
  110:     return Future.wait([
  111:       if (Platform.isLinux)
  112:         LinuxCookieManager.deleteAllCookies()
  113:       else
  114:         web.CookieManager.instance(
  115:           webViewEnvironment: webViewEnvironment,
  116:         ).deleteAllCookies(),
  117:       GStorage.userInfo.delete('userInfoCache'),
  118:     ]);
  119:   }
