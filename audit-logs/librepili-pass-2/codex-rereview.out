 1005:   Future<void> cancelDownload({
 1006:     required bool isDelete,
 1007:     bool downloadNext = true,
 1008:   }) async {
 1009:     // nothing to pause while merging; the merge completes the entry
 1010:     if (!isDelete && _mergingCids.contains(curDownload.value?.cid)) {
 1011:       return;
 1012:     }
 1013:     await _downloadManager?.cancel(isDelete: isDelete);
 1014:     await _audioDownloadManager?.cancel(isDelete: isDelete);
 1015:     _downloadManager = null;
 1016:     _audioDownloadManager = null;
 1017:     if (!isDelete) {
 1018:       final entry = curDownload.value;
 1019:       if (entry != null) {
 1020:         await _updateBiliDownloadEntryJson(entry);
 1021:       }
 1022:     }
 1023:     if (isDelete) {
 1024:       _curCid = null;
 1025:       curDownload.value = null;
 1026:     } else {
 1027:       _updateCurStatus(DownloadStatus.pause);
 1028:     }
 1029:     if (downloadNext) {
 1030:       nextDownload();
