   22: /// LibrePili: extra files written next to a downloaded video. Folder
   23: /// convention, `base` being the video file name without extension:
   24: /// `base.mp4`, `base.danmaku.xml`, `base.danmaku.ass`, `base.LANG.srt`,
   25: /// `base.comments.json`, `cover.jpg`. Every part is best-effort: a failure
   26: /// never affects the video itself.
   27: abstract final class DownloadExtras {
   28:   static const xmlSuffix = '.danmaku.xml';
   29:   static const assSuffix = '.danmaku.ass';
   30:   static const commentsSuffix = '.comments.json';
   31:   static const coverName = 'cover.jpg';
   32: 
   33:   /// The download record, so a folder opened later (local player / drag and
   34:   /// drop) restores title, ids and quality.
   35:   static const infoName = 'librepili.json';
   36: 
   37:   /// Writes the enabled extras; returns what was written (for self tests).
   38:   /// [cancelled] is polled between steps and requests: once it returns true
   39:   /// (the entry was deleted) nothing more is fetched or written.
   40:   static Future<Map<String, Object?>> export({
   41:     required BiliDownloadEntryInfo entry,
   42:     required String folder,
   43:     required String base,
   44:     bool Function()? cancelled,
   45:   }) async {
   46:     final written = <String, Object?>{};
   47:     void check() {
   48:       if (cancelled?.call() ?? false) throw const _Cancelled();
   49:     }
   50: 
   51:     try {
   52:       await File(path.join(folder, infoName)).writeAsString(
   53:         const JsonEncoder.withIndent(' ').convert(entry.toJson()),
   54:       );
   55:     } catch (_) {}
   56:     Future<void> step(String name, Future<Object?> Function() body) async {
   57:       if (cancelled?.call() ?? false) return;
   58:       try {
   59:         written[name] = await body();
   60:       } catch (e) {
   61:         written[name] = 'error: $e';
   62:         if (kDebugMode) debugPrint('download extras $name: $e');
   63:       }
   64:     }
   65: 
   66:     if (Pref.dlSaveCover) {
   67:       await step('cover', () async {
   68:         final src = File(path.join(entry.entryDirPath, PathUtils.coverName));
   69:         if (!src.existsSync()) return null;
   70:         await src.copy(path.join(folder, coverName));
   71:         return coverName;
   72:       });
   73:     }
   74: 
   75:     if (Pref.dlSaveDanmakuXml || Pref.dlSaveDanmakuAss) {
   76:       await step('danmaku', () async {
   77:         final pb = File(path.join(entry.entryDirPath, PathUtils.danmakuName));
   78:         if (!pb.existsSync()) return null;
   79:         final elems = DmSegMobileReply.fromBuffer(await pb.readAsBytes()).elems
   80:           ..sort((a, b) => a.progress.compareTo(b.progress));
   81:         final out = <String>[];
   82:         if (Pref.dlSaveDanmakuXml) {
   83:           await File(path.join(folder, '$base$xmlSuffix'))
   84:               .writeAsString(danmakuToXml(elems, cid: entry.cid));
   85:           out.add(xmlSuffix);
   86:         }
   87:         if (Pref.dlSaveDanmakuAss) {
   88:           await File(path.join(folder, '$base$assSuffix'))
   89:               .writeAsString(danmakuToAss(elems, title: entry.showTitle));
   90:           out.add(assSuffix);
   91:         }
   92:         return '${elems.length} items -> ${out.join(', ')}';
   93:       });
   94:     }
   95: 
   96:     if (Pref.dlSaveSubtitle) {
   97:       await step('subtitles', () => _subtitles(entry, folder, base, check));
   98:     }
   99: 
  100:     if (Pref.dlSaveComments) {
  101:       await step('comments', () => _comments(entry, folder, base, check));
  102:     }
  103:     return written;
  104:   }
  105: 
  106:   // ------------------------------------------------------------ subtitles
  107: 
  108:   static Future<List<String>> _subtitles(
  109:     BiliDownloadEntryInfo entry,
  110:     String folder,
  111:     String base,
  112:     void Function() check,
  113:   ) async {
  114:     final res = await VideoHttp.playInfo(
  115:       bvid: entry.bvid,
  116:       cid: entry.cid,
  117:       seasonId: entry.seasonId,
  118:       epId: entry.ep?.episodeId,
  119:     );
  120:     var subtitles = <({String lan, String url})>[
  140:     for (final s in subtitles) {
  141:       check();
  142:       final srt = await VideoHttp.getSubtitles(s.url, format: .srt);
  143:       if (srt == null) continue;
  144:       final name = '$base.${_safe(s.lan)}.srt';
  145:       await File(path.join(folder, name)).writeAsString(srt);
  146:       written.add(name);
  147:     }
  148:     return written;
  149:   }
  150: 
  151:   // ------------------------------------------------------------- comments
  152: 
  153:   static Future<String> _comments(
  154:     BiliDownloadEntryInfo entry,
  155:     String folder,
  156:     String base,
  157:     void Function() check,
  158:   ) async {
  159:     final maxRoots = Pref.dlCommentCount;
  160:     final maxReplies = Pref.dlReplyCount;
  161:     // bangumi episodes are commented on by aid as well
  162:     final oid = entry.avid;
  163:     final roots = <ReplyInfo>[];
  164:     Int64? cursorNext;
  165:     while (roots.length < maxRoots) {
  166:       check();
  167:       final res = await ReplyGrpc.mainList(
  168:         oid: oid,
  169:         mode: Mode.MAIN_LIST_HOT,
  170:         offset: null,
  171:         cursorNext: cursorNext,
  172:       );
  173:       if (res is! Success<MainListReply>) {
  174:         if (roots.isEmpty) throw StateError('$res');
  175:         break;
  176:       }
  177:       final page = res.response;
  178:       roots.addAll(page.replies);
  179:       if (page.cursor.isEnd || page.replies.isEmpty) break;
  180:       cursorNext = page.cursor.next;
  181:       await Future.delayed(const Duration(milliseconds: 200));
  182:     }
  183:     if (roots.length > maxRoots) roots.removeRange(maxRoots, roots.length);
  184: 
  185:     final images = CommentImages(folder);
  186:     final items = <Map<String, Object?>>[];
  187:     for (final root in roots) {
  188:       check();
  189:       var replies = root.replies.toList();
  190:       final wanted = math.min(maxReplies, root.count.toInt());
  191:       if (replies.length < wanted) {
  192:         replies = await _replies(oid, root.id.toInt(), wanted, check);
  193:       }
  194:       items.add(
  195:         await replyToJson(root, images)
  196:           ..['replies'] = [
  197:             for (final r in replies.take(maxReplies))
  198:               await replyToJson(r, images),
  199:           ],
  200:       );
  201:     }
  202: 
  203:     final json = {
  204:       'format': 'librepili-comments-1',
  205:       'oid': oid,
  206:       'bvid': entry.bvid,
  207:       'title': entry.showTitle,
  208:       'sort': 'hot',
  209:       'fetchedAt': DateTime.now().toIso8601String(),
  210:       'count': items.length,
  211:       'comments': items,
  212:     };
  213:     check();
  214:     await File(path.join(folder, '$base$commentsSuffix')).writeAsString(
  215:       const JsonEncoder.withIndent(' ').convert(json),
  216:     );
  217:     return '${items.length} comments, ${images.saved} images';
  218:   }
  219: 
  220:   static Future<List<ReplyInfo>> _replies(
  221:     int oid,
  222:     int root,
  223:     int wanted,
  224:     void Function() check,
  225:   ) async {
  226:     final out = <ReplyInfo>[];
  227:     String? offset;
  228:     while (out.length < wanted) {
  229:       await Future.delayed(const Duration(milliseconds: 200));
  230:       check();
  231:       final res = await ReplyGrpc.detailList(
  232:         oid: oid,
  233:         root: root,
  234:         rpid: 0,
  235:         mode: Mode.MAIN_LIST_HOT,
  236:         offset: offset,
  237:       );
  238:       if (res is! Success<DetailListReply>) break;
  239:       final page = res.response;
  240:       out.addAll(page.root.replies);
  241:       offset = page.paginationReply.nextOffset;
  242:       if (page.root.replies.isEmpty || offset.isEmpty) break;
  243:     }
  244:     return out;
  245:   }
  246: 
  247:   /// [images] saves the comment's pictures and emotes next to the video;
  248:   /// their paths (relative to the comments file) are recorded, so the
  249:   /// offline panel shows them without any network request.
  250:   static Future<Map<String, Object?>> replyToJson(
  251:     ReplyInfo r, [
  252:     CommentImages? images,
  253:   ]) async {
  254:     final pictures = <String>[];
  255:     final emotes = <String, String>{};
  256:     if (images != null) {
  257:       for (final p in r.content.pictures) {
  258:         if (await images.save(p.imgSrc) case final local?) pictures.add(local);
  259:       }
  260:       for (final e in r.content.emotes.entries) {
  261:         if (await images.save(e.value.url) case final local?) {
  262:           emotes[e.key] = local;
  263:         }
  264:       }
  265:     }
  266:     return {
  267:       'rpid': r.id.toInt(),
  268:       'mid': r.mid.toInt(),
  269:       'uname': r.member.name,
  270:       'avatar': r.member.face,
  271:       'content': r.content.message,
  272:       'ctime': r.ctime.toInt(),
  273:       'like': r.like.toInt(),
  274:       'replyCount': r.count.toInt(),
  275:       if (pictures.isNotEmpty) 'pictures': pictures,
  276:       if (emotes.isNotEmpty) 'emotes': emotes,
  277:     };
  278:   }
  279: 
  280:   // ------------------------------------------------------------ danmaku
  281: 
  282:   /// Bilibili XML danmaku format (as served by comment.bilibili.com).
  283:   static String danmakuToXml(List<DanmakuElem> elems, {required int cid}) {
  284:     final b = StringBuffer()
  285:       ..write('<?xml version="1.0" encoding="UTF-8"?>\n<i>')
  286:       ..write('<chatserver>chat.bilibili.com</chatserver>')
  287:       ..write('<chatid>$cid</chatid><mission>0</mission>')
  288:       ..write('<maxlimit>${elems.length}</maxlimit><state>0</state>')
  289:       ..write('<real_name>0</real_name><source>k-v</source>\n');
  290:     for (final e in elems) {
  291:       final p = [
  292:         (e.progress / 1000).toStringAsFixed(5),
  293:         e.mode,
  294:         e.fontsize,
  295:         e.color,
  296:         e.ctime,
  297:         e.pool,
  298:         e.midHash,
  299:         e.idStr.isNotEmpty ? e.idStr : e.id,
  300:         e.weight,
  301:       ].join(',');
  302:       b.write('<d p="$p">${_xmlEscape(e.content)}</d>\n');
  303:     }
  304:     b.write('</i>\n');
  305:     return b.toString();
  306:   }
  307: 
  308:   /// `<d ... p="..." ...>text</d>`; other tools may add attributes before
  309:   /// or after `p` and quote it with ' instead of ".
  310:   static final _xmlDanmaku = RegExp(
  311:     r'''<d\s[^>]*?\bp\s*=\s*(?:"([^"]*)"|'([^']*)')[^>]*>([\s\S]*?)</d>''',
  312:   );
  313: 
  314:   /// Parses Bilibili XML danmaku (as written by [danmakuToXml] or saved by
  315:   /// other tools) back into elements for the player.
  316:   static List<DanmakuElem> xmlToDanmaku(String xml) {
  317:     final out = <DanmakuElem>[];
  318:     for (final m in _xmlDanmaku.allMatches(xml)) {
  319:       final p = (m.group(1) ?? m.group(2)!).split(',');
  320:       if (p.length < 4) continue;
  321:       final seconds = double.tryParse(p[0]);
  322:       if (seconds == null) continue;
  323:       out.add(
  324:         DanmakuElem(
  325:           progress: (seconds * 1000).round(),
  326:           mode: int.tryParse(p[1]) ?? 1,
  327:           fontsize: int.tryParse(p[2]) ?? 25,
  328:           color: int.tryParse(p[3]) ?? 0xFFFFFF,
  329:           ctime: p.length > 4 ? Int64(int.tryParse(p[4]) ?? 0) : null,
  330:           pool: p.length > 5 ? int.tryParse(p[5]) : null,
  331:           midHash: p.length > 6 ? p[6] : null,
  332:           idStr: p.length > 7 ? p[7] : null,
  333:           weight: p.length > 8 ? int.tryParse(p[8]) : null,
  334:           content: _xmlUnescape(m.group(3)!),
  335:         ),
  336:       );
  337:     }
  338:     return out;
  339:   }
  340: 
  341:   static final _xmlEntity = RegExp(r'&(#[0-9]+|#[xX][0-9a-fA-F]+|[a-z]+);');
  342: 
  343:   /// Named and numeric (`&#39;`, `&#x27;`) entities, in one pass so an
  344:   /// escaped `&amp;lt;` stays `&lt;`.
  345:   static String _xmlUnescape(String s) => s.replaceAllMapped(_xmlEntity, (m) {
  346:     final e = m[1]!;
  347:     if (e.startsWith('#')) {
  348:       final code = e.length > 1 && (e[1] == 'x' || e[1] == 'X')
  349:           ? int.tryParse(e.substring(2), radix: 16)
  350:           : int.tryParse(e.substring(1));
  351:       return code != null && code >= 0 && code <= 0x10FFFF
  352:           ? String.fromCharCode(code)
  353:           : m[0]!;
  354:     }
  355:     return switch (e) {
  356:       'lt' => '<',
  357:       'gt' => '>',
  358:       'quot' => '"',
  359:       'apos' => "'",
  360:       'amp' => '&',
  361:       _ => m[0]!,
  362:     };
  363:   });
  364: 
  365:   static const _assW = 1920;
  366:   static const _assH = 1080;
  367:   static const _scrollSec = 8.0;
  368:   static const _fixedSec = 4.0;
  369: 
  370:   /// ASS subtitles with a fixed default style, for external players.
  371:   static String danmakuToAss(List<DanmakuElem> elems, {String title = ''}) {
  372:     final b = StringBuffer()
  373:       ..writeln('[Script Info]')
  374:       ..writeln('Title: ${title.replaceAll('\n', ' ')}')
  375:       ..writeln('ScriptType: v4.00+')
  376:       ..writeln('PlayResX: $_assW')
  377:       ..writeln('PlayResY: $_assH')
  378:       ..writeln('WrapStyle: 2')
  379:       ..writeln('ScaledBorderAndShadow: yes')
  380:       ..writeln()
  381:       ..writeln('[V4+ Styles]')
  382:       ..writeln(
  383:         'Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, '
  384:         'OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, '
  385:         'ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, '
  386:         'Alignment, MarginL, MarginR, MarginV, Encoding',
  387:       )
  388:       ..writeln(
  389:         'Style: Danmaku,Microsoft YaHei,50,&H00FFFFFF,&H00FFFFFF,'
  390:         '&H80000000,&H00000000,0,0,0,0,100,100,0,0,1,2,0,7,0,0,0,1',
  391:       )
  392:       ..writeln()
  393:       ..writeln('[Events]')
  394:       ..writeln(
  395:         'Format: Layer, Start, End, Style, Name, MarginL, MarginR, '
  396:         'MarginV, Effect, Text',
  397:       );
  398: 
  399:     const lineGap = 6;
  400:     final scrollFree = <double>[]; // per lane: time the lane frees up
  401:     final topFree = <double>[];
  402:     final bottomFree = <double>[];
  403: 
  404:     int lane(List<double> free, double t, int maxLanes) {
  405:       for (var i = 0; i < free.length; i++) {
  406:         if (free[i] <= t) return i;
  407:       }
  408:       if (free.length < maxLanes) {
  409:         free.add(0);
  410:         return free.length - 1;
  411:       }
  412:       // all busy: reuse the one that frees up first
  413:       var best = 0;
  414:       for (var i = 1; i < free.length; i++) {
  415:         if (free[i] < free[best]) best = i;
  416:       }
  417:       return best;
  418:     }
  419: 
  420:     for (final e in elems) {
  421:       final text = e.content.trim();
  422:       if (text.isEmpty) continue;
  423:       final mode = e.mode;
  424:       if (mode == 7 || mode == 8 || mode == 9) continue; // scripted/advanced
  425:       final size = _fontPx(e.fontsize);
  426:       final lineH = size + lineGap;
  427:       final maxLanes = math.max(1, (_assH * 0.85 / lineH).floor());
  428:       final w = _textWidth(text, size);
  429:       final t = e.progress / 1000;
  430:       final color = e.color == 0xFFFFFF || e.color == 0
  431:           ? ''
  432:           : '\\c${_assColor(e.color)}';
  433:       final sizeTag = size == 50 ? '' : '\\fs$size';
  434:       final String tags;
  435:       final double end;
  436:       if (mode == 4 || mode == 5) {
  437:         end = t + _fixedSec;
  438:         if (mode == 5) {
  439:           final l = lane(topFree, t, maxLanes);
  440:           topFree[l] = end;
  441:           tags = '\\an8\\pos(${_assW ~/ 2},${l * lineH})';
  442:         } else {
  443:           final l = lane(bottomFree, t, maxLanes);
  444:           bottomFree[l] = end;
  445:           tags = '\\an2\\pos(${_assW ~/ 2},${_assH - l * lineH})';
  446:         }
  447:       } else {
  448:         end = t + _scrollSec;
  449:         final l = lane(scrollFree, t, maxLanes);
  450:         // lane is free again once this item has fully entered the screen
  451:         scrollFree[l] = t + (w + 40) * _scrollSec / (_assW + w);
  452:         tags = '\\move($_assW,${l * lineH},${-w},${l * lineH})';
  453:       }
  454:       b.writeln(
  455:         'Dialogue: 0,${_assTime(t)},${_assTime(end)},Danmaku,,0,0,0,,'
  456:         '{$tags$color$sizeTag}${_assEscape(text)}',
  457:       );
  458:     }
  459:     return b.toString();
  460:   }
  461: 
  462:   static int _fontPx(int fontsize) => switch (fontsize) {
  463:     <= 18 => 38,
  464:     >= 36 => 68,
  465:     _ => 50,
  466:   };
  467: 
  468:   static int _textWidth(String s, int size) {
  469:     var w = 0.0;
  470:     for (final r in s.runes) {
  471:       w += r < 0x2E80 ? size * 0.55 : size.toDouble();
  472:     }
  473:     return w.ceil();
  474:   }
  475: 
  476:   static String _assColor(int rgb) {
  477:     final r = (rgb >> 16) & 0xFF, g = (rgb >> 8) & 0xFF, b = rgb & 0xFF;
  478:     String h(int v) => v.toRadixString(16).padLeft(2, '0').toUpperCase();
  479:     return '&H${h(b)}${h(g)}${h(r)}&';
  480:   }
  481: 
  482:   static String _assTime(double s) {
  483:     final cs = (s * 100).round();
  484:     final h = cs ~/ 360000;
  485:     final m = (cs % 360000) ~/ 6000;
  486:     final sec = (cs % 6000) ~/ 100;
  487:     final c = cs % 100;
  488:     String two(int v) => v.toString().padLeft(2, '0');
  489:     return '$h:${two(m)}:${two(sec)}.${two(c)}';
  490:   }
  491: 
  492:   static String _assEscape(String s) => s
  493:       .replaceAll('{', '｛')
  494:       .replaceAll('}', '｝')
  495:       .replaceAll('\\', '＼')
  496:       .replaceAll('\r', '')
  497:       .replaceAll('\n', '\\N');
  498: 
  499:   static String _xmlEscape(String s) => s
  500:       .replaceAll('&', '&amp;')
  501:       .replaceAll('<', '&lt;')
  502:       .replaceAll('>', '&gt;')
  503:       .replaceAll('"', '&quot;')
  504:       .replaceAll(RegExp(r'[\x00-\x08\x0B\x0C\x0E-\x1F]'), '');
  505: 
  506:   static String _safe(String s) => s.replaceAll(RegExp(r'[\\/:*?"<>|\s]'), '_');
  507: }
  508: 
  509: class _Cancelled implements Exception {
  510:   const _Cancelled();
  511: 
  512:   @override
  513:   String toString() => 'cancelled';
  514: }
  515: 
  516: /// Pictures and emotes of saved comments, stored once per URL in
  517: /// `comments_images/` next to the comments file.
  518: class CommentImages {
  519:   CommentImages(this.folder);
  520: 
  521:   static const dirName = 'comments_images';
  522: 
  523:   final String folder;
  524:   final _done = <String, String?>{};
  525:   int saved = 0;
  526: 
  527:   /// Returns the path relative to [folder], or null if it failed.
  528:   Future<String?> save(String url) async {
  529:     if (url.isEmpty) return null;
  530:     url = url.http2https;
  531:     if (_done.containsKey(url)) return _done[url];
  532:     String? result;
  533:     try {
  534:       var ext = path.extension(Uri.parse(url).path).toLowerCase();
  535:       if (ext.isEmpty || ext.length > 5) ext = '.jpg';
  536:       final name = '${md5.convert(utf8.encode(url))}$ext';
  537:       final file = File(path.join(folder, dirName, name));
  538:       if (!file.existsSync()) {
  539:         // not recursive: if the video folder was deleted meanwhile, fail
  540:         // instead of recreating it as an orphan
  541:         await file.parent.create();
  542:         final part = '${file.path}.part';
  543:         await Request.dio.download(url, part);
  544:         await File(part).rename(file.path);
  545:         saved++;
  546:       }
  547:       result = '$dirName/$name';
  548:     } catch (e) {
  549:       if (kDebugMode) debugPrint('comment image $url: $e');
  550:     }
  551:     return _done[url] = result;
  552:   }
  553: }
