   50:     // saving the favourite live areas (app-API write, access_key only)
   51:     Api.setLiveFavTag,
   52:     // messages
   53:     Api.msgUnread, Api.msgFeedUnread, Api.msgFeedReply, Api.msgFeedAt,
   54:     Api.msgFeedLike, Api.msgLikeDetail, Api.msgSysNotify,
   55:     Api.msgSysUpdateCursor, Api.sessionList, Api.sessionAccountList,
   56:     Api.sessionMsg, Api.ackSessionMsg, Api.imUserInfos, Api.getSessionSs,
   57:     Api.getMsgDnd,
   58:     // app-API writes (access_key, no csrf)
   59:     Api.likeVideo, Api.dislikeVideo, Api.coinVideo,
   60:     // login flow
   61:     Api.qrcodeConfirm, Api.logout, Api.activateBuvidApi,
   62:   };
   63: 
   64:   static const Set<String> _grpcAccountApis = {
   65:     GrpcUrl.dynRed,
   66:     GrpcUrl.audioPlayUrl,
   67:     GrpcUrl.audioThumbUp,
   68:     GrpcUrl.audioTripleLike,
   69:     GrpcUrl.audioCoinAdd,
   70:   };
   71: 
   72:   static const List<String> _grpcAccountPrefixes = [GrpcUrl.im, GrpcUrl.im2];
   73: 
   74:   static const _csrfKeys = {'csrf', 'biliCSRF', 'csrf_token'};
   75:   static const _selfKeys = ['mid', 'vmid', 'up_mid'];
   76: 
   77:   /// Whether UI that writes (comments, replies, danmaku, live chat) is
   78:   /// shown: it needs a logged-in account and the "hide interaction" switch
   79:   /// off. Existing comments and danmaku are displayed either way.
   80:   static bool get canInteract => Accounts.main.isLogin && !Pref.hideInteraction;
   81: 
   82:   /// Whether [options] may carry the logged-in account. False means it is
   83:   /// sent anonymously even in login mode.
   84:   static bool requiresAccount(RequestOptions options) {
   85:     final path = options.path;
   86:     // gRPC requests are sent as `appBaseUrl + GrpcUrl.x`
   87:     final grpcPath = path.startsWith(HttpString.appBaseUrl)
   88:         ? path.substring(HttpString.appBaseUrl.length)
   89:         : path;
   90:     if (_accountApis.contains(path) ||
   91:         _grpcAccountApis.contains(grpcPath) ||
   92:         _grpcAccountPrefixes.any(grpcPath.startsWith)) {
   93:       return true;
   94:     }
   95:     final query = options.queryParameters;
   96:     final data = options.data;
   97:     // web writes are csrf-protected (some GET reads also carry csrf; they
   98:     // are not writes and stay anonymous)
   99:     if (options.method.toUpperCase() != 'GET' &&
  100:         (query.keys.any(_csrfKeys.contains) ||
  101:             (data is Map && data.keys.any(_csrfKeys.contains)) ||
  102:             (data is FormData &&
  103:                 data.fields.any((e) => _csrfKeys.contains(e.key))))) {
  104:       return true;
  105:     }
  106:     // reads scoped to the user themself (own space, own followings...)
  107:     final mid = Accounts.main.mid;
  108:     if (mid != 0) {
  109:       for (final key in _selfKeys) {
  110:         final v = query[key] ?? (data is Map ? data[key] : null);
  111:         if (v != null && '$v' == '$mid') return true;
  112:       }
  113:     }
  114:     return false;
  115:   }
  116: }
