    9: abstract final class LinuxCookieManager {
   10:   static bool isBiliDomain(String url) {
   11:     final uri = Uri.tryParse(url);
   12:     if (uri == null) return false;
   13:     final host = uri.host.toLowerCase();
   14:     return host == 'bilibili.com' || host.endsWith('.bilibili.com');
   15:   }
   16: 
   17:   static List<Cookie> getCookies([Account? account]) {
   18:     final targetAccount = account ?? Accounts.main;
   19:     return targetAccount.cookieJar.toList();
   20:   }
   21: 
   22:   static Future<void> deleteAllCookies() async {
   23:     if (!Platform.isLinux) return;
   24:     try {
   25:       await dww.WebviewWindow.clearAll();
   26:     } catch (e) {
   27:       if (kDebugMode) {
   28:         debugPrint('LinuxCookieManager: deleteAllCookies failed: $e');
   29:       }
   30:     }
   31:   }
   32: 
   33:   static String generateCookieInjectionJs([List<Cookie>? cookieList]) {
   34:     final cookies = cookieList ?? getCookies();
   35:     if (cookies.isEmpty) return '';
   36: 
   37:     final cookieMaps = cookies.map((c) {
   38:       final rawDomain = c.domain ?? 'bilibili.com';
   39:       final domain = rawDomain.startsWith('.') ? rawDomain : '.$rawDomain';
   40:       return {
   41:         'name': c.name,
   42:         'value': c.value,
   43:         'domain': domain,
   44:         'path': c.path ?? '/',
   45:         'secure': c.secure,
   46:       };
   47:     }).toList();
   48: 
   49:     final jsonStr = jsonEncode(cookieMaps);
   50: 
   51:     return '''
   52: (function() {
   53:   try {
   54:     var cookies = $jsonStr;
   55:     for (var i = 0; i < cookies.length; i++) {
   56:       var c = cookies[i];
   57:       var str = c.name + '=' + c.value + '; path=' + (c.path || '/') + '; domain=' + c.domain + '; max-age=31536000; SameSite=Lax';
   58:       if (c.secure) str += '; Secure';
   59:       document.cookie = str;
   60:     }
   61:   } catch (e) {
   62:     console.error('[LinuxWebview] Cookie injection error:', e);
   63:   }
   64: })();
   65: ''';
   66:   }
   67: }

