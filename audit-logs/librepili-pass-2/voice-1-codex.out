   18: 
   19:   @override
   20:   List<DownloadPageInfo> get list => pages;
   21:   @override
   22:   RxList<DownloadPageInfo> get state => pages;
   23: 
   24:   @override
   25:   void onInit() {
   26:     super.onInit();
   27:     _loadList();
   28:     _downloadService.flagNotifier.add(_loadList);
   29:   }
   30: 
   31:   @override
   32:   void onClose() {
   33:     _downloadService.flagNotifier.remove(_loadList);
   34:     super.onClose();
   35:   }
   36: 
   37:   Future<void> _loadList() async {
   38:     await _downloadService.waitForInitialization;
   39:     if (isClosed) return;
   40:     if (_downloadService.downloadList.isEmpty) {
   41:       pages.clear();
   42:       return;
   43:     }
   44:     final list = <DownloadPageInfo>[];
   45:     for (final entry in _downloadService.downloadList) {
   46:       final pageId = entry.pageId;
   47:       final page = list.firstWhereOrNull((e) => e.pageId == pageId);
   48:       if (page != null) {
   49:         final aSortKey = entry.sortKey;
   50:         final bSortKey = page.sortKey;
   51:         if (aSortKey < bSortKey) {
   52:           page
   53:             ..cover = entry.cover
   54:             ..sortKey = aSortKey;
   55:         }
   56:         page.entries.add(entry);
   57:       } else {
   58:         list.add(
   59:           DownloadPageInfo(
   60:             pageId: pageId,
   61:             dirPath: entry.pageDirPath,
   62:             title: entry.title,
   63:             cover: entry.cover,
   64:             sortKey: entry.sortKey,
   65:             seasonType: entry.ep?.seasonType,
   66:             entries: [entry],
   67:           ),
   68:         );
   69:       }
   70:     }
   71:     pages.value = list;
   72:     flag.value++;
   73:   }
   74: 
   75:   @override
   76:   Future<void> onRemove() async {
   77:     final allChecked = this.allChecked.toList();
   78:     final deleteExported = await showDeleteDownloadDialog(
   79:       Get.context!,
   80:       title: '确定删除选中视频？',
   81:       exportOption: allChecked.any(
   82:         (page) => page.entries.any((e) => e.mergedPath != null),
   83:       ),
   84:     );
   85:     if (deleteExported == null) return;
   86:     SmartDialog.showLoading();
   87:     final watchProgress = GStorage.watchProgress;
   88:     for (final page in allChecked) {
   89:       await watchProgress.deleteAll(
   90:         page.entries.map((e) => e.cid.toString()),
   91:       );
   92:       await _downloadService.deletePage(
   93:         pageDirPath: page.dirPath,
   94:         refresh: false,
   95:         deleteExported: deleteExported,
   96:       );
   97:     }
   98:     _downloadService.flagNotifier.refresh();
   99:     if (enableMultiSelect.value) {
  100:       rxCount.value = 0;
  101:       enableMultiSelect.value = false;
  102:     }
  103:     SmartDialog.dismiss();
  104:   }
  105: }

