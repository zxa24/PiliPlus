   10: class DownloadManager {
   11:   final String url;
   12: 
   13:   /// Other CDN addresses of the same stream, tried in turn when a transfer
   14:   /// breaks off (LibrePili: some mirrors drop long transfers mid-way).
   15:   final List<String> backupUrls;
   16:   final String path;
   17:   final void Function(int, int)? onReceiveProgress;
   18:   final void Function([Object? error]) onDone;
   19: 
   20:   static const _maxAttempts = 6;
   21: 
   22:   DownloadStatus _status = DownloadStatus.downloading;
   23: 
   24:   DownloadStatus get status => _status;
   25:   final _cancelToken = CancelToken();
   26:   late Future<void> task;
   27: 
   28:   DownloadManager({
   29:     required this.url,
   30:     this.backupUrls = const [],
   31:     required this.path,
   32:     required this.onReceiveProgress,
   33:     required this.onDone,
   34:   }) {
   35:     task = _start();
   36:   }
   37: 
   38:   Future<void> _start() async {
   39:     final urls = [
   40:       url,
   41:       for (final u in backupUrls)
   42:         if (u != url) u,
   43:     ];
   44:     for (var attempt = 0; ; attempt++) {
   45:       final error = await _attempt(urls[attempt % urls.length]);
   46:       if (error == null) return; // completed
   47:       if (!_canRetry || attempt + 1 >= _maxAttempts) {
   48:         await _fail(error);
   49:         return;
   50:       }
   51:       // resume from what is on disk, on the next address; pause/delete
   52:       // cuts the wait short
   53:       await Future.any<void>([
   54:         Future.delayed(Duration(seconds: attempt + 1)),
   55:         _cancelToken.whenCancel,
   56:       ]);
   57:       if (!_canRetry) {
   58:         await _fail(error);
   59:         return;
   60:       }
   61:     }
   62:   }
   63: 
   64:   bool get _canRetry =>
   65:       _status == DownloadStatus.downloading && !_cancelToken.isCancelled;
   66: 
   67:   Future<void> _fail(Object e) async {
   68:     final file = File(path);
   69:     if (_status == DownloadStatus.downloading) {
   70:       _status = DownloadStatus.failDownload;
   71:       // keep any saved bytes: a later start resumes from them
   72:       if (file.existsSync() && file.lengthSync() == 0) {
   73:         await file.tryDel();
   74:       }
   75:     }
   76:     onDone(e);
   77:   }
   78: 
   79:   static final _contentRangeReg = RegExp(r'bytes\s+(\d+)-\d+/(\d+|\*)');
   80: 
   81:   /// One transfer attempt. Returns null when the file is complete, else the
   82:   /// error.
   83:   Future<Object?> _attempt(String url) async {
   84:     int received;
   85: 
   86:     final file = File(path);
   87:     if (file.existsSync()) {
   88:       received = await file.length();
   89:     } else {
   90:       file.createSync(recursive: true);
   91:       received = 0;
   92:     }
   93: 
   94:     Response<ResponseBody> response;
   95:     try {
   96:       response = await Request.http11Dio.get<ResponseBody>(
   97:         url.http2https,
   98:         options: Options(
   99:           headers: {'range': 'bytes=$received-'},
  100:           responseType: ResponseType.stream,
  101:           validateStatus: (status) =>
  102:               status != null &&
  103:               (status == 416 || (status >= 200 && status < 300)),
  104:         ),
  105:         cancelToken: _cancelToken,
  106:       );
  107:     } on DioException catch (e) {
  108:       return e;
  109:     }
  110:     final data = response.data!;
  111:     final contentRange = response.headers.value(
  112:       HttpHeaders.contentRangeHeader,
  113:     );
  114: 
  115:     Future<void> discard() async {
  116:       try {
  117:         await data.stream.listen(null).cancel();
  118:       } catch (_) {}
  119:     }
  120: 
  121:     if (response.statusCode == 416) {
  122:       await discard();
  123:       // nothing left to send: complete only if the file on disk is whole
  124:       final total = int.tryParse(contentRange?.split('/').last ?? '');
  125:       if (total != null && total == received) {
  126:         _status = DownloadStatus.completed;
  127:         onDone();
  128:         return null;
  129:       }
  130:       // what is on disk does not match the stream: start over
  131:       await file.writeAsBytes(const []);
  132:       return 'range not satisfiable ($contentRange, have $received)';
  133:     }
  134: 
  135:     int expected = data.contentLength < 0 ? -1 : data.contentLength + received;
  136:     if (received > 0) {
  137:       if (response.statusCode != 206) {
  138:         // Range ignored: the body is the whole file, rewrite it from 0
  139:         received = 0;
  140:         expected = data.contentLength;
  141:       } else {
  142:         final match = contentRange == null
  143:             ? null
  144:             : _contentRangeReg.firstMatch(contentRange);
  145:         if (match == null || int.parse(match[1]!) != received) {
  146:           await discard();
  147:           return 'unexpected content-range: $contentRange (have $received)';
  148:         }
  149:         expected = int.tryParse(match[2]!) ?? expected;
  150:       }
  151:     }
  152: 
  153:     final sink = file.openWrite(
  154:       mode: received == 0 ? FileMode.writeOnly : FileMode.writeOnlyAppend,
  155:     );
  156: 
  157:     if (received == 0) {
  158:       onReceiveProgress?.call(0, expected);
  159:     }
  160: 
  161:     int? last;
  162:     try {
  163:       await for (final chunk in data.stream) {
  164:         sink.add(chunk);
  165:         received += chunk.length;
  166:         final now = DateTime.now().millisecondsSinceEpoch ~/ 1000;
  167:         if (last != now) {
  168:           last = now;
  169:           onReceiveProgress?.call(received, expected);
  170:         }
  171:       }
  172:       await sink.close();
  173:     } catch (e) {
  174:       try {
  175:         await sink.close();
  176:       } catch (_) {}
  177:       return e;
  178:     }
  179:     if (expected >= 0 && received != expected) {
  180:       // clean early EOF: retry from what was saved
  181:       return 'incomplete transfer: $received of $expected bytes';
  182:     }
  183:     _status = DownloadStatus.completed;
  184:     onDone();
  185:     return null;
  186:   }
  187: 
  188:   Future<void> cancel({required bool isDelete}) {
  189:     if (!isDelete && _status == DownloadStatus.downloading) {
  190:       _status = DownloadStatus.pause;
  191:     }
  192:     if (!_cancelToken.isCancelled) {
  193:       _cancelToken.cancel();
  194:     }
  195:     return task;
  196:   }
  197: }

