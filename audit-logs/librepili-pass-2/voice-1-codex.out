  120:   static String genDeviceId() {
  121:     // https://github.com/bilive/bilive_client/blob/2873de0532c54832f5464a4c57325ad9af8b8698/bilive/lib/app_client.ts#L62
  122:     final time = DateTime.now();
  123: 
  124:     final List<int> bytes = [
  125:       ...Iterable.generate(16, (_) => Utils.random.nextInt(256)),
  126:       _dec2bcd(time.year ~/ 100),
  127:       _dec2bcd(time.year % 100),
  128:       _dec2bcd(time.month),
  129:       _dec2bcd(time.day),
  130:       _dec2bcd(time.hour),
  131:       _dec2bcd(time.minute),
  132:       _dec2bcd(time.second),
  133:       ...Iterable.generate(8, (_) => Utils.random.nextInt(256)),
  134:     ];
  135:     final check = (bytes.sum & 0xFF).toRadixString(16).padLeft(2, '0');
  136: 
  137:     return Digest(bytes).toString() + check;
  138:   }
  139: 
  140:   static int _dec2bcd(int dec) {
  141:     assert(0 <= dec && dec < 100);
  142:     return ((dec ~/ 10) << 4) | (dec % 10);
  143:   }
  144: }

