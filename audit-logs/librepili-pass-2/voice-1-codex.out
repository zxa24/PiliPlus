   37: abstract final class PiliScheme {
   38:   static late AppLinks appLinks;
   39:   static StreamSubscription? listener;
   40:   static final uriDigitRegExp = RegExp(r'/(\d+)');
   41:   static final _prefixRegex = RegExp(r'^\S+://');
   42: 
   43:   static void init() {
   44:     // Register our protocol only on Windows platform
   45:     // registerProtocolHandler('bilibili');
   46:     appLinks = AppLinks();
   47: 
   48:     listener?.cancel();
   49:     final handler = PlatformUtils.isDesktop ? _desktopRoutePush : routePush;
   50:     // same as uriLinkStream, plus files opened while already running
   51:     listener = appLinks.stringLinkStream.listen((link) {
   52:       if (link.startsWith(_openFilePrefix)) {
   53:         _openFile(link.substring(_openFilePrefix.length));
   54:       } else if (Uri.tryParse(link) case final uri?) {
   55:         handler(uri);
   56:       }
   57:     });
   58:   }
   59: 
   60:   /// Sent by windows/runner/main.cpp for "Open with" when an instance is
   61:   /// already running.
   62:   static const _openFilePrefix = 'librepili-open:';
   63: 
   64:   static Future<void> _openFile(String target) async {
   65:     if (PlatformUtils.isDesktop) {
   66:       await windowManager.show();
   67:       await windowManager.focus();
   68:     }
   69:     if (FileSystemEntity.typeSync(target) != FileSystemEntityType.notFound) {
   70:       await LocalPlayer.open(target);
   71:     }
   72:   }
   73: 
   74:   static Future<bool> _desktopRoutePush(Uri uri) async {
   75:     await windowManager.show();
   76:     await windowManager.focus();
   77:     return routePush(uri);
   78:   }
   79: 
   80:   static int? _videoProgress(Map<String, String> queryParameters) {
   81:     if ((queryParameters['start_progress'] ?? queryParameters['dm_progress'])
   82:         case final p?) {
   83:       return int.tryParse(p);
   84:     } else if (queryParameters['t'] case final t0?) {
   85:       if (double.tryParse(t0) case final t1?) {
   86:         return (t1 * 1000).toInt();
   87:       }
   88:     }
   89:     return null;
   90:   }
   91: 
   92:   static Future<bool> routePushFromUrl(
   93:     String url, {
   94:     bool selfHandle = false,
   95:     bool off = false,
   96:     Map? parameters,
   97:     int? businessId,
   98:     int? oid,
   99:   }) {
  100:     try {
  101:       if (url.startsWith('//')) {
  102:         url = 'https:$url';
  103:       } else if (!_prefixRegex.hasMatch(url)) {
  104:         url = 'https://$url';
  105:       }
  106:       return routePush(
  107:         Uri.parse(url),
  108:         selfHandle: selfHandle,
  109:         off: off,
  110:         parameters: parameters,
  111:         businessId: businessId,
  112:         oid: oid,
  113:       );
  114:     } catch (_) {
  115:       return Future.syncValue(false);
  116:     }
  117:   }
  118: 
  119:   /// 路由跳转
  120:   static Future<bool> routePush(
  121:     Uri uri, {
  122:     bool selfHandle = false,
  123:     bool off = false,
  124:     Map? parameters,
  125:     int? businessId,
  126:     int? oid,
  127:   }) async {
  128:     // if (kDebugMode) debugPrint('onAppLink: $uri');
  129: 
  130:     final String scheme = uri.scheme;
  131:     final String host = uri.host;
  132:     final String path = uri.path;
  133: 
  134:     switch (scheme) {
  135:       case 'bilibili':
  136:         switch (host) {
  137:           case 'root':
  138:             Get.key.currentState!.popUntil(
  139:               (Route<dynamic> route) => route.isFirst,
  140:             );
  141:             return true;
  142:           case 'pgc':
  143:             // bilibili://pgc/season/ep/123456?h5_awaken_params=random
  144:             String? id = uriDigitRegExp.firstMatch(path)?.group(1);
  145:             if (id != null) {
  146:               bool isEp = path.contains('/ep/');
  147:               PageUtils.viewPgc(
  148:                 seasonId: isEp ? null : id,
  149:                 epId: isEp ? id : null,
  150:                 progress: _videoProgress(uri.queryParameters),
  151:               );
  152:               return true;
  153:             }
  154:             return false;
  155:           case 'space':
  156:             // bilibili://space/12345678?frommodule=XX&h5awaken=random
  157:             String? mid = uriDigitRegExp.firstMatch(path)?.group(1);
  158:             if (mid != null) {
  159:               if (path.startsWith('/realname')) {
  160:                 RequestUtils.showUserRealName(mid);
  161:                 return true;
  162:               }
  163:               PageUtils.toDupNamed('/member?mid=$mid', off: off);
  164:               return true;
  165:             }
  166:             return false;
  167:           case 'video':
  168:             // bilibili://video/12345678?dm_progress=123000&cid=12345678&dmid=12345678
  169:             // bilibili://video/{aid}/?comment_root_id=***&comment_secondary_id=***
  170:             final queryParameters = uri.queryParameters;

