  657:   /// Old single-URL (durl) streams. FLV with H.264 + AAC is remuxed into a
  658:   /// real mp4 and MP4 segments are joined, all segments in timeline order; a
  659:   /// single mp4 segment is moved as is. When that is not possible (other
  660:   /// codecs, segments with differing codec configuration) the original data
  661:   /// is kept with its own extension (several segments: `<base>.flv`,
  662:   /// `<base>.2.flv`, ...). Returns the (first) exported file.
  663:   static Future<String> _exportType1(List<String> inputs, String output) async {
  664:     final isFlv = Mp4Remuxer.isFlv(inputs.first);
  665:     if (!isFlv && inputs.length == 1) {
  666:       await _moveFile(inputs.first, output);
  667:       return output;
  668:     }
  669:     if (isFlv || inputs.every(Mp4Remuxer.isMp4)) {
  670:       try {
  671:         await Isolate.run(
  672:           () => isFlv
  673:               ? Mp4Remuxer.remuxFlv(inputs: inputs, output: output)
  674:               : Mp4Remuxer.joinMp4(inputs: inputs, output: output),
  675:         );
