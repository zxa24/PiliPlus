  184:   static final _emoteReg = RegExp(r'\[[^\[\]]+\]');
  185: 
  186:   /// Text with the saved emotes inline.
  187:   Widget _content(Map c) {
  188:     const style = TextStyle(fontSize: 14, height: 1.5);
  189:     final text = '${c['content'] ?? ''}';
  190:     final emotes = (c['emotes'] as Map?)?.cast<String, String>();
  191:     if (emotes == null || emotes.isEmpty) {
  192:       return SelectableText(text, style: style);
  193:     }
  194:     final spans = <InlineSpan>[];
  195:     var last = 0;
  196:     for (final m in _emoteReg.allMatches(text)) {
  197:       final local = emotes[m[0]];
  198:       if (local == null) continue;
  199:       if (m.start > last) {
  200:         spans.add(TextSpan(text: text.substring(last, m.start)));
  201:       }
  202:       spans.add(
  203:         WidgetSpan(
  204:           alignment: PlaceholderAlignment.middle,
  205:           child: Image.file(
  206:             _file(local),
  207:             width: 20,
  208:             height: 20,
  209:             errorBuilder: (_, _, _) => Text(m[0]!),
  210:           ),
  211:         ),
  212:       );
  213:       last = m.end;
  214:     }
  215:     if (last < text.length) spans.add(TextSpan(text: text.substring(last)));
  216:     return Text.rich(TextSpan(children: spans), style: style);
  217:   }
  218: 
  219:   Widget _picture(BuildContext context, String relative) {
  220:     final file = _file(relative);
  221:     return GestureDetector(
  222:       onTap: () => showDialog<void>(
  223:         context: context,
  224:         builder: (context) => GestureDetector(
  225:           onTap: Navigator.of(context).pop,
  226:           child: InteractiveViewer(child: Image.file(file)),
  227:         ),
  228:       ),
  229:       child: ClipRRect(
  230:         borderRadius: BorderRadius.circular(6),
  231:         child: Image.file(
  232:           file,
  233:           width: 96,
  234:           height: 96,
  235:           fit: BoxFit.cover,
  236:           cacheWidth: 288,
  237:           errorBuilder: (_, _, _) => const SizedBox(
  238:             width: 96,
  239:             height: 96,
  240:             child: Icon(Icons.broken_image_outlined),
  241:           ),
  242:         ),
  243:       ),
  244:     );
  245:   }
  246: }

