    3: /// LibrePili: pure-Dart FLV demuxer feeding [Mp4Remuxer]'s progressive MP4
    4: /// writer, for the old single-URL (durl) downloads.
    5: ///
    6: /// FLV AVC payloads are already length-prefixed NAL units and AAC payloads
    7: /// raw frames, which is exactly what MP4 samples hold, so sample bytes are
    8: /// never decoded: every sample becomes a chunk pointing into its FLV file and
    9: /// is copied byte-for-byte. Only H.264 video and AAC audio are supported;
   10: /// anything else throws [UnsupportedError].
   11: abstract final class _FlvDemuxer {
   12:   /// A segment starting more than this before the end of what came earlier
   13:   /// restarted its clock and is placed after it; a continuing segment starts
   14:   /// within about a frame of that end.
   15:   static const _restartToleranceMs = 100;
   16: 
   17:   static List<_Track> demux(List<String> inputs) {
   18:     final video = _FlvTrackBuilder(isVideo: true);
   19:     final audio = _FlvTrackBuilder(isVideo: false);
   20:     for (final input in inputs) {
   21:       final raf = File(input).openSync();
   22:       try {
   23:         final r = _FileReader(raf);
   24:         final header = r.read(0, 9);
   25:         if (String.fromCharCodes(header, 0, 3) != 'FLV') {
   26:           throw FormatException('not an FLV file: $input');
   27:         }
   28:         // header, then PreviousTagSize0
   29:         var pos = ByteData.sublistView(header).getUint32(5) + 4;
   30:         int? offset; // ms added to this segment's timestamps
   31:         while (pos + 11 <= r.length) {
   32:           final h = r.read(pos, 11);
   33:           final type = h[0];
   34:           final dataSize = (h[1] << 16) | (h[2] << 8) | h[3];
   35:           final ts = ((h[7] << 24) | (h[4] << 16) | (h[5] << 8) | h[6])
   36:               .toSigned(32);
   37:           final dataPos = pos + 11;
   38:           if (dataPos + dataSize > r.length) break; // truncated last tag
   39:           pos = dataPos + dataSize + 4; // + PreviousTagSize
   40:           final kind = type & 0x1F;
   41:           if ((kind != 8 && kind != 9) || dataSize == 0) continue;
   42:           if (type & 0x20 != 0) throw UnsupportedError('encrypted FLV');
   43:           if (offset == null) {
   44:             final end = max(video.endMs, audio.endMs);
   45:             offset = end - ts > _restartToleranceMs ? end - ts : 0;
   46:           }
   47:           final head = r.read(dataPos, min(dataSize, 5));
   48:           final time = ts + offset;
   49:           if (kind == 9) {
   50:             video.addVideoTag(input, dataPos, dataSize, head, time, r);
   51:           } else {
   52:             audio.addAudioTag(input, dataPos, dataSize, head, time, r);
   53:           }
   54:         }
   55:       } finally {
   56:         raf.closeSync();
   57:       }
   58:     }
   59:     final starts = [
   60:       for (final b in [video, audio])
