  621:           path.join(videoDir, PathUtils.segmentNameType1(i)),
  622:       ];
  623:       if (inputs.isEmpty) {
  624:         inputs.add(path.join(videoDir, PathUtils.videoNameType1));
  625:       }
  626:     } else {
