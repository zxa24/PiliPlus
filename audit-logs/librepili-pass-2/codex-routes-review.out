+/// The sample entry boxes of an `stsd` box.
+List<Uint8List> _sampleEntriesOf(Uint8List stsd) {
+  // box header (8), version/flags (4), entry count (4)
+  final body = _R(Uint8List.sublistView(stsd, 16));
