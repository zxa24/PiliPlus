 1007:   static Future<String> _exportFilePath(BiliDownloadEntryInfo entry) async {
 1008:     final dir = await _exportDir();
 1009:     final parts = <String>[entry.title];
 1010:     if (entry.ep case final ep?) {
 1011:       parts.add(ep.showTitle ?? '${ep.index} ${ep.indexTitle}');
 1012:     } else if (entry.pageData case final page?) {
 1013:       final part = page.part;
 1014:       if (part != null && part.isNotEmpty && part != entry.title) {
 1015:         parts.add('P${page.page} $part');
 1016:       }
 1017:     }
 1018:     var name = parts
 1019:         .join(' - ')
 1020:         .replaceAll(_illegalFileChars, '_')
 1021:         .replaceAll(RegExp(r'\s+'), ' ')
 1022:         .trim();
 1023:     // cut by code point (never half an emoji); the name is used twice in
 1024:     // the path (folder and file), so keep it short for Windows' 260 limit
 1025:     if (name.runes.length > 80) {
 1026:       name = String.fromCharCodes(name.runes.take(80)).trim();
 1027:     }
 1028:     if (entry.qualityPithyDescription.isNotEmpty) {
 1029:       name +=
 1030:           ' [${entry.qualityPithyDescription.replaceAll(_illegalFileChars, '_')}]';
 1031:     }
 1032:     name = exportFolderName(name);
 1033:     // one folder per video: the mp4 plus danmaku / subtitles / comments
 1034:     // a folder holding only a half-written `.part` (app killed mid-merge) is
 1035:     // left over from an earlier attempt: reuse it instead of orphaning it
 1036:     // (not one another merge is writing into right now)
 1037:     bool isLeftover(Directory d) =>
 1038:         !_mergeFolders.contains(d.path) &&
 1039:         d.listSync().every((e) => e is File && e.path.endsWith('.part'));
 1040:     var base = name;
 1041:     for (
 1042:       var i = 2;
 1043:       Directory(path.join(dir, base)).existsSync() &&
 1044:           !isLeftover(Directory(path.join(dir, base)));
 1045:       i++
 1046:     ) {
 1047:       base = '$name ($i)';
 1048:     }
 1049:     final folder = Directory(path.join(dir, base));
 1050:     if (folder.existsSync()) {
 1051:       for (final part in folder.listSync()) {
 1052:         await File(part.path).tryDel();
 1053:       }
 1054:     }
 1055:     await folder.create(recursive: true);
 1056:     _mergeFolders.add(folder.path);
 1057:     return path.join(folder.path, '$base.mp4');
 1058:   }
