  830:   /// Old single-URL (durl) streams. FLV (H.264 / HEVC + AAC) is remuxed into
  831:   /// a real mp4 and MP4 segments are joined, all segments in timeline order,
  832:   /// also when the codec configuration changes between or within segments;
  833:   /// a single mp4 segment is moved as is. Damaged data ([FormatException])
  834:   /// is rethrown: [_repairSegments] has already re-downloaded what it could,
  835:   /// so the merge fails rather than splitting the video. Only what has no
  836:   /// MP4 mapping here ([UnsupportedError]: other codecs, a codec or the set
  837:   /// of tracks changing between segments, FLV and MP4 segments mixed) is
  838:   /// kept with its own extension (several segments: `<base>.flv`,
  839:   /// `<base>.2.flv`, ...). Returns the (first) exported file.
  840:   static Future<String> _exportType1(List<String> inputs, String output) async {
  841:     final allFlv = inputs.every(Mp4Remuxer.isFlv);
  842:     if (!allFlv && inputs.length == 1) {
  843:       final kept = '${path.withoutExtension(output)}${_sniffExt(inputs.first)}';
  844:       await _moveFile(inputs.first, kept);
  845:       return kept;
  846:     }
  847:     if (allFlv || inputs.every(Mp4Remuxer.isMp4)) {
  848:       try {
  849:         await Isolate.run(
  850:           () => allFlv
  851:               ? Mp4Remuxer.remuxFlv(inputs: inputs, output: output)
  852:               : Mp4Remuxer.joinMp4(inputs: inputs, output: output),
  853:         );
  854:         return output;
  855:       } on UnsupportedError catch (e) {
  856:         await File(output).tryDel();
  857:         if (kDebugMode) debugPrint('segments kept as they are: $e');
  858:       }
  859:     }
  860:     final base = path.withoutExtension(output);
  861:     String? first;
  862:     for (var i = 0; i < inputs.length; i++) {
  863:       final ext = _sniffExt(inputs[i]);
  864:       final to = i == 0 ? '$base$ext' : '$base.${i + 1}$ext';
  865:       await _moveFile(inputs[i], to);
  866:       first ??= to;
  867:     }
  868:     if (inputs.length > 1) {
  869:       SmartDialog.showToast('分段无法合并，已按原格式分为${inputs.length}个文件保存');
  870:     }

