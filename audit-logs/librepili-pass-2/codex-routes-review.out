   82:     private var pendingPick: MethodChannel.Result? = null
   83:     private val io = Executors.newSingleThreadExecutor()
   84: 
   85:     private fun pick(result: MethodChannel.Result, requestCode: Int, intent: () -> Intent) {
   86:         if (pendingPick != null) {
   87:             result.error("BUSY", "a picker is already open", null)
   88:             return
   89:         }
   90:         pendingPick = result
   91:         try {
   92:             startActivityForResult(
   93:                 intent().addFlags(
   94:                     Intent.FLAG_GRANT_READ_URI_PERMISSION or
   95:                         Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION,
   96:                 ),
   97:                 requestCode,
   98:             )
   99:         } catch (e: Exception) {
  100:             pendingPick = null
  101:             result.error("PICKER", e.message, null)
  102:         }
  103:     }
  104: 
  105:     private fun background(result: MethodChannel.Result, work: () -> Any?) {
  106:         io.execute {
  107:             try {
  108:                 val value = work()
  109:                 runOnUiThread { result.success(value) }
  110:             } catch (e: Exception) {
  111:                 runOnUiThread { result.error("IO", e.message, null) }
  112:             }
  113:         }
  114:     }
  115: 
  116:     override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
  117:         if (requestCode != REQUEST_PICK_FILE && requestCode != REQUEST_PICK_FOLDER) {
  118:             super.onActivityResult(requestCode, resultCode, data)
  119:             return
  120:         }
  121:         val result = pendingPick ?: return
  122:         pendingPick = null
  123:         val uri = if (resultCode == RESULT_OK) data?.data else null
  124:         if (uri == null) {
  125:             result.success(null)
  126:             return
  127:         }
  128:         keepGrant(uri)
  129:         background(result) {
  130:             if (requestCode == REQUEST_PICK_FOLDER) {
  131:                 mapOf("uri" to uri.toString(), "children" to listChildren(uri, null))
  132:             } else {
  133:                 describe(uri)
  134:             }
  135:         }
  136:     }
  137: 
  138:     /** Keeps read access across restarts (resume / reopen), within the system limit. */
  139:     private fun keepGrant(uri: Uri) {
  140:         try {
  141:             val kept = contentResolver.persistedUriPermissions
  142:             if (kept.size >= MAX_KEPT_GRANTS) {
  143:                 kept.sortedBy { it.persistedTime }
  144:                     .take(kept.size - MAX_KEPT_GRANTS + 1)
  145:                     .forEach {
  146:                         contentResolver.releasePersistableUriPermission(
  147:                             it.uri,
  148:                             Intent.FLAG_GRANT_READ_URI_PERMISSION,
  149:                         )
  150:                     }
  151:             }
  152:             contentResolver.takePersistableUriPermission(
  153:                 uri,
  154:                 Intent.FLAG_GRANT_READ_URI_PERMISSION,
  155:             )
  156:         } catch (_: SecurityException) {
  157:             // not persistable: still readable for this session
  158:         }
  159:     }
  160: 
  161:     /** Stable identity of a document (the same file picked again). */
  162:     private fun keyOf(uri: Uri): String = try {
  163:         "${uri.authority}/${DocumentsContract.getDocumentId(uri)}"
  164:     } catch (_: Exception) {
  165:         uri.toString()
  166:     }
  167: 
  168:     private fun describe(uri: Uri): Map<String, Any?> {
  169:         var name: String? = null
  170:         var size = 0L
  171:         contentResolver.query(
  172:             uri,
  173:             arrayOf(OpenableColumns.DISPLAY_NAME, OpenableColumns.SIZE),
  174:             null,
  175:             null,
  176:             null,
  177:         )?.use { c ->
  178:             if (c.moveToFirst()) {
  179:                 name = c.getString(0)
  180:                 if (!c.isNull(1)) size = c.getLong(1)
  181:             }
  182:         }
  183:         return mapOf(
  184:             "name" to (name ?: uri.lastPathSegment ?: "video"),
  185:             "uri" to uri.toString(),
  186:             "size" to size,
  187:             "key" to keyOf(uri),
  188:         )
  189:     }
  190: 
  191:     /** Children of [docId] (null: the granted folder itself) in [treeUri]. */
  192:     private fun listChildren(treeUri: Uri, docId: String?): List<Map<String, Any?>> {
  193:         val parent = docId ?: DocumentsContract.getTreeDocumentId(treeUri)
  194:         val out = mutableListOf<Map<String, Any?>>()
  195:         contentResolver.query(
  196:             DocumentsContract.buildChildDocumentsUriUsingTree(treeUri, parent),
  197:             arrayOf(
  198:                 DocumentsContract.Document.COLUMN_DOCUMENT_ID,
  199:                 DocumentsContract.Document.COLUMN_DISPLAY_NAME,
  200:                 DocumentsContract.Document.COLUMN_MIME_TYPE,
  201:                 DocumentsContract.Document.COLUMN_SIZE,
  202:             ),
  203:             null,
  204:             null,
  205:             null,
  206:         )?.use { c ->
  207:             while (c.moveToNext()) {
  208:                 val id = c.getString(0)
  209:                 val uri = DocumentsContract.buildDocumentUriUsingTree(treeUri, id)
  210:                 out.add(
  211:                     mapOf(
  212:                         "name" to c.getString(1),
  213:                         "uri" to uri.toString(),
  214:                         "isDir" to (c.getString(2) == DocumentsContract.Document.MIME_TYPE_DIR),
  215:                         "size" to (if (c.isNull(3)) 0L else c.getLong(3)),
  216:                         "docId" to id,
  217:                         "key" to "${uri.authority}/$id",
  218:                     ),
  219:                 )
  220:             }
  221:         }
  222:         return out
  223:     }
  224: 
  225:     /** Copies small side files (danmaku, subtitles, comments, cover, images). */
  226:     private fun copyDocuments(items: List<Map<String, String>>): Int {
  227:         var copied = 0
  228:         for (item in items) {
  229:             val from = item["uri"] ?: continue
  230:             val to = item["path"] ?: continue
  231:             try {
  232:                 val file = File(to)
  233:                 file.parentFile?.mkdirs()
  234:                 contentResolver.openInputStream(Uri.parse(from))?.use { input ->
  235:                     file.outputStream().use { input.copyTo(it) }
  236:                     copied++
  237:                 }
  238:             } catch (_: Exception) {
  239:                 // best-effort: a missing side file only loses that extra
  240:             }
  241:         }
  242:         return copied
  243:     }
