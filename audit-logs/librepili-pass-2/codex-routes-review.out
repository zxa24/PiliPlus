   58: /// LibrePili: Android access to a video file / folder the user picked, read
   59: /// through the system grant (no storage permission, no copy of the video).
   60: abstract final class LocalDocuments {
   61:   static const _channel = MethodChannel('librepili/media');
   62: 
   63:   /// Lets the user pick a video file; null when cancelled.
   64:   static Future<LocalDocument?> pickFile() async {
   65:     final res = await _channel.invokeMapMethod<String, Object?>(
   66:       'pickVideoFile',
   67:     );
   68:     return res == null ? null : LocalDocument.fromMap(res);
   69:   }
   70: 
   71:   /// Lets the user grant a folder; returns its children, null when
   72:   /// cancelled.
   73:   static Future<({String treeUri, List<LocalDocument> children})?>
   74:   pickFolder() async {
   75:     final res = await _channel.invokeMapMethod<String, Object?>(
   76:       'pickVideoFolder',
   77:     );
   78:     if (res == null) return null;
   79:     return (
   80:       treeUri: res['uri'] as String,
   81:       children: _docs(res['children']),
   82:     );
   83:   }
   84: 
   85:   /// Children of the folder [docId] inside the granted tree [treeUri].
   86:   static Future<List<LocalDocument>> list(String treeUri, String docId) async =>
   87:       _docs(
   88:         await _channel.invokeListMethod<Object?>('listTree', {
   89:           'uri': treeUri,
   90:           'docId': docId,
   91:         }),
   92:       );
   93: 
   94:   /// Copies small documents to local files (`uri` -> `path`); returns how
   95:   /// many were copied. Never used for the video itself.
   96:   static Future<int> copy(List<({String uri, String path})> items) async {
   97:     if (items.isEmpty) return 0;
   98:     try {
   99:       return await _channel.invokeMethod<int>('copyDocuments', {
  100:             'items': [
  101:               for (final i in items) {'uri': i.uri, 'path': i.path},
  102:             ],
  103:           }) ??
  104:           0;
  105:     } catch (e) {
  106:       if (kDebugMode) debugPrint('copy documents: $e');
  107:       return 0;
  108:     }
  109:   }
  110: 
  111:   /// A read-only file descriptor of [uri] for the player (`fdclose://<fd>`
  112:   /// hands it to mpv, which closes it). Null if it cannot be opened.
  113:   static Future<int?> openFd(String uri) async {
