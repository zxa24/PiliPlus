  260:         if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
  261:             window.attributes.layoutInDisplayCutoutMode =
  262:                 LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES
  263:         }
  264:     }
