+  Future<void> _repairSegments(
+    List<String> inputs,
+    List<Type1Segment> segments,
+  ) async {
+    for (var round = 0; ; round++) {
+      final bad = <int>[];
+      for (var i = 0; i < inputs.length && i < segments.length; i++) {
