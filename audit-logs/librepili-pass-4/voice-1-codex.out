  136:   static (IOHttpClientAdapter, ConnectionManager?) _createPool() {
  137:     final bool enableSystemProxy;
  138:     late final String systemProxyHost;
  139:     late final int? systemProxyPort;
  140:     if (Pref.enableSystemProxy) {
  141:       systemProxyHost = Pref.systemProxyHost;
