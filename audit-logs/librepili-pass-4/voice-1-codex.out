  311:     public static void createShortcut(@NonNull String id, @NonNull String uri, @NonNull String label, @NonNull String icon) {
  312:         if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
  313:             Context context = getContext();
  314:             ShortcutManager shortcutManager = context.getSystemService(ShortcutManager.class);
  315:             if (shortcutManager != null && shortcutManager.isRequestPinShortcutSupported()) {
  316:                 Bitmap bitmap = BitmapFactory.decodeFile(icon);
  317:                 ShortcutInfo shortcut = new ShortcutInfo.Builder(context, id)
  318:                         .setShortLabel(label)
  319:                         .setIcon(Icon.createWithAdaptiveBitmap(bitmap))
  320:                         .setIntent(new Intent(Intent.ACTION_VIEW, Uri.parse(uri)))
  321:                         .build();
  322:                 // TODO: WorkerThread
  323:                 Intent pinIntent = shortcutManager.createShortcutResultIntent(shortcut);
  324:                 PendingIntent pendingIntent = PendingIntent.getBroadcast(
  325:                         context, 0, pinIntent, PendingIntent.FLAG_IMMUTABLE
  326:                 );
  327:                 shortcutManager.requestPinShortcut(shortcut, pendingIntent.getIntentSender());
  328:             }
  329:         }
  330:     }
