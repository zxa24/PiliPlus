  361:     @RequiresApi(api = Build.VERSION_CODES.S)
  362:     public static boolean isDomainVerified(@NonNull String domain) {
  363:         try {
  364:             Context context = getContext();
  365:             DomainVerificationManager manager =
  366:                     context.getSystemService(DomainVerificationManager.class);
  367:             DomainVerificationUserState userState =
  368:                     manager.getDomainVerificationUserState(context.getPackageName());
  369:             if (userState == null) return false;
  370:             Map<String, Integer> hostToStateMap = userState.getHostToStateMap();
  371:             Integer stateValue = hostToStateMap.get(domain);
  372:             if (stateValue == null) return false;
  373:             return stateValue == DomainVerificationUserState.DOMAIN_STATE_VERIFIED ||
  374:                     stateValue == DomainVerificationUserState.DOMAIN_STATE_SELECTED;
  375:         } catch (Exception ignored) {
  376:         }
  377:         return false;
  378:     }
