   22: /// https://github.com/BiliRoamingX/BiliRoamingX
   23: class BiliDocumentsProvider : DocumentsProvider() {
   24:     private var packageName: String = ""
   25:     private var dataDir: File? = null
   26:     private var deDataDir: File? = null
   27:     private var exDataDir: File? = null
   28:     private var obbDir: File? = null
   29: 
   30:     private val defaultRootProjection = arrayOf(
   31:         DocumentsContract.Root.COLUMN_ROOT_ID,
   32:         DocumentsContract.Root.COLUMN_MIME_TYPES,
   33:         DocumentsContract.Root.COLUMN_FLAGS,
   34:         DocumentsContract.Root.COLUMN_ICON,
   35:         DocumentsContract.Root.COLUMN_TITLE,
   36:         DocumentsContract.Root.COLUMN_SUMMARY,
   37:         DocumentsContract.Root.COLUMN_DOCUMENT_ID,
   38:     )
   39: 
   40:     private val defaultDocumentProjection = arrayOf(
   41:         DocumentsContract.Document.COLUMN_DOCUMENT_ID,
   42:         DocumentsContract.Document.COLUMN_MIME_TYPE,
   43:         DocumentsContract.Document.COLUMN_DISPLAY_NAME,
   44:         DocumentsContract.Document.COLUMN_LAST_MODIFIED,
   45:         DocumentsContract.Document.COLUMN_FLAGS,
   46:         DocumentsContract.Document.COLUMN_SIZE,
   47:         COLUMN_MT_PATH,
   48:         COLUMN_MT_EXTRAS
   49:     )
   50: 
   51:     override fun onCreate() = true
   52: 
   53:     @SuppressLint("SdCardPath")
   54:     override fun attachInfo(context: Context, info: ProviderInfo?) {
   55:         super.attachInfo(context, info)
   56:         this.packageName = context.packageName
   57:         val dir = context.filesDir.parentFile
   58:         this.dataDir = dir
   59:         val dirPath = dir?.path.orEmpty()
   60:         if (dirPath.startsWith("/data/user/"))
   61:             deDataDir = File("/data/user_de/" + dirPath.substring(11))
   62:         this.exDataDir = context.getExternalFilesDir(null)?.parentFile
   63:         this.obbDir = context.obbDir
   64:     }
   65: 
   66:     override fun queryRoots(projection: Array<out String>?): Cursor {
   67:         val context = context!!
   68:         val appInfo = context.applicationInfo
   69:         val appName = appInfo.loadLabel(context.packageManager).toString()
   70:         return MatrixCursor(projection ?: defaultRootProjection).apply {
   71:             newRow().apply {
   72:                 add(DocumentsContract.Root.COLUMN_ROOT_ID, packageName)
   73:                 add(DocumentsContract.Root.COLUMN_DOCUMENT_ID, packageName)
   74:                 add(DocumentsContract.Root.COLUMN_SUMMARY, packageName)
   75:                 val flags =
   76:                     DocumentsContract.Root.FLAG_SUPPORTS_CREATE or DocumentsContract.Root.FLAG_LOCAL_ONLY or DocumentsContract.Root.FLAG_SUPPORTS_IS_CHILD
   77:                 add(DocumentsContract.Root.COLUMN_FLAGS, flags)
   78:                 add(DocumentsContract.Root.COLUMN_TITLE, appName)
   79:                 add(DocumentsContract.Root.COLUMN_MIME_TYPES, "*/*")
   80:                 add(DocumentsContract.Root.COLUMN_ICON, appInfo.icon)
   81:             }
   82:         }
   83:     }
   84: 
   85:     override fun queryDocument(documentId: String, projection: Array<out String>?): Cursor {
   86:         return MatrixCursor(projection ?: defaultDocumentProjection)
   87:             .appendFileInfo(documentId, null)
   88:     }
   89: 
   90:     override fun queryChildDocuments(
   91:         parentDocumentId: String,
   92:         projection: Array<out String>?,
   93:         sortOrder: String?
   94:     ): Cursor {
   95:         val cursor = MatrixCursor(projection ?: defaultDocumentProjection)
   96:         val file = retrieveFile(parentDocumentId, true)
   97:         if (file == null) {
   98:             if (dataDir.let { it != null && it.isDirectory })
   99:                 cursor.appendFileInfo(parentDocumentId.appendChild(LABEL_DATA_DIR), dataDir)
  100:             if (deDataDir.let { it != null && it.isDirectory })
  101:                 cursor.appendFileInfo(parentDocumentId.appendChild(LABEL_DE_DATA_DIR), deDataDir)
  102:             if (exDataDir.let { it != null && it.isDirectory })
  103:                 cursor.appendFileInfo(parentDocumentId.appendChild(LABEL_EX_DATA_DIR), exDataDir)
  104:             if (obbDir.let { it != null && it.isDirectory })
  105:                 cursor.appendFileInfo(parentDocumentId.appendChild(LABEL_OBB_DIR), obbDir)
  106:         } else file.listFiles()?.forEach {
  107:             cursor.appendFileInfo(parentDocumentId.appendChild(it.name), it)
  108:         }
  109:         return cursor
  110:     }
  111: 
  112:     override fun openDocument(
  113:         documentId: String,
  114:         mode: String,
  115:         signal: CancellationSignal?
  116:     ): ParcelFileDescriptor {
  117:         return retrieveFile(documentId, false)?.let {
  118:             ParcelFileDescriptor.open(it, ParcelFileDescriptor.parseMode(mode))
  119:         } ?: throw FileNotFoundException("$documentId not found")
  120:     }
  121: 
  122:     override fun isChildDocument(parentDocumentId: String, documentId: String): Boolean {
  123:         // path-segment prefix only; `..` is rejected by retrieveFile
  124:         return documentId == parentDocumentId ||
  125:                 documentId.startsWith(parentDocumentId.appendChild(""))
  126:     }
  127: 
  128:     override fun createDocument(
  129:         parentDocumentId: String,
  130:         mimeType: String,
  131:         displayName: String
  132:     ): String {
  133:         val dir = retrieveFile(parentDocumentId, true)
  134:         if (dir != null && displayName.isValidName) {
  135:             var file = File(dir, displayName)
  136:             var i = 2
  137:             while (file.exists())
  138:                 file = File(dir, "$displayName (${i++})")
  139:             try {
  140:                 if ((if (DocumentsContract.Document.MIME_TYPE_DIR == mimeType)
  141:                         file.mkdirs()
  142:                     else file.createNewFile())
  143:                 ) return parentDocumentId.appendChild(file.name)
  144:             } catch (_: Exception) {
  145:             }
  146:         }
  147:         throw FileNotFoundException("Failed to create document in $parentDocumentId with name $displayName")
  148:     }
  149: 
  150:     override fun removeDocument(documentId: String, parentDocumentId: String) {
  151:         deleteDocument(documentId)
  152:     }
  153: 
  154:     override fun deleteDocument(documentId: String) {
  155:         if (retrieveFile(documentId, true)
  156:                 ?.deleteRecursively() != true
  157:         ) throw FileNotFoundException("Failed to delete document $documentId")
  158:     }
  159: 
  160:     override fun moveDocument(
  161:         sourceDocumentId: String,
  162:         sourceParentDocumentId: String,
  163:         targetParentDocumentId: String
  164:     ): String {
  165:         val sourceFile = retrieveFile(sourceDocumentId, true)
  166:         val targetDir = retrieveFile(targetParentDocumentId, true)
  167:         if (sourceFile != null && targetDir != null) {
  168:             val targetFile = File(targetDir, sourceFile.name)
  169:             if (!targetFile.exists() && sourceFile.renameTo(targetFile))
  170:                 return targetParentDocumentId.appendChild(targetFile.name)
  171:         }
  172:         throw FileNotFoundException("Failed move document $sourceDocumentId to $targetParentDocumentId")
  173:     }
  174: 
  175:     override fun renameDocument(documentId: String, displayName: String): String {
  176:         val file = retrieveFile(documentId, true)
  177:         if (file == null || !displayName.isValidName || file.parentFile.let {
  178:                 it == null || !file.renameTo(File(it, displayName))
  179:             }) throw FileNotFoundException("Failed to rename document $documentId with name $displayName")
  180:         return documentId.substringBeforeLast('/').appendChild(displayName)
  181:     }
  182: 
  183:     override fun getDocumentType(documentId: String): String {
  184:         return retrieveFile(documentId, true)?.mimeType
  185:             ?: throw FileNotFoundException("$documentId not found")
  186:     }
  187: 
  188:     override fun call(method: String, arg: String?, extras: Bundle?): Bundle? {
  189:         val superResult = super.call(method, arg, extras)
  190:         if (superResult != null || !method.startsWith("mt:") || extras == null)
  191:             return superResult
  192:         // call() is not covered by the provider permission: require the
  193:         // caller to hold a write grant for the uri (and the uri's tree)
  194:         val documentId = extras.parcelable<Uri>("uri")?.takeIf {
  195:             context!!.checkCallingOrSelfUriPermission(
  196:                 it, Intent.FLAG_GRANT_WRITE_URI_PERMISSION
  197:             ) == PackageManager.PERMISSION_GRANTED
  198:         }?.let {
  199:             val id = DocumentsContract.getDocumentId(it)
  200:             if (DocumentsContract.isTreeUri(it) &&
  201:                 !isChildDocument(DocumentsContract.getTreeDocumentId(it), id)
  202:             ) null else id
  203:         } ?: return Bundle().apply {
  204:             putBoolean("result", false)
  205:             putString("message", "not found documentId")
  206:         }
  207:         when (method) {
  208:             "mt:setPermissions" -> try {
  209:                 val file = retrieveFile(documentId, true)
  210:                     ?: return Bundle().apply { putBoolean("result", false) }
  211:                 Os.chmod(file.path, extras.getInt("permissions"))
  212:                 return Bundle().apply { putBoolean("result", true) }
  213:             } catch (e: Exception) {
  214:                 return Bundle().apply {
  215:                     putBoolean("result", false)
  216:                     putString("message", e.message)
  217:                 }
  218:             }
  219: 
  220:             "mt:createSymlink" -> try {
  221:                 val file = retrieveFile(documentId, false)
  222:                     ?: return Bundle().apply { putBoolean("result", false) }
  223:                 Os.symlink(extras.getString("path"), file.path)
  224:                 return Bundle().apply { putBoolean("result", true) }
  225:             } catch (e: Exception) {
  226:                 return Bundle().apply {
  227:                     putBoolean("result", false)
  228:                     putString("message", e.message)
  229:                 }
  230:             }
  231: 
  232:             "mt:setLastModified" -> try {
  233:                 val file = retrieveFile(documentId, true)
  234:                     ?: return Bundle().apply { putBoolean("result", false) }
  235:                 return Bundle().apply {
  236:                     putBoolean("result", file.setLastModified(extras.getLong("time")))
  237:                 }
  238:             } catch (e: Exception) {
  239:                 return Bundle().apply {
  240:                     putBoolean("result", false)
  241:                     putString("message", e.message)
  242:                 }
  243:             }
  244: 
  245:             else -> return Bundle().apply {
  246:                 putBoolean("result", false)
  247:                 putString("message", "Unsupported method: $method")
  248:             }
  249:         }
  250:     }
  251: 
  252:     private fun retrieveFile(documentId: String, check: Boolean = true): File? {
  253:         val path = documentId.substring(packageName.length)
  254:             .removePrefix("/").removeSuffix("/")
  255:         if (path.isEmpty()) return null
  256:         val rootDirLabel = path.substringBefore('/')
  257:         val childPath = path.substringAfter('/', missingDelimiterValue = "")
  258:         if (childPath.isNotEmpty() && childPath.split('/').any { !it.isValidName })
  259:             throw FileNotFoundException("$documentId not found")
  260:         val root = if (rootDirLabel.equals(LABEL_DATA_DIR, true) && dataDir != null) {
  261:             dataDir!!
  262:         } else if (rootDirLabel.equals(LABEL_DE_DATA_DIR, true) && deDataDir != null) {
  263:             deDataDir!!
  264:         } else if (rootDirLabel.equals(LABEL_EX_DATA_DIR, true) && exDataDir != null) {
  265:             exDataDir!!
  266:         } else if (rootDirLabel.equals(LABEL_OBB_DIR, true) && obbDir != null) {
  267:             obbDir!!
  268:         } else throw FileNotFoundException("$documentId not found")
  269:         val file = File(root, childPath)
  270:         // the resolved file (symlinks included) must stay inside its root
  271:         try {
  272:             val rootPath = root.canonicalPath
  273:             val filePath = file.canonicalPath
  274:             if (filePath != rootPath && !filePath.startsWith(rootPath + File.separator))
  275:                 throw FileNotFoundException("$documentId not found")
  276:         } catch (_: java.io.IOException) {
  277:             throw FileNotFoundException("$documentId not found")
  278:         }
  279:         if (check) try {
  280:             Os.lstat(file.path)
  281:         } catch (_: Exception) {
  282:             throw FileNotFoundException("$documentId not found")
  283:         }
  284:         return file
  285:     }
  286: 
  287:     private fun MatrixCursor.appendFileInfo(documentId: String, file: File?): MatrixCursor {
  288:         val finalFile = file ?: retrieveFile(documentId, true)
  289:         ?: run {
  290:             newRow().apply {
  291:                 add(DocumentsContract.Document.COLUMN_DOCUMENT_ID, packageName)
  292:                 add(DocumentsContract.Document.COLUMN_DISPLAY_NAME, packageName)
  293:                 add(DocumentsContract.Document.COLUMN_SIZE, 0L)
  294:                 add(
  295:                     DocumentsContract.Document.COLUMN_MIME_TYPE,
  296:                     DocumentsContract.Document.MIME_TYPE_DIR
  297:                 )
  298:                 add(DocumentsContract.Document.COLUMN_LAST_MODIFIED, 0L)
  299:                 add(DocumentsContract.Document.COLUMN_FLAGS, 0)
  300:             }
  301:             return this
  302:         }
  303:         var flags = if (finalFile.isDirectory && finalFile.canWrite())
  304:             DocumentsContract.Document.FLAG_DIR_SUPPORTS_CREATE
  305:         else if (finalFile.isFile && finalFile.canWrite())
  306:             DocumentsContract.Document.FLAG_SUPPORTS_WRITE
  307:         else 0
  308:         if (finalFile.parentFile.let { it != null && it.canWrite() })
  309:             flags = flags or DocumentsContract.Document.FLAG_SUPPORTS_DELETE or
  310:                     DocumentsContract.Document.FLAG_SUPPORTS_RENAME or
  311:                     DocumentsContract.Document.FLAG_SUPPORTS_REMOVE or
  312:                     DocumentsContract.Document.FLAG_SUPPORTS_MOVE
  313:         val path = finalFile.path
  314:         var extraInfo = false
  315:         val name = when {
  316:             dataDir.let { it != null && path == it.path } -> LABEL_DATA_DIR
  317:             deDataDir.let { it != null && path == it.path } -> LABEL_DE_DATA_DIR
  318:             exDataDir.let { it != null && path == it.path } -> LABEL_EX_DATA_DIR
  319:             obbDir.let { it != null && path == it.path } -> LABEL_OBB_DIR
  320:             else -> {
  321:                 extraInfo = true
  322:                 finalFile.name
  323:             }
  324:         }
  325:         val row = newRow().apply {
  326:             add(DocumentsContract.Document.COLUMN_DOCUMENT_ID, documentId)
  327:             add(DocumentsContract.Document.COLUMN_DISPLAY_NAME, name)
  328:             add(DocumentsContract.Document.COLUMN_SIZE, finalFile.length())
  329:             add(DocumentsContract.Document.COLUMN_MIME_TYPE, finalFile.mimeType)
  330:             add(DocumentsContract.Document.COLUMN_LAST_MODIFIED, finalFile.lastModified())
  331:             add(DocumentsContract.Document.COLUMN_FLAGS, flags)
  332:             add(COLUMN_MT_PATH, finalFile.absolutePath)
  333:         }
  334:         if (extraInfo) try {
  335:             buildString {
  336:                 val lstat = Os.lstat(path)
  337:                 append(lstat.st_mode)
  338:                 append('|')
  339:                 append(lstat.st_uid)
  340:                 append('|')

