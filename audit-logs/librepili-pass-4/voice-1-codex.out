  141: 
  142:   @override
  143:   void onError(DioException err, ErrorInterceptorHandler handler) {
  144:     final options = err.requestOptions;
  145:     if (options.responseType == ResponseType.stream) {
  146:       return handler.next(err);
  147:     }
  148: 
  149:     if (options.method != 'POST') toast(err);
  150: 
  151:     if (err.response case final res?) {
  152:       if (_boundRequestAccount(options) case final account?) {
  153:         _saveCookies(account, res).then(
  154:           (_) => handler.next(err),
  155:           onError: (Object e, StackTrace s) => handler.next(
  156:             DioException(
  157:               requestOptions: options,
  158:               error: e,
  159:               stackTrace: s,
  160:             ),
  161:           ),
  162:         );
  163:         return;
  164:       }
  165:     }
  166:     return handler.next(err);
  167:   }
  168: 
  169:   static void toast(DioException err) {
  170:     const skipShow = [
  171:       'heartbeat',
  172:       'history/report',
  173:       'roomEntryAction',
  174:       'seg.so',
  175:       'online/total',
  176:       'github',
  177:       'hdslb.com',
  178:       'biliimg.com',
  179:       'site/getCoin',
  180:     ];
  181:     String url = err.requestOptions.uri.toString();
  182:     if (kDebugMode) debugPrint('🌹🌹ApiInterceptor: $url\n$err');
  183:     if (skipShow.any(url.contains) ||
  184:         (url.contains('skipSegments') && err.requestOptions.method == 'GET')) {
  185:       // skip
  186:     } else {
  187:       // no query: it may hold access_key / csrf / sign
  188:       final uri = err.requestOptions.uri;
  189:       final shown = uri.hasScheme
  190:           ? '${uri.scheme}://${uri.authority}${uri.path}'
  191:           : uri.path;
  192:       dioError(err).then((res) => SmartDialog.showToast(res + shown));
  193:     }
  194:   }
  195: 
  196:   static Future<void> _saveCookies(Account account, Response response) async {
  197:     final setCookies = response.headers[HttpHeaders.setCookieHeader];
  198:     if (setCookies == null || setCookies.isEmpty) {
  199:       return;
  200:     }
  201:     final List<Cookie> cookies = setCookies
  202:         .map((str) => str.split(_setCookieReg))
  203:         .expand((cookie) => cookie)
  204:         .where((cookie) => cookie.isNotEmpty)
  205:         .map(Cookie.fromSetCookieValue)
  206:         .toList();
  207:     final statusCode = response.statusCode ?? 0;
  208:     final locations = response.headers[HttpHeaders.locationHeader] ?? const [];
  209:     final isRedirectRequest = statusCode >= 300 && statusCode < 400;
  210:     final originalUri = response.requestOptions.uri;
  211:     final realUri = originalUri.resolveUri(response.realUri);
  212:     await account.cookieJar.saveFromResponse(realUri, cookies);
  213:     if (isRedirectRequest && locations.isNotEmpty) {
  214:       final originalUri = response.realUri;
  215:       await Future.wait(
  216:         locations.map(
  217:           (location) => account.cookieJar.saveFromResponse(
  218:             // Resolves the location based on the current Uri.
  219:             originalUri.resolve(location),
  220:             cookies,
  221:           ),
  222:         ),
  223:       );
  224:     }
  225:     await account.onChange();
  226:   }
  227: 
  228:   static bool _isBlockServer(String path) {
  229:     // match the host: a raw prefix match would skip every request when the
  230:     // saved address is empty or too short
  231:     final host = Uri.tryParse(blockServer)?.host;
  232:     return host != null &&
  233:         host.isNotEmpty &&
  234:         Uri.tryParse(path)?.host.toLowerCase() == host.toLowerCase();
  235:   }
  236: 
  237:   static bool _skipCookie(String path) {
  238:     return _isBlockServer(path) ||
  239:         path.contains('hdslb.com') ||
  240:         path.contains('biliimg.com');
  241:   }
  242: 
  243:   static Account _findAccount(String path) => ApiType.loginApi.contains(path)
  244:       ? AnonymousAccount()
  245:       : Accounts.get(
  246:           AccountType.values.firstWhere(
  247:             (i) => ApiType.apiTypeSet[i]?.contains(path) == true,
  248:             orElse: () => AccountType.main,
  249:           ),
  250:         );
  251: 
  252:   /// Login-flow calls that act on an explicitly passed account (e.g. logging
  253:   /// it out); they keep that account whatever the mode.
  254:   static const _explicitAccountApis = {
  255:     Api.logout,
  256:     Api.activateBuvidApi,
  257:     Api.qrcodeConfirm,
  258:   };
  259: 
  260:   static Account _bindRequestAccount(RequestOptions options) {
  261:     assert(options.extra['account'] is Account?);
  262:     final explicit = options.extra['account'] as Account?;
  263:     if (explicit is LoginAccount &&
  264:         _explicitAccountApis.contains(options.path)) {
  265:       return explicit;
  266:     }
  267:     // LibrePili: no global login. Even in login mode the account is only
  268:     // attached where it is required; everything else goes out anonymously.
  269:     return options.extra['account'] = LoginPolicy.bind(
  270:       explicit ?? _findAccount(options.path),
  271:       options,
  272:     );
  273:   }
  274: 
  275:   /// account secrets a call site may have put in the params: the app token
  276:   /// and the web csrf (the account's bili_jct)
  277:   static const _accessKeys = [
  278:     'access_key',
  279:     'mobile_access_key',
  280:     'csrf',
  281:     'csrf_token',
  282:     'biliCSRF',
  283:   ];
  284: 
  285:   static void _scrubAccessKey(RequestOptions options) {
  286:     void scrub(Map<String, dynamic> params) {
  287:       var removed = false;
  288:       for (final key in _accessKeys) {
  289:         if (params.containsKey(key)) {
  290:           params.remove(key);
  291:           removed = true;
  292:         }
  293:       }
  294:       if (removed && params.containsKey('sign')) {
  295:         AppSign.appSign(params..remove('sign'));
  296:       }
  297:     }
  298: 
  299:     scrub(options.queryParameters);
  300:     if (options.data case final Map data) {
  301:       scrub(data.cast<String, dynamic>());
  302:     } else if (options.data case final FormData data) {
  303:       data.fields.removeWhere((e) => _accessKeys.contains(e.key));
  304:     }
  305:   }
  306: 
  307:   static Account? _boundRequestAccount(RequestOptions options) {
  308:     final path = options.path;
  309:     final account = options.extra['account'] as Account;
  310:     if (account is NoAccount ||
  311:         path.startsWith(HttpString.appBaseUrl) ||
  312:         _skipCookie(path)) {
  313:       return null;
  314:     }
  315:     return account;
  316:   }
  317: 
  318:   static Future<String> dioError(DioException error) async {
  319:     switch (error.type) {
  320:       case .badCertificate:
  321:         return '证书有误！';
  322:       case .badResponse:
  323:         return '服务器异常，请稍后重试！';
  324:       case .cancel:
  325:         return '请求已被取消，请重新请求';
  326:       case .connectionError:
  327:         return '连接错误，请检查网络设置';
  328:       case .connectionTimeout:
  329:         return '网络连接超时，请检查网络设置';
  330:       case .receiveTimeout:
  331:         return '响应超时，请稍后重试！';
  332:       case .sendTimeout:
  333:         return '发送请求超时，请检查网络设置';
  334:       case .transformTimeout:
  335:         return '转换响应数据超时！';
  336:       case .unknown:
  337:         String desc;
  338:         try {
  339:           desc = PlatformUtils.isMobile
  340:               ? (await Connectivity().checkConnectivity()).first.desc
  341:               : '';
  342:         } catch (_) {
  343:           desc = '';
  344:         }
  345:         return '$desc网络异常 ${error.error}';
  346:     }
  347:   }
  348: }
  349: 
  350: extension _ConnectivityResultExt on ConnectivityResult {
  351:   String get desc => const ['蓝牙', 'Wi-Fi', '局域', '流量', '无', '代理', '其他'][index];
  352: }

