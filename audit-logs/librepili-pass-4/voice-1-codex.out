   99:   static Future<bool> _desktopRoutePush(Uri uri) async {
  100:     await windowManager.show();
  101:     await windowManager.focus();
  102:     return routePush(uri);
  103:   }
  104: 
  105:   static int? _videoProgress(Map<String, String> queryParameters) {
