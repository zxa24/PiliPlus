  380:     public static String openUrl(@NonNull String url) {
  381:         Context context = getContext();
  382:         String pkg = context.getPackageName();
  383:         PackageManager pm = context.getPackageManager();
  384: 
  385:         try {
  386:             Intent intent = new Intent(Intent.ACTION_VIEW, Uri.parse(url));
  387:             intent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
  388: 
  389:             ArrayList<Intent> external = new ArrayList<>();
  390:             for (ResolveInfo info : pm.queryIntentActivities(intent, 0)) {
  391:                 String packageName = info.activityInfo.packageName;
  392:                 if (!packageName.equals(pkg)) {
  393:                     external.add(new Intent(intent).setComponent(new ComponentName(packageName, info.activityInfo.name)));
  394:                 }
  395:             }
  396:             if (external.isEmpty()) {
  397:                 return "package not found";
  398:             } else if (external.size() == 1) {
  399:                 intent = external.get(0);
  400:             } else {
  401:                 intent = Intent.createChooser(external.remove(0), null);
  402:                 intent.putExtra(Intent.EXTRA_INITIAL_INTENTS, external.toArray(new Intent[0]));
  403:                 intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
  404:             }
  405:             context.startActivity(intent);
  406:             return null;
  407:         } catch (Exception e) {
  408:             return e.toString();
  409:         }
  410:     }
