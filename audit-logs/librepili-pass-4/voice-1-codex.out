  753:   /// cids of the entries being merged (a deleted entry's merge can overlap
  754:   /// the next one's); pause/start requests for them are ignored.
  755:   final _mergingCids = <int>{};
  756: 
  757:   /// cids of entries deleted while they were being merged.
  758:   final _mergeDeletedCids = <int>{};
  759: 
  760:   /// Turns the downloaded streams into one complete video file in the export
  761:   /// directory. Returns the file (null on failure) and the stream files the
  762:   /// caller removes once completion is saved. On failure the stream files
  763:   /// are kept, so the entry still plays in-app as before. [damaged]: durl
  764:   /// segments are damaged / missing even after re-downloading, so the
  765:   /// entry must not be treated as complete.
  766:   Future<({String? output, List<String> inputs, bool damaged})> _mergeDownload(
  767:     BiliDownloadEntryInfo entry,
  768:   ) async {
  769:     final videoDir = path.join(entry.entryDirPath, entry.typeTag);
  770:     final List<String> inputs;
  771:     // durl segments of the play URL this download used (for re-downloading
  772:     // a damaged one); segments on disk beyond them are left over from an
  773:     // earlier attempt
  774:     List<Type1Segment>? segments;
  775:     if (entry.mediaType == 1) {
  776:       int? count;
  777:       try {
  778:         final index = File(path.join(videoDir, _indexFile));
  779:         final list =
  780:             jsonDecode(await index.readAsString())['segment_list'] as List;
  781:         count = list.length;
  782:         segments = [
  783:           for (final e in list)
  784:             Type1Segment.fromJson(e as Map<String, dynamic>),
  785:         ];
  786:       } catch (_) {}
  787:       inputs = [
  788:         for (
  789:           var i = 0;
  790:           // known segments: all of them (a missing one is re-downloaded)
  791:           count != null
  792:               ? i < count
  793:               : File(
  794:                   path.join(videoDir, PathUtils.segmentNameType1(i)),
  795:                 ).existsSync();
  796:           i++
  797:         )
  798:           path.join(videoDir, PathUtils.segmentNameType1(i)),
  799:       ];
  800:       if (count != null) {
  801:         for (
  802:           var i = count;
  803:           File(path.join(videoDir, PathUtils.segmentNameType1(i))).existsSync();
  804:           i++
  805:         ) {
  806:           await File(path.join(videoDir, PathUtils.segmentNameType1(i)))
  807:               .tryDel();
  808:         }
  809:       }
  810:       if (inputs.isEmpty) {
  811:         inputs.add(path.join(videoDir, PathUtils.videoNameType1));
  812:       }
  813:     } else {
  814:       final audio = path.join(videoDir, PathUtils.audioNameType2);
  815:       inputs = [
  816:         path.join(videoDir, PathUtils.videoNameType2),
  817:         if (entry.hasDashAudio && File(audio).existsSync()) audio,
  818:       ];
  819:     }
  820:     String? output;
  821:     try {
  822:       output = await _exportFilePath(entry);
  823:       if (entry.mediaType == 1) {
  824:         // a damaged segment is a download problem, not a reason to keep the
  825:         // parts apart: fetch it again (bounded) before joining
  826:         if (segments != null) {
  827:           await _repairSegments(entry.cid, inputs, segments);
  828:         }
  829:         output = await _exportType1(inputs, output);
  830:       } else {
  831:         await _remuxInBackground(inputs, output);
  832:       }
  833:       entry.mergedPath = output;
  834:       return (output: output, inputs: inputs, damaged: false);
  835:     } catch (e) {
  836:       if (output != null) {
  837:         await File(output).tryDel();
  838:         final folder = Directory(path.dirname(output));
  839:         if (_isOwnFolder(output) && folder.listSync().isEmpty) {
  840:           await folder.tryDel();
  841:         }
  842:       }
  843:       final damaged = entry.mediaType == 1 && e is FormatException;
  844:       entry.status = DownloadStatus.failMerge;
  845:       SmartDialog.showToast(
  846:         damaged ? '视频分段已损坏且重新下载失败，可稍后重新开始该下载' : '合并音视频失败，已保留分离的音视频文件',
  847:       );
  848:       if (kDebugMode) debugPrint('merge download error: $e');
  849:       return (output: null, inputs: inputs, damaged: damaged);
  850:     } finally {
  851:       if (output != null) _mergeFolders.remove(path.dirname(output));
  852:     }
  853:   }
  854: 
  855:   static const _maxSegmentRepairs = 2;
  856: 
  857:   /// Checks every durl segment (size against the play URL's byte count,
  858:   /// structure via [Mp4Remuxer.checkSegment]) and downloads damaged or
  859:   /// missing ones again, up to [_maxSegmentRepairs] rounds; throws
  860:   /// [FormatException] if segments are still damaged after that.
  861:   Future<void> _repairSegments(
  862:     int cid,
  863:     List<String> inputs,
  864:     List<Type1Segment> segments,
  865:   ) async {
  866:     for (var round = 0; ; round++) {
  867:       final bad = <int>[];
  868:       final short = <int>{};
  869:       for (var i = 0; i < inputs.length && i < segments.length; i++) {
  870:         final file = File(inputs[i]);
  871:         final expected = segments[i].bytes;
  872:         final input = inputs[i];
  873:         if (!file.existsSync() ||
  874:             (expected > 0 && file.lengthSync() < expected)) {
  875:           // missing, or the transfer stopped early: resume what is there
  876:           bad.add(i);
  877:           short.add(i);
  878:         } else if (!await Isolate.run(() => Mp4Remuxer.checkSegment(input))) {
  879:           bad.add(i);
  880:         }
  881:       }
  882:       if (bad.isEmpty) return;
  883:       if (round >= _maxSegmentRepairs) {
  884:         throw FormatException('damaged segments after re-download: $bad');
  885:       }
