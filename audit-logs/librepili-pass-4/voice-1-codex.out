   10: class DownloadManager {
   11:   final String url;
   12: 
   13:   /// Other CDN addresses of the same stream, tried in turn when a transfer
   14:   /// breaks off (LibrePili: some mirrors drop long transfers mid-way).
   15:   final List<String> backupUrls;
   16:   final String path;
   17:   final void Function(int, int)? onReceiveProgress;
   18:   final void Function([Object? error]) onDone;
   19: 
   20:   static const _maxAttempts = 6;
   21: 
   22:   DownloadStatus _status = DownloadStatus.downloading;
   23: 
   24:   DownloadStatus get status => _status;
   25:   final _cancelToken = CancelToken();
   26:   late Future<void> task;
   27: 
   28:   DownloadManager({
   29:     required this.url,
   30:     this.backupUrls = const [],
   31:     required this.path,
   32:     required this.onReceiveProgress,
   33:     required this.onDone,
   34:   }) {
   35:     task = _start();
   36:   }
   37: 
   38:   Future<void> _start() async {
   39:     final urls = [
   40:       url,
   41:       for (final u in backupUrls)
   42:         if (u != url) u,
   43:     ];
   44:     // only consecutive attempts that saved nothing count against the budget:
   45:     // a long transfer that keeps advancing between drops is not failing
   46:     var failures = 0;
   47:     for (var attempt = 0; ; attempt++) {
   48:       final before = _savedBytes;
   49:       final error = await _attempt(urls[attempt % urls.length]);
   50:       if (error == null) return; // completed
   51:       failures = _savedBytes > before ? 1 : failures + 1;
   52:       if (!_canRetry || failures >= _maxAttempts) {
   53:         await _fail(error);
   54:         return;
   55:       }
   56:       // resume from what is on disk, on the next address; pause/delete
   57:       // cuts the wait short
   58:       await Future.any<void>([
   59:         Future.delayed(Duration(seconds: failures)),
   60:         _cancelToken.whenCancel,
   61:       ]);
   62:       if (!_canRetry) {
   63:         await _fail(error);
   64:         return;
   65:       }
   66:     }
   67:   }
   68: 
   69:   int get _savedBytes {
   70:     final file = File(path);
   71:     return file.existsSync() ? file.lengthSync() : 0;
   72:   }
   73: 
   74:   bool get _canRetry =>
   75:       _status == DownloadStatus.downloading && !_cancelToken.isCancelled;
   76: 
   77:   Future<void> _fail(Object e) async {
   78:     final file = File(path);
   79:     if (_status == DownloadStatus.downloading) {
   80:       _status = DownloadStatus.failDownload;
   81:       // keep any saved bytes: a later start resumes from them
   82:       if (file.existsSync() && file.lengthSync() == 0) {
   83:         await file.tryDel();
   84:       }
   85:     }
   86:     onDone(e);
   87:   }
   88: 
   89:   static final _contentRangeReg = RegExp(r'bytes\s+(\d+)-\d+/(\d+|\*)');
   90: 
   91:   /// Size of the stream at [url] from a one-byte range request, or null.
   92:   Future<int?> _probeTotal(String url) async {
   93:     try {
   94:       final res = await Request.http11Dio.get<ResponseBody>(
   95:         url.http2https,
   96:         options: Options(
   97:           headers: {'range': 'bytes=0-0'},
   98:           responseType: ResponseType.stream,
   99:         ),
  100:         cancelToken: _cancelToken,
  101:       );
  102:       try {
  103:         await res.data?.stream.listen(null).cancel();
  104:       } catch (_) {}
  105:       final range = res.headers.value(HttpHeaders.contentRangeHeader);
