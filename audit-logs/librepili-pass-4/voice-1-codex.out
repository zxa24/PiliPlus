  702:   /// Extras exports run one at a time (each can be hundreds of requests).
  703:   Future<void> _extrasQueue = Future.value();
  704: 
  705:   /// Pending or running extras export per cid.
  706:   final _extrasJobs = <int, Future<void>>{};
  707: 
  708:   /// cids whose export must stop (entry deleted).
  709:   final _extrasCancelled = <int>{};
  710: 
  711:   /// cid whose export is running now.
  712:   int? _extrasRunningCid;
  713: 
  714:   /// The extras export of [cid], if one is pending or running.
  715:   Future<void>? extrasDone(int cid) => _extrasJobs[cid];
  716: 
  717:   void _queueExtras(BiliDownloadEntryInfo entry, String output) {
  718:     final cid = entry.cid;
  719:     _extrasCancelled.remove(cid);
  720:     final job = _extrasQueue = _extrasQueue.then((_) async {
  721:       if (_extrasCancelled.contains(cid)) return;
  722:       _extrasRunningCid = cid;
  723:       try {
  724:         await DownloadExtras.export(
  725:           entry: entry,
  726:           folder: path.dirname(output),
  727:           base: path.basenameWithoutExtension(output),
  728:           cancelled: () => _extrasCancelled.contains(cid),
  729:         );
  730:       } catch (e) {
  731:         if (kDebugMode) debugPrint('download extras: $e');
  732:       } finally {
  733:         _extrasRunningCid = null;
  734:       }
  735:     });
  736:     _extrasJobs[cid] = job;
  737:     job.whenComplete(() {
  738:       if (identical(_extrasJobs[cid], job)) {
  739:         _extrasJobs.remove(cid);
  740:         _extrasCancelled.remove(cid);
  741:       }
  742:     });
  743:   }
  744: 
  745:   /// Stops the extras export of a deleted entry; a running one is awaited so
  746:   /// it cannot write into (or recreate) a folder that is being removed.
  747:   Future<void> _cancelExtras(int cid) async {
  748:     if (!_extrasJobs.containsKey(cid)) return;
  749:     _extrasCancelled.add(cid);
  750:     if (_extrasRunningCid == cid) await _extrasJobs[cid];
  751:   }
