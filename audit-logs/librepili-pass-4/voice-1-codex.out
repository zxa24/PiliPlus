   20:         final status = err.response!.statusCode;
   21:         if (status != null && 300 <= status && status < 400) {
   22:           var redirectUrl = err.response!.headers.value('location');
   23:           if (redirectUrl != null) {
   24:             final oldUri = options.uri;
   25:             var uri = Uri.parse(redirectUrl);
   26:             if (!uri.hasScheme) {
   27:               uri = oldUri.resolveUri(uri);
   28:               redirectUrl = uri.toString();
   29:             }
   30:             if (uri.scheme != oldUri.scheme ||
   31:                 uri.host != oldUri.host ||
   32:                 uri.port != oldUri.port) {
   33:               // another origin gets neither the account's cookies nor its
   34:               // headers, nor the old query (access_key...): the location
   35:               // carries its own
   36:               options
   37:                 ..queryParameters = {}
   38:                 ..headers.remove('cookie')
   39:                 ..headers.remove('authorization')
   40:                 ..headers.remove('x-bili-mid')
   41:                 ..headers.remove('x-bili-aurora-eid')
   42:                 ..extra['account'] = const NoAccount();
   43:               // 307/308 (and a POST this interceptor follows itself) keep
   44:               // the body: take the account's secrets out of it too
   45:               _scrubBody(options);
   46:             }
   47:             (options..path = redirectUrl).maxRedirects--;
   48:             if (status == 303) {
   49:               options
   50:                 ..data = null
   51:                 ..method = 'GET';
   52:             }
   53:             _client
   54:                 .fetch(options)
   55:                 .then(
   56:                   (i) => handler.resolve(
   57:                     i
   58:                       ..redirects.add(
   59:                         RedirectRecord(status, options.method, uri),
   60:                       )
   61:                       ..isRedirect = true,
   62:                   ),
   63:                 )
   64:                 .onError<DioException>((error, _) => handler.next(error));
   65:             return;
   66:           }
   67:         }
   68:       }
   69:       return handler.next(err);
   70:     } else {
   71:       switch (err.type) {
   72:         case DioExceptionType.connectionError:
   73:         case DioExceptionType.connectionTimeout:
   74:         case DioExceptionType.sendTimeout:
   75:         case DioExceptionType.unknown:
   76:           // only idempotent reads are re-sent: a POST (like, coin, comment,
   77:           // follow...) may already have been applied by the server
   78:           final method = err.requestOptions.method.toUpperCase();
   79:           if ((method == 'GET' || method == 'HEAD') &&
   80:               (err.requestOptions.extra['_rt'] ??= 0) < _count &&
   81:               err.error
   82:                   is! TransportConnectionException // 网络中断, 此时请求可能已经被服务器所接收
   83:                   ) {
   84:             Future.delayed(
   85:               Duration(
   86:                 milliseconds: ++err.requestOptions.extra['_rt'] * _delay,
   87:               ),
   88:               () => _client
   89:                   .fetch(err.requestOptions)
   90:                   .then(handler.resolve)
   91:                   .onError<DioException>((error, _) => handler.reject(error)),
   92:             );
   93:           } else {
   94:             handler.next(err);
   95:           }
   96:           return;
   97:         default:
   98:           return handler.next(err);
   99:       }
  100:     }
  101:   }
  102: 
  103:   /// Account secrets a body may carry (see AccountManager) and the
  104:   /// signatures computed over them: worthless at another origin, and the
  105:   /// account's to keep.
  106:   static const _bodySecrets = [
  107:     'access_key',
  108:     'mobile_access_key',
  109:     'csrf',
  110:     'csrf_token',
  111:     'biliCSRF',
  112:     'sign',
  113:     'w_rid',
  114:   ];
  115: 
  116:   static void _scrubBody(RequestOptions options) {
  117:     switch (options.data) {
  118:       case final Map data:
  119:         data.removeWhere((key, _) => _bodySecrets.contains(key));
  120:       case final FormData data:
  121:         data.fields.removeWhere((e) => _bodySecrets.contains(e.key));
  122:     }
  123:   }
  124: 
  125:   RetryInterceptor copyWith({Dio? client, int? count, int? delay}) =>
  126:       .new(client ?? _client, count ?? _count, delay ?? _delay);
  127: }

