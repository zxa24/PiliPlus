  220:       responseDecoder: _responseDecoder, // Http2Adapter没有自动解压
  221:       persistentConnection: true,
  222:     );
  223: 
  224:     final (h11, connectionManager) = _createPool();
  225: 
  226:     dio = Dio(options)
  227:       ..httpClientAdapter = _enableHttp2
  228:           ? Http2Adapter(connectionManager, fallbackAdapter: h11)
  229:           : h11;
  230: 
  231:     // 先于其他Interceptor
  232:     if (Pref.retryCount != 0) {
  233:       dio.interceptors.add(
  234:         RetryInterceptor(dio, Pref.retryCount, Pref.retryDelay),
  235:       );
  236:     }
  237: 
  238:     // 日志拦截器 输出请求、响应内容
