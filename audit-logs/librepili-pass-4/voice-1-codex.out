  137:   void downloadVideo(
  138:     Part page,
  139:     VideoDetailData? videoDetail,
  140:     ugc.EpisodeItem? videoArc,
  141:     VideoQuality videoQuality,
  142:   ) {
  143:     final cid = page.cid!;
  144:     if (downloadList.indexWhere((e) => e.cid == cid) != -1) {
  145:       return;
  146:     }
  147:     if (waitDownloadQueue.indexWhere((e) => e.cid == cid) != -1) {
  148:       return;
  149:     }
  150:     final pageData = PageInfo(
  151:       cid: cid,
  152:       page: page.page!,
  153:       from: page.from,
  154:       part: page.part,
  155:       vid: page.vid,
  156:       hasAlias: false,
  157:       tid: 0,
  158:       width: 0,
  159:       height: 0,
  160:       rotate: 0,
  161:       downloadTitle: '视频已缓存完成',
  162:       downloadSubtitle: videoDetail?.title ?? videoArc!.title,
  163:     );
  164:     final currentTime = DateTime.now().millisecondsSinceEpoch ~/ 1000;
  165:     final entry = BiliDownloadEntryInfo(
  166:       mediaType: 2,
  167:       hasDashAudio: false,
  168:       isCompleted: false,
  169:       totalBytes: 0,
  170:       downloadedBytes: 0,
  171:       title: videoDetail?.title ?? videoArc!.title!,
  172:       typeTag: videoQuality.code.toString(),
  173:       cover: (videoDetail?.pic ?? videoArc!.cover!).http2https,
  174:       preferedVideoQuality: videoQuality.code,
  175:       qualityPithyDescription: videoQuality.desc,
  176:       guessedTotalBytes: 0,
  177:       totalTimeMilli: (page.duration ?? 0) * 1000,
  178:       danmakuCount:
  179:           videoDetail?.stat?.danmaku ?? videoArc?.arc?.stat?.danmaku ?? 0,
  180:       timeUpdateStamp: currentTime,
  181:       timeCreateStamp: currentTime,
  182:       canPlayInAdvance: true,
  183:       interruptTransformTempFile: false,
  184:       avid: videoDetail?.aid ?? videoArc!.aid!,
  185:       spid: 0,
  186:       seasonId: null,
  187:       ep: null,
  188:       source: null,
  189:       bvid: videoDetail?.bvid ?? videoArc!.bvid!,
  190:       ownerId: videoDetail?.owner?.mid ?? videoArc?.arc?.author?.mid,
  191:       ownerName: videoDetail?.owner?.name ?? videoArc?.arc?.author?.name,
  192:       pageData: pageData,
  193:     );
  194:     _createDownload(entry);
  195:   }
