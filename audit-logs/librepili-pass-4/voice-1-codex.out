  110:       if (res.statusCode == 200 && (res.data?.contentLength ?? -1) >= 0) {
  111:         return res.data!.contentLength;
  112:       }
  113:     } catch (_) {}
  114:     return null;
  115:   }
  116: 
  117:   /// One transfer attempt. Returns null when the file is complete, else the
  118:   /// error.
  119:   Future<Object?> _attempt(String url) async {
  120:     int received;
  121: 
  122:     final file = File(path);
  123:     if (file.existsSync()) {
  124:       received = await file.length();
  125:     } else {
  126:       file.createSync(recursive: true);
