   37: abstract final class PiliScheme {
   38:   static late AppLinks appLinks;
   39:   static StreamSubscription? listener;
   40:   static final uriDigitRegExp = RegExp(r'/(\d+)');
   41:   static final _prefixRegex = RegExp(r'^\S+://');
   42: 
   43:   static void init() {
   44:     // Register our protocol only on Windows platform
   45:     // registerProtocolHandler('bilibili');
   46:     appLinks = AppLinks();
   47: 
   48:     listener?.cancel();
   49:     final handler = PlatformUtils.isDesktop ? _desktopRoutePush : routePush;
   50:     // same as uriLinkStream, plus files opened while already running
   51:     listener = appLinks.stringLinkStream.listen((link) {
   52:       if (link.startsWith(_openFilePrefix)) {
   53:         _openFile(link.substring(_openFilePrefix.length));
   54:       } else if (_localFile(link) case final file?) {
   55:         // Linux delivers command-line arguments (file paths) as links; the
   56:         // file the app was launched with is already opened by main()
   57:         if (file == launchFile) {
   58:           launchFile = null;
   59:         } else {
   60:           _openFile(file);
   61:         }
   62:       } else if (Uri.tryParse(link) case final uri?) {
   63:         handler(uri);
   64:       }
   65:     });
   66:   }
   67: 
   68:   /// The file / folder main() opens from the launch arguments.
   69:   static String? launchFile;
   70: 
   71:   /// [link] as an existing local path (a plain path or a `file:` URI).
   72:   static String? _localFile(String link) {
   73:     String? file;
   74:     if (link.startsWith('file:')) {
   75:       file = Uri.tryParse(link)?.toFilePath();
   76:     } else if (!_prefixRegex.hasMatch(link)) {
   77:       file = link;
   78:     }
   79:     if (file == null || file == Platform.resolvedExecutable) return null;
   80:     return FileSystemEntity.typeSync(file) == FileSystemEntityType.notFound
   81:         ? null
   82:         : file;
   83:   }
   84: 
   85:   /// Sent by windows/runner/main.cpp for "Open with" when an instance is
   86:   /// already running.
   87:   static const _openFilePrefix = 'librepili-open:';
   88: 
   89:   static Future<void> _openFile(String target) async {
   90:     if (PlatformUtils.isDesktop) {
   91:       await windowManager.show();
   92:       await windowManager.focus();
   93:     }
   94:     if (FileSystemEntity.typeSync(target) != FileSystemEntityType.notFound) {
   95:       await LocalPlayer.open(target);
   96:     }
   97:   }
