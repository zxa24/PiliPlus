   99:             PackageManager pm = getContext().getPackageManager();
  100:             android.content.pm.Signature[] signatures;
  101:             if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
  102:                 android.content.pm.SigningInfo info = pm.getPackageInfo(
  103:                         packageName, PackageManager.GET_SIGNING_CERTIFICATES).signingInfo;
  104:                 if (info == null || info.hasMultipleSigners()) return false;
  105:                 signatures = info.getSigningCertificateHistory();
  106:             } else {
  107:                 signatures = pm.getPackageInfo(packageName, PackageManager.GET_SIGNATURES).signatures;
  108:                 // several signers: not the single-key release we know
  109:                 if (signatures == null || signatures.length != 1) return false;
  110:             }
  111:             if (signatures == null || signatures.length == 0) return false;
  112:             // the current signer (last in the rotation history)
  113:             byte[] digest = java.security.MessageDigest.getInstance("SHA-256")
  114:                     .digest(signatures[signatures.length - 1].toByteArray());
  115:             StringBuilder hex = new StringBuilder(digest.length * 2);
  116:             for (byte b : digest) hex.append(String.format("%02X", b));
  117:             String actual = hex.toString();
  118:             for (String e : expected) {
  119:                 if (e.replace(":", "").equalsIgnoreCase(actual)) return true;
  120:             }
  121:         } catch (Exception ignored) {
  122:         }
  123:         return false;
  124:     }
