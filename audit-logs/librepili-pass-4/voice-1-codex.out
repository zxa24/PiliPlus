   98:       if (dir is Directory) {
   99:         downloadList.addAll(await _readDownloadDirectory(dir));
  100:       }
  101:     }
  102:     downloadList.sort((a, b) => b.timeUpdateStamp.compareTo(a.timeUpdateStamp));
  103:   }
  104: 
  105:   @pragma('vm:notify-debugger-on-exception')
  106:   Future<List<BiliDownloadEntryInfo>> _readDownloadDirectory(
  107:     Directory pageDir,
  108:   ) async {
  109:     final result = <BiliDownloadEntryInfo>[];
  110: 
  111:     if (!pageDir.existsSync()) {
  112:       return result;
  113:     }
  114: 
  115:     await for (final entryDir in pageDir.list()) {
  116:       if (entryDir is Directory) {
  117:         final entryFile = File(path.join(entryDir.path, _entryFile));
  118:         if (entryFile.existsSync()) {
  119:           try {
  120:             final entryJson = await entryFile.readAsString();
  121:             final entry = BiliDownloadEntryInfo.fromJson(jsonDecode(entryJson))
  122:               ..pageDirPath = pageDir.path
  123:               ..entryDirPath = entryDir.path;
  124:             if (entry.isCompleted) {
  125:               result.add(entry);
  126:             } else {
  127:               waitDownloadQueue.add(entry..status = DownloadStatus.wait);
  128:             }
  129:           } catch (_) {}
  130:         }
  131:       }
  132:     }
  133: 
  134:     return result;
  135:   }
