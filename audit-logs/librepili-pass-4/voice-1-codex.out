  172:                       config.onBadCertificate = (_) => true;
  173:                     }
  174:                   }
  175:                 : Pref.badCertificateCallback
  176:                 ? (_, config) => config.onBadCertificate = (_) => true
  177:                 : null,
  178:           )
  179:         : null;
  180:     return (http11Adapter, connectionManager);
  181:   }
