  243:           requestHeader: false,
  244:           responseHeader: false,
  245:         ),
  246:       );
  247:     }
  248: 
  249:     dio
  250:       ..transformer = BackgroundTransformer()
  251:       ..options.validateStatus = (int? status) {
  252:         return status != null && status >= 200 && status < 300;
  253:       };
  254: 
  255:     if (Platform.isIOS) _watchConnectivity();
  256:   }
