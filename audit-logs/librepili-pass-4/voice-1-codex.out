  119:   static String get _snapshotDir => path.join(appSupportDirPath, 'snapshots');
  120:   static const _snapshotPrefix = 'before_import_';
  121:   static const _maxSnapshots = 5;
  122: 
  123:   /// Saves the current settings and local library (credentials included:
  124:   /// the file stays in the app's own data dir) before an import replaces
  125:   /// them. Returns the file path; only the newest [_maxSnapshots] are kept.
  126:   static Future<String> _saveSnapshot() async {
  127:     final dir = Directory(_snapshotDir);
  128:     await dir.create(recursive: true);
  129:     final now = DateTime.now();
  130:     String two(int v) => v.toString().padLeft(2, '0');
  131:     final name =
  132:         '$_snapshotPrefix${now.year}${two(now.month)}${two(now.day)}_'
  133:         '${two(now.hour)}${two(now.minute)}${two(now.second)}.json';
  134:     final file = File(path.join(dir.path, name));
  135:     await file.writeAsString(exportAllSettings(includeCredentials: true));
  136:     final old = await _snapshots();
  137:     for (final f in old.skip(_maxSnapshots)) {
  138:       try {
  139:         await f.delete();
  140:       } catch (_) {}
  141:     }
  142:     return file.path;
  143:   }
  144: 
  145:   /// Snapshots taken before imports, newest first.
  146:   static Future<List<File>> _snapshots() async {
  147:     final dir = Directory(_snapshotDir);
  148:     if (!dir.existsSync()) return [];
  149:     final files = [
  150:       await for (final f in dir.list())
  151:         if (f is File && path.basename(f.path).startsWith(_snapshotPrefix)) f,
  152:     ]..sort((a, b) => path.basename(b.path).compareTo(path.basename(a.path)));
  153:     return files;
  154:   }
  155: 
  156:   /// The newest snapshot taken before an import, if any.
  157:   static Future<File?> latestSnapshot() async =>
  158:       (await _snapshots()).firstOrNull;
  159: 
  160:   /// Undoes the last import: restores [latestSnapshot] (with its
  161:   /// credentials, they were this device's) and removes it.
  162:   static Future<void> restoreLatestSnapshot() async {
  163:     final file = await latestSnapshot();
  164:     if (file == null) throw const FormatException('没有导入前的快照');
  165:     await importAllJsonSettings(
  166:       jsonDecode(await file.readAsString()),
  167:       importCredentials: true,
  168:       snapshot: false,
  169:     );
  170:     await file.delete();
  171:   }
  172: 
  173:   /// Replaces settings and the local library with [map]. Unless [snapshot]
  174:   /// is false, the current state is saved first (see [_saveSnapshot]) and
  175:   /// the snapshot path is returned. This device's [credentialKeys] are kept
  176:   /// unless [importCredentials] (the user agreed) and [map] has them.
  177:   static Future<String?> importAllJsonSettings(
  178:     Map<String, dynamic> map, {
  179:     bool importCredentials = false,
  180:     bool snapshot = true,
  181:   }) async {
  182:     // login mode is a per-device opt-in: a backup must not switch it (the
  183:     // running account state is not re-applied after an import)
  184:     final loginMode = Pref.loginMode;
  185:     // validate everything first, so a bad backup changes nothing; a missing
  186:     // section leaves that box as it is
  187:     final settingMap = map[setting.name];
  188:     final videoMap = map[video.name];
  189:     if ((settingMap != null && settingMap is! Map) ||
  190:         (videoMap != null && videoMap is! Map) ||
  191:         (settingMap == null && videoMap == null)) {
  192:       throw const FormatException('不是有效的设置备份');
  193:     }
  194:     LocalLibrary.checkImport(map);
  195:     final snapshotPath = snapshot ? await _saveSnapshot() : null;
  196:     final credentials = {
  197:       for (final key in credentialKeys)
  198:         if (setting.containsKey(key)) key: setting.get(key),
  199:     };
  200:     await Future.wait([
  201:       if (settingMap is Map)
  202:         setting
  203:             .clear()
  204:             .then(
  205:               (_) => setting.putAll({
  206:                 for (final e in settingMap.entries)
  207:                   if (importCredentials || !credentialKeys.contains(e.key))
  208:                     e.key: e.value,
  209:               }),
  210:             )
  211:             .then(
  212:               (_) => setting.putAll({
  213:                 SettingBoxKey.loginMode: loginMode,
  214:                 // credentials the backup does not replace stay as they were
  215:                 for (final e in credentials.entries)
  216:                   if (!importCredentials || !settingMap.containsKey(e.key))
  217:                     e.key: e.value,
  218:               }),
  219:             ),
  220:       if (videoMap is Map) video.clear().then((_) => video.putAll(videoMap)),

