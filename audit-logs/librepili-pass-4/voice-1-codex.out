  272:         cancelToken: cancelToken,
  273:       );
  274:     } on DioException catch (e) {
  275:       return Response(
  276:         data: {
  277:           'message': await AccountManager.dioError(e),
  278:         }, // 将自定义 Map 数据赋值给 Response 的 data 属性
  279:         statusCode: e.response?.statusCode ?? -1,
  280:         requestOptions: e.requestOptions,
  281:       );
