  197:   void downloadBangumi(
  198:     int index,
  199:     PgcInfoModel pgcItem,
  200:     pgc.EpisodeItem episode,
  201:     VideoQuality quality,
  202:   ) {
  203:     final cid = episode.cid!;
  204:     if (downloadList.indexWhere((e) => e.cid == cid) != -1) {
  205:       return;
  206:     }
  207:     if (waitDownloadQueue.indexWhere((e) => e.cid == cid) != -1) {
  208:       return;
  209:     }
  210:     final currentTime = DateTime.now().millisecondsSinceEpoch ~/ 1000;
  211:     final source = SourceInfo(
  212:       avId: episode.aid!,
  213:       cid: cid,
  214:     );
  215:     final ep = EpInfo(
  216:       avId: source.avId,
  217:       page: index,
  218:       danmaku: source.cid,
  219:       cover: episode.cover!,
  220:       episodeId: episode.id!,
  221:       index: episode.title!,
  222:       indexTitle: episode.longTitle ?? '',
  223:       showTitle: episode.showTitle,
  224:       from: episode.from ?? 'bangumi',
  225:       seasonType: pgcItem.type ?? (episode.from == 'pugv' ? -1 : 0),
  226:       width: 0,
  227:       height: 0,
  228:       rotate: 0,
  229:       link: episode.link ?? '',
  230:       bvid: episode.bvid ?? IdUtils.av2bv(source.avId),
  231:       sortIndex: index,
  232:     );
  233:     final entry = BiliDownloadEntryInfo(
  234:       mediaType: 2,
  235:       hasDashAudio: false,
  236:       isCompleted: false,
  237:       totalBytes: 0,
  238:       downloadedBytes: 0,
  239:       title: pgcItem.seasonTitle ?? pgcItem.title ?? '',
  240:       typeTag: quality.code.toString(),
  241:       cover: episode.cover!,
  242:       preferedVideoQuality: quality.code,
  243:       qualityPithyDescription: quality.desc,
  244:       guessedTotalBytes: 0,
  245:       totalTimeMilli:
  246:           (episode.duration ?? 0) *
  247:           (episode.from == 'pugv' ? 1000 : 1), // pgc millisec,, pugv sec
  248:       danmakuCount: pgcItem.stat?.danmaku ?? 0,
  249:       timeUpdateStamp: currentTime,
  250:       timeCreateStamp: currentTime,
  251:       canPlayInAdvance: true,
  252:       interruptTransformTempFile: false,
  253:       spid: 0,
  254:       seasonId: pgcItem.seasonId!.toString(),
  255:       bvid: episode.bvid ?? IdUtils.av2bv(source.avId),
  256:       avid: source.avId,
  257:       ep: ep,
  258:       source: source,
  259:       ownerId: pgcItem.upInfo?.mid,
  260:       ownerName: pgcItem.upInfo?.uname,
  261:       pageData: null,
  262:     );
  263:     _createDownload(entry);
  264:   }
  265: 
  266:   Future<void> _createDownload(BiliDownloadEntryInfo entry) async {
  267:     final entryDir = await _getDownloadEntryDir(entry);
  268:     final entryJsonFile = File(path.join(entryDir.path, _entryFile));
  269:     await entryJsonFile.writeAsString(jsonEncode(entry.toJson()));
  270:     entry
  271:       ..pageDirPath = entryDir.parent.path
  272:       ..entryDirPath = entryDir.path
  273:       ..status = DownloadStatus.wait;
  274:     waitDownloadQueue.add(entry);
  275:     if (curDownload.value?.status.isDownloading != true) {
  276:       startDownload(entry);
  277:     }
  278:   }
  279: 
  280:   Future<Directory> _getDownloadEntryDir(BiliDownloadEntryInfo entry) async {
  281:     late final String dirName;
  282:     late final String pageDirName;
  283:     if (entry.ep case final ep?) {
  284:       dirName = 's_${entry.seasonId}';
  285:       pageDirName = ep.episodeId.toString();
  286:     } else if (entry.pageData case final page?) {
  287:       dirName = entry.avid.toString();
  288:       pageDirName = 'c_${page.cid}';
  289:     }
  290:     final root = await _getDownloadPath();
  291:     // an export made before exports avoided internal names (e.g. a title
  292:     // "114514") may already occupy this video's page folder: move it aside
  293:     // so the download is not created inside it (and deleting the download
  294:     // cannot take the export with it)
  295:     final page = Directory(path.join(root, dirName));
  296:     if (page.existsSync() &&
  297:         _isForeignFolder(page) &&
  298:         // already holds downloads (made before this guard): leave it, the
  299:         // deletion guard keeps the export's files
  300:         !page.listSync().any(
  301:           (e) =>
  302:               e is Directory &&
  303:               File(path.join(e.path, _entryFile)).existsSync(),
  304:         )) {
  305:       var aside = exportFolderName(dirName);
  306:       for (var i = 2; Directory(path.join(root, aside)).existsSync(); i++) {
  307:         aside = '${exportFolderName(dirName)} ($i)';
  308:       }
  309:       final moved = path.join(root, aside);
  310:       try {
  311:         await page.rename(moved);
  312:         // the download that exported it still points at the old place
  313:         for (final e in downloadList) {
  314:           if (e.mergedPath case final merged?
  315:               when path.isWithin(page.path, merged)) {
  316:             e.mergedPath = path.join(
  317:               moved,
  318:               path.relative(merged, from: page.path),
  319:             );
  320:             await _updateBiliDownloadEntryJson(e);
  321:           }
  322:         }
  323:       } on FileSystemException catch (e) {
  324:         // e.g. Windows: a file in it is open (the export is playing). The
  325:         // download goes inside it then; the deletion guards on both sides
  326:         // keep the export's files and the download apart.
  327:         if (kDebugMode) debugPrint('cannot move export aside: $e');
  328:       }
  329:     }
  330:     final pageDir = Directory(path.join(root, dirName, pageDirName));
  331:     if (!pageDir.existsSync()) {
  332:       await pageDir.create(recursive: true);
  333:     }
  334:     return pageDir;
  335:   }
  336: 
  337:   static Future<String> _getDownloadPath() async {
  338:     final dir = Directory(downloadPath);
  339:     if (!dir.existsSync()) {
  340:       await dir.create(recursive: true);
  341:     }
  342:     return dir.path;
  343:   }
  344: 
  345:   Future<void> startDownload(BiliDownloadEntryInfo entry) {
  346:     // already finished downloading; the merge completes it
  347:     if (_mergingCids.contains(entry.cid)) return Future.value();
  348:     return _lock.synchronized(() async {
  349:       await _downloadManager?.cancel(isDelete: false);
  350:       await _audioDownloadManager?.cancel(isDelete: false);
  351:       _downloadManager = null;
  352:       _audioDownloadManager = null;
  353:       if (curDownload.value case final curEntry?) {
  354:         if (curEntry.status.isDownloading) {
  355:           curEntry.status = DownloadStatus.pause;
  356:         }
  357:       }
  358: 
  359:       _curCid = entry.cid;
  360:       curDownload.value = entry;
  361:       waitDownloadQueue.refresh();
  362:       await _startDownload(entry);
  363:     });
  364:   }
  365: 
  366:   Future<bool> downloadDanmaku({
  367:     required BiliDownloadEntryInfo entry,
  368:     bool isUpdate = false,
  369:   }) async {
  370:     final cid = entry.pageData?.cid ?? entry.source?.cid;
  371:     if (cid == null) {
  372:       return false;
  373:     }
  374:     final danmakuFile = File(
  375:       path.join(entry.entryDirPath, PathUtils.danmakuName),
  376:     );
  377:     if (isUpdate || !danmakuFile.existsSync()) {
  378:       try {
  379:         if (!isUpdate) {
  380:           _updateCurStatus(DownloadStatus.getDanmaku);
  381:         }
  382:         // unknown duration: at least the first segment
  383:         final seg = math.max(
  384:           (entry.totalTimeMilli / DmUtils.segLength).ceil(),
  385:           1,
  386:         );
  387: 
  388:         final danmaku = (await DmGrpc.dmSegMobile(
  389:           cid: cid,
  390:           segmentIndex: 1,
  391:         )).data;
  392:         for (var start = 2; start <= seg; start += _maxDanmakuConcurrency) {
  393:           final end = start + _maxDanmakuConcurrency - 1;
  394:           final responses = await Future.wait([
  395:             for (var index = start; index <= seg && index <= end; index++)
  396:               DmGrpc.dmSegMobile(cid: cid, segmentIndex: index),
  397:           ]);
  398:           for (final response in responses) {
  399:             danmaku.elems.addAll(response.data.elems);
  400:           }
  401:           responses.clear();
  402:         }
  403:         await danmakuFile.writeAsBytes(danmaku.writeToBuffer());
  404: 
  405:         return true;
  406:       } catch (e) {
  407:         if (!isUpdate) {
  408:           _updateCurStatus(DownloadStatus.failDanmaku);
  409:         }
  410:         if (kDebugMode) SmartDialog.showToast(e.toString());
  411:         return false;
  412:       }
  413:     }
  414:     return true;
  415:   }
  416: 
  417:   Future<bool> _downloadCover({
  418:     required BiliDownloadEntryInfo entry,
  419:   }) async {
  420:     try {
  421:       final filePath = path.join(entry.entryDirPath, PathUtils.coverName);
  422:       if (File(filePath).existsSync()) {
  423:         return true;
  424:       }
  425:       final file = (await CacheManager.manager.getFileFromCache(
  426:         entry.cover,
  427:       ))?.file;
  428:       if (file != null) {
  429:         await file.copy(filePath);
  430:       } else {
  431:         await Request.dio.download(entry.cover, filePath);
  432:       }
  433:       return true;
  434:     } catch (_) {
  435:       return false;
  436:     }
  437:   }
  438: 
  439:   Future<void> _startDownload(BiliDownloadEntryInfo entry) async {
  440:     try {
  441:       // danmaku is optional: a failed fetch must not block the video (it
  442:       // can be fetched again later with "update danmaku")
  443:       await downloadDanmaku(entry: entry);
  444: 
  445:       _updateCurStatus(DownloadStatus.getPlayUrl);
  446: 
  447:       final oldTypeTag = entry.typeTag;
  448:       final mediaFileInfo = await DownloadHttp.getVideoUrl(
  449:         entry: entry,
  450:         ep: entry.ep,
  451:         source: entry.source,
  452:         pageData: entry.pageData,
  453:       );
  454: 
  455:       // the stream is picked again on every start (codec / login / quality
  456:       // settings may have changed): partial files of another stream must
  457:       // not be resumed, or two streams end up in one file
  458:       if (oldTypeTag != entry.typeTag) {
  459:         await Directory(
  460:           path.join(entry.entryDirPath, oldTypeTag),
  461:         ).tryDel(recursive: true);
  462:       }
  463:       final videoDir = Directory(path.join(entry.entryDirPath, entry.typeTag));
  464:       final mediaJsonFile = File(path.join(videoDir.path, _indexFile));
  465:       if (videoDir.existsSync()) {
  466:         String? oldKey;
  467:         try {
  468:           oldKey = _streamKey(jsonDecode(await mediaJsonFile.readAsString()));
  469:         } catch (_) {}
  470:         if (oldKey != _streamKey(mediaFileInfo.toJson())) {
  471:           await videoDir.tryDel(recursive: true);
  472:         }
  473:       }
  474:       if (!videoDir.existsSync()) {
  475:         await videoDir.create(recursive: true);
  476:       }
  477: 
  478:       await Future.wait([
  479:         mediaJsonFile.writeAsString(jsonEncode(mediaFileInfo.toJson())),
  480:         _downloadCover(entry: entry),
  481:       ]);
  482: 
  483:       if (curDownload.value?.cid != entry.cid) {
  484:         return;
  485:       }
  486: 
  487:       switch (mediaFileInfo) {
  488:         case Type1 mediaFileInfo:
  489:           _startSegment(mediaFileInfo.segmentList, 0, videoDir.path);
  490:           break;
  491:         case Type2 mediaFileInfo:
  492:           _downloadManager = DownloadManager(
  493:             url: mediaFileInfo.video.first.baseUrl,
  494:             backupUrls: mediaFileInfo.video.first.backupUrl ?? const [],
  495:             path: path.join(videoDir.path, PathUtils.videoNameType2),
  496:             onReceiveProgress: _onReceive,
  497:             onDone: _onDone,
  498:           );
  499:           final audio = mediaFileInfo.audio;
  500:           if (audio != null && audio.isNotEmpty) {
  501:             _audioDownloadManager = DownloadManager(
  502:               url: audio.first.baseUrl,
  503:               backupUrls: audio.first.backupUrl ?? const [],
  504:               path: path.join(videoDir.path, PathUtils.audioNameType2),
  505:               onReceiveProgress: null,
  506:               onDone: _onAudioDone,
  507:             );
  508:           }
  509:           late final first = mediaFileInfo.video.first;
  510:           entry.pageData
  511:             ?..width = first.width
  512:             ..height = first.height;
  513:           entry.ep
  514:             ?..width = first.width
  515:             ..height = first.height;
  516:           _updateBiliDownloadEntryJson(entry);
  517:           break;
  518:         default:
  519:           break;
  520:       }
  521:     } catch (e) {
  522:       _updateCurStatus(DownloadStatus.failPlayUrl);
  523:       if (kDebugMode) {
  524:         debugPrint('get download url error: $e');
  525:       }
  526:     }
  527:   }
  528: 
  529:   /// What identifies the bytes of a saved stream ([_indexFile] json): the
  530:   /// dash video / audio stream picked, or the durl segment sizes.
  531:   static String? _streamKey(Object? json) {
  532:     if (json is! Map) return null;
  533:     String file(Object? list) {
  534:       if (list is! List || list.isEmpty || list.first is! Map) return '';
  535:       final f = list.first as Map;
  536:       return '${f['id']}/${f['codecid']}/${f['width']}x${f['height']}';
  537:     }
  538: 
  539:     if (json['video'] != null) {
  540:       return 'dash:${file(json['video'])}:${file(json['audio'])}';
  541:     }
  542:     if (json['segment_list'] case final List segments) {
  543:       return 'durl:${segments.map((e) => e is Map ? e['bytes'] : null).join(',')}';
  544:     }
  545:     return null;
  546:   }
  547: 
  548:   /// Old single-URL (durl) streams may come in several segments: they are
  549:   /// downloaded one after another (resuming what is on disk) and joined by
  550:   /// [_mergeDownload]. Progress runs over their total size.
  551:   void _startSegment(List<Type1Segment> segments, int index, String dir) {
  552:     final total = segments.fold<int>(0, (s, e) => s + e.bytes);
  553:     final done = segments.take(index).fold<int>(0, (s, e) => s + e.bytes);
  554:     final segment = segments[index];
  555:     late final DownloadManager manager;
  556:     manager = DownloadManager(
  557:       url: segment.url,
  558:       backupUrls: segment.backupUrls,
  559:       path: path.join(dir, PathUtils.segmentNameType1(index)),
  560:       onReceiveProgress: segments.length == 1 || total <= 0
  561:           ? _onReceive
  562:           : (received, _) => _onReceive(done + received, total),
  563:       onDone: ([error]) {
  564:         if (error != null || index + 1 == segments.length) {
  565:           return _onDone(error);
  566:         }
  567:         // paused / deleted / replaced meanwhile
  568:         if (!identical(_downloadManager, manager)) return;
  569:         _startSegment(segments, index + 1, dir);
  570:       },
  571:     );
  572:     _downloadManager = manager;
  573:   }
  574: 
  575:   Future<void> _updateBiliDownloadEntryJson(BiliDownloadEntryInfo entry) {
  576:     final entryJsonFile = File(path.join(entry.entryDirPath, _entryFile));
  577:     return entryJsonFile.writeAsString(jsonEncode(entry.toJson()));
  578:   }
  579: 
  580:   void _onReceive(int progress, int total) {
  581:     if (curDownload.value case final entry?) {
  582:       if (progress == 0 && total != 0) {
  583:         _updateBiliDownloadEntryJson(entry..totalBytes = total);
  584:       }
  585:       entry
  586:         ..downloadedBytes = progress
  587:         ..status = DownloadStatus.downloading;
  588:       curDownload.refresh();
  589:     }
  590:   }
  591: 
  592:   /// Last download error (diagnostics: self test, logs).
  593:   String? lastError;
  594: 
  595:   void _onDone([Object? error]) {
  596:     if (error != null) {
  597:       lastError = 'video: $error';
  598:       debugPrint('download failed: $lastError');
  599:     }
  600:     if (error != null) {
  601:       _updateCurStatus(_downloadManager?.status ?? DownloadStatus.pause);
  602:       return;
  603:     }
  604: 
  605:     final status = switch (_audioDownloadManager?.status) {
  606:       DownloadStatus.downloading => DownloadStatus.audioDownloading,
  607:       DownloadStatus.failDownload => DownloadStatus.failDownloadAudio,
  608:       _ => _downloadManager?.status ?? DownloadStatus.pause,
  609:     };
  610:     _updateCurStatus(status);
  611: 
  612:     if (curDownload.value case final curEntryInfo?) {
  613:       curEntryInfo.downloadedBytes = curEntryInfo.totalBytes;
  614:       if (status == DownloadStatus.completed) {
  615:         _completeDownload();
  616:       } else {
  617:         _updateBiliDownloadEntryJson(curEntryInfo);
  618:       }
  619:     }
  620:   }
  621: 
  622:   void _onAudioDone([Object? error]) {
  623:     if (error != null) {
  624:       lastError = 'audio: $error';
  625:       debugPrint('download failed: $lastError');
  626:     }
  627:     if (_downloadManager?.status == DownloadStatus.completed) {
  628:       if (error == null) {
  629:         _completeDownload();
  630:       } else {
  631:         final status = _audioDownloadManager?.status ?? DownloadStatus.pause;
  632:         _updateCurStatus(
  633:           status == DownloadStatus.failDownload
  634:               ? DownloadStatus.failDownloadAudio
  635:               : status,
  636:         );
  637:       }
  638:     }
  639:   }
  640: 
  641:   Future<void> _completeDownload() async {
  642:     final entry = curDownload.value;
  643:     if (entry == null) {
  644:       return;
  645:     }
  646:     _downloadManager = null;
  647:     _audioDownloadManager = null;
  648:     entry.downloadedBytes = entry.totalBytes;
  649:     final cid = entry.cid;
  650:     _mergingCids.add(cid);
  651:     _mergeDeletedCids.remove(cid);
  652:     _updateCurStatus(DownloadStatus.merging);
  653:     final (:output, :inputs, :damaged) = await _mergeDownload(entry);
  654:     _mergingCids.remove(cid);
  655:     final deleted = _mergeDeletedCids.remove(cid);
  656:     if (deleted || !Directory(entry.entryDirPath).existsSync()) {
  657:       // deleted while merging (the merge may have kept files open, so the
  658:       // delete may not have removed everything)
  659:       await _deleteMerged(entry);
  660:       await Directory(entry.entryDirPath).tryDel(recursive: true);
  661:       waitDownloadQueue.remove(entry);
  662:       if (curDownload.value == null) nextDownload();
  663:       return;
  664:     }
  665:     if (damaged) {
  666:       // segments still damaged / missing: not complete. Stays in the queue
  667:       // as failed (like a failed transfer, the queue waits for the user);
  668:       // starting it again fetches a fresh play URL and merges again.
  669:       if (curDownload.value?.cid == cid) {
  670:         _updateCurStatus(DownloadStatus.failMerge);
  671:       }
  672:       await _updateBiliDownloadEntryJson(entry);
  673:       return;
  674:     }
  675:     // record completion before removing the stream files, so a crash here
  676:     // cannot turn the entry back into an incomplete one
  677:     entry.isCompleted = true;
  678:     await _updateBiliDownloadEntryJson(entry);
  679:     if (output != null) {
  680:       for (final input in inputs) {
  681:         await File(input).tryDel();
  682:       }
  683:       if (Platform.isAndroid) {
  684:         for (final part in _exportedParts(output)) {
