   65:   }) async {
   66:     if (!Platform.isLinux) return null;
   67:     final shouldInjectCookie = LinuxCookieManager.isBiliDomain(url);
   68:     // LibrePili: pages are anonymous; only taking notes needs the account
   69:     // only the video page's note flow (which passes [oid]) gets the account,
   70:     // not a note-app url opened from a link
   71:     final accountCookie = shouldInjectCookie && _isNoteUrl(url) && oid != null;
   72:     final cookieJs = shouldInjectCookie
   73:         ? LinuxCookieManager.generateCookieInjectionJs(
   74:             LinuxCookieManager.getCookies(
   75:               accountCookie ? null : AnonymousAccount(),
   76:             ),
   77:             accountCookie,
   78:           )
   79:         : '';
   80: 
   81:     final userScripts = <dww.UserScript>[
   82:       if (cookieJs.isNotEmpty)
   83:         dww.UserScript(
   84:           source: cookieJs,
   85:           injectionTime: dww.UserScriptInjectionTime.documentStart,
   86:           forAllFrames: true,
   87:         ),
   88:       if (url.startsWith('https://www.bilibili.com/h5/note-app'))
   89:         const dww.UserScript(
   90:           source: """
   91: document.addEventListener('click', function(e) {
   92:   var finishBtn = e.target && e.target.closest ? e.target.closest('.finish-btn') : null;
   93:   if (finishBtn) {
   94:     window.webkit.messageHandlers.msgToNative.postMessage('finishButtonClicked');
   95:     return;
   96:   }
   97:   var infoBar = e.target && e.target.closest ? e.target.closest('.info-bar') : null;
   98:   if (infoBar) {
   99:     window.webkit.messageHandlers.msgToNative.postMessage('infoBarClicked');
  100:     return;
  101:   }
  102: }, true);
  103: """,
  104:           injectionTime: dww.UserScriptInjectionTime.documentEnd,
  105:           forAllFrames: true,
  106:         ),
  107:       if (url.startsWith('https://live.bilibili.com'))
  108:         const dww.UserScript(
  109:           source: """
  110: (function() {
  111:   function injectStyle() {
  112:     if (document.getElementById('pili-live-style')) return;
  113:     var s = document.createElement('style');
  114:     s.id = 'pili-live-style';
  115:     s.textContent = 'div.open-app-btn.bili-btn-warp {display:none !important;} #app__display-area > div.control-panel {display:none !important;}';
  116:     (document.head || document.documentElement).appendChild(s);
  117:   }
  118:   if (document.readyState === 'loading') {
  119:     document.addEventListener('DOMContentLoaded', injectStyle);
  120:   } else {
  121:     injectStyle();
  122:   }
  123: })();
  124: """,
  125:           injectionTime: dww.UserScriptInjectionTime.documentStart,
  126:           forAllFrames: true,
  127:         ),
