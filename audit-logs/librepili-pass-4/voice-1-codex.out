  280:   static int _intStrDescKeyComparator(dynamic k1, dynamic k2) {
  281:     if (k1 is int) {
  282:       if (k2 is int) {
  283:         return k2.compareTo(k1);
  284:       } else {
  285:         return -1;
  286:       }
  287:     } else if (k2 is String) {
  288:       final lenCompare = k2.length.compareTo((k1 as String).length);
  289:       if (lenCompare == 0) {
  290:         return k2.compareTo(k1);
  291:       } else {
  292:         return lenCompare;
  293:       }
  294:     } else {
  295:       return 1;
  296:     }
  297:   }
  298: }

