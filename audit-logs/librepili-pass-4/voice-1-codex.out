   68: 
   69:   /// The home "推荐" feed and its dislike feedback (user decision: not
   70:   /// anonymous in login mode). Bound to the recommend role's account (see
   71:   /// ApiType), which may itself be anonymous.
   72:   static const Set<String> _recommendApis = {
   73:     Api.recommendListApp,
   74:     Api.recommendListWeb,
   75:     Api.feedDislike,
   76:     Api.feedDislikeCancel,
   77:   };
   78: 
   79:   static const Set<String> _grpcAccountApis = {
   80:     GrpcUrl.dynRed,
   81:     GrpcUrl.audioPlayUrl,
   82:     GrpcUrl.audioThumbUp,
   83:     GrpcUrl.audioTripleLike,
   84:     GrpcUrl.audioCoinAdd,
   85:   };
   86: 
   87:   static const List<String> _grpcAccountPrefixes = [GrpcUrl.im, GrpcUrl.im2];
   88: 
   89:   static const _csrfKeys = {'csrf', 'biliCSRF', 'csrf_token'};
   90:   static const _selfKeys = ['mid', 'vmid', 'up_mid'];
   91: 
   92:   /// Whether UI that writes (comments, replies, danmaku, live chat) is
   93:   /// shown: it needs a logged-in account and the "hide interaction" switch
   94:   /// off. Existing comments and danmaku are displayed either way.
   95:   static bool get canInteract => Accounts.main.isLogin && !Pref.hideInteraction;
   96: 
   97:   /// `options.extra[explicitAccount] = true`: the call site must go out as
   98:   /// the account it passed in `extra['account']` although the path is not
   99:   /// on the lists (e.g. the comment check's "seen as the account" half,
  100:   /// compared with an anonymous request). Honoured in login mode only.
  101:   static const explicitAccount = 'explicitAccount';
  102: 
  103:   /// The account [options] goes out with: [account] is the one its role
  104:   /// resolved to (see ApiType), kept only when login mode is on and the
  105:   /// request needs it (or asks for it, see [explicitAccount]); otherwise
  106:   /// anonymous. [loginMode] defaults to the setting (tests pass it).
  107:   static Account bind(
  108:     Account account,
  109:     RequestOptions options, {
  110:     bool? loginMode,
  111:   }) {
  112:     if (account is LoginAccount &&
  113:         (!(loginMode ?? LoginPolicy.loginMode) ||
  114:             (!requiresAccount(options) &&
  115:                 options.extra[explicitAccount] != true))) {
  116:       return AnonymousAccount();
  117:     }
  118:     return account;
  119:   }
  120: 
  121:   /// Whether [options] may carry the logged-in account. False means it is
  122:   /// sent anonymously even in login mode.
  123:   static bool requiresAccount(RequestOptions options) {
  124:     final path = options.path;
  125:     // gRPC requests are sent as `appBaseUrl + GrpcUrl.x`
  126:     final grpcPath = path.startsWith(HttpString.appBaseUrl)
  127:         ? path.substring(HttpString.appBaseUrl.length)
  128:         : path;
  129:     if (_accountApis.contains(path) ||
  130:         _recommendApis.contains(path) ||
  131:         _grpcAccountApis.contains(grpcPath) ||
  132:         _grpcAccountPrefixes.any(grpcPath.startsWith)) {
  133:       return true;
  134:     }
  135:     final query = options.queryParameters;
  136:     final data = options.data;
  137:     // web writes are csrf-protected (some GET reads also carry csrf; they
  138:     // are not writes and stay anonymous)
  139:     if (options.method.toUpperCase() != 'GET' &&
  140:         (query.keys.any(_csrfKeys.contains) ||
  141:             (data is Map && data.keys.any(_csrfKeys.contains)) ||
  142:             (data is FormData &&
  143:                 data.fields.any((e) => _csrfKeys.contains(e.key))))) {
  144:       return true;
  145:     }
  146:     // reads scoped to the user themself (own space, own followings...)
  147:     final mid = Accounts.main.mid;
  148:     if (mid != 0) {
  149:       for (final key in _selfKeys) {
  150:         final v = query[key] ?? (data is Map ? data[key] : null);
  151:         if (v != null && '$v' == '$mid') return true;
  152:       }
  153:     }
  154:     return false;
  155:   }
  156: }

