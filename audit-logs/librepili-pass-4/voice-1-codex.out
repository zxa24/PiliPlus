    7: import 'package:flutter/foundation.dart';
    8: import 'package:logger/logger.dart';
    9: import 'package:path/path.dart' as p;
   10: 
   11: final logger = Logger(
   12:   filter: ProductionFilter(),
   13:   printer: PrettyLogPrinter(
   14:     dateTimeFormat: PrettyLogPrinter.toEncodableFallback,
   15:   ),
   16:   level: kDebugMode ? .trace : .warning,
   17: );
   18: 
   19: abstract final class LoggerUtils {
   20:   static File? _logFile;
   21: 
   22:   /// Logs above this size are dropped at start-up.
   23:   static const _maxLogSize = 2 * 1024 * 1024;
   24: 
   25:   static Future<File> getLogsPath() async {
   26:     if (_logFile != null) return _logFile!;
   27: 
   28:     // the app's own data dir (per profile), not the shared, often synced
   29:     // Documents folder, and a name of its own (upstream uses .pili_logs.json)
   30:     final String filename = p.join(appSupportDirPath, 'librepili_logs.json');
   31:     final File file = File(filename);
   32:     if (!file.existsSync()) {
   33:       await file.create(recursive: true);
   34:     } else if (await file.length() > _maxLogSize) {
   35:       await file.writeAsBytes(const [], flush: true);
   36:     }
   37:     return _logFile = file;
   38:   }
   39: 
   40:   static Future<bool> clearLogs() async {
   41:     try {
   42:       if (Pref.enableLog) {
   43:         await JsonFileHandler.add(
   44:           (raf) => raf.setPosition(0).then((raf) => raf.truncate(0)),
   45:         );
   46:       } else {
   47:         final file = await getLogsPath();
   48:         await file.writeAsBytes(const [], flush: true);
   49:       }
   50:     } catch (e) {
   51:       // if (kDebugMode) debugPrint('Error clearing file: $e');
   52:       return false;
   53:     }
   54:     return true;
   55:   }
   56: }

