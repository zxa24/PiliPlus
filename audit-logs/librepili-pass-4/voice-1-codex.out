   19: 
   20:   void checkIsEnd(int length) {}
   21: 
   22:   // bumped by every refresh: a response of an older request (a load-more or
   23:   // refresh still in flight) is dropped, so it can neither append a page to
   24:   // the new list nor advance [page]
   25:   int _generation = 0;
   26: 
   27:   @override
   28:   Future<void> queryData([bool isRefresh = true]) async {
   29:     if (!isRefresh && (isLoading || isEnd)) return;
   30:     final generation = isRefresh ? ++_generation : _generation;
   31:     isLoading = true;
   32:     final LoadingState<R> res = await customGetData();
   33:     if (generation != _generation) return;
   34:     if (res case Success(:final response)) {
   35:       if (!customHandleResponse(isRefresh, res)) {
   36:         final dataList = getDataList(response);
   37:         if (dataList == null || dataList.isEmpty) {
   38:           isEnd = true;
   39:           if (isRefresh) {
   40:             loadingState.value = Success(dataList);
   41:           } else if (hasFooter == true) {
   42:             loadingState.refresh();
   43:           }
   44:           isLoading = false;
   45:           return;
   46:         }
   47:         handleListResponse(dataList);
   48:         if (isRefresh) {
   49:           checkIsEnd(dataList.length);
   50:           loadingState.value = Success(dataList);
   51:         } else if (loadingState.value case Success(:final response)) {
   52:           response!.addAll(dataList);
   53:           checkIsEnd(response.length);
   54:           loadingState.refresh();
   55:         }
   56:       }
   57:       page++;
   58:     } else {
   59:       if (isRefresh && !handleError(res is Error ? res.errMsg : null)) {
   60:         loadingState.value = res as Error;
   61:       }
   62:     }
   63:     isLoading = false;
   64:   }
