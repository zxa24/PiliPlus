  152:               ..autoUncompress = false
  153:               // certificates are still verified; only the separate
  154:               // badCertificateCallback setting (HttpOverrides) skips it
  155:               ..findProxy = ((_) => 'PROXY $systemProxyHost:$systemProxyPort')
