   53:             }
   54:             (options..path = redirectUrl).maxRedirects--;
   55:             if (status == 303) {
   56:               options
   57:                 ..data = null
   58:                 ..method = 'GET';
   59:             }
   60:             _client
   61:                 .fetch(options)
   62:                 .then(
   63:                   (i) => handler.resolve(
   64:                     i
   65:                       ..redirects.add(
   66:                         RedirectRecord(status, options.method, uri),
   67:                       )
   68:                       ..isRedirect = true,
   69:                   ),
   70:                 )
   71:                 .onError<DioException>((error, _) => handler.next(error));
   72:             return;
   73:           }
   74:         }
   75:       }
   76:       return handler.next(err);
   77:     } else {
   78:       switch (err.type) {
   79:         case DioExceptionType.connectionError:
   80:         case DioExceptionType.connectionTimeout:
   81:         case DioExceptionType.sendTimeout:
   82:         case DioExceptionType.unknown:
   83:           // only idempotent reads are re-sent: a POST (like, coin, comment,
   84:           // follow...) may already have been applied by the server
   85:           final method = err.requestOptions.method.toUpperCase();
   86:           final extra = err.requestOptions.extra;
   87:           // a retry re-enters this interceptor through `_client.fetch`, so
   88:           // onError runs once per attempt on the same RequestOptions. Only
   89:           // the attempt the caller made (no `_rt` yet) passes the final
   90:           // error on, so the interceptors after this one — AccountManager's
   91:           // toast and cookie save — run exactly once, not once per retry.
   92:           final isRetryAttempt = extra.containsKey('_rt');
   93:           void finish(DioException error) =>
   94:               isRetryAttempt ? handler.reject(error) : handler.next(error);
   95:           if ((method == 'GET' || method == 'HEAD') &&
   96:               (extra['_rt'] ??= 0) < _count &&
   97:               err.error
   98:                   is! TransportConnectionException // 网络中断, 此时请求可能已经被服务器所接收
   99:                   ) {
  100:             Future.delayed(
  101:               Duration(milliseconds: ++extra['_rt'] * _delay),
  102:               () => _client
  103:                   .fetch(err.requestOptions)
  104:                   .then(handler.resolve)
  105:                   .onError<DioException>((error, _) => finish(error)),
  106:             );
  107:           } else {
  108:             finish(err);
  109:           }
  110:           return;
  111:         default:
  112:           return handler.next(err);
  113:       }
  114:     }
  115:   }
