    7: class _Ctr extends CommonListController<List<int>?, int> {
    8:   int calls = 0;
    9:   final pending = <Completer<LoadingState<List<int>?>>>[];
   10: 
   11:   @override
   12:   Future<LoadingState<List<int>?>> customGetData() {
   13:     calls++;
   14:     final c = Completer<LoadingState<List<int>?>>();
   15:     pending.add(c);
   16:     return c.future;
   17:   }
   18: 
   19:   void completeAll(List<int> data) {
   20:     for (final c in List.of(pending)) {
   21:       if (!c.isCompleted) c.complete(Success(data));
   22:     }
   23:     pending.clear();
   24:   }
   25: }
