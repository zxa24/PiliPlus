   22:   // bumped by every refresh: a response of an older request (a load-more or
   23:   // refresh still in flight) is dropped, so it can neither append a page to
   24:   // the new list nor advance [page]
   25:   int _generation = 0;
   26: 
   27:   // A refresh already in flight is shared instead of raced: a fast second
   28:   // pull would otherwise send a second request only to throw one away.
   29:   // [_generation] still drops a stale response when a new request *is* made.
   30:   Future<void>? _refreshing;
   31: 
   32:   // Set by [markRefreshStale]: the request parameters changed, so attaching
   33:   // to the refresh in flight would answer with data fetched for the old ones.
   34:   bool _refreshIsStale = false;
   35: 
   36:   /// Call before [onRefresh] when the next request differs from the one that
   37:   /// may still be in flight (a new search keyword, a sort order, a different
   38:   /// account): that one must not be attached to, it is answering the old
   39:   /// parameters. [onReload] does this itself.
   40:   void markRefreshStale() => _refreshIsStale = true;
   41: 
   42:   @override
   43:   Future<void> queryData([bool isRefresh = true]) {
   44:     if (!isRefresh) return _queryData(false);
   45:     final stale = _refreshIsStale;
   46:     _refreshIsStale = false;
   47:     final refreshing = _refreshing;
   48:     if (!stale && refreshing != null) return refreshing;
   49:     final future = _queryData(true);
   50:     _refreshing = future;
   51:     return future.whenComplete(() {
   52:       // a stale refresh that replaced this one owns the slot now
   53:       if (identical(_refreshing, future)) _refreshing = null;
   54:     });
   55:   }
   56: 
   57:   Future<void> _queryData(bool isRefresh) async {
   58:     if (!isRefresh && (isLoading || isEnd)) return;
   59:     final generation = isRefresh ? ++_generation : _generation;
   60:     isLoading = true;
   61:     final LoadingState<R> res = await customGetData();
   62:     if (generation != _generation) return;
   63:     if (res case Success(:final response)) {
   64:       if (!customHandleResponse(isRefresh, res)) {
   65:         final dataList = getDataList(response);
   66:         if (dataList == null || dataList.isEmpty) {
   67:           isEnd = true;
   68:           if (isRefresh) {
   69:             loadingState.value = Success(dataList);
   70:           } else if (hasFooter == true) {
   71:             loadingState.refresh();
   72:           }
   73:           isLoading = false;
   74:           return;
   75:         }
   76:         handleListResponse(dataList);
   77:         if (isRefresh) {
   78:           checkIsEnd(dataList.length);
   79:           loadingState.value = Success(dataList);
   80:         } else if (loadingState.value case Success(:final response)) {
   81:           response!.addAll(dataList);
   82:           checkIsEnd(response.length);
   83:           loadingState.refresh();
   84:         }
   85:       }
   86:       page++;
   87:     } else {
   88:       if (isRefresh && !handleError(res is Error ? res.errMsg : null)) {
   89:         loadingState.value = res as Error;
   90:       }
   91:     }
   92:     isLoading = false;
   93:   }
   94: 
   95:   @override
   96:   Future<void> onRefresh() {
   97:     page = 1;
   98:     isEnd = false;
   99:     return super.onRefresh();
  100:   }
  101: 
  102:   @override
  103:   Future<void> onReload() {
  104:     markRefreshStale();
  105:     loadingState.value = LoadingState<List<T>?>.loading();
  106:     return super.onReload();
  107:   }
  108: }

