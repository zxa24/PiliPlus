  228:   /// Hosts a block server may never be set to: matching one would make
  229:   /// [_skipCookie] true for the API itself and strip the account off every
  230:   /// request (the U5 catastrophe). Suffix-matched, so subdomains count.
  231:   static const _reservedHosts = [
  232:     'bilibili.com',
  233:     'bilibili.cn',
  234:     'bilibili.tv',
  235:     'bilivideo.com',
  236:     'bilivideo.cn',
  237:     'hdslb.com',
  238:     'biliimg.com',
  239:     'b23.tv',
  240:   ];
  241: 
  242:   /// The parsed [blockServer] when it is usable, else null. A block server is
  243:   /// `http(s)://host[:port][/prefix]` on a host that is not bilibili's.
  244:   /// Anything else is refused here *and* by the settings dialog, so
  245:   /// [_isBlockServer] can never degrade into "matches everything".
  246:   static Uri? parseBlockServer(String value) {
  247:     final uri = Uri.tryParse(value.trim());
  248:     if (uri == null ||
  249:         !(uri.isScheme('http') || uri.isScheme('https')) ||
  250:         uri.host.isEmpty ||
  251:         uri.userInfo.isNotEmpty) {
  252:       return null;
  253:     }
  254:     final host = uri.host.toLowerCase();
  255:     for (final reserved in _reservedHosts) {
  256:       if (host == reserved || host.endsWith('.$reserved')) return null;
  257:     }
  258:     return uri;
  259:   }
  260: 
  261:   static bool _isBlockServer(String path) {
  262:     // scheme + host + port + path prefix, and never a bilibili host: a
  263:     // host-only match on `https://api.bilibili.com/sb` would strip the
  264:     // cookies off every API request, and a raw prefix match would match
  265:     // everything when the saved address is empty or too short.
  266:     final server = parseBlockServer(blockServer);
  267:     if (server == null) return false;
  268:     final uri = Uri.tryParse(path);
  269:     if (uri == null ||
  270:         uri.scheme.toLowerCase() != server.scheme ||
  271:         uri.host.toLowerCase() != server.host.toLowerCase() ||
  272:         uri.port != server.port) {
  273:       return false;
  274:     }
  275:     final prefix = server.path.replaceAll(RegExp(r'/+$'), '');
  276:     return prefix.isEmpty ||
  277:         uri.path == prefix ||
  278:         uri.path.startsWith('$prefix/');
  279:   }
  280: 
  281:   static bool _skipCookie(String path) {
  282:     return _isBlockServer(path) ||
  283:         path.contains('hdslb.com') ||
  284:         path.contains('biliimg.com');
  285:   }
