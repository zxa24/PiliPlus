    7: /// Writes bits MSB first, with Exp-Golomb helpers (for building an SPS).
    8: class _Bits {
    9:   final _out = <int>[];
   10:   int _cur = 0;
   11:   int _n = 0;
   12: 
   13:   void bit(int b) {
   14:     _cur = (_cur << 1) | (b & 1);
   15:     if (++_n == 8) {
