   45:   /// LibrePili: pages in the in-app WebView are anonymous. Removes the stored
   46:   /// accounts' cookies (e.g. installed by an older build) and installs the
   47:   /// anonymous jar; account cookies go in only for explicit account flows
   48:   /// (the "reset cookie" menu, taking notes).
   49:   static FutureOr setAnonymousWebCookie() async {
   50:     // Linux (WebKitGTK via desktop_webview_window) has no set-cookie API and
   51:     // no jar to seed between windows: [clearWebCookies] drops the shared
   52:     // store, and every window opened afterwards injects the anonymous buvid3
   53:     // itself at documentStart (WebviewPage.openLinux ->
   54:     // LinuxCookieManager.generateCookieInjectionJs with AnonymousAccount).
   55:     if (Platform.isLinux) return null;
   56:     final webManager = web.CookieManager.instance(
   57:       webViewEnvironment: webViewEnvironment,
   58:     );
   59:     await Future.wait([
   60:       for (final account in Accounts.account.values)
   61:         for (final cookie in account.cookieJar.toList())
   62:           webManager.deleteCookie(
   63:             url: web.WebUri(
   64:               '${Platform.isWindows ? 'https://' : ''}${cookie.domain}',
   65:             ),
   66:             name: cookie.name,
   67:             path: cookie.path ?? '/',
   68:             domain: cookie.domain,
   69:           ),
   70:     ]);
   71:     return setWebCookie(AnonymousAccount());
   72:   }
