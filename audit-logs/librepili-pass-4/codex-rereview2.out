  117:   /// Account secrets a body may carry (see AccountManager) and the
  118:   /// signatures computed over them: worthless at another origin, and the
  119:   /// account's to keep.
  120:   static const _bodySecrets = [
  121:     'access_key',
  122:     'mobile_access_key',
  123:     'csrf',
  124:     'csrf_token',
  125:     'biliCSRF',
  126:     'sign',
  127:     'w_rid',
