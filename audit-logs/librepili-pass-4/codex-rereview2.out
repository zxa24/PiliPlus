    3: /// LibrePili: pure-Dart FLV demuxer feeding [Mp4Remuxer]'s progressive MP4
    4: /// writer, for the old single-URL (durl) downloads.
    5: ///
    6: /// FLV AVC payloads are already length-prefixed NAL units and AAC payloads
    7: /// raw frames, which is exactly what MP4 samples hold, so sample bytes are
    8: /// never decoded: every sample becomes a chunk pointing into its FLV file and
    9: /// is copied byte-for-byte. H.264 / HEVC video (legacy codec id 7 / 12, or
   10: /// enhanced FLV with the `avc1` / `hvc1` FourCC) and AAC audio are
   11: /// supported; a codec configuration that changes mid-stream or between
   12: /// segments becomes another sample entry. Anything else throws
   13: /// [UnsupportedError].
   14: abstract final class _FlvDemuxer {
   15:   /// A segment starting more than this before the end of what came earlier
   16:   /// restarted its clock and is placed after it; a continuing segment starts
   17:   /// within about a frame of that end.
   18:   static const _restartToleranceMs = 100;
   19: 
   20:   /// [strict]: a tag cut off by the end of the file throws
   21:   /// [FormatException] (a damaged download) instead of being dropped.
   22:   static List<_Track> demux(List<String> inputs, {bool strict = false}) {
   23:     final video = _FlvTrackBuilder(isVideo: true);
   24:     final audio = _FlvTrackBuilder(isVideo: false);
   25:     for (final input in inputs) {
   26:       final raf = File(input).openSync();
   27:       try {
   28:         final r = _FileReader(raf);
   29:         final header = r.read(0, 9);
   30:         if (String.fromCharCodes(header, 0, 3) != 'FLV') {
   31:           throw FormatException('not an FLV file: $input');
   32:         }
   33:         // header, then PreviousTagSize0
   34:         var pos = ByteData.sublistView(header).getUint32(5) + 4;
   35:         int? offset; // ms added to this segment's timestamps
  170:     // one track holds one codec (players switch configuration, not codec)
  171:     if (codec != c) {
  172:       throw UnsupportedError('FLV video codec changes ($codec -> $c)');
  173:     }
  174:   }
  175: 
  176:   void addAudioTag(
  177:     String path,
  178:     int dataPos,
  179:     int dataSize,
  180:     Uint8List head,
  181:     int time,
  182:     _FileReader r,
  183:   ) {
  184:     final format = head[0] >> 4;
  185:     if (format != 10) {
  186:       throw UnsupportedError('FLV audio codec $format (only AAC)');
  187:     }
  188:     if (dataSize <= 2) return;
  189:     switch (head[1]) {
  190:       case 0: // AudioSpecificConfig
  191:         _setConfig(r.read(dataPos + 2, dataSize - 2));
  192:       case 1: // raw frame
  193:         _add(path, dataPos + 2, dataSize - 2, time, 0, true);
  194:     }
  195:   }
  196: 
  197:   /// Repeated at segment starts (same bytes: nothing changes); a different
  198:   /// configuration (resolution / profile / sample rate change) becomes a
  199:   /// new sample entry for the samples that follow.
  200:   void _setConfig(Uint8List c) {
  201:     for (var i = 0; i < configs.length; i++) {
  202:       if (_sameBytes(configs[i], c)) {
  203:         _current = i;
  204:         return;
  205:       }
  206:     }
  207:     configs.add(Uint8List.fromList(c));
  208:     _current = configs.length - 1;
  209:   }
  210: 
  211:   void _add(String path, int offset, int size, int time, int cts, bool key) {
  212:     if (_current < 0) return; // undecodable before the sequence header
  213:     if (times.isNotEmpty && time <= times.last) time = times.last + 1;
  214:     configIndex.add(_current);
  215:     times.add(time);
  216:     ctsMs.add(cts);
  217:     keys.add(key);
  218:     paths.add(path);
  219:     offsets.add(offset);
  220:     sizes.add(size);
  221:   }
  222: 
  223:   /// [baseMs]: earliest start of all tracks; a later start becomes an empty
  224:   /// edit so audio and video stay in sync.
  225:   _Track? build(int baseMs) {
  226:     if (configs.isEmpty || sizes.isEmpty) return null;
  227:     final config = configs.first;
  228:     final t = _Track(paths.first)
  229:       ..sourceMovieTimescale = 1000
  230:       ..tkhdFlags = 0
  231:       ..mdhdLanguage =
  232:           Uint8List.fromList([0x55, 0xC4]) // und
  233:       ..dinf = _box(
  234:         'dinf',
  235:         _box(
  236:           'dref',
  237:           (_W()
  238:                 ..u32(0)
  239:                 ..u32(1)
  240:                 ..bytes_(_box('url ', (_W()..u32(1)).bytes)))
  250:         ..mediaHeader = _box(
  251:           'vmhd',
  252:           (_W()
  253:                 ..u32(1)
  254:                 ..zeros(8))
  255:               .bytes,
  256:         )
  257:         ..tkhdTail = _tkhdTail(0, width, height);
  258:     } else {
  259:       final (rate, _) = _aacFormat(config);
  260:       t
  261:         ..timescale = rate
  262:         ..sampleEntryType = 'mp4a'
  263:         ..hdlr = _hdlr('soun', 'SoundHandler')
  264:         ..mediaHeader = _box('smhd', (_W()..zeros(8)).bytes)
  265:         ..tkhdTail = _tkhdTail(0x0100, 0, 0);
  266:     }
  267:     final entries = [for (final c in configs) _sampleEntry(c)];
  268:     t.stsd = _stsdOf(entries);
  269:     if (entries.length > 1) t.sampleEntries = entries;
  270: 
  271:     final ts = t.timescale;
  272:     final first = times.first;
  273:     final dts = [for (final ms in times) _scale(ms - first, 1000, ts)];
  274:     // Samples are grouped into chunks of about a second, the way the
  275:     // fragmented-MP4 path does, so the sample tables stay small (one `stco`
  276:     // entry per chunk, not per sample). FLV samples are payloads of separate
  277:     // tags with the other track's tags in between, so a chunk lists its
  278:     // samples' ranges one by one: what has to be contiguous is the chunk's
  279:     // place in the *output* file, not in its source.
  280:     final maxChunk = (Mp4Remuxer._maxChunkSeconds * ts).round();
  281:     _Chunk? chunk;
  282:     for (var i = 0; i < dts.length; i++) {
  283:       final dur = i + 1 < dts.length
  284:           ? dts[i + 1] - dts[i]
  285:           : (i > 0
  286:                 ? dts[i] - dts[i - 1]
  287:                 : _scale(_defaultDurationMs, 1000, ts));
  288:       final descIndex = configIndex[i] + 1;
  289:       // a chunk holds one sample description and comes from one file
  290:       if (chunk == null ||
  291:           chunk.descIndex != descIndex ||
  292:           chunk.sourcePath != paths[i] ||
  293:           dts[i] - chunk.startDts >= maxChunk) {
  294:         chunk = _Chunk(t, offsets[i], i, dts[i], paths[i])
  295:           ..descIndex = descIndex
  296:           ..ranges = <(int, int)>[];
  297:         t.chunks.add(chunk);
  298:       }
  299:       chunk
  300:         ..ranges!.add((offsets[i], sizes[i]))
  301:         ..length += sizes[i]
  302:         ..sampleCount += 1;
  303:       t
  304:         ..durations.add(dur)
  305:         ..sizes.add(sizes[i])
  306:         ..ctos.add(_scale(ctsMs[i], 1000, ts))
  307:         ..syncs.add(keys[i]);
  308:     }
  309:     if (first > baseMs) {
  310:       t.edits
  311:         ..add(_EditEntry(first - baseMs, -1, 0x10000))
  312:         ..add(_EditEntry(0, 0, 0x10000));
  313:     }
  314:     return t;
  315:   }
  316: 
  317:   /// The sample entry for one codec configuration of this track.
  318:   Uint8List _sampleEntry(Uint8List config) {
  319:     if (isVideo) {
  320:       final (width, height) = _videoDimensions(config);
  321:       final hevc = codec == 'hvc1';
  322:       return _box(
  323:         codec!,
  324:         (_W()
  325:               ..zeros(6)
  350:             ..zeros(4)
  351:             ..u32(rate <= 0xFFFF ? rate << 16 : 0)
  352:             ..bytes_(_esds(config)))
  353:           .bytes,
  354:     );
  355:   }
  356: 
  357:   /// Picture size for the sample entry and track header; (0, 0) when it
  358:   /// cannot be read.
  359:   (int, int) _videoDimensions(Uint8List config) =>
  360:       codec == 'hvc1' ? _hevcDimensions(config) : _avcDimensions(config);
  361: 
  362:   /// Conformance-window size from the first SPS of an HEVC configuration
  363:   /// record (H.265 7.3.2.2.1); (0, 0) if it cannot be read.
  364:   static (int, int) _hevcDimensions(Uint8List hvcC) {
  365:     try {
  366:       var p = 23;
  367:       for (var a = 0; a < hvcC[22]; a++) {
  368:         final type = hvcC[p] & 0x3F;
  369:         final n = (hvcC[p + 1] << 8) | hvcC[p + 2];
  370:         p += 3;
  371:         for (var i = 0; i < n; i++) {
  372:           final len = (hvcC[p] << 8) | hvcC[p + 1];
  373:           if (type == 33) {
  374:             return _hevcSpsDimensions(
  375:               Uint8List.sublistView(hvcC, p + 2, p + 2 + len),
  376:             );
  377:           }
  378:           p += 2 + len;
  379:         }
  380:       }
  381:     } catch (_) {}
  382:     return (0, 0);
  383:   }
  384: 
  385:   static (int, int) _hevcSpsDimensions(Uint8List nal) {
  386:     // skip sps_video_parameter_set_id (4 bits)
  387:     final b = _BitReader(_rbsp(nal, 2))..bits(4);
  388:     final maxSubLayersMinus1 = b.bits(3);
  389:     b
  390:       ..bit() // temporal_id_nesting
  391:       ..bits(32) // general profile space / tier / idc + 24 compat bits
  392:       ..bits(8) // rest of the compatibility flags
  393:       ..bits(32) // source / constraint flags ...
  394:       ..bits(16) // ... (48 bits in all)
  395:       ..bits(8); // general_level_idc
  396:     final profilePresent = <bool>[];
  397:     final levelPresent = <bool>[];
  398:     for (var i = 0; i < maxSubLayersMinus1; i++) {
  399:       profilePresent.add(b.bit() == 1);
  400:       levelPresent.add(b.bit() == 1);
  401:     }
  402:     if (maxSubLayersMinus1 > 0) {
  403:       for (var i = maxSubLayersMinus1; i < 8; i++) {
  404:         b.bits(2);
  405:       }
  406:     }
  407:     for (var i = 0; i < maxSubLayersMinus1; i++) {
  408:       if (profilePresent[i]) {
  409:         b
  410:           ..bits(32)
  411:           ..bits(32)
  412:           ..bits(24); // 88 bits
  413:       }
  414:       if (levelPresent[i]) b.bits(8);
  415:     }
  416:     b.ue(); // sps_seq_parameter_set_id
  417:     final chroma = b.ue();
  418:     final separate = chroma == 3 && b.bit() == 1;
  419:     var width = b.ue();
  420:     var height = b.ue();
  421:     if (b.bit() == 1) {
  422:       final left = b.ue();
  423:       final right = b.ue();
  424:       final top = b.ue();
  425:       final bottom = b.ue();
  426:       final subW = !separate && (chroma == 1 || chroma == 2) ? 2 : 1;
  427:       final subH = !separate && chroma == 1 ? 2 : 1;
  428:       width -= subW * (left + right);
  429:       height -= subH * (top + bottom);
  430:     }
  431:     return (width, height);
  432:   }
  433: 
  434:   /// RBSP of a NAL unit: without its [headerBytes] and the emulation
  435:   /// prevention bytes (00 00 03).
  436:   static Uint8List _rbsp(Uint8List nal, int headerBytes) {
  437:     final rbsp = <int>[];
  438:     var zeros = 0;
  439:     for (var i = headerBytes; i < nal.length; i++) {
  440:       final v = nal[i];
  441:       if (zeros >= 2 && v == 3) {
  442:         zeros = 0;
  443:         continue;
  444:       }
  445:       zeros = v == 0 ? zeros + 1 : 0;
  446:       rbsp.add(v);
  447:     }
  448:     return Uint8List.fromList(rbsp);
  449:   }
  450: 
  451:   static Uint8List _tkhdTail(int volume, int width, int height) {
  452:     final w = _W()
  453:       ..zeros(8)
  454:       ..u16(0) // layer
  455:       ..u16(0) // alternate group
--- lib/utils/mp4_remux.dart
    1: import 'dart:io';
    2: import 'dart:math' show max, min;
    3: import 'dart:typed_data';
    4: 
    5: part 'flv_demux.dart';
    6: part 'mp4_join.dart';
    7: 
    8: /// Losslessly merges single-track fragmented MP4 inputs (bilibili DASH
    9: /// `video.m4s` / `audio.m4s`) into one progressive MP4 with `moov` placed
   10: /// before `mdat` (fast start).
   11: ///
   12: /// Sample data is copied byte-for-byte, codec configuration (`stsd`) and edit
   13: /// lists are carried over, so any codec the inputs carry (AVC / HEVC / AV1 /
   14: /// AAC ...) is supported. Pure Dart, no Flutter dependency: safe to run inside
   15: /// `Isolate.run`.
   16: abstract final class Mp4Remuxer {
   17:   static const _movieTimescale = 1000;
   18:   static const _maxChunkSeconds = 1.0;
   19:   static const _copyBufferSize = 4 << 20;
   20:   static const _readWindowSize = 1 << 20;
   21: 
   22:   static Future<void> remux({
   23:     required List<String> inputs,
   24:     required String output,
   25:     void Function(int copied, int total)? onProgress,
   26:   }) async {
   27:     if (inputs.isEmpty) throw ArgumentError('no input');
   28:     final tracks = <_Track>[];
   29:     for (final input in inputs) {
   30:       tracks.add(
   31:         await _Track.parse(input)
   32:           ..index = tracks.length,
   33:       );
   34:     }
   35:     await _write(tracks, output, onProgress);
  170:       c.outputOffset = offset;
  171:       offset += c.length;
  172:     }
  173:     final moov = _moov(tracks, useCo64);
  174:     assert(moov.length == moovSize);
  175: 
  176:     final tmp = File('$output.part');
  177:     final out = await tmp.open(mode: FileMode.write);
  178:     final sources = <String, RandomAccessFile>{};
  179:     final windows = <String, _ReadWindow>{};
  180:     try {
  181:       await out.writeFrom(ftyp);
  182:       await out.writeFrom(moov);
  183:       final mdatHeader = _W();
  184:       if (mdatHeaderSize == 16) {
  185:         mdatHeader
  186:           ..u32(1)
  187:           ..fourcc('mdat')
  188:           ..u64(payloadSize + 16);
  189:       } else {
  190:         mdatHeader
  191:           ..u32(payloadSize + 8)
  192:           ..fourcc('mdat');
  193:       }
  194:       await out.writeFrom(mdatHeader.bytes);
  195: 
  196:       // Sample bytes go through buffers on both sides: a chunk is one sample
  197:       // in an FLV, so a read and a write per chunk is hundreds of thousands
  198:       // of round-trips for a long video. Chunks run forward through each
  199:       // source, so a window that slides forward serves nearly all of them
  200:       // from memory.
  201:       final outBuf = Uint8List(_copyBufferSize);
  202:       var outLen = 0;
  203:       var copied = 0;
  204: 
  205:       Future<void> flushOut() async {
  206:         if (outLen > 0) {
  207:           await out.writeFrom(outBuf, 0, outLen);
  208:           outLen = 0;
  209:         }
  210:       }
  211: 
  212:       Future<void> putBytes(Uint8List bytes, int start, int end) async {
  213:         var i = start;
  214:         while (i < end) {
  215:           if (outLen == outBuf.length) await flushOut();
  216:           final n = min(end - i, outBuf.length - outLen);
  217:           outBuf.setRange(outLen, outLen + n, bytes, i);
  218:           outLen += n;
  219:           i += n;
  220:           copied += n;
  221:         }
  222:       }
  223: 
  224:       Future<void> copyRange(
  225:         RandomAccessFile src,
  226:         _ReadWindow win,
  227:         String from,
  228:         int offset,
  229:         int length,
  230:       ) async {
  231:         if (length <= 0) return;
  232:         if (length >= win.buf.length) {
  233:           // bigger than the window: stream it straight through
  234:           await flushOut();
  235:           await src.setPosition(offset);
  236:           win.length = 0; // the window's bytes are no longer what it says
  237:           var left = length;
  238:           while (left > 0) {
  239:             final n = await src.readInto(
  240:               win.buf,
  250:         }
  251:         if (offset < win.start || offset + length > win.start + win.length) {
  252:           await src.setPosition(offset);
  253:           final n = await src.readInto(win.buf);
  254:           if (n < length) throw FormatException('unexpected EOF in $from');
  255:           win
  256:             ..start = offset
  257:             ..length = n;
  258:         }
  259:         final at = offset - win.start;
  260:         await putBytes(win.buf, at, at + length);
  261:       }
  262: 
  263:       for (final c in chunks) {
  264:         final src = sources[c.sourcePath] ??= await File(
  265:           c.sourcePath,
  266:         ).open();
  267:         final win = windows[c.sourcePath] ??= _ReadWindow();
  268:         final prefix = c.prefix;
  269:         if (prefix != null) {
  270:           await putBytes(prefix, 0, prefix.length);
  271:         }
  272:         if (c.ranges case final ranges?) {
  273:           for (final (offset, length) in ranges) {
  274:             await copyRange(src, win, c.sourcePath, offset, length);
  275:           }
  276:         } else {
  277:           await copyRange(
  278:             src,
  279:             win,
  280:             c.sourcePath,
  281:             c.sourceOffset,
  282:             c.length - (prefix?.length ?? 0),
  283:           );
  284:         }
  285:         onProgress?.call(copied, payloadSize);
  286:       }
  287:       await flushOut();
  288:     } catch (_) {
  289:       await out.close();
  290:       for (final s in sources.values) {
  291:         await s.close();
  292:       }
  293:       if (tmp.existsSync()) await tmp.delete();
  294:       rethrow;
  295:     }
  296:     await out.close();
  297:     for (final s in sources.values) {
  298:       await s.close();
  299:     }
  300:     final dest = File(output);
  301:     if (dest.existsSync()) await dest.delete();
  302:     await tmp.rename(output);
  303:   }
  304: 
  305:   static Uint8List _ftyp(List<_Track> tracks) {
  306:     final brands = <String>{'isom', 'iso2', 'mp41'};
  307:     for (final t in tracks) {
  308:       final fmt = t.sampleEntryType;
  309:       if (fmt == 'avc1' || fmt == 'avc3') brands.add('avc1');
  310:       if (fmt == 'av01') brands.add('av01');
  311:     }
  312:     final w = _W()
  313:       ..fourcc('isom')
  314:       ..u32(0x200);
  315:     brands.forEach(w.fourcc);
  316:     return _box('ftyp', w.bytes);
  317:   }
  318: 
  319:   static Uint8List _moov(List<_Track> tracks, bool useCo64) {
  320:     final traks = <Uint8List>[];
  321:     var movieDuration = 0;
  322:     for (var i = 0; i < tracks.length; i++) {
  323:       final t = tracks[i];
  324:       final trackDuration = t.movieDuration;
  325:       movieDuration = max(movieDuration, trackDuration);
  350:       ..u32(tracks.length + 1);
  351:     return _box('moov', _concat([_box('mvhd', mvhd.bytes), ...traks]));
  352:   }
  353: }
  354: 
  355: final _unityMatrix = () {
  356:   final w = _W();
  357:   for (final v in [0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000]) {
  358:     w.u32(v);
  359:   }
  360:   return w.bytes;
  361: }();
  362: 
  363: class _Chunk {
  364:   _Chunk(
  365:     this.track,
  366:     this.sourceOffset,
  367:     this.firstSample,
  368:     this.startDts, [
  369:     String? sourcePath,
  370:   ]) : sourcePath = sourcePath ?? track.path;
  371:   final _Track track;
  372: 
  373:   /// File the chunk's bytes are read from (FLV input: one per segment).
  374:   final String sourcePath;
  375:   final int sourceOffset;
  376:   final int firstSample;
  377:   final int startDts;
  378:   int length = 0;
  379:   int sampleCount = 0;
  380:   int outputOffset = 0;
  381: 
  382:   /// `(offset, length)` of this chunk's sample bytes in [sourcePath], in
  383:   /// output order. Null when the samples are one contiguous run starting at
  384:   /// [sourceOffset], as in a fragmented MP4. An FLV's samples are payloads
  385:   /// of separate tags with the other track's tags in between, so they are
  386:   /// listed one by one: a chunk has to be contiguous in the *output* file
  387:   /// (`stco` names one offset for it), not in its source.
  388:   List<(int, int)>? ranges;
  389: 
  390:   /// 1-based index of the sample entry (in `stsd`) its samples use.
  391:   int descIndex = 1;
  392: 
  393:   /// Bytes written before the source bytes (counted in [length] and in the
  394:   /// first sample's size): in-band parameter sets at a configuration switch.
  395:   Uint8List? prefix;
  396:   double get startSeconds => startDts / track.timescale;
  397: }
  398: 
  399: /// A block of one source file held in memory, so the many small reads a
  400: /// chunk list makes (one sample each, in increasing offset order) mostly
  401: /// come out of it instead of hitting the file.
  402: class _ReadWindow {
  403:   final Uint8List buf = Uint8List(Mp4Remuxer._readWindowSize);
  404: 
  405:   /// Offset in the source [buf] starts at, and how much of it is filled.
  406:   int start = 0;
  407:   int length = 0;
  408: }
  409: 
  410: class _EditEntry {
  411:   _EditEntry(this.segmentDuration, this.mediaTime, this.rate);
  412:   int segmentDuration; // in source movie timescale; 0 = until end
  413:   final int mediaTime; // in media timescale; -1 = empty edit
  414:   final int rate;
  415: }
  416: 
  417: class _Track {
  418:   _Track(this.path);
  419:   final String path;
  420:   int index = 0;
  421: 
  422:   late int timescale;
  423:   late int sourceMovieTimescale;
  424:   late String sampleEntryType;
  425:   late Uint8List tkhdTail; // layer .. height, copied verbatim
  426:   late int tkhdFlags;
  427:   late Uint8List mdhdLanguage;
  428:   late Uint8List hdlr;
  429:   late Uint8List mediaHeader; // vmhd / smhd / nmhd
  430:   late Uint8List dinf;
  431:   late Uint8List stsd;
  432: 
  433:   /// Set when the track carries several codec configurations (segments /
  434:   /// a stream whose configuration changes): `stsd` is then built from these
  435:   /// sample entries and each chunk points at its own with
  436:   /// [_Chunk.descIndex].
  437:   List<Uint8List>? sampleEntries;
  438: 
  439:   /// The `stsd` box written to the output.
  440:   Uint8List get stsdBox =>
  441:       sampleEntries == null ? stsd : _stsdOf(sampleEntries!);
  442: 
  443:   bool _inlined = false;
  444: 
  445:   /// HEVC with several configurations: the switch to another sample entry
  446:   /// is only signalled through the container, which FFmpeg's
  447:   /// `hevc_mp4toannexb` (the MediaCodec path) ignores, so the new frames
  448:   /// would be decoded with the first VPS/SPS/PPS. The first sample after
  449:   /// each switch therefore also carries its configuration's parameter sets
  450:   /// in-band, and the entries become `hev1` (parameter sets may be in-band).
  451:   void _inlineParameterSets() {
  452:     final entries = sampleEntries;
  453:     if (_inlined || entries == null || entries.length < 2) return;
  454:     if (sampleEntryType != 'hvc1' && sampleEntryType != 'hev1') return;
  455:     _inlined = true;
