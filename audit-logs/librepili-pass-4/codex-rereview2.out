  130:   static void _scrubBody(RequestOptions options) {
  131:     switch (options.data) {
  132:       case final Map data:
  133:         data.removeWhere((key, _) => _bodySecrets.contains(key));
  134:       case final FormData data:
  135:         data.fields.removeWhere((e) => _bodySecrets.contains(e.key));
  136:     }
  137:   }
