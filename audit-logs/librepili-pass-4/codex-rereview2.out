   28:   static String getCookies(List<Cookie> cookies) {
   29:     // Sort cookies by path (longer path first).
   30:     cookies.sort((a, b) {
   31:       if (a.path == null && b.path == null) {
   32:         return 0;
   33:       } else if (a.path == null) {
   34:         return -1;
   35:       } else if (b.path == null) {
   36:         return 1;
   37:       } else {
   38:         return b.path!.length.compareTo(a.path!.length);
   39:       }
   40:     });
   41:     return cookies.map((cookie) => '${cookie.name}=${cookie.value}').join('; ');
   42:   }
