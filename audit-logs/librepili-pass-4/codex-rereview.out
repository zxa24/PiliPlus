--- lib/utils/accounts/login_policy.dart
    1: import 'package:PiliPlus/grpc/url.dart';
    2: import 'package:PiliPlus/http/api.dart';
    3: import 'package:PiliPlus/http/constants.dart';
    4: import 'package:PiliPlus/utils/accounts.dart';
    5: import 'package:PiliPlus/utils/accounts/account.dart';
    6: import 'package:PiliPlus/utils/storage_pref.dart';
    7: import 'package:dio/dio.dart';
    8: 
    9: /// LibrePili privacy model: incognito by default, login is opt-in, and even
   10: /// in login mode the account is attached only to requests that need it.
   11: ///
   12: /// In login mode the home "推荐" feed (and its "不感兴趣" feedback) uses the
   13: /// account assigned to the recommend role, so the feed is personalised; with
   14: /// that role left anonymous it stays anonymous. Everything else (search,
   15: /// other home tabs, video info, comments, spaces...) is sent anonymously so
   16: /// it cannot be tied to the account. Incognito: everything is anonymous.
   17: abstract final class LoginPolicy {
   18:   /// Opt-in switch. Off: every account role is anonymous (stored accounts
   19:   /// stay dormant). On: see [requiresAccount].
   20:   static bool get loginMode => Pref.loginMode;
   21: 
   22:   /// Account-private reads, app-API writes (signed with access_key instead of
   23:   /// csrf), login-flow calls and stream URLs (high quality needs an account).
   24:   static const Set<String> _accountApis = {
   25:     // stream (1080P+ / VIP quality)
   26:     Api.ugcUrl, Api.pgcUrl, Api.pugvUrl, Api.tvPlayUrl,
   27:     // account info
   28:     Api.userInfo, Api.userStatOwner, Api.getCoin, Api.coinLog, Api.loginLog,
   29:     Api.expLog, Api.moralLog, Api.loginDevices, Api.userRealName,
   30:     Api.myEmote, Api.spaceSetting,
   31:     // own profile (账号资料) page: read + app-API edits (access_key, no csrf)
   32:     '${HttpString.appBaseUrl}/x/v2/account/myinfo',
   33:     '/x/member/app/uname/update', '/x/member/app/sign/update',
   34:     '/x/member/app/sex/update', '/x/member/app/birthday/update',
   35:     // relation to the current user
   36:     Api.pgcLikeCoinFav,
   37:     Api.videoRelation, Api.seasonStatus, Api.relation, Api.relations,
   38:     Api.mutualRelation,
   39:     Api.sameFollowing, Api.followedUp, Api.followSearch, Api.blackLst,
   40:     Api.followUpTag, Api.followUpGroup, Api.danmakuFilter,
   41:     Api.replyInteraction, Api.danmakuEditState,
   42:     // own favorites / later / history
   43:     Api.favFolder, Api.userFavFolder, Api.favFolderInfo, Api.userSubFolder,
   44:     Api.favPgc, Api.favArticle, Api.favPugv, Api.favTopicList,
   45:     Api.favSeasonList, Api.seeYouLater, Api.historyList, Api.historyStatus,
   46:     // folder contents (private folders) and watch-later / fav "play all"
   47:     Api.favResourceList, Api.mediaList,
   48:     Api.searchHistory, Api.noteList, Api.archiveNote, Api.userNoteList,
   49:     // playback history reporting
   50:     Api.heartBeat, Api.historyReport, Api.roomEntryAction,
   51:     Api.mediaListHistory, Api.liveLikeReport,
   52:     // followed feed
   53:     Api.followUp, Api.dynUplist, Api.followDynamic, Api.getUnreadDynamic,
   54:     Api.liveFollow, Api.getLiveFavTag, Api.followeeVotes,
   55:     // saving the favourite live areas (app-API write, access_key only)
   56:     Api.setLiveFavTag,
   57:     // messages
   58:     Api.msgUnread, Api.msgFeedUnread, Api.msgFeedReply, Api.msgFeedAt,
   59:     Api.msgFeedLike, Api.msgLikeDetail, Api.msgSysNotify,
   60:     Api.msgSysUpdateCursor, Api.sessionList, Api.sessionAccountList,
   61:     Api.sessionMsg, Api.ackSessionMsg, Api.imUserInfos, Api.getSessionSs,
   62:     Api.getMsgDnd,
   63:     // app-API writes (access_key, no csrf)
   64:     Api.likeVideo, Api.dislikeVideo, Api.coinVideo,
   65:     // login flow
   66:     Api.qrcodeConfirm, Api.logout, Api.activateBuvidApi,
   67:   };
   68: 
   69:   /// The home "推荐" feed and its dislike feedback (user decision: not
   70:   /// anonymous in login mode). Bound to the recommend role's account (see
   71:   /// ApiType), which may itself be anonymous.
   72:   static const Set<String> _recommendApis = {
   73:     Api.recommendListApp,
   74:     Api.recommendListWeb,
   75:     Api.feedDislike,
   76:     Api.feedDislikeCancel,
   77:     // 直播「不感兴趣」: signed with the recommend role's access_key
   78:     Api.liveFeedback,
   79:   };
   80: 
   81:   static const Set<String> _grpcAccountApis = {
   82:     GrpcUrl.dynRed,
   83:     GrpcUrl.audioPlayUrl,
   84:     // 听视频 of a favourite folder / watch later: account-scoped lists
   85:     GrpcUrl.audioPlayList,
   86:     GrpcUrl.audioThumbUp,
   87:     GrpcUrl.audioTripleLike,
   88:     GrpcUrl.audioCoinAdd,
   89:   };
   90: 
   91:   static const List<String> _grpcAccountPrefixes = [GrpcUrl.im, GrpcUrl.im2];
   92: 
   93:   static const _csrfKeys = {'csrf', 'biliCSRF', 'csrf_token'};
   94:   static const _selfKeys = ['mid', 'vmid', 'up_mid'];
   95: 
   96:   /// Whether UI that writes (comments, replies, danmaku, live chat) is
   97:   /// shown: it needs a logged-in account and the "hide interaction" switch
   98:   /// off. Existing comments and danmaku are displayed either way.
   99:   static bool get canInteract => Accounts.main.isLogin && !Pref.hideInteraction;
  100: 
  101:   /// `options.extra[explicitAccount] = true`: the call site must go out as
  102:   /// the account it passed in `extra['account']` although the path is not
  103:   /// on the lists (e.g. the comment check's "seen as the account" half,
  104:   /// compared with an anonymous request). Honoured in login mode only.
  105:   static const explicitAccount = 'explicitAccount';
  106: 
  107:   /// The account [options] goes out with: [account] is the one its role
  108:   /// resolved to (see ApiType), kept only when login mode is on and the
  109:   /// request needs it (or asks for it, see [explicitAccount]); otherwise
  110:   /// anonymous. [loginMode] defaults to the setting (tests pass it).
  111:   static Account bind(
  112:     Account account,
  113:     RequestOptions options, {
  114:     bool? loginMode,
  115:   }) {
  116:     if (account is LoginAccount &&
  117:         (!(loginMode ?? LoginPolicy.loginMode) ||
  118:             (!requiresAccount(options) &&
  119:                 options.extra[explicitAccount] != true))) {
  120:       return AnonymousAccount();
  121:     }
  122:     return account;
  123:   }
  124: 
  125:   /// Whether [path] is on the lists that may carry the account. For the
  126:   /// settings UI: the per-request checks in [requiresAccount] (csrf writes,
  127:   /// own-mid reads) can still attach the account to a path not listed here.
  128:   static bool isAccountPath(String path) =>
  129:       _accountApis.contains(path) || _recommendApis.contains(path);
  130: 
  131:   /// Whether [options] may carry the logged-in account. False means it is
  132:   /// sent anonymously even in login mode.
  133:   static bool requiresAccount(RequestOptions options) {
  134:     final path = options.path;
  135:     // gRPC requests are sent as `appBaseUrl + GrpcUrl.x`
  136:     final grpcPath = path.startsWith(HttpString.appBaseUrl)
  137:         ? path.substring(HttpString.appBaseUrl.length)
  138:         : path;
  139:     if (_accountApis.contains(path) ||
  140:         _recommendApis.contains(path) ||
  141:         _grpcAccountApis.contains(grpcPath) ||
  142:         _grpcAccountPrefixes.any(grpcPath.startsWith)) {
  143:       return true;
  144:     }
  145:     final query = options.queryParameters;
  146:     final data = options.data;
  147:     // web writes are csrf-protected (some GET reads also carry csrf; they
  148:     // are not writes and stay anonymous)
  149:     if (options.method.toUpperCase() != 'GET' &&
  150:         (query.keys.any(_csrfKeys.contains) ||
  151:             (data is Map && data.keys.any(_csrfKeys.contains)) ||
  152:             (data is FormData &&
  153:                 data.fields.any((e) => _csrfKeys.contains(e.key))))) {
  154:       return true;
  155:     }
  156:     // reads scoped to the user themself (own space, own followings...)
  157:     final mid = Accounts.main.mid;
  158:     if (mid != 0) {
  159:       for (final key in _selfKeys) {
  160:         final v = query[key] ?? (data is Map ? data[key] : null);
  161:         if (v != null && '$v' == '$mid') return true;
  162:       }
  163:     }
  164:     return false;
  165:   }
  166: }
--- lib/http/retry_interceptor.dart
    1: import 'package:PiliPlus/utils/accounts/account.dart';
    2: import 'package:dio/dio.dart';
    3: import 'package:http2/http2.dart';
    4: 
    5: class RetryInterceptor extends Interceptor {
    6:   final Dio _client;
    7:   final int _count;
    8:   final int _delay;
    9: 
   10:   RetryInterceptor(this._client, this._count, this._delay);
   11: 
   12:   @override
   13:   void onError(DioException err, ErrorInterceptorHandler handler) {
   14:     if (err.requestOptions.responseType == ResponseType.stream) {
   15:       return handler.next(err);
   16:     }
   17:     if (err.response != null) {
   18:       final options = err.requestOptions;
   19:       if (options.followRedirects && options.maxRedirects > 0) {
   20:         final status = err.response!.statusCode;
   21:         if (status != null && 300 <= status && status < 400) {
   22:           var redirectUrl = err.response!.headers.value('location');
   23:           if (redirectUrl != null) {
   24:             final oldUri = options.uri;
   25:             var uri = Uri.parse(redirectUrl);
   26:             if (!uri.hasScheme) {
   27:               uri = oldUri.resolveUri(uri);
   28:               redirectUrl = uri.toString();
   29:             }
   30:             if (uri.scheme != oldUri.scheme ||
   31:                 uri.host != oldUri.host ||
   32:                 uri.port != oldUri.port) {
   33:               // another origin gets neither the account's cookies nor its
   34:               // headers, nor the old query (access_key...): the location
   35:               // carries its own
   36:               options
   37:                 ..queryParameters = {}
   38:                 // every gRPC header too: x-bili-metadata-bin starts with the
   39:                 // accessKey, x-bili-device-bin/buvid carry the persistent
   40:                 // device id, and the referer names where we came from
   41:                 ..headers.removeWhere((key, _) {
   42:                   final name = key.toLowerCase();
   43:                   return name.startsWith('x-bili-') ||
   44:                       name == 'cookie' ||
   45:                       name == 'authorization' ||
   46:                       name == 'buvid' ||
   47:                       name == 'referer';
   48:                 })
   49:                 ..extra['account'] = const NoAccount();
   50:               // 307/308 (and a POST this interceptor follows itself) keep
   51:               // the body: take the account's secrets out of it too
   52:               _scrubBody(options);
   53:             }
   54:             (options..path = redirectUrl).maxRedirects--;
   55:             if (status == 303) {
   56:               options
   57:                 ..data = null
   58:                 ..method = 'GET';
   59:             }
   60:             _client
   61:                 .fetch(options)
   62:                 .then(
   63:                   (i) => handler.resolve(
   64:                     i
   65:                       ..redirects.add(
   66:                         RedirectRecord(status, options.method, uri),
   67:                       )
   68:                       ..isRedirect = true,
   69:                   ),
   70:                 )
   71:                 .onError<DioException>((error, _) => handler.next(error));
   72:             return;
   73:           }
   74:         }
   75:       }
   76:       return handler.next(err);
   77:     } else {
   78:       switch (err.type) {
   79:         case DioExceptionType.connectionError:
   80:         case DioExceptionType.connectionTimeout:
   81:         case DioExceptionType.sendTimeout:
   82:         case DioExceptionType.unknown:
   83:           // only idempotent reads are re-sent: a POST (like, coin, comment,
   84:           // follow...) may already have been applied by the server
   85:           final method = err.requestOptions.method.toUpperCase();
   86:           if ((method == 'GET' || method == 'HEAD') &&
   87:               (err.requestOptions.extra['_rt'] ??= 0) < _count &&
   88:               err.error
   89:                   is! TransportConnectionException // 网络中断, 此时请求可能已经被服务器所接收
   90:                   ) {
   91:             Future.delayed(
   92:               Duration(
   93:                 milliseconds: ++err.requestOptions.extra['_rt'] * _delay,
   94:               ),
   95:               () => _client
   96:                   .fetch(err.requestOptions)
   97:                   .then(handler.resolve)
   98:                   .onError<DioException>((error, _) => handler.reject(error)),
   99:             );
  100:           } else {
  101:             handler.next(err);
  102:           }
  103:           return;
  104:         default:
  105:           return handler.next(err);
  106:       }
  107:     }
  108:   }
  109: 
  110:   /// Account secrets a body may carry (see AccountManager) and the
  111:   /// signatures computed over them: worthless at another origin, and the
  112:   /// account's to keep.
  113:   static const _bodySecrets = [
  114:     'access_key',
  115:     'mobile_access_key',
  116:     'csrf',
  117:     'csrf_token',
  118:     'biliCSRF',
  119:     'sign',
  120:     'w_rid',
  121:   ];
  122: 
  123:   static void _scrubBody(RequestOptions options) {
  124:     switch (options.data) {
  125:       case final Map data:
  126:         data.removeWhere((key, _) => _bodySecrets.contains(key));
  127:       case final FormData data:
  128:         data.fields.removeWhere((e) => _bodySecrets.contains(e.key));
  129:     }
  130:   }
  131: 
  132:   RetryInterceptor copyWith({Dio? client, int? count, int? delay}) =>
  133:       .new(client ?? _client, count ?? _count, delay ?? _delay);
  134: }

