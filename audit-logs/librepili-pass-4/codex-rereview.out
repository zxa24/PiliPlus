   84:     final account = Accounts.main;
   85:     final res = await UserHttp.userInfo();
   86:     if (res case Success(:final response)) {
   87:       setAnonymousWebCookie();
   88:       RequestUtils.syncHistoryStatus();
   89:       if (response.isLogin == true) {
   90:         final accountService = Get.find<AccountService>()
   91:           ..face.value = response.face!;
   92: 
   93:         if (accountService.isLogin.value) {
   94:           accountService.isLogin.refresh();
   95:         } else {
   96:           accountService.isLogin.value = true;
   97:         }
   98: 
   99:         SmartDialog.showToast('main登录成功');
  100:         if (response != Pref.userInfoCache) {
  101:           await GStorage.userInfo.put('userInfoCache', response);
  102:         }
  103:       }
  104:     } else {
  105:       // 获取用户信息失败
  106:       final errMsg = res.toString();
  107:       if (errMsg == '账号未登录') {
  108:         // kept (marked expired), so one bad answer cannot delete it
  109:         if (account is LoginAccount) await Accounts.markExpired({account});
  110:         SmartDialog.showNotify(
  111:           msg: '账号登录已失效（$errMsg），可在「账号切换」中重新登录或删除',
  112:           notifyType: .warning,
  113:         );
  114:       } else {
  115:         SmartDialog.showToast(errMsg);
  116:       }
  117:     }
  118:   }
  119: 
  120:   static Future<void> onLogoutMain() {
  121:     Get.find<AccountService>()
  122:       ..face.value = ''
  123:       ..isLogin.value = false;
  124: 
  125:     return Future.wait([
  126:       if (Platform.isLinux)
  127:         LinuxCookieManager.deleteAllCookies()
  128:       else
  129:         // an empty jar is not anonymous: put the anonymous buvid3 back, or
  130:         // every WebView page for the rest of the session looks like a bot
  131:         () async {
  132:           await web.CookieManager.instance(
  133:             webViewEnvironment: webViewEnvironment,
  134:           ).deleteAllCookies();
  135:           await setAnonymousWebCookie();
  136:         }(),
  137:       GStorage.userInfo.delete('userInfoCache'),
  138:     ]);
  139:   }
  140: 
  141:   static String generateBuvid() {
  142:     final md5Str = Digest(
  143:       List.generate(16, (_) => Utils.random.nextInt(256)),
  144:     ).toString();
  145:     return 'XY${md5Str[2]}${md5Str[12]}${md5Str[22]}$md5Str';
  146:   }
  147: 
  148:   /// Persistent device id: only for requests that carry the account.
  149:   static final buvid = Pref.buvid;
  150: 
  151:   /// LibrePili: fresh device id per launch for anonymous requests, so they
  152:   /// cannot be linked across launches or to the logged-in account.
  153:   static final sessionBuvid = generateBuvid();
  154: 
  155:   // static String getUUID() {
  156:   //   return const Uuid().v4().replaceAll('-', '');
  157:   // }
  158: 
  159:   // static String generateBuvid() {
  160:   //   String uuid = getUUID() + getUUID();
  161:   //   return 'XY${uuid.substring(0, 35).toUpperCase()}';
  162:   // }
  163: 
  164:   static String genDeviceId() {
  165:     // https://github.com/bilive/bilive_client/blob/2873de0532c54832f5464a4c57325ad9af8b8698/bilive/lib/app_client.ts#L62
  166:     final time = DateTime.now();
  167: 
  168:     final List<int> bytes = [
  169:       ...Iterable.generate(16, (_) => Utils.random.nextInt(256)),
  170:       _dec2bcd(time.year ~/ 100),
  171:       _dec2bcd(time.year % 100),
  172:       _dec2bcd(time.month),
  173:       _dec2bcd(time.day),
  174:       _dec2bcd(time.hour),
  175:       _dec2bcd(time.minute),
  176:       _dec2bcd(time.second),
  177:       ...Iterable.generate(8, (_) => Utils.random.nextInt(256)),
  178:     ];
  179:     final check = (bytes.sum & 0xFF).toRadixString(16).padLeft(2, '0');
  180: 
  181:     return Digest(bytes).toString() + check;
  182:   }
  183: 
  184:   static int _dec2bcd(int dec) {
  185:     assert(0 <= dec && dec < 100);
  186:     return ((dec ~/ 10) << 4) | (dec % 10);
  187:   }
  188: }
