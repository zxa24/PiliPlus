  189:     public static boolean openMusic(@NonNull String title, String artist, String album) {
  190:         Intent intent = new Intent(MediaStore.INTENT_ACTION_MEDIA_SEARCH);
  191:         intent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
  192:         intent.putExtra(SearchManager.QUERY, title);
  193:         intent.putExtra(MediaStore.EXTRA_MEDIA_TITLE, title);
  194:         if (artist != null) {
  195:             intent.putExtra(MediaStore.EXTRA_MEDIA_ARTIST, artist);
  196:         }
  197:         if (album != null) {
  198:             intent.putExtra(MediaStore.EXTRA_MEDIA_ALBUM, album);
  199:         }
  200:         intent.addCategory(Intent.CATEGORY_DEFAULT);
  201: 
  202:         Context context = getContext();
  203:         PackageManager pm = context.getPackageManager();
  204: 
  205:         try {
  206:             if (pm.resolveActivity(intent, PackageManager.MATCH_DEFAULT_ONLY) != null) {
  207:                 context.startActivity(intent);
  208:                 return true;
  209:             }
  210:         } catch (Exception ignored) {
  211:         }
  212: 
  213:         try {
  214:             intent.setAction(MediaStore.INTENT_ACTION_MEDIA_PLAY_FROM_SEARCH);
  215:             if (pm.resolveActivity(intent, PackageManager.MATCH_DEFAULT_ONLY) != null) {
  216:                 context.startActivity(intent);
  217:                 return true;
  218:             }
  219:         } catch (Exception ignored) {
  220:         }
  221: 
  222:         return false;
  223:     }
