  236:           parameters: {
  237:             'id': item.idStr,
  238:             'type': 'opus',
  239:           },
  240:         );
  241:       } else {
  242:         if (item.linkFolded) {
  243:           pushDynFromId(id: item.idStr);
  244:           return;
  245:         }
  246:         toDupNamed(
  247:           '/dynamicDetail',
  248:           arguments: {
  249:             'item': item,
  250:             if (viewComment) 'viewComment': true,
  251:           },
  252:         );
  253:       }
  254:     }
  255: 
  256:     /// 点击评论action 直接查看评论
  257:     if (isPush) {
  258:       push();
  259:       return;
  260:     }
--- lib/utils/extension/string_ext.dart
    1: final _regExp = RegExp("^(http:)?//", caseSensitive: false);
    2: 
    3: extension NullableStringExt on String? {
    4:   String get http2https => this?.replaceFirst(_regExp, "https://") ?? '';
    5: 
    6:   bool get isNullOrEmpty => this == null || this!.isEmpty;
    7: }
    8: 
    9: extension StringExt on String {
   10:   /// Whether this may be opened in the in-app WebView / handed to the OS.
   11:   /// A deep link (`bilibili://browser/?url=…`) is attacker-controlled, and
   12:   /// `file:` / `content:` would render app-private files (hive/account.hive),
   13:   /// `javascript:` would run in the page that is already loaded.
   14:   bool get isHttpUrl {
   15:     final scheme = Uri.tryParse(this)?.scheme.toLowerCase();
   16:     return scheme == 'http' || scheme == 'https';
   17:   }
   18: 
   19:   String subLength(int length) {
   20:     if (this.length < length) return this;
   21:     return substring(0, length);
   22:   }
   23: 
   24:   String get substring1 {
   25:     return substring(1, length - 1);
   26:   }
   27: 
   28:   String get emote {
   29:     int start = 0;
   30:     int end = length;
   31: 
   32:     loop:
   33:     for (int index = length - 1; index >= 0; index--) {
   34:       switch (codeUnitAt(index)) {
   35:         case 0x5F || 0x7C: // `_`, `|`
   36:           start = index + 1;
   37:           break loop;
   38:         case 0x5B: // `[`
   39:           start = index + 1;
   40:         case 0x5D: // `]`
   41:           end = index;
   42:       }
   43:     }
   44: 
   45:     return substring(start, end);
   46:   }
   47: }
--- lib/utils/accounts.dart
    1: import 'package:PiliPlus/http/init.dart';
    2: import 'package:PiliPlus/models/common/account_type.dart';
    3: import 'package:PiliPlus/pages/mine/controller.dart';
    4: import 'package:PiliPlus/utils/accounts/account.dart';
    5: import 'package:PiliPlus/utils/accounts/login_policy.dart';
    6: import 'package:PiliPlus/utils/login_utils.dart';
    7: import 'package:PiliPlus/utils/storage.dart';
    8: import 'package:PiliPlus/utils/storage_key.dart';
    9: import 'package:hive_ce/hive.dart';
   10: 
   11: abstract final class Accounts {
   12:   static late final Box<LoginAccount> account;
   13:   static final List<Account> accountMode = List.filled(
   14:     AccountType.values.length,
   15:     AnonymousAccount(),
   16:   );
   17:   static bool get mainEqVideo => main == video;
   18:   static Account get main => accountMode[AccountType.main.index];
   19:   static Account get video => accountMode[AccountType.video.index];
   20:   static Account get heartbeat => accountMode[AccountType.heartbeat.index];
   21:   static Account get history {
   22:     final heartbeat = Accounts.heartbeat;
   23:     if (heartbeat is AnonymousAccount) {
   24:       return Accounts.main;
   25:     }
   26:     return heartbeat;
   27:   }
   28:   // static set main(Account account) => set(AccountType.main, account);
   29: 
   30:   static Future<void> init() async {
   31:     account = await Hive.openBox(
   32:       'account',
   33:       compactionStrategy: (int entries, int deletedEntries) {
   34:         return deletedEntries > 2;
   35:       },
   36:     );
   37:   }
   38: 
   39:   static Future<void> refresh() {
   40:     for (int i = 0; i < AccountType.values.length; i++) {
   41:       accountMode[i] = AnonymousAccount();
   42:     }
   43:     // LibrePili: stored accounts stay dormant unless login mode is on
   44:     if (LoginPolicy.loginMode) {
   45:       // expired accounts are not used for requests
   46:       for (final a in account.values.where((a) => !a.expired)) {
   47:         for (final t in a.type) {
   48:           accountMode[t.index] = a;
   49:         }
   50:       }
   51:     }
   52:     return Future.wait(
   53:       (accountMode.toSet()..removeWhere((i) => i.activated)).map(
   54:         Request.buvidActive,
   55:       ),
   56:     );
   57:   }
   58: 
   59:   static Future<void> clear() async {
   60:     await LoginUtils.clearWebCookies();
   61:     await account.clear();
   62:     for (int i = 0; i < AccountType.values.length; i++) {
   63:       accountMode[i] = AnonymousAccount();
   64:     }
   65:     await AnonymousAccount().delete();
   66:     Request.buvidActive(AnonymousAccount());
   67:     // the setting box is cleared alongside this, so login mode is back off:
   68:     // take the UI out of the logged-in state too
   69:     MineController.anonymity.value = true;
   70:     await LoginUtils.onLogoutMain();
   71:   }
   72: 
   73:   static Future<void> deleteAll(Set<Account> accounts) async {
   74:     final isLoginMain = Accounts.main.isLogin;
   75:     for (int i = 0; i < AccountType.values.length; i++) {
   76:       if (accounts.contains(accountMode[i])) {
   77:         accountMode[i] = AnonymousAccount();
   78:       }
   79:     }
   80:     await Future.wait(accounts.map((i) => i.delete()));
   81:     // no account left: back to the advertised default, incognito
   82:     if (account.isEmpty) {
   83:       await GStorage.setting.put(SettingBoxKey.loginMode, false);
   84:       MineController.anonymity.value = true;
   85:     }
   86:     if (isLoginMain && !Accounts.main.isLogin) {
   87:       await LoginUtils.onLogoutMain();
   88:     }
   89:   }
   90: 
   91:   /// The server said "not logged in" for [accounts]: they are not deleted
   92:   /// (the user re-logs in or removes them in the account list), only
   93:   /// marked expired (persisted) and no longer used for requests.
   94:   static Future<void> markExpired(Set<LoginAccount> accounts) async {
   95:     final isLoginMain = Accounts.main.isLogin;
   96:     for (int i = 0; i < AccountType.values.length; i++) {
   97:       if (accounts.contains(accountMode[i])) {
   98:         accountMode[i] = AnonymousAccount();
   99:       }
  100:     }
  101:     await Future.wait([
  102:       for (final a in accounts)
  103:         ?(a
  104:               ..expired = true
  105:               ..dropCredentials())
  106:             .onChange(),
  107:     ]);
  108:     if (isLoginMain && !Accounts.main.isLogin) {
  109:       await LoginUtils.onLogoutMain();
  110:     }
  111:   }
  112: 
  113:   /// Roles as saved on the stored accounts, whether login mode is on or not.
  114:   static List<Account> savedMode() {
  115:     final mode = List<Account>.filled(
  116:       AccountType.values.length,
  117:       AnonymousAccount(),
  118:     );
  119:     for (final a in account.values) {
  120:       for (final t in a.type) {
  121:         mode[t.index] = a;
  122:       }
  123:     }
  124:     return mode;
  125:   }
  126: 
  127:   static Future<void> set(AccountType key, Account account) async {
  128:     // in incognito accountMode only holds the anonymous placeholder, so drop
  129:     // the role from every stored account, not just the active holder
  130:     final changed = <Account>{accountMode[key.index]..type.remove(key)};
  131:     for (final a in Accounts.account.values) {
  132:       if (a.type.remove(key)) changed.add(a);
  133:     }
  134:     accountMode[key.index] = account..type.add(key);
  135:     changed.add(account);
  136:     await Future.wait([for (final a in changed) ?a.onChange()]);
  137:     if (!LoginPolicy.loginMode ||
  138:         (account is LoginAccount && account.expired)) {
  139:       // role is saved on the account but stays dormant until login mode
  140:       // (or, for an expired account, until it is logged in again)
  141:       accountMode[key.index] = AnonymousAccount();
  142:       return;
  143:     }
  144:     if (!account.activated) await Request.buvidActive(account);
  145:     switch (key) {
  146:       case AccountType.main:
  147:         await (account.isLogin
  148:             ? LoginUtils.onLoginMain()
  149:             : LoginUtils.onLogoutMain());
  150:         break;
  151:       default:
  152:         break;
  153:     }
  154:   }
  155: 
  156:   @pragma("vm:prefer-inline")
  157:   static Account get(AccountType key) {
  158:     return accountMode[key.index];
  159:   }
  160: }
