--- lib/utils/duration_utils.dart
    1: import 'dart:math' show pow;
    2: 
    3: abstract final class DurationUtils {
    4:   static String formatDuration(num? seconds) {
    5:     if (seconds == null || seconds == 0) {
    6:       return '00:00';
    7:     }
    8:     int h = seconds ~/ 3600;
    9:     seconds %= 3600;
   10:     int m = seconds ~/ 60;
   11:     seconds %= 60;
   12:     String sms = seconds is double
   13:         ? seconds.toStringAsFixed(3).padLeft(6, '0')
   14:         : seconds.toString().padLeft(2, '0');
   15:     return h == 0
   16:         ? "${m.toString().padLeft(2, '0')}:$sms"
   17:         : "${h.toString().padLeft(2, '0')}:${m.toString().padLeft(2, '0')}:$sms";
   18:   }
   19: 
   20:   static final _splitRegex = RegExp(r'[:：]');
   21:   static int parseDuration(String? data) {
   22:     if (data == null || data.isEmpty) {
   23:       return 0;
   24:     }
   25:     // a part too large to parse counts as 0 instead of throwing: this also
   26:     // runs on text from danmaku / subtitles
   27:     List<int> split = data
   28:         .split(_splitRegex)
   29:         .reversed
   30:         .map((e) => int.tryParse(e) ?? 0)
   31:         .toList();
   32:     int duration = 0;
   33:     for (int i = 0; i < split.length; i++) {
   34:       duration += split[i] * pow(60, i).toInt();
   35:     }
   36:     return duration;
   37:   }
   38: 
   39:   static String formatDurationBetween(int startMillis, int endMillis) =>
   40:       formatTimeDuration(Duration(milliseconds: endMillis - startMillis));
   41: 
   42:   static String formatTimeDuration(Duration duration) {
   43:     final inDays = duration.inDays;
   44:     final daysLeft = inDays % 365;
   45:     final years = inDays ~/ 365;
   46:     final months = daysLeft ~/ 30;
   47:     final days = daysLeft % 30;
   48:     final hours = duration.inHours % 24;
   49:     final minutes = duration.inMinutes % 60;
   50: 
   51:     final format = StringBuffer();
   52: 
   53:     if (years > 0) format.write('$years年');
   54:     if (months > 0) format.write('$months月');
   55:     if (days > 0) format.write('$days天');
   56:     if (hours > 0) format.write('$hours小时');
   57:     if (minutes > 0) format.write('$minutes分钟');
   58: 
   59:     return format.toString();
   60:   }
   61: }
--- lib/pages/webdav/webdav.dart
    1: import 'dart:convert';
    2: 
    3: import 'package:PiliPlus/common/constants.dart';
    4: import 'package:PiliPlus/common/widgets/pair.dart';
    5: import 'package:PiliPlus/utils/device_utils.dart';
    6: import 'package:PiliPlus/utils/storage.dart';
    7: import 'package:PiliPlus/utils/storage_pref.dart';
    8: import 'package:flutter_smart_dialog/flutter_smart_dialog.dart';
    9: import 'package:webdav_client/webdav_client.dart' as webdav;
   10: 
   11: typedef _WebDavConfig = ({
   12:   String uri,
   13:   String username,
   14:   String password,
   15:   String directory,
   16: });
   17: 
   18: class WebDav {
   19:   _WebDavConfig? _clientConfig;
   20:   webdav.Client? _client;
   21: 
   22:   WebDav._internal();
   23:   static final WebDav _instance = WebDav._internal();
   24:   factory WebDav() => _instance;
   25: 
   26:   _WebDavConfig _getConfig() {
   27:     String directory = Pref.webdavDirectory;
   28:     if (!directory.endsWith('/')) {
   29:       directory += '/';
   30:     }
   31:     return (
   32:       uri: Pref.webdavUri,
   33:       username: Pref.webdavUsername,
   34:       password: Pref.webdavPassword,
   35:       directory: '$directory${Constants.appName}',
   36:     );
   37:   }
   38: 
   39:   Future<webdav.Client> _connect(
   40:     _WebDavConfig config, {
   41:     bool force = false,
   42:   }) async {
   43:     final cachedClient = _client;
   44:     if (!force && cachedClient != null && _clientConfig == config) {
   45:       return cachedClient;
   46:     }
   47: 
   48:     final client =
   49:         webdav.newClient(
   50:             config.uri,
   51:             user: config.username,
   52:             password: config.password,
   53:           )
   54:           ..setHeaders({'accept-charset': 'utf-8'})
   55:           ..setConnectTimeout(12000)
   56:           ..setReceiveTimeout(12000)
   57:           ..setSendTimeout(12000);
   58: 
   59:     await client.mkdirAll(config.directory);
   60:     _clientConfig = config;
   61:     _client = client;
   62:     return client;
   63:   }
   64: 
   65:   Future<Pair<bool, String?>> init() async {
   66:     try {
   67:       await _connect(_getConfig(), force: true);
   68: 
   69:       return Pair(first: true, second: null);
   70:     } catch (e) {
   71:       return Pair(first: false, second: e.toString());
   72:     }
   73:   }
   74: 
   75:   String _getFileName() {
   76:     return 'piliplus_settings_${DeviceUtils.platformName}.json';
   77:   }
   78: 
   79:   Future<void> backup({bool includeCredentials = false}) async {
   80:     // Keep the payload bound to the same settings snapshot as the connection.
   81:     final config = _getConfig();
   82:     final data = GStorage.exportAllSettings(
   83:       includeCredentials: includeCredentials,
   84:     );
   85:     final webdav.Client client;
   86:     try {
   87:       client = await _connect(config);
   88:     } catch (e) {
   89:       SmartDialog.showToast('备份失败，请检查配置: $e');
   90:       return;
   91:     }
   92:     final path = '${config.directory}/${_getFileName()}';
   93:     // write a new file first and move it over the old one: a failed upload
   94:     // must not lose the existing backup
   95:     final tmpPath = '$path.tmp';
   96:     try {
   97:       await client.write(tmpPath, utf8.encode(data));
   98:       await client.rename(tmpPath, path, true);
   99:     } catch (e) {
  100:       // the old backup is untouched; the half-written copy must not stay
  101:       // on the server
  102:       try {
  103:         await client.remove(tmpPath);
  104:       } catch (_) {}
  105:       SmartDialog.showToast('备份失败，原有备份未改动: $e');
  106:       return;
  107:     }
  108:     SmartDialog.showToast('备份成功');
  109:   }
  110: 
  111:   /// [askCredentials]: asked when the backup carries credentials; true
  112:   /// lets them replace this device's.
  113:   Future<void> restore({
  114:     required Future<bool> Function() askCredentials,
  115:   }) async {
  116:     final config = _getConfig();
  117:     final webdav.Client client;
  118:     try {
  119:       client = await _connect(config);
  120:     } catch (e) {
  121:       SmartDialog.showToast('恢复失败，请检查配置: $e');
  122:       return;
  123:     }
  124:     try {
  125:       final path = '${config.directory}/${_getFileName()}';
  126:       final data = await client.read(path);
  127:       final Map<String, dynamic> map = jsonDecode(utf8.decode(data));
  128:       final importCredentials =
  129:           GStorage.hasCredentials(map) && await askCredentials();
  130:       final snapshot = await GStorage.importAllJsonSettings(
  131:         map,
  132:         importCredentials: importCredentials,
  133:       );
  134:       SmartDialog.showToast('恢复成功，恢复前的数据已保存至 $snapshot');
  135:     } catch (e) {
  136:       SmartDialog.showToast('恢复失败: $e');
  137:     }
  138:   }
  139: 
  140:   /// Undoes the last restore / import (see [GStorage.restoreLatestSnapshot]).
