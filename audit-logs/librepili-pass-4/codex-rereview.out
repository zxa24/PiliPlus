+			that did carried a nested CFBundleURLTypes with bilibili.com
+			hostnames in a CFBundleURLSchemes array, which iOS ignores —
+			hostname matching is what Universal Links are for).
+		-->
 		<key>CFBundleURLTypes</key>
 		<array>
-			<dict>
