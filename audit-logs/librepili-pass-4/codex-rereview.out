  165:     // toast asserts a privacy posture the app is not in
  166:     if (Accounts.account.isEmpty) {
  167:       if (LoginPolicy.loginMode) {
  168:         await GStorage.setting.put(SettingBoxKey.loginMode, false);
  169:         await Accounts.refresh();
  170:         anonymity.value = true;
