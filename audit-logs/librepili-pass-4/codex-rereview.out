  232:       episodeId: episode.id!,
  233:       index: episode.title!,
  234:       indexTitle: episode.longTitle ?? '',
  235:       showTitle: episode.showTitle,
  236:       from: episode.from ?? 'bangumi',
  237:       seasonType: pgcItem.type ?? (episode.from == 'pugv' ? -1 : 0),
  238:       width: 0,
  239:       height: 0,
  240:       rotate: 0,
  241:       link: episode.link ?? '',
  242:       bvid: episode.bvid ?? IdUtils.av2bv(source.avId),
  243:       sortIndex: index,
  244:     );
  245:     final entry = BiliDownloadEntryInfo(
  246:       mediaType: 2,
  247:       hasDashAudio: false,
  248:       isCompleted: false,
  249:       totalBytes: 0,
  250:       downloadedBytes: 0,
  251:       title: pgcItem.seasonTitle ?? pgcItem.title ?? '',
  252:       typeTag: quality.code.toString(),
  253:       cover: episode.cover!,
  254:       preferedVideoQuality: quality.code,
  255:       qualityPithyDescription: quality.desc,
  256:       guessedTotalBytes: 0,
  257:       totalTimeMilli:
  258:           (episode.duration ?? 0) *
  259:           (episode.from == 'pugv' ? 1000 : 1), // pgc millisec,, pugv sec
  260:       danmakuCount: pgcItem.stat?.danmaku ?? 0,
  261:       timeUpdateStamp: currentTime,
  262:       timeCreateStamp: currentTime,
  263:       canPlayInAdvance: true,
  264:       interruptTransformTempFile: false,
  265:       spid: 0,
  266:       seasonId: pgcItem.seasonId!.toString(),
  267:       bvid: episode.bvid ?? IdUtils.av2bv(source.avId),
  268:       avid: source.avId,
  269:       ep: ep,
  270:       source: source,
  271:       ownerId: pgcItem.upInfo?.mid,
  272:       ownerName: pgcItem.upInfo?.uname,
  273:       pageData: null,
  274:     );
  275:     _createDownload(entry);
  276:   }
  277: 
  278:   Future<void> _createDownload(BiliDownloadEntryInfo entry) async {
  279:     final entryDir = await _getDownloadEntryDir(entry);
  280:     final entryJsonFile = File(path.join(entryDir.path, _entryFile));
  281:     await entryJsonFile.writeAsString(jsonEncode(entry.toJson()));
  282:     entry
  283:       ..pageDirPath = entryDir.parent.path
  284:       ..entryDirPath = entryDir.path
  285:       ..status = DownloadStatus.wait;
  286:     waitDownloadQueue.add(entry);
  287:     if (curDownload.value?.status.isDownloading != true) {
  288:       startDownload(entry);
  289:     }
  290:   }
  291: 
  292:   Future<Directory> _getDownloadEntryDir(BiliDownloadEntryInfo entry) async {
  293:     late final String dirName;
  294:     late final String pageDirName;
  295:     if (entry.ep case final ep?) {
  296:       dirName = 's_${entry.seasonId}';
  297:       pageDirName = ep.episodeId.toString();
  298:     } else if (entry.pageData case final page?) {
  299:       dirName = entry.avid.toString();
  300:       pageDirName = 'c_${page.cid}';
  301:     }
  302:     final root = await _getDownloadPath();
  303:     // an export made before exports avoided internal names (e.g. a title
  304:     // "114514") may already occupy this video's page folder: move it aside
  305:     // so the download is not created inside it (and deleting the download
  306:     // cannot take the export with it)
  307:     final page = Directory(path.join(root, dirName));
  308:     if (page.existsSync() &&
  309:         _isForeignFolder(page) &&
  310:         // already holds downloads (made before this guard): leave it, the
  311:         // deletion guard keeps the export's files
  312:         !page.listSync().any(
  313:           (e) =>
  314:               e is Directory &&
  315:               File(path.join(e.path, _entryFile)).existsSync(),
  316:         )) {
  317:       var aside = exportFolderName(dirName);
  318:       for (var i = 2; Directory(path.join(root, aside)).existsSync(); i++) {
  319:         aside = '${exportFolderName(dirName)} ($i)';
  320:       }
  321:       final moved = path.join(root, aside);
  322:       try {
  323:         await page.rename(moved);
  324:         // the download that exported it still points at the old place
  325:         for (final e in downloadList) {
  326:           if (e.mergedPath case final merged?
  327:               when path.isWithin(page.path, merged)) {
  328:             e.mergedPath = path.join(
  329:               moved,
  330:               path.relative(merged, from: page.path),
  331:             );
  332:             await _updateBiliDownloadEntryJson(e);
  333:           }
  334:         }
  335:       } on FileSystemException catch (e) {
  336:         // e.g. Windows: a file in it is open (the export is playing). The
  337:         // download goes inside it then; the deletion guards on both sides
  338:         // keep the export's files and the download apart.
  339:         if (kDebugMode) debugPrint('cannot move export aside: $e');
  340:       }
--- lib/services/download/download_manager.dart
    1: import 'dart:async';
    2: import 'dart:io';
    3: 
    4: import 'package:PiliPlus/http/init.dart';
    5: import 'package:PiliPlus/models_new/download/bili_download_entry_info.dart';
    6: import 'package:PiliPlus/utils/extension/file_ext.dart';
    7: import 'package:PiliPlus/utils/extension/string_ext.dart';
    8: import 'package:dio/dio.dart';
    9: 
   10: class DownloadManager {
   11:   final String url;
   12: 
   13:   /// Other CDN addresses of the same stream, tried in turn when a transfer
   14:   /// breaks off (LibrePili: some mirrors drop long transfers mid-way).
   15:   final List<String> backupUrls;
   16:   final String path;
   17:   final void Function(int, int)? onReceiveProgress;
   18:   final void Function([Object? error]) onDone;
   19: 
   20:   /// Size of this stream when the bytes on disk were saved, 0 if unknown.
   21:   /// The stream is resolved again on every start, and the saved index only
   22:   /// identifies it by id / codec / resolution: a different length means
   23:   /// different bytes, so the partial file is dropped instead of resumed
   24:   /// (LibrePili).
   25:   final int expectedTotal;
   26: 
   27:   static const _maxAttempts = 6;
   28: 
   29:   DownloadStatus _status = DownloadStatus.downloading;
   30: 
   31:   DownloadStatus get status => _status;
   32:   final _cancelToken = CancelToken();
   33:   late Future<void> task;
   34: 
   35:   DownloadManager({
   36:     required this.url,
   37:     this.backupUrls = const [],
   38:     required this.path,
   39:     required this.onReceiveProgress,
   40:     required this.onDone,
   41:     this.expectedTotal = 0,
   42:   }) {
   43:     task = _start();
   44:   }
   45: 
   46:   Future<void> _start() async {
   47:     final urls = [
   48:       url,
   49:       for (final u in backupUrls)
   50:         if (u != url) u,
   51:     ];
   52:     // only consecutive attempts that saved nothing count against the budget:
   53:     // a long transfer that keeps advancing between drops is not failing
   54:     var failures = 0;
   55:     for (var attempt = 0; ; attempt++) {
   56:       final before = _savedBytes;
   57:       final error = await _attempt(urls[attempt % urls.length]);
   58:       if (error == null) return; // completed
   59:       failures = _savedBytes > before ? 1 : failures + 1;
   60:       if (!_canRetry || failures >= _maxAttempts) {
   61:         await _fail(error);
   62:         return;
   63:       }
   64:       // resume from what is on disk, on the next address; pause/delete
   65:       // cuts the wait short
   66:       await Future.any<void>([
   67:         Future.delayed(Duration(seconds: failures)),
   68:         _cancelToken.whenCancel,
   69:       ]);
   70:       if (!_canRetry) {
   71:         await _fail(error);
   72:         return;
   73:       }
   74:     }
   75:   }
   76: 
   77:   int get _savedBytes {
   78:     final file = File(path);
   79:     return file.existsSync() ? file.lengthSync() : 0;
   80:   }
   81: 
   82:   bool get _canRetry =>
   83:       _status == DownloadStatus.downloading && !_cancelToken.isCancelled;
   84: 
   85:   Future<void> _fail(Object e) async {
   86:     final file = File(path);
   87:     if (_status == DownloadStatus.downloading) {
   88:       _status = DownloadStatus.failDownload;
   89:       // keep any saved bytes: a later start resumes from them
   90:       if (file.existsSync() && file.lengthSync() == 0) {
   91:         await file.tryDel();
   92:       }
   93:     }
   94:     onDone(e);
   95:   }
   96: 
   97:   static final _contentRangeReg = RegExp(r'bytes\s+(\d+)-\d+/(\d+|\*)');
   98: 
   99:   /// Size of the stream at [url] from a one-byte range request, or null.
  100:   Future<int?> _probeTotal(String url) async {
  101:     try {
  102:       final res = await Request.http11Dio.get<ResponseBody>(
  103:         url.http2https,
  104:         options: Options(
  105:           headers: {'range': 'bytes=0-0'},
  106:           responseType: ResponseType.stream,
  107:         ),
  108:         cancelToken: _cancelToken,
  109:       );
  110:       try {
  111:         await res.data?.stream.listen(null).cancel();
  112:       } catch (_) {}
  113:       final range = res.headers.value(HttpHeaders.contentRangeHeader);
  114:       if (res.statusCode == 206 && range != null) {
  115:         return int.tryParse(_contentRangeReg.firstMatch(range)?[2] ?? '');
  116:       }
  117:       // range ignored: the body is the whole stream
  118:       if (res.statusCode == 200 && (res.data?.contentLength ?? -1) >= 0) {
  119:         return res.data!.contentLength;
  120:       }
  121:     } catch (_) {}
  122:     return null;
  123:   }
  124: 
  125:   /// One transfer attempt. Returns null when the file is complete, else the
  126:   /// error.
  127:   Future<Object?> _attempt(String url) async {
  128:     int received;
  129: 
  130:     final file = File(path);
  131:     if (file.existsSync()) {
  132:       received = await file.length();
  133:     } else {
  134:       file.createSync(recursive: true);
  135:       received = 0;
  136:     }
  137: 
  138:     Response<ResponseBody> response;
  139:     try {
  140:       response = await Request.http11Dio.get<ResponseBody>(
  141:         url.http2https,
  142:         options: Options(
  143:           headers: {'range': 'bytes=$received-'},
  144:           responseType: ResponseType.stream,
  145:           validateStatus: (status) =>
  146:               status != null &&
  147:               (status == 416 || (status >= 200 && status < 300)),
  148:         ),
  149:         cancelToken: _cancelToken,
  150:       );
  151:     } on DioException catch (e) {
  152:       return e;
  153:     }
  154:     final data = response.data!;
  155:     final contentRange = response.headers.value(
  156:       HttpHeaders.contentRangeHeader,
  157:     );
  158: 
  159:     Future<void> discard() async {
  160:       try {
  161:         await data.stream.listen(null).cancel();
  162:       } catch (_) {}
  163:     }
  164: 
  165:     if (response.statusCode == 416) {
  166:       await discard();
  167:       // nothing left to send: complete only if the file on disk is whole
  168:       var total = int.tryParse(contentRange?.split('/').last ?? '');
  169:       // no usable Content-Range: ask for the size instead of guessing
  170:       if (total == null && received > 0) total = await _probeTotal(url);
  171:       if (total != null && total == received) {
  172:         _status = DownloadStatus.completed;
  173:         onDone();
  174:         return null;
  175:       }
  176:       if (total == null) {
  177:         // size unknown: never throw away the saved bytes on a guess
  178:         return 'range not satisfiable, size unknown (have $received)';
  179:       }
  180:       // what is on disk does not match the stream: start over
  181:       await file.writeAsBytes(const []);
  182:       return 'range not satisfiable ($contentRange, have $received)';
  183:     }
  184: 
  185:     int expected = data.contentLength < 0 ? -1 : data.contentLength + received;
  186:     if (received > 0) {
  187:       if (response.statusCode != 206) {
  188:         // Range ignored: the body is the whole file, rewrite it from 0
  189:         received = 0;
  190:         expected = data.contentLength;
  191:       } else {
  192:         final match = contentRange == null
  193:             ? null
  194:             : _contentRangeReg.firstMatch(contentRange);
  195:         if (match == null || int.parse(match[1]!) != received) {
  196:           await discard();
  197:           return 'unexpected content-range: $contentRange (have $received)';
  198:         }
  199:         expected = int.tryParse(match[2]!) ?? expected;
  200:         // same quality and codec but another length: another stream, the
  201:         // bytes on disk do not belong to it
  202:         if (expectedTotal > 0 && expected > 0 && expected != expectedTotal) {
  203:           await discard();
  204:           await file.writeAsBytes(const []);
  205:           return 'stream size changed ($expected, had $expectedTotal)';
  206:         }
  207:       }
  208:     }
  209: 
  210:     final sink = file.openWrite(
  211:       mode: received == 0 ? FileMode.writeOnly : FileMode.writeOnlyAppend,
  212:     );
  213: 
  214:     // also on a resume (received > 0): this is where the size becomes known,
  215:     // and the caller has no other chance to record it
  216:     onReceiveProgress?.call(received, expected);
  217: 
  218:     int? last;
  219:     try {
  220:       await for (final chunk in data.stream) {
  221:         sink.add(chunk);
  222:         received += chunk.length;
  223:         final now = DateTime.now().millisecondsSinceEpoch ~/ 1000;
  224:         if (last != now) {
  225:           last = now;
  226:           onReceiveProgress?.call(received, expected);
  227:         }
  228:       }
  229:       await sink.close();
  230:     } catch (e) {
  231:       try {
  232:         await sink.close();
  233:       } catch (_) {}
  234:       return e;
  235:     }
  236:     if (expected >= 0 && received != expected) {
  237:       // clean early EOF: retry from what was saved
  238:       return 'incomplete transfer: $received of $expected bytes';
  239:     }
  240:     _status = DownloadStatus.completed;
  241:     onDone();
  242:     return null;
  243:   }
  244: 
  245:   Future<void> cancel({required bool isDelete}) {
  246:     if (!isDelete && _status == DownloadStatus.downloading) {
  247:       _status = DownloadStatus.pause;
  248:     }
  249:     if (!_cancelToken.isCancelled) {
  250:       _cancelToken.cancel();
  251:     }
  252:     return task;
  253:   }
  254: }
--- lib/http/download.dart
    1: import 'package:PiliPlus/http/loading_state.dart';
    2: import 'package:PiliPlus/http/video.dart';
    3: import 'package:PiliPlus/models/common/account_type.dart';
    4: import 'package:PiliPlus/models/common/video/audio_quality.dart';
    5: import 'package:PiliPlus/models/common/video/video_quality.dart';
    6: import 'package:PiliPlus/models/common/video/video_type.dart';
    7: import 'package:PiliPlus/models/video/play/url.dart';
    8: import 'package:PiliPlus/models_new/download/bili_download_entry_info.dart';
    9: import 'package:PiliPlus/models_new/download/bili_download_media_file_info.dart';
   10: import 'package:PiliPlus/utils/accounts.dart';
   11: import 'package:PiliPlus/utils/extension/iterable_ext.dart';
   12: import 'package:PiliPlus/utils/storage_pref.dart';
   13: import 'package:PiliPlus/utils/video_utils.dart';
   14: import 'package:collection/collection.dart';
   15: 
   16: abstract final class DownloadHttp {
   17:   static const String referer = "https://www.bilibili.com/";
   18:   static const String userAgent = "Bilibili Freedoooooom/MarkII";
   19: 
   20:   static Future<BiliDownloadMediaInfo> getVideoUrl({
   21:     required BiliDownloadEntryInfo entry,
   22:     SourceInfo? source,
   23:     PageInfo? pageData,
   24:     EpInfo? ep,
   25:   }) async {
   26:     final isLogin = Accounts.get(AccountType.video).isLogin;
   27:     final res = await VideoHttp.videoUrl(
   28:       avid: entry.avid,
   29:       bvid: entry.bvid,
   30:       cid: entry.cid,
   31:       seasonId: entry.seasonId,
   32:       epid: ep?.episodeId,
   33:       qn: entry.preferedVideoQuality,
   34:       tryLook: !isLogin && Pref.p1080,
   35:       videoType: switch (ep?.from) {
   36:         'pugv' => VideoType.pugv,
   37:         != null when isLogin => VideoType.pgc,
   38:         _ => VideoType.ugc,
   39:       },
   40:     );
   41:     if (res case Success(:final response)) {
   42:       final dash = response.dash;
   43:       if (dash != null) {
   44:         final targetVideoQa = response.findAvailableVideoQuality(
   45:           entry.preferedVideoQuality,
   46:         );
   47: 
   48:         /// 优先顺序 设置中指定解码格式 -> 当前可选的首个解码格式
   49:         final supportFormats = response.supportFormats!;
   50:         // 根据画质选编码格式
   51:         final targetSupportFormats = supportFormats.firstWhere(
   52:           (e) => e.quality == targetVideoQa,
   53:           orElse: () => supportFormats.first,
   54:         );
   55: 
   56:         final currentDecodeFormats = VideoUtils.selectCodec(
   57:           targetSupportFormats.codecs!,
   58:           Pref.preferCodecs,
   59:         );
   60: 
   61:         entry
   62:           ..mediaType = 2
   63:           ..typeTag = targetVideoQa.toString()
   64:           ..videoQuality = targetVideoQa
   65:           ..preferedVideoQuality = targetVideoQa
   66:           ..qualityPithyDescription =
   67:               targetSupportFormats.newDesc ??
   68:               VideoQuality.fromCode(targetVideoQa).desc;
   69: 
   70:         /// 取出符合当前画质的videoList
   71:         final videosList = dash.video!
   72:             .where((e) => e.quality.code == targetVideoQa)
   73:             .toList();
   74: 
   75:         /// 取出符合当前解码格式的videoItem
   76:         final videoDash = videosList.firstWhere(
   77:           (e) => currentDecodeFormats.codes.any(e.codecs!.startsWith),
   78:           orElse: () => videosList.first,
   79:         );
   80: 
   81:         final videoUrl = VideoUtils.getCdnUrl(videoDash.playUrls);
   82: 
   83:         final Type2File videoFile = Type2File(
   84:           id: videoDash.id,
   85:           baseUrl: videoUrl,
   86:           backupUrl: [
   87:             for (final u in videoDash.playUrls)
   88:               if (u != videoUrl) u,
   89:           ],
   90:           bandwidth: videoDash.bandWidth!,
   91:           codecid: videoDash.codecid!,
   92:           size: 0,
   93:           md5: '',
   94:           noRexcode: false,
   95:           frameRate: videoDash.frameRate ?? '',
   96:           width: videoDash.width!,
   97:           height: videoDash.height!,
   98:           dashDrmType: 0,
   99:         );
  100:         List<Type2File>? audioFileList;
  101:         final List<AudioItem>? audioDashList = dash.audio;
  102:         if (audioDashList != null && audioDashList.isNotEmpty) {
  103:           final preferAudioQa = Pref.defaultAudioQa;
  104:           final List<int> audioIds = audioDashList
  105:               .map((map) => map.id)
  106:               .toList();
  107:           int closestNumber = audioIds.findClosestTarget(
  108:             (e) => e <= preferAudioQa,
  109:             (a, b) => a > b ? a : b,
  110:           );
  111:           if (!audioIds.contains(preferAudioQa) &&
  112:               audioIds.any((e) => e > preferAudioQa)) {
  113:             closestNumber = AudioQuality.k192.code;
  114:           }
  115:           final AudioItem audioDash = audioDashList.firstWhere(
  116:             (e) => e.id == closestNumber,
  117:             orElse: () => audioDashList.first,
  118:           );
  119:           final audioUrl = VideoUtils.getCdnUrl(
  120:             audioDash.playUrls,
  121:             isAudio: true,
  122:           );
  123:           audioFileList = [
  124:             Type2File(
  125:               id: audioDash.id,
  126:               baseUrl: audioUrl,
  127:               backupUrl: [
  128:                 for (final u in audioDash.playUrls)
  129:                   if (u != audioUrl) u,
  130:               ],
  131:               bandwidth: audioDash.bandWidth!,
  132:               codecid: audioDash.codecid!,
  133:               size: 0,
  134:               md5: '',
  135:               noRexcode: false,
  136:               frameRate: audioDash.frameRate!,
  137:               width: audioDash.width!,
  138:               height: audioDash.height!,
  139:               dashDrmType: 0,
  140:             ),
  141:           ];
  142:         }
  143:         // assigned from the stream just resolved: an entry re-resolved to a
  144:         // video-only stream must not keep the flag from an earlier attempt
  145:         entry.hasDashAudio = audioFileList != null;
  146:         return Type2(
  147:           duration: dash.duration!,
  148:           video: [videoFile],
  149:           audio: audioFileList,
  150:           referer: referer,
  151:           userAgent: userAgent,
  152:         );
  153:       } else {
  154:         // LibrePili: every segment, in timeline order (not just the first)
  155:         final List<Type1Segment> segmentList = [
  156:           for (final (i, durl) in response.durl!.indexed)
  157:             Type1Segment(
  158:               backupUrls: durl.playUrls.toList(),
  159:               bytes: durl.size ?? 0,
  160:               duration: durl.length ?? 0,
  161:               md5: '',
  162:               metaUrl: '',
  163:               order: durl.order ?? i + 1,
  164:               url: VideoUtils.getCdnUrl(durl.playUrls),
  165:             ),
  166:         ]..sort((a, b) => a.order.compareTo(b.order));
  167:         final FormatItem? formatItem = response.supportFormats
  168:             ?.firstWhereOrNull((e) => e.quality == response.quality);
  169:         final String description =
  170:             formatItem?.newDesc ?? VideoQuality.clear480.desc;
  171:         final int targetVideoQa =
  172:             formatItem?.quality ?? VideoQuality.clear480.code;
  173: 
  174:         entry
  175:           ..mediaType = 1
  176:           ..typeTag = targetVideoQa.toString()
  177:           ..videoQuality = targetVideoQa
  178:           ..preferedVideoQuality = targetVideoQa
  179:           ..qualityPithyDescription = description;
  180: 
  181:         final List<Type1PlayerCodecConfig> playerCodecConfigList = [
  182:           Type1PlayerCodecConfig(
  183:             player: "IJK_PLAYER",
  184:             useIjkMediaCodec: false,
  185:           ),
  186:           Type1PlayerCodecConfig(
  187:             player: "ANDROID_PLAYER",
  188:             useIjkMediaCodec: false,
  189:           ),
  190:         ];
  191: 
  192:         return Type1(
  193:           from: pageData?.from ?? ep?.from,
  194:           quality: entry.preferedVideoQuality,
  195:           typeTag: entry.typeTag,
  196:           description: description,
  197:           playerCodecConfigList: playerCodecConfigList,
  198:           segmentList: segmentList,
  199:           parseTimestampMilli: 0,
  200:           availablePeriodMilli: 0,
  201:           isDownloaded: false,
  202:           isResolved: true,
  203:           timeLength: 0,
  204:           marlinToken: '',
  205:           videoCodecId: 0,
  206:           videoProject: true,
  207:           format: response.format!,
  208:           playerError: 0,
  209:           needVip: false,
  210:           needLogin: false,
  211:           intact: false,
  212:           referer: referer,
  213:           userAgent: userAgent,
  214:         );
  215:       }
  216:     } else {
  217:       throw res.toString();
  218:     }
  219:   }
  220: }
--- lib/utils/cache_manager.dart
    1: import 'dart:io' show Directory, File;
    2: 
    3: import 'package:PiliPlus/utils/path_utils.dart';
    4: import 'package:PiliPlus/utils/platform_utils.dart';
    5: import 'package:PiliPlus/utils/storage_pref.dart';
    6: import 'package:cached_network_image_ce/cached_network_image.dart';
    7: import 'package:path/path.dart' as path;
    8: import 'package:path_provider/path_provider.dart';
    9: 
   10: abstract final class CacheManager {
   11:   static late final DefaultCacheManager manager;
   12: 
   13:   static Future<void> ensureInitialized() => DefaultCacheManager.init(
   14:     maxNrOfCacheLength: Pref.maxCacheSize.toInt(),
   15:     cacheDirectoryProvider: appTempDirectory,
   16:   ).then((i) => manager = i);
   17: 
   18:   // 获取缓存目录
   19:   @pragma('vm:notify-debugger-on-exception')
   20:   static Future<int> loadApplicationCache() async {
   21:     try {
   22:       if (PlatformUtils.isDesktop) {
   23:         return manager.getTotalLength();
   24:       }
   25: 
   26:       final Directory tempDirectory = await getTemporaryDirectory();
   27:       if (tempDirectory.existsSync()) {
   28:         return await getTotalSizeOfFilesInDir(tempDirectory);
   29:       }
   30:     } catch (_) {}
   31:     return 0;
   32:   }
   33: 
   34:   // 循环计算文件的大小
   35:   @pragma('vm:notify-debugger-on-exception')
   36:   static Future<int> getTotalSizeOfFilesInDir(Directory file) async {
   37:     int total = 0;
   38:     await for (final child in file.list(recursive: false)) {
   39:       if (child is File) {
   40:         total += await child.length();
   41:       } else if (child is Directory) {
   42:         if (path.equals(child.path, manager.cacheDir)) {
   43:           total += manager.getTotalLength();
   44:         } else {
   45:           await for (final i in child.list(recursive: true)) {
   46:             if (i is File) {
   47:               total += await i.length();
   48:             }
   49:           }
   50:         }
   51:       }
   52:     }
   53:     return total;
   54:   }
   55: 
   56:   // 缓存大小格式转换
   57:   static String formatSize(num value) {
   58:     const unitArr = ['B', 'K', 'M', 'G', 'T', 'P'];
   59:     int index = 0;
   60:     while (value >= 1024) {
   61:       index++;
   62:       value = value / 1024;
   63:     }
   64:     String size = value.toStringAsFixed(2);
   65:     return size + (unitArr.elementAtOrNull(index) ?? '');
   66:   }
   67: 
   68:   // 清除 Library/Caches 目录及文件缓存
   69:   @pragma('vm:notify-debugger-on-exception')
   70:   static Future<void> clearLibraryCache() async {
   71:     try {
   72:       await manager.emptyCache();
   73:       if (PlatformUtils.isDesktop) return;
   74: 
   75:       final tempDirectory = await getTemporaryDirectory();
   76:       if (tempDirectory.existsSync()) {
   77:         await for (final file in tempDirectory.list(recursive: false)) {
   78:           // this app's own folder: its image cache was emptied above, and
   79:           // the rest is scratch a running task may still be holding (share
   80:           // / export / remux files, side files of a local video). Everything
   81:           // else here belongs to plugins and is cache proper.
   82:           if (path.equals(file.path, tmpDirPath) ||
   83:               path.isWithin(file.path, tmpDirPath)) {
   84:             continue;
   85:           }
   86:           await file.delete(recursive: true);
   87:         }
   88:       }
   89:     } catch (_) {}
   90:   }
   91: }
--- macos/Runner/AppDelegate.swift
    1: import Cocoa
    2: import FlutterMacOS
    3: import app_links
    4: 
    5: @main
    6: class AppDelegate: FlutterAppDelegate {
    7:   override func applicationShouldTerminateAfterLastWindowClosed(_ sender: NSApplication) -> Bool {
    8:     return false
    9:   }
   10: 
   11:   /// "Open with" (see CFBundleDocumentTypes in Info.plist): Finder sends the
   12:   /// file as a `file:` url here. `FlutterAppDelegate` only offers these to
   13:   /// plugins implementing `handleOpenURLs:`, and app_links implements none
   14:   /// (it claims kAEGetURL for custom schemes instead), so they would be
   15:   /// dropped. Feeding them into app_links' own stream is what the Dart side
   16:   /// already expects: `PiliScheme.init` turns a `file:` link into a path and
   17:   /// opens it with `LocalPlayer` (the same path Linux takes). A url received
   18:   /// before the engine is up is replayed to the first subscriber.
   19:   override func application(_ application: NSApplication, open urls: [URL]) {
   20:     let files = urls.filter { $0.isFileURL }
   21:     let others = urls.filter { !$0.isFileURL }
   22:     if !others.isEmpty {
   23:       super.application(application, open: others)
   24:     }
   25:     for url in files {
   26:       AppLinks.shared.handleLink(link: url.absoluteString)
   27:     }
   28:   }
   29: 
   30:   override func applicationSupportsSecureRestorableState(_ app: NSApplication) -> Bool {
   31:     return true
   32:   }
   33: 
   34:   override func applicationShouldHandleReopen(_ sender: NSApplication, hasVisibleWindows flag: Bool) -> Bool {
   35:     if !flag {
   36:       for window in NSApp.windows {
   37:         if !window.isVisible {
   38:           window.setIsVisible(true)
   39:         }
   40:         window.makeKeyAndOrderFront(self)
   41:         NSApp.activate(ignoringOtherApps: true)
   42:       }
   43:     }
   44:     return true
   45:   }
   46: }
--- macos/Runner/Info.plist
    1: <?xml version="1.0" encoding="UTF-8"?>
    2: <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    3: <plist version="1.0">
    4: <dict>
    5: 	<key>CFBundleDevelopmentRegion</key>
    6: 	<string>$(DEVELOPMENT_LANGUAGE)</string>
    7: 	<key>CFBundleExecutable</key>
    8: 	<string>$(EXECUTABLE_NAME)</string>
    9: 	<key>CFBundleIconFile</key>
   10: 	<string></string>
   11: 	<key>CFBundleIdentifier</key>
   12: 	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
   13: 	<key>CFBundleInfoDictionaryVersion</key>
   14: 	<string>6.0</string>
   15: 	<key>CFBundleName</key>
   16: 	<string>$(PRODUCT_NAME)</string>
   17: 	<key>CFBundlePackageType</key>
   18: 	<string>APPL</string>
   19: 	<key>CFBundleShortVersionString</key>
   20: 	<string>$(FLUTTER_BUILD_NAME)</string>
   21: 	<key>CFBundleVersion</key>
   22: 	<string>$(FLUTTER_BUILD_NUMBER)</string>
   23: 	<key>LSMinimumSystemVersion</key>
   24: 	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
   25: 	<key>NSHumanReadableCopyright</key>
   26: 	<string>$(PRODUCT_COPYRIGHT)</string>
   27: 	<key>NSMainNibFile</key>
   28: 	<string>MainMenu</string>
   29: 	<key>NSPrincipalClass</key>
   30: 	<string>NSApplication</string>
   31: 	<!--
   32: 		`bilibili://` deep links. app_links installs a kAEGetURL Apple Event
   33: 		handler (AppLinksMacosPlugin.handleWillFinishLaunching) and feeds the
   34: 		url into the stream PiliScheme.init already listens to, so this
   35: 		declaration is all that was missing.
   36: 	-->
   37: 	<key>CFBundleURLTypes</key>
   38: 	<array>
   39: 		<dict>
   40: 			<key>CFBundleURLName</key>
   41: 			<string>bilibili</string>
   42: 			<key>CFBundleURLSchemes</key>
   43: 			<array>
   44: 				<string>bilibili</string>
   45: 			</array>
   46: 		</dict>
   47: 	</array>
