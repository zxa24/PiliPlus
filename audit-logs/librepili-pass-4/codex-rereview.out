  271: 
  272:   static Future<List<void>> clear() {
  273:     return Future.wait([
  274:       userInfo.clear(),
  275:       historyWord.clear(),
  276:       localCache.clear(),
  277:       setting.clear(),
  278:       video.clear(),
  279:       Accounts.clear(),
  280:       watchProgress.clear(),
