   38: // ref https://github.com/10miaomiao/bilimiao2/blob/master/bilimiao-download/src/main/java/cn/a10miaomiao/bilimiao/download/DownloadService.kt
   39: 
   40: class DownloadService extends GetxService {
   41:   static const _entryFile = 'entry.json';
   42:   static const _indexFile = 'index.json';
   43:   static const _maxDanmakuConcurrency = 4;
   44: 
   45:   /// Stream folder of [entry]. [BiliDownloadEntryInfo.typeTag] is nullable
   46:   /// (an `entry.json` written by another client may have no `type_tag`) and
   47:   /// `path.join` drops a null part, so joining it directly would give the
   48:   /// entry folder itself — which is deleted recursively below.
   49:   static String _streamDirPath(BiliDownloadEntryInfo entry) =>
   50:       path.join(entry.entryDirPath, entry.typeTag ?? '0');
   51: 
   52:   final _lock = Lock();
   53: 
   54:   final flagNotifier = SetNotifier();
   55:   final waitDownloadQueue = RxList<BiliDownloadEntryInfo>();
   56:   final downloadList = <BiliDownloadEntryInfo>[];
   57: 
   58:   int? _curCid;
   59:   int? get curCid => _curCid;
   60:   final curDownload = Rxn<BiliDownloadEntryInfo>();
   61:   void _updateCurStatus(DownloadStatus status) {
   62:     if (curDownload.value != null) {
   63:       curDownload
   64:         ..value!.status = status
   65:         ..refresh();
   66:     }
   67:   }
   68: 
   69:   DownloadManager? _downloadManager;
   70:   DownloadManager? _audioDownloadManager;
   71: 
   72:   late Future<void> waitForInitialization;
   73: 
   74:   @override
   75:   void onInit() {
   76:     super.onInit();
   77:     initDownloadList();
   78:   }
   79: 
   80:   void initDownloadList() {
   81:     waitForInitialization = _readDownloadList();
   82:   }
   83: 
   84:   /// The download folder changed: the running transfer (it writes into the
   85:   /// old folder) is paused, and the list and queue are re-read from the new
   86:   /// folder.
   87:   void reloadDownloadList() {
   88:     waitForInitialization = () async {
   89:       await waitForInitialization;
   90:       await cancelDownload(isDelete: false, downloadNext: false);
   91:       // a merge still in progress completes its entry on its own
   92:       if (!_mergingCids.contains(_curCid)) {
   93:         _curCid = null;
   94:         curDownload.value = null;
   95:       }
   96:       await _readDownloadList();
   97:     }();
   98:   }
   99: 
  100:   Future<void> _readDownloadList() async {
  101:     downloadList.clear();
  102:     waitDownloadQueue.clear();
  103:     final downloadDir = Directory(await _getDownloadPath());
  104:     await for (final dir in downloadDir.list()) {
  105:       if (dir is Directory) {
  106:         downloadList.addAll(await _readDownloadDirectory(dir));
  107:       }
  108:     }
  109:     downloadList.sort((a, b) => b.timeUpdateStamp.compareTo(a.timeUpdateStamp));
  110:   }
  111: 
  112:   @pragma('vm:notify-debugger-on-exception')
  113:   Future<List<BiliDownloadEntryInfo>> _readDownloadDirectory(
  114:     Directory pageDir,
  115:   ) async {
  116:     final result = <BiliDownloadEntryInfo>[];
  117: 
  118:     if (!pageDir.existsSync()) {
  119:       return result;
  120:     }
  121: 
  122:     await for (final entryDir in pageDir.list()) {
  123:       if (entryDir is Directory) {
  124:         final entryFile = File(path.join(entryDir.path, _entryFile));
  125:         if (entryFile.existsSync()) {
  126:           try {
  127:             final entryJson = await entryFile.readAsString();
  128:             final entry = BiliDownloadEntryInfo.fromJson(jsonDecode(entryJson))
  129:               ..pageDirPath = pageDir.path
  130:               ..entryDirPath = entryDir.path;
  131:             if (entry.isCompleted) {
  132:               result.add(entry);
  133:             } else {
  134:               waitDownloadQueue.add(entry..status = DownloadStatus.wait);
  135:             }
  136:           } catch (e) {
  137:             // a record this build cannot read: left out of the list, its
  138:             // files stay on disk
  139:             lastError = 'entry.json (${entryDir.path}): $e';
  140:             debugPrint('skipped download entry: $lastError');
  141:           }
  142:         }
  143:       }
  144:     }
  145: 
  146:     return result;
  147:   }
