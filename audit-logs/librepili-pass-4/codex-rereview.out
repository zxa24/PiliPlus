  927:   static bool _onPushDynDetail(Uri uri, bool off) {
  928:     String? id = uriDigitRegExp.firstMatch(uri.path)?.group(1);
  929:     bool isRid = uri.queryParameters['type'] == '2';
  930:     if (id != null) {
