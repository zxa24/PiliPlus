  149:   void downloadVideo(
  150:     Part page,
  151:     VideoDetailData? videoDetail,
  152:     ugc.EpisodeItem? videoArc,
  153:     VideoQuality videoQuality,
  154:   ) {
  155:     final cid = page.cid!;
  156:     if (downloadList.indexWhere((e) => e.cid == cid) != -1) {
  157:       return;
  158:     }
  159:     if (waitDownloadQueue.indexWhere((e) => e.cid == cid) != -1) {
  160:       return;
  161:     }
  162:     final pageData = PageInfo(
  163:       cid: cid,
  164:       page: page.page!,
  165:       from: page.from,
  166:       part: page.part,
  167:       vid: page.vid,
  168:       hasAlias: false,
  169:       tid: 0,
  170:       width: 0,
  171:       height: 0,
  172:       rotate: 0,
  173:       downloadTitle: '视频已缓存完成',
  174:       downloadSubtitle: videoDetail?.title ?? videoArc!.title,
  175:     );
  176:     final currentTime = DateTime.now().millisecondsSinceEpoch ~/ 1000;
  177:     final entry = BiliDownloadEntryInfo(
  178:       mediaType: 2,
  179:       hasDashAudio: false,
  180:       isCompleted: false,
  181:       totalBytes: 0,
  182:       downloadedBytes: 0,
  183:       title: videoDetail?.title ?? videoArc!.title!,
  184:       typeTag: videoQuality.code.toString(),
  185:       cover: (videoDetail?.pic ?? videoArc!.cover!).http2https,
  186:       preferedVideoQuality: videoQuality.code,
  187:       qualityPithyDescription: videoQuality.desc,
  188:       guessedTotalBytes: 0,
  189:       totalTimeMilli: (page.duration ?? 0) * 1000,
  190:       danmakuCount:
  191:           videoDetail?.stat?.danmaku ?? videoArc?.arc?.stat?.danmaku ?? 0,
  192:       timeUpdateStamp: currentTime,
  193:       timeCreateStamp: currentTime,
  194:       canPlayInAdvance: true,
  195:       interruptTransformTempFile: false,
  196:       avid: videoDetail?.aid ?? videoArc!.aid!,
  197:       spid: 0,
  198:       seasonId: null,
  199:       ep: null,
  200:       source: null,
  201:       bvid: videoDetail?.bvid ?? videoArc!.bvid!,
  202:       ownerId: videoDetail?.owner?.mid ?? videoArc?.arc?.author?.mid,
  203:       ownerName: videoDetail?.owner?.name ?? videoArc?.arc?.author?.name,
  204:       pageData: pageData,
  205:     );
  206:     _createDownload(entry);
  207:   }
