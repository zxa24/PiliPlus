  941:   static void _toWebview(
  942:     String url,
  943:     bool off,
  944:     Map? parameters,
  945:   ) {
  946:     // `bilibili://browser/?url=…` is attacker-controlled: only http(s) may
  947:     // reach the WebView, never file: / content: / javascript:
  948:     if (!url.http2https.isHttpUrl) {
  949:       return;
  950:     }
  951:     PageUtils.toDupNamed(
  952:       '/webview',
  953:       parameters: {
  954:         'url': url,
  955:         ...?parameters,
  956:       },
  957:       off: off,
  958:     );
  959:   }
