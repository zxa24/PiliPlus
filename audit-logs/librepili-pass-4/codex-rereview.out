  112:   static Future<void> pushDynFromId({
  113:     String? id,
  114:     Object? rid,
  115:     bool off = false,
  116:     Object? type,
  117:   }) async {
  118:     assert(id != null || rid != null);
  119:     SmartDialog.showLoading();
  120:     final res = await DynamicsHttp.dynamicDetail(
  121:       id: id,
  122:       rid: rid,
  123:       type: rid != null ? 2 : null,
  124:     );
  125:     SmartDialog.dismiss();
  126:     if (res case Success(:final response)) {
  127:       if (response.basic?.commentType == 12) {
  128:         toDupNamed(
  129:           '/articlePage',
  130:           parameters: {
  131:             'id': id!,
  132:             'type': 'opus',
  133:           },
  134:           off: off,
  135:         );
  136:       } else {
  137:         toDupNamed(
  138:           '/dynamicDetail',
  139:           arguments: {
  140:             'item': response,
  141:           },
  142:           off: off,
  143:         );
  144:       }
  145:     } else {
  146:       SmartDialog.showToast('${type != null ? 'type: $type ' : ''}$res');
  147:     }
  148:   }
