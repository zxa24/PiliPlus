  176:     final enterIncognito = !anonymity.value;
  177:     await GStorage.setting.put(SettingBoxKey.loginMode, !enterIncognito);
  178:     await Accounts.refresh();
  179:     anonymity.value = enterIncognito;
  180:     if (enterIncognito) {
