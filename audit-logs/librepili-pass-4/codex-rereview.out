  225:     public static void enterPip(long engineId, int width, int height, boolean autoEnter, boolean isLive, boolean isPlaying) {
  226:         if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
  227:             Activity activity = JniFlutterPlugin.getActivity(engineId);
  228:             assert activity != null;
  229:             PictureInPictureParams.Builder builder = new PictureInPictureParams.Builder()
  230:                     .setAspectRatio(new Rational(width, height));
  231:             setPipActions(activity, builder, isLive, isPlaying);
  232:             if (autoEnter) {
  233:                 if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
  234:                     builder.setAutoEnterEnabled(true);
  235:                     activity.setPictureInPictureParams(builder.build());
  236:                 }
  237:             } else {
  238:                 activity.enterPictureInPictureMode(builder.build());
  239:             }
  240:         }
  241:     }
  242: 
  243:     @RequiresApi(api = Build.VERSION_CODES.O)
  244:     public static void updatePipActions(long engineId, boolean isLive, boolean isPlaying) {
  245:         Activity activity = JniFlutterPlugin.getActivity(engineId);
  246:         assert activity != null;
  247:         PictureInPictureParams.Builder builder = new PictureInPictureParams.Builder();
  248:         setPipActions(activity, builder, isLive, isPlaying);
  249:         activity.setPictureInPictureParams(builder.build());
  250:     }
  251: 
  252:     @RequiresApi(api = Build.VERSION_CODES.O)
  253:     private static void setPipActions(Activity activity, PictureInPictureParams.Builder builder, boolean isLive, boolean isPlaying) {
  254:         ComponentName mbrComponent = MediaHelper.getMediaButtonReceiverComponent(activity);
  255:         if (mbrComponent == null) return;
  256:         ArrayList<RemoteAction> actionList = new ArrayList<>(3);
  257:         if (!isLive) {
  258:             actionList.add(getRemoteAction(mbrComponent, activity, R.drawable.ic_player_rewind_10s, "ACTION_REWIND", (int) PlaybackState.ACTION_REWIND));
  259:         }
  260:         if (isPlaying) {
  261:             actionList.add(getRemoteAction(mbrComponent, activity, R.drawable.ic_player_pause, "ACTION_PAUSE", (int) PlaybackState.ACTION_PAUSE));
  262:         } else {
  263:             actionList.add(getRemoteAction(mbrComponent, activity, R.drawable.ic_player_play, "ACTION_PLAY", (int) PlaybackState.ACTION_PLAY));
  264:         }
  265:         if (!isLive) {
  266:             actionList.add(getRemoteAction(mbrComponent, activity, R.drawable.ic_player_fast_forward_10s, "ACTION_FAST_FORWARD", (int) PlaybackState.ACTION_FAST_FORWARD));
  267:         }
  268:         builder.setActions(actionList);
  269:     }
  270: 
  271:     @RequiresApi(api = Build.VERSION_CODES.O)
  272:     private static RemoteAction getRemoteAction(@NonNull ComponentName mbrComponent, Activity activity, @DrawableRes int resId, String title, int action) {
  273:         return new RemoteAction(
  274:                 Icon.createWithResource(activity, resId),
  275:                 title,
  276:                 title,
  277:                 Objects.requireNonNull(MediaHelper.buildMediaButtonPendingIntent(activity, mbrComponent, action))
  278:         );
  279:     }
  280: 
  281:     public static void disableAutoEnterPip(long engineId) {
  282:         if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
  283:             Activity activity = JniFlutterPlugin.getActivity(engineId);
  284:             if (activity != null) {
  285:                 activity.setPictureInPictureParams(new PictureInPictureParams.Builder()
  286:                         .setAutoEnterEnabled(false)
  287:                         .build()
  288:                 );
  289:             }
  290:         }
  291:     }
  292: 
  293:     public static int[] maxScreenSize() {
  294:         Context context = getContext();
  295:         WindowManager wm = context.getSystemService(WindowManager.class);
  296:         try {
  297:             float density = context.getResources().getDisplayMetrics().density;
  298:             if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
  299:                 Rect maxBounds = wm.getMaximumWindowMetrics().getBounds();
  300:                 return new int[]{Math.round(maxBounds.width() / density), Math.round(maxBounds.height() / density)};
  301:             } else {
  302:                 Point realSize = new Point();
  303:                 wm.getDefaultDisplay().getRealSize(realSize);
  304:                 return new int[]{Math.round(realSize.x / density), Math.round(realSize.y / density)};
  305:             }
  306:         } catch (Exception ignored) {
  307:             return null;
  308:         }
  309:     }
  310: 
  311:     public static void createShortcut(@NonNull String id, @NonNull String uri, @NonNull String label, @NonNull String icon) {
  312:         if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
  313:             Context context = getContext();
  314:             ShortcutManager shortcutManager = context.getSystemService(ShortcutManager.class);
  315:             if (shortcutManager != null && shortcutManager.isRequestPinShortcutSupported()) {
  316:                 // the cached avatar can be missing / corrupt / not an image
  317:                 Bitmap bitmap = BitmapFactory.decodeFile(icon);
  318:                 Icon shortcutIcon = bitmap != null
  319:                         ? Icon.createWithAdaptiveBitmap(bitmap)
  320:                         : Icon.createWithResource(context, R.mipmap.ic_launcher);
  321:                 ShortcutInfo shortcut = new ShortcutInfo.Builder(context, id)
  322:                         .setShortLabel(label)
  323:                         .setIcon(shortcutIcon)
  324:                         .setIntent(new Intent(Intent.ACTION_VIEW, Uri.parse(uri)))
  325:                         .build();
  326:                 // TODO: WorkerThread
  327:                 Intent pinIntent = shortcutManager.createShortcutResultIntent(shortcut);
  328:                 PendingIntent pendingIntent = PendingIntent.getBroadcast(
  329:                         context, 0, pinIntent, PendingIntent.FLAG_IMMUTABLE
  330:                 );
  331:                 shortcutManager.requestPinShortcut(shortcut, pendingIntent.getIntentSender());
  332:             }
  333:         }
  334:     }
  335: 
  336:     @SuppressLint("BlockedPrivateApi")
  337:     public static String[] fontFamilies() {
  338:         Map<String, Typeface> systemFontMap = null;
  339:         try {
  340:             Method method = Typeface.class.getDeclaredMethod("getSystemFontMap");
  341:             method.setAccessible(true);
  342:             systemFontMap = (Map<String, Typeface>) method.invoke(null);
  343:         } catch (Exception ignored) {
  344:             try {
  345:                 @SuppressLint("DiscouragedPrivateApi") Field field = Typeface.class.getDeclaredField("sSystemFontMap");
  346:                 field.setAccessible(true);
  347:                 systemFontMap = (Map<String, Typeface>) field.get(null);
  348:             } catch (Exception ignored0) {
  349:             }
  350:         }
  351:         if (null != systemFontMap) {
  352:             return systemFontMap.keySet().toArray(new String[0]);
  353:         }
  354:         return null;
  355:     }
  356: 
  357:     public static void updateDocProvider(boolean enabled) {
  358:         Context context = getContext();
  359:         final ComponentName componentName = new ComponentName(context, BiliDocumentsProvider.class);
  360:         final int state = enabled ? PackageManager.COMPONENT_ENABLED_STATE_ENABLED
--- android/app/build.gradle.kts
    1: import com.android.build.gradle.internal.api.ApkVariantOutputImpl
    2: import org.jetbrains.kotlin.konan.properties.Properties
    3: 
    4: plugins {
    5:     id("com.android.application")
    6:     // The Flutter Gradle Plugin must be applied after the Android and Kotlin Gradle plugins.
    7:     id("dev.flutter.flutter-gradle-plugin")
    8: }
    9: 
   10: val agpMajorVersion = com.android.Version.ANDROID_GRADLE_PLUGIN_VERSION
   11:     .substringBefore('.')
   12:     .toInt()
   13: val builtInKotlinProperty = providers.gradleProperty("android.builtInKotlin").orNull
   14: val isBuiltInKotlinEnabled = agpMajorVersion >= 9 &&
   15:         (builtInKotlinProperty == null || builtInKotlinProperty.toBoolean())
   16: if (!isBuiltInKotlinEnabled) {
   17:     apply(plugin = "org.jetbrains.kotlin.android")
   18: }
   19: 
   20: android {
   21:     namespace = "com.example.piliplus"
   22:     compileSdk = 37
   23:     ndkVersion = flutter.ndkVersion
   24: 
   25:     compileOptions {
   26:         sourceCompatibility = JavaVersion.VERSION_17
   27:         targetCompatibility = JavaVersion.VERSION_17
   28:     }
   29: 
   30:     defaultConfig {
   31:         applicationId = "com.zxa24.librepili"
   32:         minSdk = flutter.minSdkVersion
   33:         targetSdk = 37
   34:         versionCode = flutter.versionCode
   35:         versionName = flutter.versionName
   36:     }
   37: 
   38:     packagingOptions.jniLibs.useLegacyPackaging = true
   39: 
   40:     val keyProperties = Properties().also {
   41:         val properties = rootProject.file("key.properties")
   42:         if (properties.exists())
   43:             it.load(properties.inputStream())
   44:     }
   45: 
   46:     val config = keyProperties.getProperty("storeFile")?.let {
   47:         // a half-configured keystore would silently produce a release the
   48:         // installed builds cannot be updated from: fail instead
   49:         val missing = listOf("storePassword", "keyAlias", "keyPassword")
   50:             .filter { key -> keyProperties.getProperty(key).isNullOrEmpty() }
   51:         if (missing.isNotEmpty())
   52:             throw GradleException(
   53:                 "android/key.properties has storeFile but no ${missing.joinToString()}"
   54:             )
   55:         signingConfigs.create("release") {
   56:             storeFile = file(it)
   57:             storePassword = keyProperties.getProperty("storePassword")
   58:             keyAlias = keyProperties.getProperty("keyAlias")
   59:             keyPassword = keyProperties.getProperty("keyPassword")
   60:             enableV1Signing = true
   61:             enableV2Signing = true
   62:         }
   63:     }
   64: 
   65:     buildFeatures {
   66:         if (project.hasProperty("dev")) {
   67:             resValues = true
   68:         }
   69:     }
   70: 
   71:     buildTypes {
   72:         all {
   73:             signingConfig = config ?: signingConfigs["debug"]
   74:         }
   75:         release {
   76:             if (project.hasProperty("dev")) {
   77:                 applicationIdSuffix = ".dev"
   78:                 resValue(
   79:                     type = "string",
   80:                     name = "app_name",
   81:                     value = "LibrePili dev",
   82:                 )
   83:             }
   84: //            proguardFiles(
   85: //                getDefaultProguardFile("proguard-android-optimize.txt"),
   86: //                "proguard-rules.pro"
   87: //            )
   88:         }
   89:         debug {
   90:             applicationIdSuffix = ".debug"
   91:         }
   92:     }
   93: 
   94:     applicationVariants.all {
   95:         val variant = this
   96:         variant.outputs.forEach { output ->
   97:             (output as ApkVariantOutputImpl).versionCodeOverride = flutter.versionCode
   98:         }
   99:     }
  100: }
  101: 
  102: kotlin {
  103:     compilerOptions {
  104:         jvmTarget = org.jetbrains.kotlin.gradle.dsl.JvmTarget.JVM_17
  105:     }
  106: }
  107: 
  108: flutter {
  109:     source = "../.."
  110: }
--- .github/workflows/build.yml
    1: name: Build
    2: 
    3: on:
    4:     # pull_request:
    5:     #     types:
    6:     #         - opened
    7:     #         - synchronize
    8:     #         - reopened
    9:     #         - ready_for_review
   10:     #     paths-ignore:
   11:     #         - "**.md"
   12:     workflow_dispatch:
   13:         inputs:
   14:             build_android:
   15:                 description: "Build Android"
   16:                 required: false
   17:                 default: true
   18:                 type: boolean
   19: 
   20:             build_ios:
   21:                 description: "Build iOS"
   22:                 required: false
   23:                 default: true
   24:                 type: boolean
   25: 
   26:             build_mac:
   27:                 description: "Build Mac"
   28:                 required: false
   29:                 default: true
   30:                 type: boolean
   31: 
   32:             build_win_x64:
   33:                 description: "Build Win-x64"
   34:                 required: false
   35:                 default: true
   36:                 type: boolean
   37: 
   38:             build_linux_x64:
   39:                 description: "Build Linux-x64"
   40:                 required: false
   41:                 default: true
   42:                 type: boolean
   43: 
   44:             tag:
   45:                 description: "tag"
   46:                 required: false
   47:                 default: ""
   48:                 type: string
   49: 
   50: jobs:
   51:     android:
   52:         if: ${{ github.event.inputs.build_android == 'true' }}
   53:         name: Release Android
   54:         runs-on: ubuntu-latest
   55:         permissions:
   56:             contents: write # publishing the release only
   57: 
   58:         steps:
   59:             - name: 代码迁出
   60:               uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
   61:               with:
   62:                   fetch-depth: 0
   63: 
   64:             - name: 构建Java环境
   65:               uses: actions/setup-java@b6effb05e454b25005698d916606bdc6ffcbf961 # v5
   66:               with:
   67:                   distribution: "zulu"
   68:                   java-version: "17"
   69:                   cache: "gradle"
   70:                   cache-dependency-path: |
   71:                       android/*.gradle*
   72:                       android/**/gradle-wrapper.properties
   73: 
   74:             - name: 安装Flutter
   75:               uses: subosito/flutter-action@1a449444c387b1966244ae4d4f8c696479add0b2 # v2
   76:               id: flutter-action
   77:               with:
   78:                   channel: stable
   79:                   flutter-version-file: pubspec.yaml
   80:                   cache: true
   81: 
   82:             - name: Apply Patch
   83:               shell: pwsh
   84:               run: lib/scripts/patch.ps1 android
   85: 
   86:             - name: Write key
   87:               if: github.event_name == 'workflow_dispatch'
   88:               # via env, not inline interpolation: a password containing a
   89:               # quote would otherwise break (or escape) the shell command
   90:               env:
   91:                   SIGN_KEYSTORE_BASE64: ${{ secrets.SIGN_KEYSTORE_BASE64 }}
   92:                   KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
   93:                   KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
   94:                   KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
   95:                   TAG: ${{ github.event.inputs.tag }}
   96:               run: |
   97:                   if [ -n "$SIGN_KEYSTORE_BASE64" ]; then
   98:                     # all four are needed: a half-configured keystore would
   99:                     # fail at signing time, or (worse) fall back to the debug key
  100:                     if [ -z "$KEYSTORE_PASSWORD" ] || [ -z "$KEY_ALIAS" ] || [ -z "$KEY_PASSWORD" ]; then
  101:                       echo "::error::SIGN_KEYSTORE_BASE64 is set but KEYSTORE_PASSWORD / KEY_ALIAS / KEY_PASSWORD is empty"
  102:                       exit 1
  103:                     fi
  104:                     printf '%s' "$SIGN_KEYSTORE_BASE64" | base64 --decode > android/app/key.jks
  105:                     {
  106:                       echo "storeFile=key.jks"
  107:                       echo "storePassword=$KEYSTORE_PASSWORD"
  108:                       echo "keyAlias=$KEY_ALIAS"
  109:                       echo "keyPassword=$KEY_PASSWORD"
  110:                     } >> android/key.properties
  111:                   elif [ -n "$TAG" ]; then
  112:                     # a tagged release signed with the runner's throwaway debug
  113:                     # key cannot update installed builds (users would have to
  114:                     # uninstall and lose local follows / favorites)
  115:                     echo "::error::SIGN_KEYSTORE_BASE64 is not set: refusing to build a tagged release"
  116:                     exit 1
  117:                   fi
  118: 
  119:             - name: Set and Extract version
  120:               if: ${{ github.event_name == 'workflow_dispatch' }}
  121:               shell: pwsh
  122:               run: lib/scripts/build.ps1 android
  123: 
  124:             - name: Flutter Build Release Apk
  125:               if: ${{ github.event_name == 'workflow_dispatch' }}
  126:               run: flutter build apk --release --split-per-abi --dart-define-from-file=pili_release.json --no-pub
  127: 
  128:             - name: Rename
  129:               run: |
  130:                   for file in build/app/outputs/flutter-apk/app-*-release.apk; do
  131:                     abi=$(echo "$file" | sed -E 's|.*app-(.*)-release\.apk|\1|')
  132:                     mv "$file" "LibrePili_android_${{ env.version }}_${abi}.apk"
  133:                   done
  134:               shell: bash
  135: 
  136:             - name: Release
  137:               if: ${{ github.event_name == 'workflow_dispatch' && github.event.inputs.tag != '' }}
  138:               uses: softprops/action-gh-release@efb35369e0ad2afab669f228072c1b0d510eae64 # v3
  139:               with:
  140:                   tag_name: ${{ github.event.inputs.tag }}
  141:                   name: ${{ github.event.inputs.tag }}
  142:                   files: LibrePili_android_*.apk
  143: 
  144:             - name: 上传
  145:               uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
  146:               with:
  147:                   archive: false
  148:                   name: Android_arm64-v8a
  149:                   path: LibrePili_android_*_arm64-v8a.apk
  150: 
  151:             - name: 上传
  152:               uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
  153:               with:
  154:                   archive: false
  155:                   name: Android_armeabi-v7a
  156:                   path: LibrePili_android_*_armeabi-v7a.apk
  157: 
  158:             - name: 上传
  159:               uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
  160:               with:
  161:                   archive: false
  162:                   name: Android_x86_64
  163:                   path: LibrePili_android_*_x86_64.apk
  164: 
  165:     ios:
  166:         if: ${{ github.event.inputs.build_ios == 'true' }}
  167:         uses: ./.github/workflows/ios.yml
  168:         permissions:
  169:             contents: write # publishing the release only
  170:         with:
  171:             tag: ${{ github.event_name == 'workflow_dispatch' && github.event.inputs.tag || '' }}
  172: 
  173:     mac:
  174:         if: ${{ github.event.inputs.build_mac == 'true' }}
  175:         uses: ./.github/workflows/mac.yml
  176:         permissions:
  177:             contents: write # publishing the release only
  178:         with:
  179:             tag: ${{ github.event_name == 'workflow_dispatch' && github.event.inputs.tag || '' }}
  180: 
  181:     win_x64:
  182:         if: ${{ github.event.inputs.build_win_x64 == 'true' }}
  183:         uses: ./.github/workflows/win_x64.yml
  184:         permissions:
  185:             contents: write # publishing the release only
  186:         with:
  187:             tag: ${{ github.event_name == 'workflow_dispatch' && github.event.inputs.tag || '' }}
  188: 
  189:     linux_x64:
  190:         if: ${{ github.event.inputs.build_linux_x64 == 'true' }}
  191:         uses: ./.github/workflows/linux_x64.yml
  192:         permissions:
  193:             contents: write # publishing the release only
  194:         with:
  195:             tag: ${{ github.event_name == 'workflow_dispatch' && github.event.inputs.tag || '' }}
--- .github/workflows/linux_x64.yml
    1: name: Build for Linux x64
    2: 
    3: on:
    4:   workflow_call:
    5:     inputs:
    6:       tag:
    7:         description: "tag"
    8:         required: false
    9:         default: ""
   10:         type: string
   11:   workflow_dispatch:
   12: 
   13: jobs:
   14:   build-linux-app:
   15:     name: Release Linux x64
   16:     runs-on: ubuntu-latest
   17:     permissions:
   18:       contents: write # publishing the release only
   19:     steps:
   20:       - name: Checkout repository
   21:         uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
   22:         with:
   23:           fetch-depth: 0
   24: 
   25:       - name: Install dependencies
   26:         run: |
   27:           sudo apt-get update
   28:           sudo apt-get install -y libgtk-3-dev libayatana-appindicator3-dev webkit2gtk-4.1 libasound2-dev libmpv-dev
   29:         shell: bash
   30: 
   31:       - name: Setup flutter
   32:         uses: subosito/flutter-action@1a449444c387b1966244ae4d4f8c696479add0b2 # v2
   33:         with:
   34:           channel: stable
   35:           flutter-version-file: pubspec.yaml
   36:           cache: true
   37: 
   38:       - name: Set and Extract version
   39:         shell: pwsh
   40:         run: lib/scripts/build.ps1
   41: 
   42:       - name: Apply Patch
   43:         shell: pwsh
   44:         run: lib/scripts/patch.ps1 Linux
   45: 
   46:         #TODO: deb and rpm packages need to be build
   47:       - name: Build Linux
   48:         run: flutter build linux --release --dart-define-from-file=pili_release.json --no-pub
   49: 
   50:       - name: Package .tar.gz
   51:         run: tar -zcvf LibrePili_linux_${{ env.version }}_amd64.tar.gz -C build/linux/x64/release/bundle .
   52: 
   53:       - name: Packege deb
   54:         run: |
   55:           printf "建立构建目录...\n"
   56:           mkdir "LibrePili_linux_${{ env.version }}_amd64"
   57:           pushd "LibrePili_linux_${{ env.version }}_amd64"
   58:           mkdir -p opt/LibrePili
   59:           mkdir -p usr/share/applications
   60:           mkdir -p usr/share/icons/hicolor/512x512/apps
   61: 
   62:           printf "复制文件...\n"
   63:           cp -r ../build/linux/x64/release/bundle/* opt/LibrePili
   64:           cp -r ../assets/linux/DEBIAN .
   65:           cp ../assets/linux/com.zxa24.librepili.desktop usr/share/applications
   66:           cp ../assets/images/logo/logo.png usr/share/icons/hicolor/512x512/apps/librepili.png
   67: 
   68:           printf "修改控制文件...\n"
   69:           # 替换版本号
   70:           sed -i  "2s/version_need_change/${{ env.version }}/g" DEBIAN/control
   71:           # 计算安装大小并替换
   72:           SIZE_KB=$(du -s -b --apparent-size . | awk '{print int($1)}')
   73:           SIZE_KB=$(($SIZE_KB - $(du -s -b --apparent-size DEBIAN | awk '{print int($1)}')))
   74:           SIZE_KB=$(echo $SIZE_KB | awk '{print int($1/1024 + 0.999)}')
   75:           printf "\t安装大小: %s KB\n" "$SIZE_KB"
   76:           sed -i "9s/size_need_change/${SIZE_KB}/g" DEBIAN/control
   77: 
   78:           printf "生成并写入 md5sums ...\n"
   79:           md5sum opt/LibrePili/librepili >> DEBIAN/md5sums
   80:           md5sum opt/LibrePili/lib/* >> DEBIAN/md5sums
   81:           md5sum opt/LibrePili/data/icudtl.dat >> DEBIAN/md5sums
   82: 
   83:           printf "设置权限...\n"
   84:           chmod 0644 DEBIAN/control
   85:           chmod 0644 DEBIAN/md5sums
   86:           chmod 0755 DEBIAN/postinst
   87:           chmod 0755 DEBIAN/postrm
   88:           chmod 0755 DEBIAN/prerm
   89: 
   90:           printf "打包 deb 文件...\n"
   91:           popd
   92:           dpkg-deb --build --verbose --root-owner-group "LibrePili_linux_${{ env.version }}_amd64"
   93:           printf "完成: LibrePili_linux_%s_amd64.deb\n" "${{ env.version }}"
   94:         shell: bash
   95: 
   96:       - name: Packege rpm
   97:         run: |
   98:           printf "建立 RPM 构建目录...\n"
   99:           RPM_BUILD_ROOT="$PWD/rpm_build"
  100:           mkdir -p "$RPM_BUILD_ROOT/BUILD" "$RPM_BUILD_ROOT/RPMS" "$RPM_BUILD_ROOT/SOURCES" "$RPM_BUILD_ROOT/SPECS" "$RPM_BUILD_ROOT/SRPMS"
  101: 
  102:           printf "准备源码归档（仅包含运行时与元数据）...\n"
  103:           DATE="$(date '+%a %b %d %Y')"
  104:           SRC_DIR="$PWD/librepili-${{ env.version }}"
  105:           mkdir -p "$SRC_DIR/bundle" "$SRC_DIR/assets"
  106:           cp -r build/linux/x64/release/bundle/* "$SRC_DIR/bundle/"
  107:           cp assets/linux/com.zxa24.librepili.desktop "$SRC_DIR/assets/com.zxa24.librepili.desktop"
  108:           cp assets/images/logo/logo.png "$SRC_DIR/assets/librepili.png"
  109:           tar -zcvf "$RPM_BUILD_ROOT/SOURCES/librepili-${{ env.version }}.tar.gz" -C "$PWD" "librepili-${{ env.version }}"
  110: 
  111:           printf "生成 spec 文件...\n"
  112:           cat > "$RPM_BUILD_ROOT/SPECS/librepili.spec" <<EOF
  113:           Name:           librepili
  114:           Version:        ${{ env.version }}
  115:           Release:        1%{?dist}
  116:           Summary:        LibrePili Linux Version
  117:           License:        GPL-3.0
  118:           Source0:        librepili-${{ env.version }}.tar.gz
  119:           Requires:       desktop-file-utils, hicolor-icon-theme
  120: 
  121:           %description
  122:           使用 Flutter 开发的 BiliBili 第三方客户端
  123: 
  124:           %prep
  125:           %setup -q -n librepili-${{ env.version }}
  126: 
  127:           %build
  128: 
  129:           %install
  130:           mkdir -p %{buildroot}/opt/LibrePili
  131:           cp -r bundle/* %{buildroot}/opt/LibrePili/
  132: 
  133:           # 二进制权限与命令行入口
  134:           chmod 755 %{buildroot}/opt/LibrePili/librepili
  135:           mkdir -p %{buildroot}/usr/bin
  136:           ln -sf /opt/LibrePili/librepili %{buildroot}/usr/bin/librepili
  137: 
  138:           # 桌面集成
  139:           mkdir -p %{buildroot}/usr/share/applications
  140:           install -m 644 assets/com.zxa24.librepili.desktop %{buildroot}/usr/share/applications/com.zxa24.librepili.desktop
  141: 
  142:           mkdir -p %{buildroot}/usr/share/icons/hicolor/512x512/apps
  143:           install -m 644 assets/librepili.png %{buildroot}/usr/share/icons/hicolor/512x512/apps/librepili.png
  144: 
  145:           %post
  146:           update-desktop-database -q || true
  147:           gtk-update-icon-cache -q -t -f %{_datadir}/icons/hicolor || true
  148: 
  149:           %postun
  150:           update-desktop-database -q || true
  151:           gtk-update-icon-cache -q -t -f %{_datadir}/icons/hicolor || true
  152: 
  153:           %files
  154:           /opt/LibrePili
  155:           /usr/bin/librepili
  156:           /usr/share/applications/com.zxa24.librepili.desktop
  157:           /usr/share/icons/hicolor/512x512/apps/librepili.png
  158: 
  159:           %changelog
  160:           * DATE - ${{ env.version }}-1
  161:           - Initial RPM release
  162:           EOF
  163: 
  164:           sed -i "s/DATE/${DATE}/g" "$RPM_BUILD_ROOT/SPECS/librepili.spec"
  165: 
  166:           printf "构建 RPM 包...\n"
  167:           rpmbuild --define "_topdir $RPM_BUILD_ROOT" -bb "$RPM_BUILD_ROOT/SPECS/librepili.spec"
  168: 
  169:           printf "移动生成的 RPM...\n"
  170:           find "$RPM_BUILD_ROOT/RPMS" -name "*.rpm" -exec mv {} "LibrePili_linux_${{ env.version }}_amd64.rpm" \;
  171: 
  172:           printf "完成: LibrePili_linux_%s_amd64.rpm\n" "${{ env.version }}"
  173:         shell: bash
  174: 
  175:       - name: Package AppImage
  176:         run: |
  177:           printf "下载 appimagetool...\n"
  178:           # a fixed release, checked against its sha256 (not the moving
  179:           # `continuous` tag)
  180:           wget -q https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-x86_64.AppImage
  181:           echo "ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0  appimagetool-x86_64.AppImage" | sha256sum -c -
  182:           chmod +x appimagetool-x86_64.AppImage
  183: 
  184:           printf "建立 AppDir 目录结构...\n"
  185:           APPDIR="LibrePili.AppDir"
  186:           mkdir -p "$APPDIR/usr/bin"
  187:           mkdir -p "$APPDIR/usr/lib"
  188:           mkdir -p "$APPDIR/usr/share/applications"
  189:           mkdir -p "$APPDIR/usr/share/icons/hicolor/512x512/apps"
  190: 
  191:           printf "复制应用文件...\n"
  192:           cp -r build/linux/x64/release/bundle/* "$APPDIR/usr/bin/"
  193: 
  194:           printf "复制桌面文件和图标...\n"
  195:           cp assets/linux/com.zxa24.librepili.desktop "$APPDIR/com.zxa24.librepili.desktop"
  196:           cp assets/linux/com.zxa24.librepili.desktop "$APPDIR/usr/share/applications/com.zxa24.librepili.desktop"
  197:           cp assets/images/logo/logo.png "$APPDIR/librepili.png"
  198:           cp assets/images/logo/logo.png "$APPDIR/usr/share/icons/hicolor/512x512/apps/librepili.png"
  199: 
  200:           printf "创建 AppRun 启动脚本...\n"
  201:           cat > "$APPDIR/AppRun" <<'APPRUN_EOF'
  202:           #!/bin/bash
  203:           SELF=$(readlink -f "$0")
  204:           HERE=${SELF%/*}
  205:           export PATH="${HERE}/usr/bin:${PATH}"
  206:           export LD_LIBRARY_PATH="${HERE}/usr/lib:${LD_LIBRARY_PATH}"
  207:           exec "${HERE}/usr/bin/librepili" "$@"
  208:           APPRUN_EOF
  209:           chmod +x "$APPDIR/AppRun"
  210: 
  211:           printf "打包 AppImage...\n"
  212:           ARCH=x86_64 ./appimagetool-x86_64.AppImage "$APPDIR" "LibrePili_linux_${{ env.version }}_amd64.AppImage"
  213: 
  214:           printf "完成: LibrePili_linux_%s_amd64.AppImage\n" "${{ env.version }}"
  215:         shell: bash
  216: 
  217:       - name: Release
  218:         if: ${{ inputs.tag != '' }}
  219:         uses: softprops/action-gh-release@efb35369e0ad2afab669f228072c1b0d510eae64 # v3
  220:         with:
  221:           tag_name: ${{ inputs.tag }}
  222:           name: ${{ inputs.tag }}
  223:           files: |
  224:             LibrePili_linux_*.tar.gz
  225:             LibrePili_linux_*.deb
  226:             LibrePili_linux_*.rpm
  227:             LibrePili_linux_*.AppImage
  228: 
  229:       - name: Upload linux targz package
  230:         uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
  231:         with:
  232:           archive: false
  233:           name: Linux_targz_amd64_packege
  234:           path: LibrePili_linux_*.tar.gz
  235: 
  236:       - name: Upload linux deb package
  237:         uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
  238:         with:
  239:           archive: false
  240:           name: Linux_deb_amd64_package
  241:           path: LibrePili_linux_*.deb
  242: 
  243:       - name: Upload linux rpm package
  244:         uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
  245:         with:
  246:           archive: false
  247:           name: Linux_rpm_amd64_package
  248:           path: LibrePili_linux_*.rpm
  249: 
  250:       - name: Upload linux AppImage package
  251:         uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
  252:         with:
  253:           archive: false
  254:           name: Linux_AppImage_amd64_package
  255:           path: LibrePili_linux_*.AppImage
--- lib/scripts/patch.ps1
    1: param(
    2:     [string]$platform = ""
    3: )
    4: 
    5: # only on the CI runner: `git apply` needs no identity, and a contributor
    6: # running this locally must keep their own
    7: if ($env:GITHUB_ACTIONS -eq "true") {
    8:     git config --global user.name "ci"
    9:     git config --global user.email "example@example.com"
   10: }
   11: 
   12: # TODO: remove
   13: # https://github.com/flutter/flutter/issues/182281
   14: $NewOverScrollIndicator = "362b1de29974ffc1ed6faa826e1df870d7bec75f";
   15: 
   16: # set `gestureSettings`
   17: $BottomSheetAndroidPatch = "lib/scripts/bottom_sheet_android.patch"
   18: 
   19: # https://github.com/bggRGjQaUbCoE/PiliPlus/issues/1906
   20: $BottomSheetIOSFlutterPatch = "lib/scripts/bottom_sheet_ios_flutter.patch"
   21: $BottomSheetIOSPiliPlusPatch = "lib/scripts/bottom_sheet_ios_piliplus.patch"
   22: 
   23: # https://github.com/bggRGjQaUbCoE/PiliPlus/issues/1662
   24: # handle bottom scroll event
   25: $ScrollViewPatch = "lib/scripts/scroll_view.patch"
   26: 
   27: # https://github.com/bggRGjQaUbCoE/PiliPlus/issues/2106
   28: # use `TouchGestureRecognizer` on all platforms
   29: $TextSelectionPatch = "lib/scripts/text_selection.patch"
   30: 
   31: # https://github.com/bggRGjQaUbCoE/PiliPlus/issues/1947
   32: $NavigatorPatch = "lib/scripts/navigator.patch"
   33: 
   34: # https://github.com/bggRGjQaUbCoE/PiliPlus/issues/2107
   35: $ImageAnimPatch = "lib/scripts/image_anim.patch"
   36: 
   37: # remove `_scheduleRebuild`
   38: $LayoutBuilderPatch = "lib/scripts/layout_builder.patch"
   39: 
   40: # https://github.com/bggRGjQaUbCoE/PiliPlus/issues/2308
   41: $NavigationDrawerPatch = "lib/scripts/navigation_drawer.patch"
   42: 
   43: # apply text color to icon color
   44: $PopupMenuPatch = "lib/scripts/popup_menu.patch"
   45: 
   46: # remove `Hero` effect
   47: $FABPatch = "lib/scripts/fab.patch"
   48: 
   49: # https://github.com/flutter/flutter/issues/139890
   50: # https://github.com/flutter/flutter/issues/174689
   51: # separator support
   52: # clamp handle offset
   53: # widgetspan selection support
   54: # clear selection when tapping outside
   55: # free selection if there is only one text
   56: # clamp dragging selection behavior on Android
   57: # show selection menu if secondary tap position is in text region on desktop
   58: $SelectableRegionPatch = "lib/scripts/selectable_region.patch"
   59: 
   60: # https://github.com/flutter/flutter/issues/132047
   61: # https://github.com/flutter/flutter/issues/174689
   62: $EditableTextPatch = "lib/scripts/editable_text.patch"
   63: 
   64: # set `selectAllOnFocus` to `false` by default
   65: $TextFieldPatch = "lib/scripts/text_field.patch"
   66: 
   67: # notify `userScrollDirection` only if position is actually changing
   68: $ScrollPositionPatch = "lib/scripts/scroll_position.patch"
   69: 
   70: # expose `_shouldIgnorePointer`
   71: $ScrollablePatch = "lib/scripts/scrollable.patch"
   72: 
   73: # expose
   74: $ScaffoldPatch = "lib/scripts/scaffold.patch"
   75: 
   76: # fix nested scrollable gesture
   77: # custom `HorizontalDragGestureRecognizer` support
   78: $ScrollableGesturePatch = "lib/scripts/scrollable_gesture.patch"
   79: 
   80: # expose
   81: $DraggableScrollableSheetPatch = "lib/scripts/draggable_scrollable_sheet.patch"
   82: 
   83: # expose
   84: $TextPatch = "lib/scripts/text.patch"
   85: 
   86: # expose
   87: $TextPainterPatch = "lib/scripts/text_painter.patch"
   88: 
   89: $SliverPatch = "lib/scripts/sliver.patch"
   90: 
   91: $RefreshIndicatorPatch = "lib/scripts/refresh_indicator.patch"
   92: 
   93: # TODO: remove
   94: # https://github.com/flutter/flutter/issues/124078
   95: # https://github.com/flutter/flutter/pull/183261
   96: $NullSafetySelectableRegionPatch = "lib/scripts/null_safety_for_selectable_region.patch"
   97: 
   98: # TODO: remove
   99: # https://github.com/flutter/flutter/issues/90223
  100: $ModalBarrierPatch = "lib/scripts/modal_barrier.patch"
  101: 
  102: # TODO: remove
  103: # https://github.com/flutter/flutter/issues/182466
  104: $MouseCursorPatch = "lib/scripts/mouse_cursor.patch"
  105: 
  106: $GeetestIOSPatch = "lib/scripts/geetest_ios.patch"
  107: 
  108: if ($platform.ToLower() -eq "ios") {
  109:     git apply $BottomSheetIOSPiliPlusPatch
  110:     if ($LASTEXITCODE -eq 0) {
  111:         Write-Host "$BottomSheetIOSPiliPlusPatch applied"
  112:     } else {
  113:         throw "$LASTEXITCODE"
  114:     }
  115:     git apply $GeetestIOSPatch
  116:     if ($LASTEXITCODE -eq 0) {
  117:         Write-Host "$GeetestIOSPatch applied"
  118:     } else {
  119:         throw "$LASTEXITCODE"
  120:     }
  121: }
  122: 
  123: Set-Location $env:FLUTTER_ROOT
  124: 
  125: $picks   = @()
  126: $reverts = @()
  127: $patches = @($ModalBarrierPatch, $TextSelectionPatch, $MouseCursorPatch,
  128:             $ImageAnimPatch, $LayoutBuilderPatch, $NavigationDrawerPatch,
  129:             $PopupMenuPatch, $FABPatch, $NullSafetySelectableRegionPatch,
  130:             $SelectableRegionPatch, $EditableTextPatch, $TextFieldPatch,
  131:             $ScrollPositionPatch, $ScrollablePatch, $ScrollableGesturePatch,
  132:             $DraggableScrollableSheetPatch, $ScaffoldPatch, $TextPatch,
  133:             $TextPainterPatch, $SliverPatch, $RefreshIndicatorPatch)
  134: 
  135: switch ($platform.ToLower()) {
  136:     "android" {
  137:         $patches += $BottomSheetAndroidPatch
  138:         $patches += $ScrollViewPatch
  139:         $patches += $NavigatorPatch
  140: 
  141:         git reset --hard HEAD
  142:     }
  143:     "ios" {
  144:         $patches += $ScrollViewPatch
  145:         $patches += $BottomSheetIOSFlutterPatch
  146:         $patches += $NavigatorPatch
  147:     }
  148:     "linux" {
  149:         git reset --hard HEAD
  150:     }
  151:     "macos" {
  152:     }
  153:     "windows" {
  154:     }
  155:     default {}
  156: }
  157: 
  158: foreach ($pick in $picks) {
  159:     git stash
  160:     git cherry-pick $pick --no-edit
  161:     if ($LASTEXITCODE -eq 0) {
  162:         git reset --soft HEAD~1
  163:         Write-Host "$pick picked"
  164:     } else {
  165:         throw "$LASTEXITCODE"
  166:     }
  167:     git stash pop
  168: }
  169: 
  170: foreach ($revert in $reverts) {
  171:     git stash
  172:     git revert $revert --no-edit
  173:     if ($LASTEXITCODE -eq 0) {
  174:         git reset --soft HEAD~1
  175:         Write-Host "$revert reverted"
  176:     } else {
  177:         throw "$LASTEXITCODE"
  178:     }
  179:     git stash pop
  180: }
  181: 
  182: foreach ($patch in $patches) {
  183:     git apply "$env:GITHUB_WORKSPACE/$patch"
  184:     if ($LASTEXITCODE -eq 0) {
  185:         Write-Host "$patch applied"
  186:     } else {
  187:         throw "$LASTEXITCODE"
  188:     }
  189: }
  190: 
  191: Set-Location $env:GITHUB_WORKSPACE
  192: 
  193: $BottomSheetAndroidPatchMaterial = "lib/scripts/material/bottom_sheet_android.patch"
  194: 
  195: $BottomSheetIOSFlutterMaterialPatchMaterial = "lib/scripts/material/bottom_sheet_ios_flutter_material.patch"
  196: 
  197: $ModalBarrierPatchMaterial = "lib/scripts/material/modal_barrier_material.patch"
  198: 
  199: $NavigationDrawerPatchMaterial = "lib/scripts/material/navigation_drawer.patch"
  200: 
  201: $PopupMenuPatchMaterial = "lib/scripts/material/popup_menu.patch"
  202: 
  203: $FABPatchMaterial = "lib/scripts/material/fab.patch"
  204: 
  205: $TextFieldPatchMaterial = "lib/scripts/material/text_field.patch"
  206: 
  207: $ScaffoldPatchMaterial = "lib/scripts/material/scaffold.patch"
  208: 
  209: $RefreshIndicatorPatchMaterial = "lib/scripts/material/refresh_indicator.patch"
  210: 
  211: $TabsPatchMaterial = "lib/scripts/material/tabs.patch"
  212: 
  213: $patches_material = @($ModalBarrierPatchMaterial, $NavigationDrawerPatchMaterial, $PopupMenuPatchMaterial,
  214:                     $FABPatchMaterial, $TextFieldPatchMaterial, $ScaffoldPatchMaterial, $RefreshIndicatorPatchMaterial,
  215:                     $TabsPatchMaterial)
  216: 
  217: $PubCacheDir = "~/.pub-cache"
  218: 
  219: switch ($platform.ToLower()) {
  220:     "android" {
  221:         $patches_material += $BottomSheetAndroidPatchMaterial
  222:     }
  223:     "ios" {
  224:         $patches_material += $BottomSheetIOSFlutterMaterialPatchMaterial
  225:     }
  226:     "linux" {
  227:     }
  228:     "macos" {
  229:     }
  230:     "windows" {
  231:         $PubCacheDir = "$env:LOCALAPPDATA/Pub/Cache"
  232:     }
  233:     default {}
  234: }
  235: 
  236: # Resolve the cached package from the version pub actually resolved, not from
  237: # a name glob: `material_ui-1.0.9` sorts after `material_ui-1.0.10`, so
  238: # `Select-Object -Last 1` can patch a version nothing links against.
  239: $RepoRoot = (Resolve-Path "$PSScriptRoot/../..").Path
  240: 
  241: function Get-CachedPackageDir([string]$name) {
  242:     $lockPath = Join-Path $RepoRoot "pubspec.lock"
  243:     if (-not (Test-Path $lockPath)) { return $null }
  244:     $lines = Get-Content $lockPath
  245:     $version = $null
  246:     for ($i = 0; $i -lt $lines.Count; $i++) {
  247:         if ($lines[$i] -match "^  $([regex]::Escape($name)):\s*$") {
  248:             for ($j = $i + 1; $j -lt $lines.Count -and $lines[$j] -match "^    "; $j++) {
  249:                 if ($lines[$j] -match '^    version:\s*"?([^"]+)"?\s*$') {
  250:                     $version = $Matches[1]
  251:                     break
  252:                 }
  253:             }
  254:             break
  255:         }
  256:     }
  257:     if (-not $version) { return $null }
  258:     $dir = Join-Path "$PubCacheDir/hosted/pub.dev" "$name-$version"
  259:     if (Test-Path $dir) { return Get-Item $dir }
  260:     return $null
  261: }
  262: 
  263: try {
  264:     $MaterialUiDir = Get-CachedPackageDir "material_ui"
  265: 
  266:     if ($MaterialUiDir) {
  267:         Remove-Item -Path $MaterialUiDir.FullName -Recurse -Force
  268:     }
  269: } catch {
  270: }
  271: 
  272: flutter pub get
  273: 
  274: $MaterialUiDir = Get-CachedPackageDir "material_ui"
  275: 
  276: if (-not $MaterialUiDir) {
  277:     throw "material_ui package not found in pub cache"
  278: }
  279: 
  280: Write-Host "material_ui dir: $($MaterialUiDir.FullName)"
  281: 
  282: Get-ChildItem -Path "$env:GITHUB_WORKSPACE/lib/scripts/material" -Filter *.patch | ForEach-Object {
  283:     (Get-Content $_.FullName -Raw) -replace "`r`n", "`n" | 
  284:         Set-Content -NoNewline $_.FullName
  285: }
  286: 
  287: cd $MaterialUiDir.FullName
  288: 
  289: foreach ($patch in $patches_material) {
  290:     git apply "$env:GITHUB_WORKSPACE/$patch"
  291:     if ($LASTEXITCODE -eq 0) {
  292:         Write-Host "$patch applied"
  293:     } else {
  294:         throw "$LASTEXITCODE"
  295:     }
  296: }
  297: 
  298: $BottomSheetIOSFlutterPatchCupertino = "lib/scripts/cupertino/bottom_sheet_ios_flutter.patch"
  299: 
  300: $patches_cupertino = @()
  301: 
  302: switch ($platform.ToLower()) {
  303:     "android" {
  304:     }
  305:     "ios" {
  306:         $patches_cupertino += $BottomSheetIOSFlutterPatchCupertino
  307:     }
  308:     "linux" {
  309:     }
  310:     "macos" {
  311:     }
  312:     "windows" {
  313:     }
  314:     default {}
  315: }
  316: 
  317: $CupertinoUiDir = Get-CachedPackageDir "cupertino_ui"
  318: 
  319: if (-not $CupertinoUiDir) {
  320:     throw "cupertino_ui package not found in pub cache"
  321: }
  322: 
  323: Write-Host "cupertino_ui dir: $($CupertinoUiDir.FullName)"
  324: 
  325: Get-ChildItem -Path "$env:GITHUB_WORKSPACE/lib/scripts/cupertino" -Filter *.patch | ForEach-Object {
  326:     (Get-Content $_.FullName -Raw) -replace "`r`n", "`n" | 
  327:         Set-Content -NoNewline $_.FullName
  328: }
  329: 
  330: cd $CupertinoUiDir.FullName
  331: 
  332: foreach ($patch in $patches_cupertino) {
  333:     git apply "$env:GITHUB_WORKSPACE/$patch"
  334:     if ($LASTEXITCODE -eq 0) {
  335:         Write-Host "$patch applied"
  336:     } else {
  337:         throw "$LASTEXITCODE"
  338:     }
  339: }
--- windows/runner/main.cpp
    1: #include <flutter/dart_project.h>
    2: #include <flutter/flutter_view_controller.h>
    3: #include <windows.h>
    4: 
    5: #include <string>
    6: 
    7: #include "app_links/app_links_plugin_c_api.h"
    8: #include "flutter_window.h"
    9: #include "utils.h"
   10: 
   11: // LibrePili: "Open with" passes a plain file/folder path, which app_links
   12: // does not forward (no URI scheme). Send it to a running instance as a
   13: // `librepili-open:<full path>` link (handled in lib/utils/app_scheme.dart).
   14: static bool SendFileToInstance() {
   15:   int argc;
   16:   wchar_t **argv = ::CommandLineToArgvW(::GetCommandLineW(), &argc);
   17:   if (argv == nullptr) {
   18:     return false;
   19:   }
   20:   std::string path;
   21:   if (argc == 2 && ::GetFileAttributesW(argv[1]) != INVALID_FILE_ATTRIBUTES) {
   22:     wchar_t full[32768] = {};
   23:     if (::GetFullPathNameW(argv[1], 32768, full, nullptr) != 0) {
   24:       path = Utf8FromUtf16(full);
   25:     }
   26:   }
   27:   ::LocalFree(argv);
   28:   if (path.empty()) {
   29:     return false;
   30:   }
   31: 
   32:   struct State {
   33:     HWND found;
   34:     wchar_t ourExe[MAX_PATH];
   35:   };
   36:   State s = {};
   37:   ::GetModuleFileNameW(nullptr, s.ourExe, MAX_PATH);
   38:   ::EnumWindows(
   39:       [](HWND hwnd, LPARAM lp) -> BOOL {
   40:         auto *s = reinterpret_cast<State *>(lp);
   41:         wchar_t cls[64] = {};
   42:         ::GetClassNameW(hwnd, cls, 64);
   43:         if (_wcsicmp(cls, L"FLUTTER_RUNNER_WIN32_WINDOW") != 0) return TRUE;
   44:         DWORD pid = 0;
   45:         ::GetWindowThreadProcessId(hwnd, &pid);
   46:         HANDLE h = ::OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid);
   47:         if (!h) return TRUE;
   48:         wchar_t exe[MAX_PATH] = {};
   49:         DWORD len = MAX_PATH;
   50:         ::QueryFullProcessImageNameW(h, 0, exe, &len);
   51:         ::CloseHandle(h);
   52:         if (_wcsicmp(exe, s->ourExe) == 0) {
   53:           s->found = hwnd;
   54:           return FALSE;
   55:         }
   56:         return TRUE;
   57:       },
   58:       reinterpret_cast<LPARAM>(&s));
   59:   if (!s.found) {
   60:     return false;
   61:   }
   62: 
   63:   const std::string link = "librepili-open:" + path;
   64:   COPYDATASTRUCT cds = {0};
   65:   cds.dwData = WM_USER + 2;  // app_links' APPLINK_MSG_ID
   66:   cds.cbData = static_cast<DWORD>(link.size() + 1);
   67:   cds.lpData = (PVOID)link.c_str();
   68:   // with a plain SendMessage this process would hang (invisibly) until the
   69:   // running instance pumps its message queue: give up and start normally
   70:   DWORD_PTR result = 0;
   71:   if (!::SendMessageTimeoutW(s.found, WM_COPYDATA, (WPARAM)s.found,
   72:                              (LPARAM)(LPVOID)&cds, SMTO_ABORTIFHUNG, 3000,
   73:                              &result)) {
   74:     return false;
   75:   }
   76: 
   77:   WINDOWPLACEMENT place = {sizeof(WINDOWPLACEMENT)};
   78:   ::GetWindowPlacement(s.found, &place);
   79:   ::ShowWindow(s.found, place.showCmd == SW_SHOWMAXIMIZED ? SW_SHOWMAXIMIZED
   80:                         : place.showCmd == SW_SHOWMINIMIZED ? SW_RESTORE
   81:                                                             : SW_NORMAL);
   82:   ::SetForegroundWindow(s.found);
   83:   return true;
   84: }
   85: 
