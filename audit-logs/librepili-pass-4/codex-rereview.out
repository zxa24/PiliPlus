   18: import 'package:flutter_smart_dialog/flutter_smart_dialog.dart';
   19: import 'package:material_ui/material_ui.dart';
   20: 
   21: final _setCookieReg = RegExp('(?<=)(,)(?=[^;]+?=)');
   22: 
   23: class AccountManager extends Interceptor {
   24:   AccountManager();
   25: 
   26:   static String blockServer = Pref.blockServer;
   27: 
   28:   static String getCookies(List<Cookie> cookies) {
   29:     // Sort cookies by path (longer path first).
   30:     cookies.sort((a, b) {
   31:       if (a.path == null && b.path == null) {
   32:         return 0;
   33:       } else if (a.path == null) {
   34:         return -1;
   35:       } else if (b.path == null) {
   36:         return 1;
   37:       } else {
   38:         return b.path!.length.compareTo(a.path!.length);
   39:       }
   40:     });
   41:     return cookies.map((cookie) => '${cookie.name}=${cookie.value}').join('; ');
   42:   }
   43: 
   44:   @override
   45:   void onRequest(RequestOptions options, RequestInterceptorHandler handler) {
   46:     final path = options.path;
   47: 
   48:     final account = _bindRequestAccount(options);
   49: 
   50:     // call sites may have put the account's access_key / csrf in the params
   51:     // before the policy anonymized the request: scrub them (and re-sign) so the
   52:     // anonymous request cannot be tied to the account
   53:     if (account is! LoginAccount) _scrubAccessKey(options);
   54: 
   55:     if (account is NoAccount || _skipCookie(path)) return handler.next(options);
   56: 
   57:     if (!account.isLogin && path == Api.heartBeat) {
   58:       return handler.reject(
   59:         DioException.requestCancelled(requestOptions: options, reason: null),
   60:         false,
   61:       );
   62:     }
   63: 
   64:     final isApp = path.startsWith(HttpString.appBaseUrl);
   65: 
   66:     if (isApp && options.responseType == ResponseType.bytes) {
   67:       options.headers.addAll(account.grpcHeaders);
   68:       return handler.next(options);
   69:     }
   70: 
   71:     options.headers
   72:       ..addAll(account.headers)
   73:       ..['referer'] ??= HttpString.baseUrl;
   74: 
   75:     // app端不需要管理cookie
   76:     if (isApp) {
   77:       // if (kDebugMode) debugPrint('is app: ${options.path}');
   78:       final dataPtr = (options.method == 'POST' && options.data is Map
   79:           ? (options.data as Map).cast<String, dynamic>()
   80:           : options.queryParameters);
   81:       if (dataPtr.isNotEmpty) {
   82:         if (!account.accessKey.isNullOrEmpty) {
   83:           dataPtr['access_key'] = account.accessKey!;
   84:         }
   85:         AppSign.appSign(dataPtr..remove('sign'));
   86:         // if (kDebugMode) debugPrint(dataPtr.toString());
   87:       }
   88:       return handler.next(options);
   89:     } else {
   90:       account.cookieJar
   91:           .loadForRequest(options.uri)
   92:           .then((cookies) {
   93:             final previousCookies =
   94:                 options.headers[HttpHeaders.cookieHeader] as String?;
   95:             final newCookies = getCookies([
   96:               ...?previousCookies
   97:                   ?.split(';')
   98:                   .where((e) => e.isNotEmpty)
   99:                   .map(Cookie.fromSetCookieValue),
  100:               ...cookies,
  101:             ]);
  102:             options.headers[HttpHeaders.cookieHeader] = newCookies.isNotEmpty
  103:                 ? newCookies
  104:                 : '';
  105:             handler.next(options);
  106:           })
  107:           .catchError((Object e, StackTrace s) {
  108:             final err = DioException(
  109:               requestOptions: options,
  110:               error: e,
  111:               stackTrace: s,
  112:             );
  113:             handler.reject(err, true);
  114:           });
  115:     }
  116:   }
  117: 
  118:   @override
  119:   void onResponse(Response response, ResponseInterceptorHandler handler) {
  120:     if (_boundRequestAccount(response.requestOptions) case final account?) {
--- lib/utils/flv_demux.dart
    1: part of 'mp4_remux.dart';
    2: 
    3: /// LibrePili: pure-Dart FLV demuxer feeding [Mp4Remuxer]'s progressive MP4
    4: /// writer, for the old single-URL (durl) downloads.
    5: ///
    6: /// FLV AVC payloads are already length-prefixed NAL units and AAC payloads
    7: /// raw frames, which is exactly what MP4 samples hold, so sample bytes are
    8: /// never decoded: every sample becomes a chunk pointing into its FLV file and
    9: /// is copied byte-for-byte. H.264 / HEVC video (legacy codec id 7 / 12, or
   10: /// enhanced FLV with the `avc1` / `hvc1` FourCC) and AAC audio are
   11: /// supported; a codec configuration that changes mid-stream or between
   12: /// segments becomes another sample entry. Anything else throws
   13: /// [UnsupportedError].
   14: abstract final class _FlvDemuxer {
   15:   /// A segment starting more than this before the end of what came earlier
   16:   /// restarted its clock and is placed after it; a continuing segment starts
   17:   /// within about a frame of that end.
   18:   static const _restartToleranceMs = 100;
   19: 
   20:   /// [strict]: a tag cut off by the end of the file throws
   21:   /// [FormatException] (a damaged download) instead of being dropped.
   22:   static List<_Track> demux(List<String> inputs, {bool strict = false}) {
   23:     final video = _FlvTrackBuilder(isVideo: true);
   24:     final audio = _FlvTrackBuilder(isVideo: false);
   25:     for (final input in inputs) {
   26:       final raf = File(input).openSync();
   27:       try {
   28:         final r = _FileReader(raf);
   29:         final header = r.read(0, 9);
   30:         if (String.fromCharCodes(header, 0, 3) != 'FLV') {
   31:           throw FormatException('not an FLV file: $input');
   32:         }
   33:         // header, then PreviousTagSize0
   34:         var pos = ByteData.sublistView(header).getUint32(5) + 4;
   35:         int? offset; // ms added to this segment's timestamps
   36:         while (pos + 11 <= r.length) {
   37:           final h = r.read(pos, 11);
   38:           final type = h[0];
   39:           final dataSize = (h[1] << 16) | (h[2] << 8) | h[3];
   40:           final ts = ((h[7] << 24) | (h[4] << 16) | (h[5] << 8) | h[6])
   41:               .toSigned(32);
   42:           final dataPos = pos + 11;
   43:           if (dataPos + dataSize > r.length) {
   44:             if (strict) throw FormatException('truncated FLV tag in $input');
   45:             break; // truncated last tag
   46:           }
   47:           pos = dataPos + dataSize + 4; // + PreviousTagSize
   48:           final kind = type & 0x1F;
   49:           if ((kind != 8 && kind != 9) || dataSize == 0) continue;
   50:           if (type & 0x20 != 0) throw UnsupportedError('encrypted FLV');
   51:           if (offset == null) {
   52:             final end = max(video.endMs, audio.endMs);
   53:             offset = end - ts > _restartToleranceMs ? end - ts : 0;
   54:           }
   55:           final head = r.read(dataPos, min(dataSize, 5));
   56:           final time = ts + offset;
   57:           if (kind == 9) {
   58:             video.addVideoTag(input, dataPos, dataSize, head, time, r);
   59:           } else {
   60:             audio.addAudioTag(input, dataPos, dataSize, head, time, r);
   61:           }
   62:         }
   63:         // a whole file ends exactly after the last PreviousTagSize; less
   64:         // (a cut tag header or size field) means the transfer stopped early
   65:         if (strict && pos != r.length) {
   66:           throw FormatException('FLV cut off at $pos of ${r.length}: $input');
   67:         }
   68:       } finally {
   69:         raf.closeSync();
   70:       }
   71:     }
   72:     final starts = [
   73:       for (final b in [video, audio])
   74:         if (b.times.isNotEmpty) b.times.first,
   75:     ];
   76:     if (starts.isEmpty) throw const FormatException('no audio/video in FLV');
   77:     final base = starts.reduce(min);
   78:     final tracks = <_Track>[];
   79:     for (final b in [video, audio]) {
   80:       if (b.build(base) case final t?) tracks.add(t..index = tracks.length);
   81:     }
   82:     return tracks;
   83:   }
   84: }
   85: 
   86: class _FlvTrackBuilder {
   87:   _FlvTrackBuilder({required this.isVideo});
   88: 
   89:   final bool isVideo;
   90: 
   91:   /// Video: 'avc1' or 'hvc1' (sample entry type); one codec per track.
   92:   String? codec;
   93: 
   94:   /// AVCDecoderConfigurationRecord / HEVCDecoderConfigurationRecord /
   95:   /// AudioSpecificConfig, each distinct one seen; [_current] is in use.
   96:   final configs = <Uint8List>[];
   97:   int _current = -1;
   98: 
   99:   // per sample, in decode order
  100:   final configIndex = <int>[];
  101:   final times = <int>[]; // ms
  102:   final ctsMs = <int>[];
  103:   final keys = <bool>[];
  104:   final paths = <String>[];
  105:   final offsets = <int>[];
  106:   final sizes = <int>[];
  107: 
  108:   int get _defaultDurationMs => isVideo ? 40 : 23;
  109: 
  110:   int get _lastDurationMs => times.length < 2
  111:       ? _defaultDurationMs
  112:       : times.last - times[times.length - 2];
  113: 
  114:   /// Where the next sample of a following segment would start.
  115:   int get endMs => times.isEmpty ? 0 : times.last + _lastDurationMs;
  116: 
  117:   void addVideoTag(
  118:     String path,
  119:     int dataPos,
  120:     int dataSize,
