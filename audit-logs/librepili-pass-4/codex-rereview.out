  211:                           : MdiIcons.incognitoOff,
  212:                       size: 20,
  213:                     ),
  214:                     const SizedBox(width: 10),
  215:                     Text(
  216:                       enterIncognito ? '已进入无痕模式' : '已开启登录模式',
  217:                       style: theme.textTheme.titleMedium,
  218:                     ),
  219:                   ],
  220:                 ),
  221:                 const SizedBox(height: 10),
  222:                 Text(
