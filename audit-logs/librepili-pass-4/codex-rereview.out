  150:   static void showFavBottomSheet({
  151:     required BuildContext context,
  152:     required FavMixin ctr,
  153:   }) {
  154:     showModalBottomSheet(
  155:       context: context,
  156:       useSafeArea: true,
  157:       isScrollControlled: true,
  158:       constraints: BoxConstraints(
  159:         maxWidth: min(640, context.mediaQueryShortestSide),
  160:       ),
  161:       builder: (BuildContext context) {
  162:         final maxChildSize =
  163:             PlatformUtils.isMobile && !context.mediaQuerySize.isPortrait
  164:             ? 1.0
  165:             : 0.7;
  166:         return DraggableScrollableSheet(
  167:           minChildSize: 0,
  168:           maxChildSize: 1,
  169:           snap: true,
  170:           expand: false,
  171:           snapSizes: [maxChildSize],
  172:           initialChildSize: maxChildSize,
  173:           builder: (BuildContext context, ScrollController scrollController) {
  174:             return FavPanel(
  175:               ctr: ctr,
  176:               scrollController: scrollController,
  177:             );
  178:           },
  179:         );
  180:       },
  181:     );
