   10: import 'package:flutter/services.dart' show Clipboard;
   11: import 'package:flutter_smart_dialog/flutter_smart_dialog.dart';
   12: import 'package:get/get_core/src/get_main.dart';
   13: import 'package:get/get_navigation/src/extension_navigation.dart';
   14: import 'package:intl/intl.dart' show DateFormat;
   15: import 'package:material_ui/material_ui.dart';
   16: import 'package:re_highlight/languages/json.dart';
   17: import 'package:re_highlight/re_highlight.dart';
   18: import 'package:re_highlight/styles/base16/github.dart';
   19: import 'package:re_highlight/styles/github-dark.dart';
   20: 
   21: void exportToClipBoard({
   22:   required ValueGetter<String> onExport,
   23: }) {
   24:   Utils.copyText(onExport());
   25: }
   26: 
   27: void exportToLocalFile({
   28:   required ValueGetter<String> onExport,
   29:   required ValueGetter<String> localFileName,
   30: }) {
   31:   final res = utf8.encode(onExport());
   32:   StorageUtils.saveBytes2File(
   33:     name:
   34:         'piliplus_${localFileName()}_'
   35:         '${DateFormat('yyyyMMddHHmmss').format(DateTime.now())}.json',
   36:     bytes: res,
   37:     allowedExtensions: const ['json'],
   38:   );
   39: }
   40: 
   41: Future<void> importFromClipBoard<T>(
   42:   BuildContext context, {
   43:   required String title,
   44:   required ValueGetter<String> onExport,
   45:   required FutureOr<void> Function(T json) onImport,
   46:   bool showConfirmDialog = true,
   47: }) async {
   48:   final data = await Clipboard.getData('text/plain');
   49:   if (data?.text case final text? when (text.isNotEmpty)) {
   50:     if (!context.mounted) return;
   51:     final T json;
   52:     final String formatText;
   53:     try {
   54:       json = jsonDecode(text);
   55:       formatText = Utils.jsonEncoder.convert(json);
   56:     } catch (e) {
   57:       SmartDialog.showToast('解析json失败：$e');
   58:       return;
   59:     }
   60:     bool? executeImport;
   61:     if (showConfirmDialog) {
   62:       final highlight = Highlight()..registerLanguage('json', langJson);
   63:       final result = highlight.highlight(
   64:         code: formatText,
   65:         language: 'json',
   66:       );
   67:       late TextSpanRenderer renderer;
   68:       bool? isDarkMode;
   69:       executeImport = await showDialog<bool>(
   70:         context: context,
   71:         builder: (context) {
   72:           final colorScheme = ColorScheme.of(context);
   73:           final isDark = colorScheme.isDark;
   74:           if (isDark != isDarkMode) {
   75:             isDarkMode = isDark;
   76:             renderer = TextSpanRenderer(
   77:               null,
   78:               isDark ? githubDarkTheme : githubTheme,
   79:             );
   80:             result.render(renderer);
   81:           }
   82:           return AlertDialog(
   83:             title: Text('是否导入如下$title？'),
   84:             content: SingleChildScrollView(
   85:               child: Text.rich(renderer.span!),
   86:             ),
   87:             actions: [
   88:               TextButton(
   89:                 onPressed: Get.back,
   90:                 child: Text('取消', style: TextStyle(color: colorScheme.outline)),
   91:               ),
   92:               TextButton(
   93:                 onPressed: () => Get.back(result: true),
   94:                 child: const Text('确定'),
   95:               ),
   96:             ],
   97:           );
   98:         },
   99:       );
  100:     } else {
  101:       executeImport = true;
  102:     }
  103:     if (executeImport ?? false) {
  104:       try {
  105:         await onImport(json);
  106:         SmartDialog.showToast('导入成功');
  107:       } catch (e) {
  108:         SmartDialog.showToast('导入失败：$e');
  109:       }
  110:     }
  111:   } else {
  112:     SmartDialog.showToast('剪贴板无数据');
  113:     return;
  114:   }
  115: }
  116: 
  117: Future<void> importFromLocalFile<T>({
  118:   required FutureOr<void> Function(T json) onImport,
  119: }) async {
  120:   final result = await FilePicker.pickFile(
  121:     type: .custom,
  122:     allowedExtensions: const ['json', 'txt'],
  123:   );
  124:   if (result != null) {
  125:     final data = await result.xFile.readAsString();
  126:     final T json;
  127:     try {
  128:       json = jsonDecode(data);
  129:     } catch (e) {
  130:       SmartDialog.showToast('解析json失败：$e');
  131:       return;
  132:     }
  133:     try {
  134:       await onImport(json);
  135:       SmartDialog.showToast('导入成功');
  136:     } catch (e) {
  137:       SmartDialog.showToast('导入失败：$e');
  138:     }
  139:   }
  140: }
  141: 
  142: void importFromInput<T>(
  143:   BuildContext context, {
  144:   required String title,
  145:   required FutureOr<void> Function(T json) onImport,
  146: }) {
  147:   final key = GlobalKey<FormFieldState<String>>();
  148:   late T json;
  149:   String? forceErrorText;
  150: 
  151:   showDialog(
  152:     context: context,
  153:     builder: (context) => AlertDialog(
  154:       title: Text('输入$title'),
  155:       constraints: Style.dialogFixedConstraints,
  156:       content: TextFormField(
  157:         key: key,
  158:         minLines: 4,
  159:         maxLines: 12,
  160:         autofocus: true,
  161:         decoration: const InputDecoration(
  162:           border: OutlineInputBorder(),
  163:           errorMaxLines: 3,
  164:         ),
  165:         validator: (value) {
  166:           if (forceErrorText != null) return forceErrorText;
  167:           try {
  168:             json = jsonDecode(value!) as T;
  169:             return null;
  170:           } catch (e) {
  171:             return '解析json失败：$e';
  172:           }
  173:         },
  174:       ),
  175:       actions: [
  176:         TextButton(
  177:           onPressed: Get.back,
  178:           child: Text(
  179:             '取消',
  180:             style: TextStyle(
  181:               color: ColorScheme.of(context).outline,
  182:             ),
  183:           ),
  184:         ),
  185:         TextButton(
  186:           onPressed: () async {
  187:             if (key.currentState?.validate() == true) {
  188:               try {
  189:                 await onImport(json);
  190:                 Get.back();
  191:                 SmartDialog.showToast('导入成功');
  192:                 return;
  193:               } catch (e) {
  194:                 forceErrorText = '导入失败：$e';
  195:               }
  196:               key.currentState?.validate();
  197:               forceErrorText = null;
  198:             }
  199:           },
  200:           child: const Text('确定'),
  201:         ),
  202:       ],
  203:     ),
  204:   );
  205: }
  206: 
  207: Future<void> showImportExportDialog<T>(
  208:   BuildContext context, {
  209:   required String title,
  210:   required ValueGetter<String> onExport,
  211:   required FutureOr<void> Function(T json) onImport,
  212:   required ValueGetter<String> localFileName,
  213:   // runs before either export, e.g. to ask what to include or to confirm;
  214:   // returning false cancels the export
  215:   Future<bool> Function()? beforeExport,
  216: }) => showDialog(
  217:   context: context,
  218:   // note: the outer [context] is used for what runs after this dialog is
  219:   // popped; the builder's own context is unmounted by then
  220:   builder: (dialogContext) {
  221:     const style = TextStyle(fontSize: 15);
  222:     return SimpleDialog(
  223:       clipBehavior: .hardEdge,
  224:       title: Text('导入/导出$title'),
  225:       children: [
  226:         DialogOption(
  227:           child: const Text('导出至剪贴板', style: style),
  228:           onPressed: () async {
  229:             Get.back();
  230:             if (await beforeExport?.call() == false) return;
  231:             exportToClipBoard(onExport: onExport);
  232:           },
  233:         ),
  234:         DialogOption(
  235:           child: const Text('导出文件至本地', style: style),
  236:           onPressed: () async {
  237:             Get.back();
  238:             if (await beforeExport?.call() == false) return;
  239:             exportToLocalFile(onExport: onExport, localFileName: localFileName);
  240:           },
  241:         ),
  242:         Divider(
  243:           height: 1,
  244:           color: ColorScheme.of(dialogContext).outline.withValues(alpha: 0.1),
  245:         ),
  246:         DialogOption(
  247:           child: const Text('输入', style: style),
  248:           onPressed: () {
  249:             Get.back();
  250:             importFromInput<T>(context, title: title, onImport: onImport);
  251:           },
  252:         ),
  253:         DialogOption(
  254:           child: const Text('从剪贴板导入', style: style),
  255:           onPressed: () {
  256:             Get.back();
  257:             importFromClipBoard<T>(
  258:               context,
  259:               title: title,
  260:               onExport: onExport,
  261:               onImport: onImport,
  262:             );
  263:           },
  264:         ),
  265:         DialogOption(
  266:           child: const Text('从本地文件导入', style: style),
  267:           onPressed: () {
  268:             Get.back();
  269:             importFromLocalFile<T>(onImport: onImport);
  270:           },
  271:         ),
  272:       ],
  273:     );
  274:   },
  275: );
