  200:               bottom: MediaQuery.viewPaddingOf(context).bottom + 15,
  201:             ),
  202:             child: Column(
  203:               mainAxisSize: MainAxisSize.min,
  204:               crossAxisAlignment: CrossAxisAlignment.start,
