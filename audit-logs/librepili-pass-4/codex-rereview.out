    1: import 'package:PiliPlus/common/constants.dart';
    2: import 'package:PiliPlus/models/common/account_type.dart';
    3: import 'package:PiliPlus/utils/accounts.dart';
    4: import 'package:PiliPlus/utils/accounts/grpc_headers.dart';
    5: import 'package:PiliPlus/utils/id_utils.dart';
    6: import 'package:cookie_jar/cookie_jar.dart';
    7: import 'package:hive_ce/hive.dart';
    8: 
    9: sealed class Account {
   10:   Map<String, dynamic>? toJson() => null;
   11: 
   12:   Future<void>? onChange() => null;
   13: 
   14:   Set<AccountType> get type => const {};
   15: 
   16:   bool get activated => false;
   17: 
   18:   set activated(bool value) => throw UnimplementedError();
   19: 
   20:   String? get accessKey => throw UnimplementedError();
   21: 
   22:   DefaultCookieJar get cookieJar => throw UnimplementedError();
   23: 
   24:   String get csrf => throw UnimplementedError();
   25: 
   26:   Future<void> delete() => throw UnimplementedError();
   27: 
   28:   Map<String, String> get headers => throw UnimplementedError();
   29: 
   30:   Map<String, String> get grpcHeaders => throw UnimplementedError();
   31: 
   32:   bool get isLogin => throw UnimplementedError();
   33: 
   34:   int get mid => throw UnimplementedError();
   35: 
   36:   String? get refresh => throw UnimplementedError();
   37: 
   38:   const Account();
   39: }
   40: 
   41: @HiveType(typeId: 9)
   42: class LoginAccount extends Account {
   43:   @override
   44:   final bool isLogin = true;
   45:   @override
   46:   @HiveField(0)
   47:   final DefaultCookieJar cookieJar;
   48:   @override
   49:   @HiveField(1)
   50:   String? accessKey;
   51:   @override
   52:   @HiveField(2)
   53:   String? refresh;
   54:   @override
   55:   @HiveField(3)
   56:   final Set<AccountType> type;
   57: 
   58:   @override
   59:   bool activated = false;
   60: 
   61:   /// The server answered "not logged in" for a request that carried this
   62:   /// account. It is kept (the user may re-login or remove it) but not used
   63:   /// for requests; see [Accounts.markExpired].
   64:   @HiveField(4)
   65:   bool expired = false;
   66: 
   67:   @override
   68:   late final int mid = int.parse(_midStr);
   69: 
   70:   @override
   71:   late final Map<String, String> headers = {
   72:     ...Constants.baseHeaders,
   73:     'x-bili-mid': _midStr,
   74:     'x-bili-aurora-eid': IdUtils.genAuroraEid(mid),
   75:   };
   76: 
   77:   @override
   78:   late final Map<String, String> grpcHeaders = GrpcHeaders.newHeaders(
   79:     accessKey,
   80:   );
   81: 
   82:   @override
   83:   // empty once [dropCredentials] ran (the session is dead anyway)
   84:   late final String csrf =
   85:       cookieJar
   86:           .domainCookies['bilibili.com']?['/']?['bili_jct']
   87:           ?.cookie
   88:           .value ??
   89:       '';
   90: 
   91:   /// The stored credentials are dead (see [Accounts.markExpired]): drop them
   92:   /// so they do not stay in `hive/account.hive`. Only what identifies the
   93:   /// record in the account list is kept, so the user can re-login or remove
   94:   /// it. Call [onChange] to persist.
   95:   void dropCredentials() {
   96:     // [_midStr] / the account list need DedeUserID; buvid3 is not a secret
   97:     const keep = {'DedeUserID', 'buvid3'};
   98:     cookieJar.domainCookies['bilibili.com']?['/']?.removeWhere(
   99:       (name, _) => !keep.contains(name),
  100:     );
  101:     accessKey = null;
  102:     refresh = null;
  103:   }
  104: 
  105:   bool _hasDelete = false;
  106: 
  107:   @override
  108:   Future<void> delete() {
  109:     _hasDelete = true;
  110:     return Future.wait([cookieJar.deleteAll(), _box.delete(_midStr)]);
  111:   }
  112: 
  113:   @override
  114:   Future<void>? onChange() {
  115:     if (_hasDelete) return null;
  116:     return _box.put(_midStr, this);
  117:   }
  118: 
  119:   @override
  120:   Map<String, dynamic>? toJson() => {
  121:     'cookies': cookieJar.toJson(),
  122:     'accessKey': accessKey,
  123:     'refresh': refresh,
  124:     'type': type.map((i) => i.index).toList(),
  125:     if (expired) 'expired': true,
  126:   };
  127: 
  128:   late final String _midStr = cookieJar
  129:       .domainCookies['bilibili.com']!['/']!['DedeUserID']!
  130:       .cookie
  131:       .value;
  132: 
  133:   late final Box<LoginAccount> _box = Accounts.account;
  134: 
  135:   LoginAccount(
  136:     this.cookieJar,
  137:     this.accessKey,
  138:     this.refresh, [
  139:     Set<AccountType>? type,
  140:   ]) : type = type ?? {} {
  141:     cookieJar.setBuvid3();
  142:   }
  143: 
  144:   factory LoginAccount.fromJson(Map json) => LoginAccount(
  145:     BiliCookieJar.fromJson(json['cookies']),
  146:     json['accessKey'],
  147:     json['refresh'],
  148:     (json['type'] as Iterable?)?.map((i) => AccountType.values[i]).toSet(),
  149:   )..expired = json['expired'] == true;
  150: 
  151:   @override
  152:   int get hashCode => mid.hashCode;
  153: 
  154:   @override
  155:   bool operator ==(Object other) =>
  156:       identical(this, other) || (other is LoginAccount && mid == other.mid);
  157: }
  158: 
  159: class AnonymousAccount extends Account {
  160:   @override
  161:   final bool isLogin = false;
  162:   @override
  163:   final DefaultCookieJar cookieJar = DefaultCookieJar()..setBuvid3();
  164:   @override
  165:   final String? accessKey = null;
  166:   @override
  167:   final String? refresh = null;
  168:   @override
  169:   final Set<AccountType> type = {};
  170:   @override
  171:   final int mid = 0;
  172:   @override
  173:   final String csrf = '';
  174:   @override
  175:   final Map<String, String> headers = Constants.baseHeaders;
  176: 
  177:   @override
  178:   final Map<String, String> grpcHeaders = GrpcHeaders.newHeaders();
  179: 
  180:   @override
  181:   bool activated = false;
  182: 
  183:   @override
  184:   Future<void> delete() {
  185:     grpcHeaders['x-bili-fawkes-req-bin'] = GrpcHeaders.fawkes;
  186:     // the regenerated buvid3 is a new device id: it has to be activated again
  187:     activated = false;
  188:     return cookieJar.deleteAll().whenComplete(cookieJar.setBuvid3);
  189:   }
  190: 
  191:   static final _instance = AnonymousAccount._();
  192: 
  193:   AnonymousAccount._();
  194: 
  195:   factory AnonymousAccount() => _instance;
  196: 
  197:   @override
  198:   int get hashCode => cookieJar.hashCode;
  199: 
  200:   @override
  201:   bool operator ==(Object other) =>
  202:       identical(this, other) ||
  203:       (other is AnonymousAccount && cookieJar == other.cookieJar);
  204: }
  205: 
  206: extension BiliCookie on Cookie {
  207:   void setBiliDomain([String domain = '.bilibili.com']) {
  208:     this.domain = domain;
  209:     httpOnly = false;
  210:     path = '/';
  211:   }
  212: }
  213: 
  214: extension BiliCookieJar on DefaultCookieJar {
  215:   Map<String, String> toJson() {
  216:     final cookies = domainCookies['bilibili.com']?['/'] ?? const {};
  217:     return {for (final i in cookies.values) i.cookie.name: i.cookie.value};
  218:   }
  219: 
  220:   List<Cookie> toList() =>
  221:       domainCookies['bilibili.com']?['/']?.entries
  222:           .map((i) => i.value.cookie)
  223:           .toList() ??
  224:       [];
  225: 
  226:   void setBuvid3() {
  227:     (domainCookies['bilibili.com'] ??= {
  228:       '/': {},
  229:     })['/']!['buvid3'] ??= SerializableCookie(
  230:       Cookie('buvid3', IdUtils.genBuvid3())..setBiliDomain(),
  231:     );
  232:   }
  233: 
  234:   static DefaultCookieJar fromJson(Map json) =>
  235:       DefaultCookieJar(ignoreExpires: true)
  236:         ..domainCookies['bilibili.com'] = {
  237:           '/': {
  238:             for (final i in json.entries)
  239:               i.key: SerializableCookie(
  240:                 Cookie(i.key, i.value)..setBiliDomain(),
  241:               ),
  242:           },
  243:         };
  244: 
  245:   static DefaultCookieJar fromList(List cookies) =>
  246:       DefaultCookieJar(ignoreExpires: true)
  247:         ..domainCookies['bilibili.com'] = {
  248:           '/': {
  249:             for (final i in cookies)
  250:               i['name']!: SerializableCookie(
  251:                 Cookie(i['name']!, i['value']!)..setBiliDomain(),
  252:               ),
  253:           },
  254:         };
  255: }
  256: 
  257: final class NoAccount extends Account {
  258:   const NoAccount();
  259: }
