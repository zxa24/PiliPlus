   28: 
   29: /// Command-line self test (LibrePili), for scripted checks of a real build:
   30: ///
   31: ///   LibrePili.exe --selftest [--download BVxxx] [--qn 80] [--local]
   32: ///                 [--keep] [--out result.json]
   33: ///
   34: /// Runs after the app has started normally, writes a JSON report and exits
   35: /// with 0 when every check passed, 1 otherwise.
   36: abstract final class SelfTest {
   37:   static bool isRequested(List<String> args) => args.contains('--selftest');
   38: 
   39:   static String? _arg(List<String> args, String name) {
   40:     final i = args.indexOf(name);
   41:     return i != -1 && i + 1 < args.length ? args[i + 1] : null;
   42:   }
   43: 
   44:   /// Schedules the run once the first frame is on screen. Writes a
   45:   /// `started` marker right away so a caller can tell "app never started"
   46:   /// from "test still running".
   47:   static void schedule(List<String> args) {
   48:     if (_arg(args, '--out') case final out?) {
   49:       File(out).writeAsStringSync(jsonEncode({'stage': 'started'}));
   50:     }
   51:     WidgetsBinding.instance.addPostFrameCallback((_) {
   52:       Future.delayed(const Duration(seconds: 2), () => _run(args));
   53:     });
   54:   }
   55: 
   56:   static Future<void> _run(List<String> args) async {
   57:     final out = _arg(args, '--out') ?? path.join(tmpDirPath, 'selftest.json');
   58:     final report = <String, dynamic>{
   59:       'startedAt': DateTime.now().toIso8601String(),
   60:       'args': args,
   61:       // isolated profile: never the user's own data (see isSelfTestProfile)
   62:       'dataDir': appSupportDirPath,
   63:       'downloadDir': downloadPath,
   64:       'checks': <Map<String, dynamic>>[],
   65:     };
   66:     final checks = report['checks'] as List<Map<String, dynamic>>;
   67:     var ok = true;
   68: 
   69:     Future<void> scenario(
   70:       String name,
   71:       Future<Map<String, dynamic>> Function() body,
   72:     ) async {
   73:       final sw = Stopwatch()..start();
   74:       Map<String, dynamic> result;
   75:       try {
   76:         result = await body();
   77:       } catch (e, s) {
   78:         result = {'pass': false, 'error': '$e', 'stack': '$s'};
   79:       }
   80:       result['name'] = name;
   81:       result['ms'] = sw.elapsedMilliseconds;
   82:       ok &= result['pass'] == true;
   83:       checks.add(result);
   84:     }
   85: 
   86:     if (_arg(args, '--feed') case final mid?) {
   87:       await scenario('feed', () => _feed(int.parse(mid)));
   88:     }
   89:     if (args.contains('--local')) {
   90:       await scenario('localLibrary', _localLibrary);
   91:     }
   92:     if (_arg(args, '--open-local') case final target?) {
   93:       final hold = int.tryParse(_arg(args, '--hold') ?? '') ?? 15;
   94:       await scenario(
   95:         'openLocal',
   96:         () => _openLocal(target, hold, play: args.contains('--play')),
   97:       );
   98:     }
   99:     if (args.contains('--open-offline')) {
  100:       final hold = int.tryParse(_arg(args, '--hold') ?? '') ?? 15;
  101:       final tab = int.tryParse(_arg(args, '--tab') ?? '');
  102:       await scenario(
  103:         'openOffline',
  104:         () => _openOffline(hold, tab: tab, play: args.contains('--play')),
  105:       );
  106:     }
  107:     if (_arg(args, '--download') case final bvid?) {
  108:       final qn = int.tryParse(_arg(args, '--qn') ?? '') ?? 80;
  109:       await scenario(
  110:         'download',
  111:         () => _download(bvid, qn, keep: args.contains('--keep')),
  112:       );
  113:     }
  114: 
  115:     report
  116:       ..['pass'] = ok
  117:       ..['finishedAt'] = DateTime.now().toIso8601String();
  118:     await File(out).writeAsString(
  119:       const JsonEncoder.withIndent('  ').convert(report),
  120:     );
  121:     exit(ok ? 0 : 1);
  122:   }
  123: 
  124:   // ------------------------------------------------------------ scenarios
  125: 
  126:   /// Opens a video file / folder with the local player, optionally starts
  127:   /// playback, and reports position, duration and loaded danmaku.
  128:   static Future<Map<String, dynamic>> _openLocal(
  129:     String target,
  130:     int hold, {
  131:     required bool play,
  132:   }) async {
  133:     const heroTag = 'selftest_local';
  134:     PlDanmakuController.lastLoadedCount = -1;
  135:     unawaited(LocalPlayer.open(target, heroTag: heroTag));
  136:     await Future.delayed(const Duration(seconds: 6));
  137:     // read only: getInstance() would raise the player count
  138:     final player = PlPlayerController.instance;
  139:     if (play) {
  140:       // same steps as tapping play on the page (handlePlay)
  141:       final ctr = Get.find<VideoDetailController>(tag: heroTag)
  142:         ..autoPlay = true;
  143:       await ctr.playerInit(autoplay: true);
  144:     }
  145:     await Future.delayed(Duration(seconds: hold));
  146:     final pos = player?.positionInMilliseconds ?? 0;
  147:     return {
  148:       'pass': !play || pos > 0,
  149:       'positionMs': pos,
  150:       // no player (nothing playing): 0, the scripted checks read these as
  151:       // numbers
  152:       'durationMs': player?.durationInMilliseconds ?? 0,
  153:       'danmakuLoaded': PlDanmakuController.lastLoadedCount,
  154:     };
  155:   }
  156: 
  157:   /// Opens the newest completed download (merged file present) in the
  158:   /// offline player and keeps it on screen for [hold] seconds, so a caller
  159:   /// can screenshot it. Reports which folder extras it should pick up.
  160:   static Future<Map<String, dynamic>> _openOffline(
  161:     int hold, {
  162:     int? tab,
  163:     bool play = false,
  164:   }) async {
  165:     const heroTag = 'selftest_offline';
  166:     final service = Get.find<DownloadService>();
  167:     await service.waitForInitialization;
  168:     final entry = service.downloadList.firstWhereOrNull(
  169:       (e) => e.mergedPath != null && File(e.mergedPath!).existsSync(),
  170:     );
  171:     if (entry == null) {
  172:       return {
  173:         'pass': false,
  174:         'error': 'no completed download with a video file',
  175:       };
  176:     }
  177:     final merged = entry.mergedPath!;
  178:     final folder = Directory(path.dirname(merged));
  179:     final base = path.basenameWithoutExtension(merged);
  180:     final extras = [
  181:       for (final f in folder.listSync().whereType<File>())
  182:         if (path.basename(f.path).startsWith('$base.') &&
  183:             !f.path.endsWith('.mp4'))
  184:           path.basename(f.path).substring(base.length),
  185:     ];
  186:     unawaited(
  187:       PageUtils.toVideoPage(
  188:         aid: entry.avid,
  189:         cid: entry.cid,
  190:         cover: entry.cover,
  191:         title: entry.showTitle,
  192:         isVertical: entry.pageData?.isVertical ?? false,
  193:         extraArguments: {
  194:           'sourceType': SourceType.file,
  195:           'entry': entry,
  196:           'dirPath': entry.entryDirPath,
  197:           'heroTag': heroTag,
  198:         },
  199:       ),
  200:     );
  201:     PlDanmakuController.lastLoadedCount = -1;
  202:     if (play) {
  203:       await Future.delayed(const Duration(seconds: 5));
  204:       final ctr = Get.find<VideoDetailController>(tag: heroTag)
  205:         ..autoPlay = true;
  206:       await ctr.playerInit(autoplay: true);
  207:     }
  208:     String? tabs;
  209:     if (tab != null) {
  210:       await Future.delayed(const Duration(seconds: 5));
  211:       final ctr = Get.find<VideoDetailController>(tag: heroTag);
  212:       tabs = 'tabs=${ctr.tabCtr.length}, showReply=${ctr.showReply}';
  213:       if (tab < ctr.tabCtr.length) ctr.tabCtr.animateTo(tab);
  214:     }
  215:     await Future.delayed(Duration(seconds: hold));
  216:     // read only: getInstance() would raise the player count
  217:     final player = PlPlayerController.instance;
  218:     final detail = Get.find<VideoDetailController>(tag: heroTag);
  219:     return {
  220:       'pass': true,
  221:       'title': entry.showTitle,
  222:       'subtitles': [for (final s in detail.subtitles) s.lan],
  223:       'subtitleIndex': detail.vttSubtitlesIndex.value,
  224:       'extras': extras,
  225:       'tabs': ?tabs,
  226:       if (play) ...{
  227:         'positionMs': player?.positionInMilliseconds ?? 0,
  228:         'durationMs': player?.durationInMilliseconds ?? 0,
  229:         'danmakuLoaded': PlDanmakuController.lastLoadedCount,
  230:       },
  231:     };
  232:   }
  233: 
  234:   /// Diagnoses the local feed: the web API it uses (searchArchive, WBI) vs
  235:   /// the app API (spaceArchive, app-signed), both anonymous.
  236:   static Future<Map<String, dynamic>> _feed(int mid) async {
  237:     final web = await MemberHttp.searchArchive(mid: mid, pn: 1, ps: 10);
  238:     final app = await MemberHttp.spaceArchive(
  239:       type: ContributeType.video,
  240:       mid: mid,
  241:     );
  242:     final webOk = web is Success<SearchArchiveData>;
  243:     final appOk = app is Success<SpaceArchiveData>;
  244:     return {
  245:       'pass': webOk,
  246:       'mid': mid,
  247:       'web_searchArchive': webOk
  248:           ? 'ok, ${web.response.list?.vlist?.length ?? 0} items'
  249:           : '$web',
  250:       'app_spaceArchive': appOk
  251:           ? 'ok, ${app.response.item?.length ?? 0} items'
  252:           : '$app',
  253:       if (appOk && (app.response.item?.isNotEmpty ?? false))
  254:         'app_first_item': {
  255:           'title': app.response.item!.first.title,
  256:           'bvid': app.response.item!.first.bvid,
  257:           'param': app.response.item!.first.param,
  258:           'ctime': app.response.item!.first.ctime,
  259:           'duration': app.response.item!.first.duration,
  260:         },
  440:       'streamLeftovers': leftovers,
  441:       'entryJsonMergedPath': savedMergedPath,
  442:       'entryDir': done.entryDirPath,
  443:       // per-video folder contents (video + danmaku / subtitles / comments)
  444:       if (merged != null)
  445:         'folderFiles': {
  446:           for (final f in Directory(path.dirname(merged)).listSync())
  447:             if (f is File) path.basename(f.path): f.lengthSync(),
  448:         },
  449:     };
  450:     result['pass'] =
  451:         merged != null &&
  452:         result['mergedExists'] == true &&
  453:         (result['mergedBytes'] as int) > 0 &&
  454:         leftovers.isEmpty &&
  455:         savedMergedPath == merged;
  456: 
  457:     if (!keep) {
  458:       await service.deleteDownload(
  459:         entry: done,
  460:         removeList: true,
  461:         deleteExported: true,
  462:       );
  463:       result['cleanedUp'] = !(mergedFile?.existsSync() ?? false);
  464:     }
  465:     return result;
  466:   }
  467: }

