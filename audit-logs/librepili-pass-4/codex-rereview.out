   77:     private static final String ANTIFRAUD_PACKAGE = "icu.freedomIntrovert.biliSendCommAntifraud";
   78: 
   79:     /**
   80:      * SHA-256 fingerprints (uppercase hex, no separators) of the signing
   81:      * certificate of the official biliSendCommAntifraud release
   82:      * (https://github.com/freedom-introvert/biliSendCommAntifraud). The full
   83:      * cookie string is only handed to a package signed with one of these.
   84:      * <p>
   85:      * Taken from the v2 signing certificate of the official release APKs
   86:      * (tags 6.4.5-fix, 6.3.5 and 6.2.5 all carry this one), as printed by
   87:      * {@code apksigner verify --print-certs <apk>} ("Signer #1 certificate
   88:      * SHA-256 digest"). A package signed by anything else gets nothing.
   89:      */
   90:     private static final String[] ANTIFRAUD_CERT_SHA256 = {
   91:             "0225A7553765722353B0A27980F779A4ECF8302AFB27911E3D42AACBECAA31BF",
   92:     };
   93: 
   94:     /** Whether [packageName] is installed and signed by one of [expected]. */
   95:     @SuppressWarnings("deprecation")
   96:     private static boolean isSignedBy(@NonNull String packageName, @NonNull String[] expected) {
   97:         if (expected.length == 0) return false;
   98:         try {
   99:             PackageManager pm = getContext().getPackageManager();
  100:             android.content.pm.Signature[] signatures;
  101:             if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
  102:                 android.content.pm.SigningInfo info = pm.getPackageInfo(
  103:                         packageName, PackageManager.GET_SIGNING_CERTIFICATES).signingInfo;
  104:                 if (info == null || info.hasMultipleSigners()) return false;
  105:                 signatures = info.getSigningCertificateHistory();
  106:             } else {
  107:                 signatures = pm.getPackageInfo(packageName, PackageManager.GET_SIGNATURES).signatures;
  108:                 // several signers: not the single-key release we know
  109:                 if (signatures == null || signatures.length != 1) return false;
  110:             }
  111:             if (signatures == null || signatures.length == 0) return false;
  112:             // the current signer (last in the rotation history)
  113:             byte[] digest = java.security.MessageDigest.getInstance("SHA-256")
  114:                     .digest(signatures[signatures.length - 1].toByteArray());
  115:             StringBuilder hex = new StringBuilder(digest.length * 2);
  116:             for (byte b : digest) hex.append(String.format("%02X", b));
  117:             String actual = hex.toString();
  118:             for (String e : expected) {
  119:                 if (e.replace(":", "").equalsIgnoreCase(actual)) return true;
  120:             }
  121:         } catch (Exception ignored) {
  122:         }
  123:         return false;
  124:     }
  125: 
  126:     public static void biliSendCommAntifraud(
  127:             int action, long oid, int type, long rpId, long root, long parent, long ctime, @NonNull String commentText,
  128:             String pictures, @NonNull String sourceId, long uid, @NonNull String cookie
  129:     ) {
  130:         // the intent carries the account's full cookies: only for the genuine
  131:         // app, never for whatever package happens to use its name
  132:         if (!isSignedBy(ANTIFRAUD_PACKAGE, ANTIFRAUD_CERT_SHA256)) {
  133:             new android.os.Handler(android.os.Looper.getMainLooper()).post(() ->
  134:                     android.widget.Toast.makeText(
  135:                             getContext(),
  136:                             "未能验证 biliSendCommAntifraud 的签名，未发送账号信息",
  137:                             android.widget.Toast.LENGTH_LONG
  138:                     ).show());
  139:             return;
  140:         }
  141:         Intent intent = new Intent();
  142:         intent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
  143:         intent.setComponent(new ComponentName(
  144:                 ANTIFRAUD_PACKAGE,
  145:                 "icu.freedomIntrovert.biliSendCommAntifraud.ByXposedLaunchedActivity"
  146:         ));
  147:         intent.putExtra("action", action);
  148:         intent.putExtra("oid", oid);
  149:         intent.putExtra("type", type);
  150:         intent.putExtra("rpid", rpId);
  151:         intent.putExtra("root", root);
  152:         intent.putExtra("parent", parent);
  153:         intent.putExtra("ctime", ctime);
  154:         intent.putExtra("comment_text", commentText);
  155:         if (pictures != null) {
  156:             intent.putExtra("pictures", pictures);
  157:         }
  158:         intent.putExtra("source_id", sourceId);
  159:         intent.putExtra("uid", uid);
  160:         ArrayList<String> cookiesList = new ArrayList<>(1);
  161:         cookiesList.add(cookie);
  162:         intent.putStringArrayListExtra("cookies", cookiesList);
  163:         getContext().startActivity(intent);
  164:     }
