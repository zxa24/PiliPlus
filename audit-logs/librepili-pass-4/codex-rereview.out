  259:     private fun retrieveFile(documentId: String, check: Boolean = true): File? {
  260:         val path = documentId.substring(packageName.length)
  261:             .removePrefix("/").removeSuffix("/")
  262:         if (path.isEmpty()) return null
  263:         val rootDirLabel = path.substringBefore('/')
  264:         val childPath = path.substringAfter('/', missingDelimiterValue = "")
  265:         if (childPath.isNotEmpty() && childPath.split('/').any { !it.isValidName })
  266:             throw FileNotFoundException("$documentId not found")
  267:         val root = if (rootDirLabel.equals(LABEL_DATA_DIR, true) && dataDir != null) {
  268:             dataDir!!
  269:         } else if (rootDirLabel.equals(LABEL_DE_DATA_DIR, true) && deDataDir != null) {
  270:             deDataDir!!
  271:         } else if (rootDirLabel.equals(LABEL_EX_DATA_DIR, true) && exDataDir != null) {
  272:             exDataDir!!
  273:         } else if (rootDirLabel.equals(LABEL_OBB_DIR, true) && obbDir != null) {
  274:             obbDir!!
  275:         } else throw FileNotFoundException("$documentId not found")
  276:         val file = File(root, childPath)
  277:         // the resolved file (symlinks included) must stay inside its root
  278:         try {
  279:             val rootPath = root.canonicalPath
  280:             val filePath = file.canonicalPath
  281:             if (filePath != rootPath && !filePath.startsWith(rootPath + File.separator))
  282:                 throw FileNotFoundException("$documentId not found")
  283:         } catch (_: java.io.IOException) {
  284:             throw FileNotFoundException("$documentId not found")
  285:         }
  286:         if (check) try {
  287:             Os.lstat(file.path)
  288:         } catch (_: Exception) {
  289:             throw FileNotFoundException("$documentId not found")
  290:         }
  291:         return file
  292:     }
