   41: abstract final class PageUtils {
   42:   static RelativeRect menuPosition(Offset offset) {
   43:     return .fromLTRB(offset.dx, offset.dy, offset.dx, 0);
   44:   }
   45: 
   46:   static Future<void> imageView({
   47:     int initialPage = 0,
   48:     required List<SourceModel> imgList,
   49:     int? quality,
   50:     ValueChanged<int>? onPageChanged,
   51:     String tag = '',
   52:   }) {
   53:     return Get.key.currentState!.push<void>(
   54:       HeroDialogRoute(
   55:         pageBuilder: (context, animation, secondaryAnimation) => GalleryViewer(
   56:           sources: imgList,
   57:           initIndex: initialPage,
   58:           quality: quality ?? GlobalData().imgQuality,
   59:           onPageChanged: onPageChanged,
   60:           tag: tag,
   61:         ),
   62:       ),
   63:     );
   64:   }
   65: 
   66:   static Future<void> pmShare(
   67:     BuildContext context, {
   68:     required Map content,
   69:   }) async {
   70:     // if (kDebugMode) debugPrint(content.toString());
   71: 
   72:     List<UserModel> userList = <UserModel>[];
   73: 
   74:     final res = await ImGrpc.shareList(size: 5);
   75:     if (res case Success(:final response)) {
   76:       if (response.sessionList.isNotEmpty) {
   77:         userList.addAll(
   78:           response.sessionList.map<UserModel>(
   79:             (item) => UserModel(
   80:               mid: item.talkerId.toInt(),
   81:               name: item.talkerUname,
   82:               avatar: item.talkerIcon,
   83:             ),
   84:           ),
   85:         );
   86:       }
   87:     }
   88: 
   89:     if (userList.isEmpty && context.mounted) {
   90:       final UserModel? userModel = await Navigator.of(context).push(
   91:         GetPageRoute(page: () => const ContactPage()),
   92:       );
   93:       if (userModel != null) {
   94:         userList.add(userModel);
   95:       }
   96:     }
   97: 
   98:     if (context.mounted) {
   99:       showModalBottomSheet(
  100:         context: context,
  101:         builder: (context) => SharePanel(
  102:           content: content,
  103:           userList: userList,
  104:         ),
  105:         useSafeArea: true,
  106:         enableDrag: false,
  107:         isScrollControlled: true,
  108:       );
  109:     }
  110:   }
