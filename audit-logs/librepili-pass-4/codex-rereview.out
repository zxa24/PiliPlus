  191:   static bool _fitsInAndroidRequirements(int width, int height) {
  192:     final aspectRatio = width / height;
  193:     const min = 1 / 2.39;
  194:     const max = 2.39;
  195:     return (min <= aspectRatio) && (aspectRatio <= max);
  196:   }
  197: 
  198:   static void enterPip({
  199:     int? width,
  200:     int? height,
  201:     bool autoEnter = false,
  202:     required bool isLive,
  203:     required bool isPlaying,
  204:   }) {
  205:     if (width != null &&
  206:         height != null &&
  207:         !_fitsInAndroidRequirements(width, height)) {
  208:       if (height > width) {
  209:         width = 9;
  210:         height = 16;
  211:       } else {
  212:         width = 16;
  213:         height = 9;
  214:       }
  215:     }
  216:     PiliAndroidHelper.enterPip(
  217:       width ?? 16,
  218:       height ?? 9,
  219:       autoEnter: autoEnter,
  220:       isLive: isLive,
  221:       isPlaying: isPlaying,
  222:     );
  223:   }
