  205:   Map<String, dynamic> toJson() => <String, dynamic>{
  206:     'id': id,
  207:     'base_url': baseUrl,
  208:     'backup_url': ?backupUrl,
  209:     'bandwidth': bandwidth,
  210:     'codecid': codecid,
  211:     'size': size,
  212:     'md5': md5,
  213:     'no_rexcode': noRexcode,
  214:     'frame_rate': frameRate,
  215:     'width': width,
  216:     'height': height,
  217:     'dash_drm_type': dashDrmType,
  218:   };
  219: }
