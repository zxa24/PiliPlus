  294:     private fun MatrixCursor.appendFileInfo(documentId: String, file: File?): MatrixCursor {
  295:         val finalFile = file ?: retrieveFile(documentId, true)
  296:         ?: run {
  297:             newRow().apply {
  298:                 add(DocumentsContract.Document.COLUMN_DOCUMENT_ID, packageName)
  299:                 add(DocumentsContract.Document.COLUMN_DISPLAY_NAME, packageName)
  300:                 add(DocumentsContract.Document.COLUMN_SIZE, 0L)
  301:                 add(
  302:                     DocumentsContract.Document.COLUMN_MIME_TYPE,
  303:                     DocumentsContract.Document.MIME_TYPE_DIR
  304:                 )
  305:                 add(DocumentsContract.Document.COLUMN_LAST_MODIFIED, 0L)
  306:                 add(DocumentsContract.Document.COLUMN_FLAGS, 0)
  307:             }
  308:             return this
  309:         }
  310:         var flags = if (finalFile.isDirectory && finalFile.canWrite())
  311:             DocumentsContract.Document.FLAG_DIR_SUPPORTS_CREATE
  312:         else if (finalFile.isFile && finalFile.canWrite())
  313:             DocumentsContract.Document.FLAG_SUPPORTS_WRITE
  314:         else 0
  315:         if (finalFile.parentFile.let { it != null && it.canWrite() })
  316:             flags = flags or DocumentsContract.Document.FLAG_SUPPORTS_DELETE or
  317:                     DocumentsContract.Document.FLAG_SUPPORTS_RENAME or
  318:                     DocumentsContract.Document.FLAG_SUPPORTS_REMOVE or
  319:                     DocumentsContract.Document.FLAG_SUPPORTS_MOVE
  320:         val path = finalFile.path
  321:         var extraInfo = false
  322:         val name = when {
  323:             dataDir.let { it != null && path == it.path } -> LABEL_DATA_DIR
  324:             deDataDir.let { it != null && path == it.path } -> LABEL_DE_DATA_DIR
  325:             exDataDir.let { it != null && path == it.path } -> LABEL_EX_DATA_DIR
  326:             obbDir.let { it != null && path == it.path } -> LABEL_OBB_DIR
  327:             else -> {
  328:                 extraInfo = true
  329:                 finalFile.name
  330:             }
  331:         }
  332:         val row = newRow().apply {
  333:             add(DocumentsContract.Document.COLUMN_DOCUMENT_ID, documentId)
  334:             add(DocumentsContract.Document.COLUMN_DISPLAY_NAME, name)
  335:             add(DocumentsContract.Document.COLUMN_SIZE, finalFile.length())
  336:             add(DocumentsContract.Document.COLUMN_MIME_TYPE, finalFile.mimeType)
  337:             add(DocumentsContract.Document.COLUMN_LAST_MODIFIED, finalFile.lastModified())
  338:             add(DocumentsContract.Document.COLUMN_FLAGS, flags)
  339:             add(COLUMN_MT_PATH, finalFile.absolutePath)
  340:         }
  341:         if (extraInfo) try {
  342:             buildString {
  343:                 val lstat = Os.lstat(path)
  344:                 append(lstat.st_mode)
  345:                 append('|')
  346:                 append(lstat.st_uid)
  347:                 append('|')
  348:                 append(lstat.st_gid)
  349:                 if (OsConstants.S_ISLNK(lstat.st_mode)) {
  350:                     append('|')
  351:                     append(Os.readlink(path))
  352:                 }
  353:             }.let { row.add(COLUMN_MT_EXTRAS, it) }
  354:         } catch (_: Exception) {
  355:         }
  356:         return this
  357:     }
