   26: 
   27: class LoginPageController extends GetxController
   28:     with GetSingleTickerProviderStateMixin {
   29:   final TextEditingController telTextController = TextEditingController();
   30:   final TextEditingController usernameTextController = TextEditingController();
   31:   final TextEditingController passwordTextController = TextEditingController();
   32:   final TextEditingController smsCodeTextController = TextEditingController();
   33:   final TextEditingController cookieTextController = TextEditingController();
   34: 
   35:   late final codeInfo =
   36:       LoadingState<({String authCode, String url})>.loading().obs;
   37: 
   38:   late final TabController tabController;
   39: 
   40:   late final CaptchaDataModel captchaData = CaptchaDataModel();
   41:   late final RxInt qrCodeLeftTime = 180.obs;
   42:   late final RxString statusQRCode = ''.obs;
   43: 
   44:   late var selectedCountryCodeId = Login.dialPrefix.first;
   45:   late String captchaKey = '';
   46:   late final RxInt smsSendCooldown = 0.obs;
   47:   late int smsSendTimestamp = 0;
   48: 
   49:   // 定时器
   50:   Timer? qrCodeTimer;
   51:   Timer? smsSendCooldownTimer;
   52: 
   53:   bool _isReq = false;
   54: 
   55:   @override
   56:   void onInit() {
   57:     super.onInit();
   58:     tabController = TabController(length: 4, vsync: this)
   59:       ..addListener(_handleTabChange);
   60:   }
   61: 
   62:   @override
   63:   void onClose() {
   64:     tabController
   65:       ..removeListener(_handleTabChange)
   66:       ..dispose();
   67:     qrCodeTimer?.cancel();
   68:     smsSendCooldownTimer?.cancel();
   69:     telTextController.dispose();
   70:     usernameTextController.dispose();
   71:     passwordTextController.dispose();
   72:     smsCodeTextController.dispose();
   73:     cookieTextController.dispose();
   74:     super.onClose();
   75:   }
   76: 
   77:   Future<void> refreshQRCode() async {
   78:     final res = await LoginHttp.getHDcode();
   79:     if (res case Success(:final response)) {
   80:       qrCodeTimer?.cancel();
   81:       codeInfo.value = res;
   82:       qrCodeTimer = Timer.periodic(const Duration(milliseconds: 1000), (t) {
   83:         final left = 180 - t.tick;
   84:         if (left <= 0) {
   85:           t.cancel();
   86:           statusQRCode.value = '二维码已过期，请刷新';
   87:           qrCodeLeftTime.value = 0;
   88:           return;
   89:         }
   90:         qrCodeLeftTime.value = left;
   91:         if (_isReq || tabController.index != 2) return;
   92: 
   93:         _isReq = true;
   94:         LoginHttp.codePoll(response.authCode).then((value) async {
   95:           _isReq = false;
   96:           if (value['status']) {
   97:             t.cancel();
   98:             final data = value['data'];
   99:             if (data == null || data['cookie_info'] == null) {
  100:               statusQRCode.value = '登录异常，接口未返回身份信息，可能是因为账号风控';
  101:               return;
  102:             }
  103:             statusQRCode.value = '扫码成功';
  104:             await setAccount(data, data['cookie_info']['cookies']);
  105:             Get.back();
  106:           } else if (value['code'] == 86038) {
  107:             t.cancel();
  108:             qrCodeLeftTime.value = 0;
  109:           } else {
  110:             statusQRCode.value = value['msg'];
  111:           }
  112:         });
  113:       });
  114:     }
  115:   }
  116: 
  117:   void _handleTabChange() {
  118:     if (tabController.index == 2) {
  119:       if (qrCodeTimer == null || !qrCodeTimer!.isActive) {
  120:         refreshQRCode();
  121:       }
  122:     }
  123:   }
  124: 
  125:   // 申请极验验证码
  126:   void getCaptcha(
  127:     String geeGt,
  128:     String geeChallenge,
  129:     VoidCallback onSuccess,
  130:   ) {
  131:     GeetestWebviewDialog.geetest(geeGt, geeChallenge).then((res) {
  132:       if (res != null) {
  133:         captchaData
  134:           ..validate = res['geetest_validate']
  135:           ..seccode = res['geetest_seccode']
  136:           ..geetest = GeetestData(
  137:             challenge: res['geetest_challenge'],
  138:             gt: geeGt,
  139:           );
  140:         SmartDialog.showToast('验证成功');
  141:         onSuccess();
  142:       }
  143:     });
  144:   }
  145: 
  146:   static String validateCookie(String cookie) {
  147:     return cookie
  148:         .split(';')
  149:         .where((e) {
  150:           try {
  151:             Cookie.fromSetCookieValue(e.trim());
  152:           } catch (_) {
  153:             return false;
  154:           }
  155:           return true;
  156:         })
  157:         .join(';');
  158:   }
  159: 
  160:   // cookie登录
  161:   Future<void> loginByCookie() async {
  162:     if (cookieTextController.text.isEmpty) {
  163:       SmartDialog.showToast('cookie不能为空');
  164:       return;
  165:     }
  166:     try {
  167:       final result = await Request().get(
  168:         "/x/member/web/account",
  169:         options: Options(
  170:           headers: {
  171:             "cookie": validateCookie(cookieTextController.text),
  172:           },
  173:           extra: {'account': AnonymousAccount()},
  174:         ),
  175:       );
  176:       if (result.data['code'] == 0) {
  177:         try {
  178:           // LibrePili: finishing a login is the explicit opt-in to login mode
  179:           await GStorage.setting.put(SettingBoxKey.loginMode, true);
  180:           await LoginAccount(
  181:             BiliCookieJar.fromJson(
  182:               Map.fromEntries(
  183:                 cookieTextController.text
  184:                     .split(';')
  185:                     .map((item) => item.trim())
  186:                     .where((item) => item.contains('='))
  187:                     .map((item) {
  188:                       final list = item.split('=');
  189:                       return MapEntry(
  190:                         list.first.trim(),
  191:                         list.skip(1).join('=').trim(),
  192:                       );
  193:                     })
  194:                     .where((e) => e.key.isNotEmpty),
  195:               ),
  196:             ),
  197:             null,
  198:             null,
  199:           ).onChange();
  200:           // login mode was just turned on: activate the saved roles
  201:           await Accounts.refresh();
  202:           MineController.anonymity.value = false;
  203:           if (Accounts.main.isLogin) {
  204:             await LoginUtils.onLoginMain();
  205:           } else {
  206:             await switchAccountDialog(Get.context!);
  207:           }
  208:           SmartDialog.showToast('登录成功');
  209:           Get.back();
  210:         } catch (e) {
  211:           SmartDialog.showToast("登录失败: $e");
  212:         }
  213:       } else {
  214:         SmartDialog.showToast("哔哩哔哩登录已失效，请重新登录");
  215:       }
  216:     } catch (e) {
  217:       SmartDialog.showToast("获取哔哩哔哩用户信息失败，可前往账号管理重试");
  218:     }
  219:   }
  220: 
