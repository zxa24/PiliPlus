  182:     } else if (Accounts.main.isLogin) {
  183:       await LoginUtils.onLoginMain();
  184:     }
  185:     SmartDialog.dismiss();
  186:     SmartDialog.show(
  187:       clickMaskDismiss: true,
  188:       usePenetrate: true,
  189:       displayTime: const Duration(seconds: 3),
