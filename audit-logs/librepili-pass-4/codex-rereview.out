  166:     public static void openLinkVerifySettings() {
  167:         Context context = getContext();
  168:         Uri uri = Uri.parse("package:" + context.getPackageName());
  169:         try {
  170:             Intent intent;
  171:             if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
  172:                 intent = new Intent(Settings.ACTION_APP_OPEN_BY_DEFAULT_SETTINGS, uri);
  173:             } else {
  174:                 intent = new Intent(Intent.ACTION_MAIN, uri);
  175:                 intent.setClassName(
  176:                         "com.android.settings",
  177:                         "com.android.settings.applications.InstalledAppOpenByDefaultActivity"
  178:                 );
  179:             }
  180:             intent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
  181:             context.startActivity(intent);
  182:         } catch (Exception ignored) {
  183:             Intent intent = new Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS, uri);
  184:             intent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
  185:             context.startActivity(intent);
  186:         }
  187:     }
