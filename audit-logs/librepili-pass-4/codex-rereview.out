--- lib/utils/mp4_join.dart
    1: part of 'mp4_remux.dart';
    2: 
    3: /// LibrePili: joins progressive MP4 segments (old single-URL downloads that
    4: /// come split into several files) into one timeline for [Mp4Remuxer]'s
    5: /// writer. Samples are read from each segment's sample tables (stts, ctts,
    6: /// stss, stsc, stsz/stz2, stco/co64) and copied byte-for-byte.
    7: ///
    8: /// Every segment must carry the same tracks (same kind and codec); a codec
    9: /// configuration (stsd) that differs between segments is kept as an extra
   10: /// sample entry, which chunks of that segment point at, and a differing
   11: /// media timescale is converted. Only different tracks or codecs throw
   12: /// [UnsupportedError], and the caller keeps the segments as separate files.
   13: abstract final class _Mp4Joiner {
   14:   static List<_Track> join(List<String> inputs) {
   15:     final tracks = _readProgressive(inputs.first);
   16:     for (final t in tracks) {
   17:       _openEndedEdits(t);
   18:     }
   19:     for (final input in inputs.skip(1)) {
   20:       final segment = _readProgressive(input);
   21:       if (segment.length != tracks.length) {
   22:         throw UnsupportedError('segments have different tracks: $input');
   23:       }
   24:       for (var i = 0; i < tracks.length; i++) {
   25:         final t = tracks[i];
   26:         final s = segment[i];
   27:         if (!_sameBytes(_handlerType(t), _handlerType(s))) {
   28:           throw UnsupportedError('segments have different tracks: $input');
   29:         }
   30:         if (s.sampleEntryType != t.sampleEntryType) {
   31:           throw UnsupportedError(
   32:             'codec changes between segments '
   33:             '(${t.sampleEntryType} -> ${s.sampleEntryType}): $input',
   34:           );
   35:         }
   36:         if (s.timescale != t.timescale) _rescale(s, t.timescale);
   37:       }
   38:       // start where the longest track ended, so the tracks stay in sync
   39:       final start = tracks
   40:           .map((t) => t.mediaDuration / t.timescale)
   41:           .reduce(max);
   42:       for (var i = 0; i < tracks.length; i++) {
   43:         final t = tracks[i];
   44:         final s = segment[i];
   45:         // this segment's sample entries, as indexes into the joined stsd
   46:         final entries = t.sampleEntries ??= _sampleEntriesOf(t.stsd);
   47:         final descIndex = [
   48:           for (final e in _sampleEntriesOf(s.stsd)) _entryIndex(entries, e),
   49:         ];
   50:         final gap = (start * t.timescale).round() - t.mediaDuration;
   51:         if (gap > 0) t.durations.last += gap;
   52:         final firstSample = t.sizes.length;
   53:         final dts = t.mediaDuration;
   54:         for (final c in s.chunks) {
   55:           t.chunks.add(
   56:             _Chunk(
   57:                 t,
   58:                 c.sourceOffset,
   59:                 c.firstSample + firstSample,
   60:                 c.startDts + dts,
   61:                 c.sourcePath,
   62:               )
   63:               ..length = c.length
   64:               ..sampleCount = c.sampleCount
   65:               ..descIndex = c.descIndex <= descIndex.length
   66:                   ? descIndex[c.descIndex - 1]
   67:                   : descIndex.first,
   68:           );
   69:         }
   70:         t
   71:           ..durations.addAll(s.durations)
   72:           ..sizes.addAll(s.sizes)
   73:           ..ctos.addAll(s.ctos)
   74:           ..syncs.addAll(s.syncs);
   75:       }
   76:     }
   77:     // a single configuration throughout: keep the stsd as it was
   78:     for (final t in tracks) {
   79:       if (t.sampleEntries?.length == 1) t.sampleEntries = null;
   80:     }
   81:     return tracks;
   82:   }
   83: 
   84:   /// handler_type of the track's `hdlr` (vide / soun ...).
   85:   static Uint8List _handlerType(_Track t) =>
   86:       Uint8List.sublistView(t.hdlr, 16, 20);
   87: 
   88:   /// Converts [s]'s decode times to [timescale], rounding the running time
   89:   /// (not each duration) so the segment does not drift.
   90:   static void _rescale(_Track s, int timescale) {
   91:     final from = s.timescale;
   92:     var src = 0;
   93:     var dst = 0;
   94:     final starts = <int>[];
   95:     for (var i = 0; i < s.durations.length; i++) {
   96:       starts.add(dst);
   97:       src += s.durations[i];
   98:       final end = _scale(src, from, timescale);
   99:       s.durations[i] = end - dst;
  100:       s.ctos[i] = _scale(s.ctos[i], from, timescale);
  101:       dst = end;
  102:     }
  103:     for (var i = 0; i < s.chunks.length; i++) {
  104:       final c = s.chunks[i];
  105:       s.chunks[i] =
  106:           _Chunk(
  107:               s,
  108:               c.sourceOffset,
  109:               c.firstSample,
  110:               starts[c.firstSample],
  111:               c.sourcePath,
  112:             )
  113:             ..length = c.length
  114:             ..sampleCount = c.sampleCount
  115:             ..descIndex = c.descIndex;
  116:     }
  117:     s.timescale = timescale;
  118:   }
  119: 
  120:   /// The first segment's edit list is kept (encoder delay, a late start),
  121:   /// but its playing edit must run to the end of the joined track.
  122:   static void _openEndedEdits(_Track t) {
  123:     final firstPlaying = t.edits.indexWhere((e) => e.mediaTime >= 0);
  124:     if (firstPlaying == -1) {
  125:       t.edits.clear();
  126:       return;
  127:     }
  128:     final playing = t.edits[firstPlaying];
  129:     t.edits
  130:       ..removeRange(firstPlaying, t.edits.length)
  131:       ..add(_EditEntry(0, playing.mediaTime, playing.rate));
  132:   }
  133: 
  134:   static List<_Track> _readProgressive(String path) {
  135:     final raf = File(path).openSync();
  136:     Uint8List? moov;
  137:     try {
  138:       final length = raf.lengthSync();
  139:       var pos = 0;
  140:       while (pos + 8 <= length) {
  141:         raf.setPositionSync(pos);
  142:         final header = raf.readSync(16);
  143:         final hd = ByteData.sublistView(header);
  144:         var size = hd.getUint32(0);
  145:         final type = String.fromCharCodes(header, 4, 8);
  146:         var headerSize = 8;
  147:         if (size == 1) {
  148:           // 64-bit size: the header must be there in full
  149:           if (header.length < 16) {
  150:             throw FormatException('truncated box $type at $pos in $path');
  151:           }
  152:           size = hd.getUint64(8);
  153:           headerSize = 16;
  154:         } else if (size == 0) {
  155:           size = length - pos;
  156:         }
  157:         if (size < headerSize || pos + size > length) {
  158:           throw FormatException('bad box $type at $pos in $path');
  159:         }
  160:         if (type == 'moov') {
  161:           raf.setPositionSync(pos + headerSize);
  162:           moov = raf.readSync(size - headerSize);
  163:         } else if (type == 'moof') {
  164:           throw UnsupportedError('fragmented MP4 segment: $path');
  165:         }
  166:         pos += size;
  167:       }
  168:     } finally {
  169:       raf.closeSync();
  170:     }
  171:     if (moov == null) throw FormatException('no moov in $path');
  172: 
  173:     var movieTimescale = Mp4Remuxer._movieTimescale;
  174:     final traks = <Uint8List>[];
  175:     for (final (type, body) in _R(moov).boxes()) {
  176:       if (type == 'mvhd') {
  177:         final b = _R(body);
  178:         final v = b.u8();
  179:         b.skip(3 + (v == 1 ? 16 : 8));
  180:         movieTimescale = b.u32();
  181:       } else if (type == 'trak') {
  182:         traks.add(body);
  183:       }
  184:     }
  185:     final tracks = <_Track>[];
  186:     for (final trak in traks) {
  187:       final t = _Track(path)
  188:         ..sourceMovieTimescale = movieTimescale
  189:         .._parseTrak(trak);
  190:       _readSampleTables(t, trak);
  191:       if (t.sizes.isNotEmpty) tracks.add(t..index = tracks.length);
  192:     }
  193:     if (tracks.isEmpty) throw FormatException('no samples in $path');
  194:     return tracks;
  195:   }
  196: 
  197:   static Map<String, Uint8List> _stbl(Uint8List trak) {
  198:     for (final (type, mdia) in _R(trak).boxes()) {
  199:       if (type != 'mdia') continue;
  200:       for (final (t2, minf) in _R(mdia).boxes()) {
  201:         if (t2 != 'minf') continue;
  202:         for (final (t3, stbl) in _R(minf).boxes()) {
  203:           if (t3 == 'stbl') {
  204:             return {for (final (k, v) in _R(stbl).boxes()) k: v};
  205:           }
  206:         }
  207:       }
  208:     }
  209:     return const {};
  210:   }
  211: 
  212:   static void _readSampleTables(_Track t, Uint8List trak) {
  213:     final stbl = _stbl(trak);
  214: 
  215:     // sample sizes
  216:     final sizes = <int>[];
  217:     if (stbl['stsz'] case final body?) {
  218:       final b = _R(body)..skip(4);
  219:       final fixed = b.u32();
  220:       final n = b.u32();
  221:       for (var i = 0; i < n; i++) {
  222:         sizes.add(fixed != 0 ? fixed : b.u32());
  223:       }
  224:     } else if (stbl['stz2'] case final body?) {
  225:       final b = _R(body)..skip(7);
  226:       final field = b.u8();
  227:       final n = b.u32();
  228:       for (var i = 0; i < n; i++) {
  229:         switch (field) {
  230:           case 4:
  231:             final byte = b.data[b.pos + (i >> 1)];
  232:             sizes.add(i.isEven ? byte >> 4 : byte & 0xF);
  233:           case 8:
  234:             sizes.add(b.u8());
  235:           case 16:
  236:             sizes.add((b.u8() << 8) | b.u8());
  237:           default:
  238:             throw FormatException('bad stz2 field size $field');
  239:         }
  240:       }
  241:     }
  242:     if (sizes.isEmpty) return;
  243:     final n = sizes.length;
  244: 
  245:     // decode durations
  246:     final durations = <int>[];
  247:     if (stbl['stts'] case final body?) {
  248:       final b = _R(body)..skip(4);
  249:       final entries = b.u32();
  250:       for (var i = 0; i < entries && durations.length < n; i++) {
  251:         final count = b.u32();
  252:         final delta = b.u32();
  253:         for (var j = 0; j < count && durations.length < n; j++) {
  254:           durations.add(delta);
  255:         }
  256:       }
  257:     }
  258:     while (durations.length < n) {
  259:       durations.add(durations.isEmpty ? 0 : durations.last);
  260:     }
--- lib/utils/mp4_remux.dart
    1: import 'dart:io';
    2: import 'dart:math' show max, min;
    3: import 'dart:typed_data';
    4: 
    5: part 'flv_demux.dart';
    6: part 'mp4_join.dart';
    7: 
    8: /// Losslessly merges single-track fragmented MP4 inputs (bilibili DASH
    9: /// `video.m4s` / `audio.m4s`) into one progressive MP4 with `moov` placed
   10: /// before `mdat` (fast start).
   11: ///
   12: /// Sample data is copied byte-for-byte, codec configuration (`stsd`) and edit
   13: /// lists are carried over, so any codec the inputs carry (AVC / HEVC / AV1 /
   14: /// AAC ...) is supported. Pure Dart, no Flutter dependency: safe to run inside
   15: /// `Isolate.run`.
   16: abstract final class Mp4Remuxer {
   17:   static const _movieTimescale = 1000;
   18:   static const _maxChunkSeconds = 1.0;
   19:   static const _copyBufferSize = 4 << 20;
   20: 
   21:   static Future<void> remux({
   22:     required List<String> inputs,
   23:     required String output,
   24:     void Function(int copied, int total)? onProgress,
   25:   }) async {
   26:     if (inputs.isEmpty) throw ArgumentError('no input');
   27:     final tracks = <_Track>[];
   28:     for (final input in inputs) {
   29:       tracks.add(
   30:         await _Track.parse(input)
   31:           ..index = tracks.length,
   32:       );
   33:     }
   34:     await _write(tracks, output, onProgress);
   35:   }
   36: 
   37:   /// Whether [path] starts with an FLV header.
   38:   static bool isFlv(String path) => _hasMagic(path, 0, 'FLV');
   39: 
   40:   /// Whether [path] is an (ISO BMFF) MP4 file.
   41:   static bool isMp4(String path) => _hasMagic(path, 4, 'ftyp');
   42: 
   43:   static bool _hasMagic(String path, int offset, String magic) {
   44:     final RandomAccessFile raf;
   45:     try {
   46:       raf = File(path).openSync();
   47:     } on FileSystemException {
   48:       // missing or unreadable: not this format (the caller reports the file
   49:       // itself as damaged)
   50:       return false;
   51:     }
   52:     try {
   53:       raf.setPositionSync(offset);
   54:       return String.fromCharCodes(raf.readSync(magic.length)) == magic;
   55:     } finally {
   56:       raf.closeSync();
   57:     }
   58:   }
   59: 
   60:   /// Joins FLV segments (in timeline order) into one progressive MP4.
   61:   /// Supports H.264 / HEVC video (legacy codec id 7 / 12 and enhanced FLV
   62:   /// `avc1` / `hvc1`) and AAC audio, also when the codec configuration
   63:   /// changes mid-stream or between segments (one sample entry per
   64:   /// configuration). Anything else throws [UnsupportedError] so the caller
   65:   /// can keep the original file.
   66:   static Future<void> remuxFlv({
   67:     required List<String> inputs,
   68:     required String output,
   69:     void Function(int copied, int total)? onProgress,
   70:   }) async {
   71:     if (inputs.isEmpty) throw ArgumentError('no input');
   72:     await _write(_FlvDemuxer.demux(inputs), output, onProgress);
   73:   }
   74: 
   75:   /// Joins progressive MP4 segments (in timeline order) into one MP4.
   76:   /// Differing codec configurations of the same codec become several sample
   77:   /// entries; throws [UnsupportedError] only when the segments' tracks or
   78:   /// codecs differ, so the caller can keep them separate.
   79:   static Future<void> joinMp4({
   80:     required List<String> inputs,
   81:     required String output,
   82:     void Function(int copied, int total)? onProgress,
   83:   }) async {
   84:     if (inputs.isEmpty) throw ArgumentError('no input');
   85:     await _write(_Mp4Joiner.join(inputs), output, onProgress);
   86:   }
   87: 
   88:   /// Whether a downloaded durl segment reads cleanly (FLV: every tag
   89:   /// complete; MP4: sample tables inside the file). False means the data is
   90:   /// damaged (e.g. a truncated transfer) and the segment should be
   91:   /// downloaded again; formats it cannot check count as fine.
   92:   static bool checkSegment(String path) {
   93:     try {
   94:       if (isFlv(path)) {
   95:         _FlvDemuxer.demux([path], strict: true);
   96:         return true;
   97:       }
   98:       if (isMp4(path)) {
   99:         final length = File(path).lengthSync();
  100:         for (final t in _Mp4Joiner._readProgressive(path)) {
  101:           for (final c in t.chunks) {
  102:             if (c.sourceOffset + c.length > length) return false;
  103:           }
  104:         }
  105:       }
  106:       return true;
  107:     } on FormatException {
  108:       return false;
  109:     } on RangeError {
  110:       // e.g. a box header cut off before its 64-bit size
  111:       return false;
  112:     } on UnsupportedError {
  113:       // readable, just not joinable: not a download problem
  114:       return true;
  115:     }
  116:   }
  117: 
  118:   /// The tracks an FLV demux produces; for tests only.
  119:   static List<Map<String, Object>> debugFlvTracks(List<String> inputs) =>
  120:       _debugSummary(_FlvDemuxer.demux(inputs));
  121: 
  122:   /// The tracks [joinMp4] reads from progressive MP4 inputs; for tests only.
  123:   static List<Map<String, Object>> debugMp4JoinTracks(List<String> inputs) =>
  124:       _debugSummary(_Mp4Joiner.join(inputs));
  125: 
  126:   static List<Map<String, Object>> _debugSummary(List<_Track> tracks) => [
  127:     for (final t in tracks)
  128:       {
  129:         'type': t.sampleEntryType,
  130:         'timescale': t.timescale,
  131:         'sizes': t.sizes,
  132:         'durations': t.durations,
  133:         'ctos': t.ctos,
  134:         'syncs': t.syncs,
  135:         'stsd': t.stsdBox,
  136:         'sampleEntries': t.sampleEntries?.length ?? 1,
  137:         'descIndexes': [for (final c in t.chunks) c.descIndex],
  138:         'tkhdTail': t.tkhdTail,
  139:         'edits': [
  140:           for (final e in t.edits) [e.segmentDuration, e.mediaTime],
  141:         ],
  142:       },
  143:   ];
  144: 
  145:   static Future<void> _write(
  146:     List<_Track> tracks,
  147:     String output,
  148:     void Function(int copied, int total)? onProgress,
  149:   ) async {
  150:     for (final t in tracks) {
  151:       t._inlineParameterSets();
  152:     }
  153:     final chunks = [for (final t in tracks) ...t.chunks]
  154:       ..sort((a, b) {
  155:         final c = a.startSeconds.compareTo(b.startSeconds);
  156:         return c != 0 ? c : a.track.index.compareTo(b.track.index);
  157:       });
  158: 
  159:     final payloadSize = chunks.fold<int>(0, (s, c) => s + c.length);
  160:     final ftyp = _ftyp(tracks);
  161:     // Size of moov does not depend on offset values, only on stco vs co64.
  162:     final useCo64 = payloadSize + ftyp.length + (64 << 20) > 0xFFFFFFFF;
  163:     final mdatHeaderSize = payloadSize + 8 > 0xFFFFFFFF ? 16 : 8;
  164:     final moovSize = _moov(tracks, useCo64).length;
  165:     var offset = ftyp.length + moovSize + mdatHeaderSize;
  166:     for (final c in chunks) {
  167:       c.outputOffset = offset;
  168:       offset += c.length;
  169:     }
  170:     final moov = _moov(tracks, useCo64);
  171:     assert(moov.length == moovSize);
  172: 
  173:     final tmp = File('$output.part');
  174:     final out = await tmp.open(mode: FileMode.write);
  175:     final sources = <String, RandomAccessFile>{};
  176:     try {
  177:       await out.writeFrom(ftyp);
  178:       await out.writeFrom(moov);
  179:       final mdatHeader = _W();
  180:       if (mdatHeaderSize == 16) {
  181:         mdatHeader
  182:           ..u32(1)
  183:           ..fourcc('mdat')
  184:           ..u64(payloadSize + 16);
  185:       } else {
  186:         mdatHeader
  187:           ..u32(payloadSize + 8)
  188:           ..fourcc('mdat');
  189:       }
  190:       await out.writeFrom(mdatHeader.bytes);
  191: 
  192:       final buffer = Uint8List(_copyBufferSize);
  193:       var copied = 0;
  194:       for (final c in chunks) {
  195:         final src = sources[c.sourcePath] ??= await File(
  196:           c.sourcePath,
  197:         ).open();
  198:         await src.setPosition(c.sourceOffset);
  199:         var remaining = c.length;
  200:         if (c.prefix case final prefix?) {
  201:           await out.writeFrom(prefix);
  202:           remaining -= prefix.length;
  203:           copied += prefix.length;
  204:         }
  205:         while (remaining > 0) {
  206:           final n = await src.readInto(
  207:             buffer,
  208:             0,
  209:             remaining < buffer.length ? remaining : buffer.length,
  210:           );
  211:           if (n <= 0) {
  212:             throw FormatException('unexpected EOF in ${c.sourcePath}');
  213:           }
  214:           await out.writeFrom(buffer, 0, n);
  215:           remaining -= n;
  216:           copied += n;
  217:         }
  218:         onProgress?.call(copied, payloadSize);
  219:       }
  220:     } catch (_) {
  221:       await out.close();
  222:       for (final s in sources.values) {
  223:         await s.close();
  224:       }
  225:       if (tmp.existsSync()) await tmp.delete();
  226:       rethrow;
  227:     }
  228:     await out.close();
  229:     for (final s in sources.values) {
  230:       await s.close();
  231:     }
  232:     final dest = File(output);
  233:     if (dest.existsSync()) await dest.delete();
  234:     await tmp.rename(output);
  235:   }
  236: 
  237:   static Uint8List _ftyp(List<_Track> tracks) {
  238:     final brands = <String>{'isom', 'iso2', 'mp41'};
  239:     for (final t in tracks) {
  240:       final fmt = t.sampleEntryType;
  241:       if (fmt == 'avc1' || fmt == 'avc3') brands.add('avc1');
  242:       if (fmt == 'av01') brands.add('av01');
  243:     }
  244:     final w = _W()
  245:       ..fourcc('isom')
  246:       ..u32(0x200);
  247:     brands.forEach(w.fourcc);
  248:     return _box('ftyp', w.bytes);
  249:   }
  250: 
  251:   static Uint8List _moov(List<_Track> tracks, bool useCo64) {
  252:     final traks = <Uint8List>[];
  253:     var movieDuration = 0;
  254:     for (var i = 0; i < tracks.length; i++) {
  255:       final t = tracks[i];
  256:       final trackDuration = t.movieDuration;
  257:       movieDuration = max(movieDuration, trackDuration);
  258:       traks.add(t.buildTrak(i + 1, trackDuration, useCo64));
  259:     }
  260:     final mvhd = _W();
  440:           e.mediaTime,
  441:           e.rate,
  442:         ),
  443:     ];
  444:   }
  445: 
  446:   static Future<_Track> parse(String path) async {
  447:     final t = _Track(path);
  448:     final raf = await File(path).open();
  449:     try {
  450:       final length = await raf.length();
  451:       var pos = 0;
  452:       var sawMoov = false;
  453:       var dts = 0;
  454:       while (pos + 8 <= length) {
  455:         await raf.setPosition(pos);
  456:         final header = await raf.read(16);
  457:         final hd = ByteData.sublistView(header);
  458:         var size = hd.getUint32(0);
  459:         final type = String.fromCharCodes(header, 4, 8);
  460:         var headerSize = 8;
  461:         if (size == 1) {
  462:           // 64-bit size: the header must be there in full
  463:           if (header.length < 16) {
  464:             throw FormatException('truncated box $type at $pos in $path');
  465:           }
  466:           size = hd.getUint64(8);
  467:           headerSize = 16;
  468:         } else if (size == 0) {
  469:           size = length - pos;
  470:         }
  471:         if (size < headerSize || pos + size > length) {
  472:           throw FormatException('bad box $type at $pos in $path');
  473:         }
  474:         if (type == 'moov') {
  475:           await raf.setPosition(pos + headerSize);
  476:           t._parseMoov(await raf.read(size - headerSize));
  477:           sawMoov = true;
  478:         } else if (type == 'moof') {
  479:           if (!sawMoov) throw FormatException('moof before moov in $path');
  480:           await raf.setPosition(pos + headerSize);
