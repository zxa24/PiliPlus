 2255:   int? _getValidOffset(String data) {
 2256:     final timeLength = videoDetailController.data.timeLength;
 2257:     if (timeLength == null) return null;
 2258:     if (_timeRegExp.firstMatch(data) case final timeStr?) {
 2259:       final offset = DurationUtils.parseDuration(timeStr.group(0));
 2260:       if (0 < offset && offset * 1000 < timeLength) {
 2261:         return offset;
 2262:       }
 2263:     }
 2264:     return null;
 2265:   }
