+        await File(part).rename(file.path);
+        saved++;
+      }
+      result = '$dirName/$name';
+    } catch (e) {
+      if (kDebugMode) debugPrint('comment image $url: $e');
+    }
+    return _done[url] = result;
+  }
+}
