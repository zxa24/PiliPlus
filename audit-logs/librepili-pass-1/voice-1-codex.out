  233:   static Account _bindRequestAccount(RequestOptions options) {
  234:     assert(options.extra['account'] is Account?);
  235:     var account =
  236:         options.extra['account'] as Account? ?? _findAccount(options.path);
  237:     // LibrePili: no global login. Even in login mode the account is only
  238:     // attached where it is required; everything else goes out anonymously.
  239:     if (account is LoginAccount &&
  240:         (!LoginPolicy.loginMode || !LoginPolicy.requiresAccount(options))) {
  241:       account = AnonymousAccount();
  242:     }
  243:     return options.extra['account'] = account;
