  550:   /// Turns the downloaded streams into one complete video file in the export
  551:   /// directory and removes the separate stream files. On failure the stream
  552:   /// files are kept, so the entry still plays in-app as before.
  553:   Future<void> _mergeDownload(BiliDownloadEntryInfo entry) async {
  554:     final videoDir = path.join(entry.entryDirPath, entry.typeTag);
  555:     final List<String> inputs;
  556:     if (entry.mediaType == 1) {
  557:       inputs = [path.join(videoDir, PathUtils.videoNameType1)];
  558:     } else {
  559:       final audio = path.join(videoDir, PathUtils.audioNameType2);
  560:       inputs = [
  561:         path.join(videoDir, PathUtils.videoNameType2),
  562:         if (entry.hasDashAudio && File(audio).existsSync()) audio,
  563:       ];
  564:     }
  565:     String? output;
  566:     try {
  567:       output = await _exportFilePath(entry);
  568:       if (entry.mediaType == 1) {
  569:         await _moveFile(inputs.first, output);
  570:       } else {
  571:         await _remuxInBackground(inputs, output);
  572:         for (final input in inputs) {
  573:           await File(input).tryDel();
  574:         }
  575:       }
  576:       entry.mergedPath = output;
  577:       if (Platform.isAndroid) await _scanMedia(output);
  578:       await DownloadExtras.export(
  579:         entry: entry,
  580:         folder: path.dirname(output),
  581:         base: path.basenameWithoutExtension(output),
  582:       );
  583:     } catch (e) {
  584:       if (output != null) {
  585:         await File(output).tryDel();
  586:         final folder = Directory(path.dirname(output));
  587:         if (_isOwnFolder(output) && folder.listSync().isEmpty) {
  588:           await folder.tryDel();
  589:         }
  590:       }
  591:       SmartDialog.showToast('合并音视频失败，已保留分离的音视频文件');
  592:       if (kDebugMode) debugPrint('merge download error: $e');
  593:     }
