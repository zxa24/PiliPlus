+    } catch (e) {
+      if (kDebugMode) debugPrint('media scan failed: $e');
+    }
+  }
+
+  // Static so the isolate closure only captures the two arguments.
+  static Future<void> _remuxInBackground(List<String> inputs, String output) =>
