  482:   late bool _isHorizontal = true;
  483:   DragStartDetails? _downPos;
  484:   void _onDragDown(DragStartDetails detail) => _downPos = detail;
  485:   void _onDragEnd([_]) => _downPos = null;
  486:   void _onDragUpdate(DragUpdateDetails e) {
  487:     if (_downPos == null) {
  488:       return;
  489:     }
  490:     final offset = _isHorizontal
  491:         ? (e.localPosition.dx - _downPos!.localPosition.dx).abs()
  492:         : (e.localPosition.dy - _downPos!.localPosition.dy).abs();
  493:     if (offset < 20) {
  494:       return;
  495:     }
  496:     _downPos = null;
  497:     if (_isHorizontal) {
  498:       if (e.delta.dx > 0) {
  499:         if (_pageIndex.value == 1) {
  500:           _onScroll(0);
  501:         }
  502:       } else {
  503:         if (_pageIndex.value == 0) {
  504:           _onScroll(1);
  505:         }
  506:       }
  507:     } else {
  508:       if (e.delta.dy < 0) {
  509:         _onPayCoin();
  510:       }
  511:     }
  512:   }
  513: 
  514:   void _onPayCoin() {
  515:     if (_isPaying) return;
  516:     _isPaying = true;
  517:     _pageIndex.refresh();
  518:     _slide22Controller.forward().whenComplete(() {
  519:       _slide22Controller.reverse().whenComplete(() {
  520:         if (_pageIndex.value == 1) {
  521:           _thunderIndex.value += 1;
  522:           _timer ??= Timer.periodic(const Duration(milliseconds: 50 ~/ 3), (_) {
  523:             final index = _thunderIndex.value;
  524:             if (index == _thunderImages.length) {
  525:               _cancelTimer();
  526:             } else {
  527:               _thunderIndex.value = index + 1;
  528:             }
  529:           });
  530:         }
  531:         _boxAnimController.forward().whenComplete(_boxAnimController.reverse);
  532:         _coinController.forward().whenComplete(() {
  533:           Get.back();
  534:           widget.onPayCoin(_pageIndex.value + 1, _coinWithLike.value);
  535:         });
  536:       });
  537:     });
  538:   }
  539: }

