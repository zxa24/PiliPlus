    3: /// LibrePili: joins progressive MP4 segments (old single-URL downloads that
    4: /// come split into several files) into one timeline for [Mp4Remuxer]'s
    5: /// writer. Samples are read from each segment's sample tables (stts, ctts,
    6: /// stss, stsc, stsz/stz2, stco/co64) and copied byte-for-byte.
    7: ///
    8: /// Every segment must carry the same tracks with identical codec
    9: /// configuration (stsd); otherwise [UnsupportedError] is thrown and the
   10: /// caller keeps the segments as separate files.
   11: abstract final class _Mp4Joiner {
   12:   static List<_Track> join(List<String> inputs) {
   13:     final tracks = _readProgressive(inputs.first);
   14:     for (final t in tracks) {
   15:       _openEndedEdits(t);
   16:     }
   17:     for (final input in inputs.skip(1)) {
   18:       final segment = _readProgressive(input);
   19:       if (segment.length != tracks.length) {
   20:         throw UnsupportedError('segments have different tracks: $input');
   21:       }
   22:       for (var i = 0; i < tracks.length; i++) {
   23:         if (!_sameConfig(tracks[i], segment[i])) {
   24:           throw UnsupportedError('codec configuration differs: $input');
   25:         }
   26:       }
   27:       // start where the longest track ended, so the tracks stay in sync
   28:       final start = tracks
   29:           .map((t) => t.mediaDuration / t.timescale)
   30:           .reduce(max);
   31:       for (var i = 0; i < tracks.length; i++) {
   32:         final t = tracks[i];
   33:         final s = segment[i];
   34:         final gap = (start * t.timescale).round() - t.mediaDuration;
   35:         if (gap > 0) t.durations.last += gap;
   36:         final firstSample = t.sizes.length;
   37:         final dts = t.mediaDuration;
   38:         for (final c in s.chunks) {
   39:           t.chunks.add(
   40:             _Chunk(
   41:                 t,
   42:                 c.sourceOffset,
   43:                 c.firstSample + firstSample,
   44:                 c.startDts + dts,
   45:                 c.sourcePath,
   46:               )
   47:               ..length = c.length
   48:               ..sampleCount = c.sampleCount,
   49:           );
   50:         }
   51:         t
   52:           ..durations.addAll(s.durations)
   53:           ..sizes.addAll(s.sizes)
   54:           ..ctos.addAll(s.ctos)
   55:           ..syncs.addAll(s.syncs);
   56:       }
   57:     }
   58:     return tracks;
   59:   }
