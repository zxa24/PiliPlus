   87:   static List<_Track> _readProgressive(String path) {
   88:     final raf = File(path).openSync();
   89:     Uint8List? moov;
   90:     try {
   91:       final length = raf.lengthSync();
   92:       var pos = 0;
   93:       while (pos + 8 <= length) {
   94:         raf.setPositionSync(pos);
   95:         final header = raf.readSync(16);
   96:         final hd = ByteData.sublistView(header);
   97:         var size = hd.getUint32(0);
   98:         final type = String.fromCharCodes(header, 4, 8);
   99:         var headerSize = 8;
  100:         if (size == 1) {
  101:           size = hd.getUint64(8);
  102:           headerSize = 16;
  103:         } else if (size == 0) {
  104:           size = length - pos;
  105:         }
  106:         if (size < headerSize || pos + size > length) {
  107:           throw FormatException('bad box $type at $pos in $path');
  108:         }
  109:         if (type == 'moov') {
