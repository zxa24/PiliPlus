   66:     }
   67:     for (var i = 0; i < a.stsd.length; i++) {
   68:       if (a.stsd[i] != b.stsd[i]) return false;
   69:     }
   70:     return true;
   71:   }
   72: 
   73:   /// The first segment's edit list is kept (encoder delay, a late start),
   74:   /// but its playing edit must run to the end of the joined track.
   75:   static void _openEndedEdits(_Track t) {
   76:     final firstPlaying = t.edits.indexWhere((e) => e.mediaTime >= 0);
   77:     if (firstPlaying == -1) {
   78:       t.edits.clear();
   79:       return;
   80:     }
   81:     final playing = t.edits[firstPlaying];
   82:     t.edits
   83:       ..removeRange(firstPlaying, t.edits.length)
   84:       ..add(_EditEntry(0, playing.mediaTime, playing.rate));
   85:   }
