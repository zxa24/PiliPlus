+              ..sampleCount = c.sampleCount,
+          );
+        }
+        t
+          ..durations.addAll(s.durations)
+          ..sizes.addAll(s.sizes)
+          ..ctos.addAll(s.ctos)
+          ..syncs.addAll(s.syncs);
+      }
