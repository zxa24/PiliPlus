   63: 
   64:     override fun queryRoots(projection: Array<out String>?): Cursor {
   65:         val context = context!!
   66:         val appInfo = context.applicationInfo
   67:         val appName = appInfo.loadLabel(context.packageManager).toString()
   68:         return MatrixCursor(projection ?: defaultRootProjection).apply {
   69:             newRow().apply {
   70:                 add(DocumentsContract.Root.COLUMN_ROOT_ID, packageName)
   71:                 add(DocumentsContract.Root.COLUMN_DOCUMENT_ID, packageName)
   72:                 add(DocumentsContract.Root.COLUMN_SUMMARY, packageName)
   73:                 val flags =
   74:                     DocumentsContract.Root.FLAG_SUPPORTS_CREATE or DocumentsContract.Root.FLAG_LOCAL_ONLY or DocumentsContract.Root.FLAG_SUPPORTS_IS_CHILD
   75:                 add(DocumentsContract.Root.COLUMN_FLAGS, flags)
   76:                 add(DocumentsContract.Root.COLUMN_TITLE, appName)
   77:                 add(DocumentsContract.Root.COLUMN_MIME_TYPES, "*/*")
   78:                 add(DocumentsContract.Root.COLUMN_ICON, appInfo.icon)
   79:             }
   80:         }
   81:     }
