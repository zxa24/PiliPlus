  327:   Future<void> _handleMenuItem(WebviewMenuItem item) async {
  328:     switch (item) {
  329:       case WebviewMenuItem.refresh:
  330:         if (Platform.isLinux) {
  331:           _linuxWebview?.reload();
  332:         } else {
  333:           _webViewController?.reload();
  334:         }
  335:         break;
  336:       case WebviewMenuItem.copy:
  337:         if (Platform.isLinux) {
  338:           Utils.copyText(_url);
  339:         } else {
  340:           WebUri? uri = await _webViewController?.getUrl();
  341:           if (uri != null) {
  342:             Utils.copyText(uri.toString());
  343:           }
  344:         }
  345:         break;
  346:       case WebviewMenuItem.openInBrowser:
  347:         if (Platform.isLinux) {
  348:           PageUtils.launchURL(_url);
  349:         } else {
  350:           WebUri? uri = await _webViewController?.getUrl();
  351:           if (uri != null) {
  352:             PageUtils.launchURL(uri.toString());
  353:           }
  354:         }
  355:         break;
  356:       case WebviewMenuItem.clearCache:
  357:         try {
  358:           // desktop_webview_window 的 clearAll 方法会销毁所有 GTK 窗口
  359:           if (Platform.isLinux) {
  360:             await LinuxCookieManager.deleteAllCookies();
  361:             _closeLinuxWebview();
  362:             SmartDialog.showToast('已清理缓存并关闭窗口');
  363:             if (mounted) {
  364:               Get.back();
  365:             }
  366:           } else {
  367:             await InAppWebViewController.clearAllCache();
  368:             await _webViewController?.clearHistory();
  369:             SmartDialog.showToast('已清理');
  370:           }
  371:         } catch (e) {
  372:           SmartDialog.showToast(e.toString());
  373:         }
  374:         break;
  375:       case WebviewMenuItem.goBack:
  376:         if (Platform.isLinux) {
  377:           _linuxWebview?.back();
  378:         } else {
  379:           if (await _webViewController?.canGoBack() == true) {
  380:             _webViewController?.goBack();
  381:           } else {
  382:             Get.back();
  383:           }
  384:         }
  385:         break;
  386:       case WebviewMenuItem.resetCookie:
  387:         if (Platform.isLinux) {
  388:           if (LinuxCookieManager.isBiliDomain(_url)) {
  389:             final js = LinuxCookieManager.generateCookieInjectionJs();
  390:             if (js.isNotEmpty) {
  391:               await _linuxWebview?.evaluateJavaScript(js);
  392:             }
  393:           }
  394:           _linuxWebview?.reload();
  395:         } else {
  396:           await LoginUtils.setWebCookie();
  397:         }
  398:         SmartDialog.showToast('设置成功，刷新或重新打开网页');
  399:         break;
  400:     }
  401:   }
