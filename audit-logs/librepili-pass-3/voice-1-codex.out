  348:   Future<bool> downloadDanmaku({
  349:     required BiliDownloadEntryInfo entry,
  350:     bool isUpdate = false,
  351:   }) async {
  352:     final cid = entry.pageData?.cid ?? entry.source?.cid;
  353:     if (cid == null) {
  354:       return false;
  355:     }
  356:     final danmakuFile = File(
  357:       path.join(entry.entryDirPath, PathUtils.danmakuName),
  358:     );
  359:     if (isUpdate || !danmakuFile.existsSync()) {
  360:       try {
  361:         if (!isUpdate) {
  362:           _updateCurStatus(DownloadStatus.getDanmaku);
  363:         }
  364:         final seg = (entry.totalTimeMilli / DmUtils.segLength).ceil();
  365:         if (seg <= 0) {
  366:           throw StateError('Invalid danmaku segment count: $seg');
  367:         }
  368: 
  369:         final danmaku = (await DmGrpc.dmSegMobile(
  370:           cid: cid,
  371:           segmentIndex: 1,
  372:         )).data;
  373:         for (var start = 2; start <= seg; start += _maxDanmakuConcurrency) {
  374:           final end = start + _maxDanmakuConcurrency - 1;
  375:           final responses = await Future.wait([
  376:             for (var index = start; index <= seg && index <= end; index++)
  377:               DmGrpc.dmSegMobile(cid: cid, segmentIndex: index),
  378:           ]);
  379:           for (final response in responses) {
  380:             danmaku.elems.addAll(response.data.elems);
  381:           }
  382:           responses.clear();
  383:         }
  384:         await danmakuFile.writeAsBytes(danmaku.writeToBuffer());
  385: 
  386:         return true;
  387:       } catch (e) {
  388:         if (!isUpdate) {
  389:           _updateCurStatus(DownloadStatus.failDanmaku);
  390:         }
  391:         if (kDebugMode) SmartDialog.showToast(e.toString());
  392:         return false;
  393:       }
  394:     }
  395:     return true;
  396:   }
