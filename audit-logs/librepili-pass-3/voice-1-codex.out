    9: /// LibrePili privacy model: incognito by default, login is opt-in, and even
   10: /// in login mode the account is attached only to requests that need it.
   11: ///
   12: /// In login mode the home "推荐" feed (and its "不感兴趣" feedback) uses the
   13: /// account assigned to the recommend role, so the feed is personalised; with
   14: /// that role left anonymous it stays anonymous. Everything else (search,
   15: /// other home tabs, video info, comments, spaces...) is sent anonymously so
   16: /// it cannot be tied to the account. Incognito: everything is anonymous.
   17: abstract final class LoginPolicy {
   18:   /// Opt-in switch. Off: every account role is anonymous (stored accounts
   19:   /// stay dormant). On: see [requiresAccount].
   20:   static bool get loginMode => Pref.loginMode;
   21: 
   22:   /// Account-private reads, app-API writes (signed with access_key instead of
   23:   /// csrf), login-flow calls and stream URLs (high quality needs an account).
   24:   static const Set<String> _accountApis = {
   25:     // stream (1080P+ / VIP quality)
   26:     Api.ugcUrl, Api.pgcUrl, Api.pugvUrl, Api.tvPlayUrl,
   27:     // account info
   28:     Api.userInfo, Api.userStatOwner, Api.getCoin, Api.coinLog, Api.loginLog,
   29:     Api.expLog, Api.moralLog, Api.loginDevices, Api.userRealName,
   30:     Api.myEmote, Api.spaceSetting,
   31:     // own profile (账号资料) page: read + app-API edits (access_key, no csrf)
   32:     '${HttpString.appBaseUrl}/x/v2/account/myinfo',
   33:     '/x/member/app/uname/update', '/x/member/app/sign/update',
   34:     '/x/member/app/sex/update', '/x/member/app/birthday/update',
   35:     // relation to the current user
   36:     Api.pgcLikeCoinFav,
   37:     Api.videoRelation, Api.seasonStatus, Api.relation, Api.relations,
   38:     Api.sameFollowing, Api.followedUp, Api.followSearch, Api.blackLst,
   39:     Api.followUpTag, Api.followUpGroup, Api.danmakuFilter,
   40:     Api.replyInteraction, Api.danmakuEditState,
   41:     // own favorites / later / history
   42:     Api.favFolder, Api.userFavFolder, Api.favFolderInfo, Api.userSubFolder,
   43:     Api.favPgc, Api.favArticle, Api.favPugv, Api.favTopicList,
   44:     Api.favSeasonList, Api.seeYouLater, Api.historyList, Api.historyStatus,
   45:     // folder contents (private folders) and watch-later / fav "play all"
   46:     Api.favResourceList, Api.mediaList,
   47:     Api.searchHistory, Api.noteList, Api.archiveNote, Api.userNoteList,
   48:     // playback history reporting
   49:     Api.heartBeat, Api.historyReport, Api.roomEntryAction,
   50:     Api.mediaListHistory, Api.liveLikeReport,
   51:     // followed feed
   52:     Api.followUp, Api.dynUplist, Api.followDynamic, Api.getUnreadDynamic,
   53:     Api.liveFollow, Api.getLiveFavTag, Api.followeeVotes,
   54:     // saving the favourite live areas (app-API write, access_key only)
   55:     Api.setLiveFavTag,
   56:     // messages
   57:     Api.msgUnread, Api.msgFeedUnread, Api.msgFeedReply, Api.msgFeedAt,
