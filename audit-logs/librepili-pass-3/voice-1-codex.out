  492:   /// Old single-URL (durl) streams may come in several segments: they are
  493:   /// downloaded one after another (resuming what is on disk) and joined by
  494:   /// [_mergeDownload]. Progress runs over their total size.
  495:   void _startSegment(List<Type1Segment> segments, int index, String dir) {
  496:     final total = segments.fold<int>(0, (s, e) => s + e.bytes);
  497:     final done = segments.take(index).fold<int>(0, (s, e) => s + e.bytes);
  498:     final segment = segments[index];
  499:     late final DownloadManager manager;
  500:     manager = DownloadManager(
  501:       url: segment.url,
  502:       backupUrls: segment.backupUrls,
  503:       path: path.join(dir, PathUtils.segmentNameType1(index)),
  504:       onReceiveProgress: segments.length == 1 || total <= 0
  505:           ? _onReceive
  506:           : (received, _) => _onReceive(done + received, total),
  507:       onDone: ([error]) {
  508:         if (error != null || index + 1 == segments.length) {
  509:           return _onDone(error);
  510:         }
  511:         // paused / deleted / replaced meanwhile
  512:         if (!identical(_downloadManager, manager)) return;
  513:         _startSegment(segments, index + 1, dir);
  514:       },
  515:     );
  516:     _downloadManager = manager;
  517:   }
  518: 
  519:   Future<void> _updateBiliDownloadEntryJson(BiliDownloadEntryInfo entry) {
  520:     final entryJsonFile = File(path.join(entry.entryDirPath, _entryFile));
  521:     return entryJsonFile.writeAsString(jsonEncode(entry.toJson()));
  522:   }
  523: 
  524:   void _onReceive(int progress, int total) {
  525:     if (curDownload.value case final entry?) {
  526:       if (progress == 0 && total != 0) {
  527:         _updateBiliDownloadEntryJson(entry..totalBytes = total);
  528:       }
  529:       entry
  530:         ..downloadedBytes = progress
  531:         ..status = DownloadStatus.downloading;
  532:       curDownload.refresh();
  533:     }
  534:   }
  535: 
  536:   /// Last download error (diagnostics: self test, logs).
  537:   String? lastError;
  538: 
  539:   void _onDone([Object? error]) {
  540:     if (error != null) {
  541:       lastError = 'video: $error';
  542:       debugPrint('download failed: $lastError');
  543:     }
  544:     if (error != null) {
  545:       _updateCurStatus(_downloadManager?.status ?? DownloadStatus.pause);
  546:       return;
  547:     }
  548: 
  549:     final status = switch (_audioDownloadManager?.status) {
  550:       DownloadStatus.downloading => DownloadStatus.audioDownloading,
  551:       DownloadStatus.failDownload => DownloadStatus.failDownloadAudio,
  552:       _ => _downloadManager?.status ?? DownloadStatus.pause,
  553:     };
  554:     _updateCurStatus(status);
  555: 
  556:     if (curDownload.value case final curEntryInfo?) {
  557:       curEntryInfo.downloadedBytes = curEntryInfo.totalBytes;
  558:       if (status == DownloadStatus.completed) {
  559:         _completeDownload();
  560:       } else {
  561:         _updateBiliDownloadEntryJson(curEntryInfo);
  562:       }
  563:     }
  564:   }
  565: 
  566:   void _onAudioDone([Object? error]) {
  567:     if (error != null) {
  568:       lastError = 'audio: $error';
  569:       debugPrint('download failed: $lastError');
  570:     }
  571:     if (_downloadManager?.status == DownloadStatus.completed) {
  572:       if (error == null) {
  573:         _completeDownload();
  574:       } else {
  575:         final status = _audioDownloadManager?.status ?? DownloadStatus.pause;
  576:         _updateCurStatus(
  577:           status == DownloadStatus.failDownload
  578:               ? DownloadStatus.failDownloadAudio
  579:               : status,
  580:         );
  581:       }
  582:     }
  583:   }
  584: 
  585:   Future<void> _completeDownload() async {
  586:     final entry = curDownload.value;
  587:     if (entry == null) {
  588:       return;
  589:     }
  590:     _downloadManager = null;
  591:     _audioDownloadManager = null;
  592:     entry.downloadedBytes = entry.totalBytes;
  593:     final cid = entry.cid;
  594:     _mergingCids.add(cid);
  595:     _mergeDeletedCids.remove(cid);
  596:     _updateCurStatus(DownloadStatus.merging);
  597:     final (:output, :inputs, :damaged) = await _mergeDownload(entry);
  598:     _mergingCids.remove(cid);
  599:     final deleted = _mergeDeletedCids.remove(cid);
  600:     if (deleted || !Directory(entry.entryDirPath).existsSync()) {
  601:       // deleted while merging (the merge may have kept files open, so the
  602:       // delete may not have removed everything)
  603:       await _deleteMerged(entry);
  604:       await Directory(entry.entryDirPath).tryDel(recursive: true);
  605:       waitDownloadQueue.remove(entry);
  606:       if (curDownload.value == null) nextDownload();
  607:       return;
  608:     }
  609:     if (damaged) {
  610:       // segments still damaged / missing: not complete. Stays in the queue
  611:       // as failed (like a failed transfer, the queue waits for the user);
  612:       // starting it again fetches a fresh play URL and merges again.
  613:       if (curDownload.value?.cid == cid) {
  614:         _updateCurStatus(DownloadStatus.failMerge);
  615:       }
  616:       await _updateBiliDownloadEntryJson(entry);
  617:       return;
  618:     }
  619:     // record completion before removing the stream files, so a crash here
  620:     // cannot turn the entry back into an incomplete one

