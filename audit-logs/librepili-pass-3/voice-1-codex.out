   10: class DownloadManager {
   11:   final String url;
   12: 
   13:   /// Other CDN addresses of the same stream, tried in turn when a transfer
   14:   /// breaks off (LibrePili: some mirrors drop long transfers mid-way).
   15:   final List<String> backupUrls;
   16:   final String path;
   17:   final void Function(int, int)? onReceiveProgress;
   18:   final void Function([Object? error]) onDone;
   19: 
   20:   static const _maxAttempts = 6;
   21: 
