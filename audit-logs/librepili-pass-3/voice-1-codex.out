  199:     if (received == 0) {
  200:       onReceiveProgress?.call(0, expected);
  201:     }
  202: 
  203:     int? last;
  204:     try {
  205:       await for (final chunk in data.stream) {
  206:         sink.add(chunk);
  207:         received += chunk.length;
  208:         final now = DateTime.now().millisecondsSinceEpoch ~/ 1000;
  209:         if (last != now) {
  210:           last = now;
  211:           onReceiveProgress?.call(received, expected);
  212:         }
  213:       }
  214:       await sink.close();
  215:     } catch (e) {
  216:       try {
  217:         await sink.close();
  218:       } catch (_) {}
  219:       return e;
  220:     }
  221:     if (expected >= 0 && received != expected) {
  222:       // clean early EOF: retry from what was saved
  223:       return 'incomplete transfer: $received of $expected bytes';
  224:     }
  225:     _status = DownloadStatus.completed;
  226:     onDone();
  227:     return null;
  228:   }
  229: 
  230:   Future<void> cancel({required bool isDelete}) {
  231:     if (!isDelete && _status == DownloadStatus.downloading) {
  232:       _status = DownloadStatus.pause;
  233:     }
  234:     if (!_cancelToken.isCancelled) {
  235:       _cancelToken.cancel();
  236:     }
  237:     return task;
  238:   }
  239: }

