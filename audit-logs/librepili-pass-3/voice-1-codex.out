  149:   /// Picks the video of a folder (the largest video file, as on desktop)
  150:   /// and the side files written next to it by a LibrePili download or by
  151:   /// other tools: `librepili.json`, `cover.jpg`, `<base>.danmaku.xml` /
  152:   /// `<base>.xml`, `<base>.<lan>.srt`, `<base>.comments.json` and its
  153:   /// `comments_images/` folder.
  154:   static LocalFolderMatch? match(
  155:     List<LocalDocument> children, {
  156:     required bool Function(String name) isVideo,
  157:   }) {
  158:     final videos = children.where((e) => !e.isDir && isVideo(e.name)).toList()
  159:       ..sort((a, b) => b.size.compareTo(a.size));
  160:     final video = videos.firstOrNull;
  161:     if (video == null) return null;
  162:     final base = path.basenameWithoutExtension(video.name);
  163:     bool isSide(String name) =>
  164:         name == DownloadExtras.infoName ||
  165:         name == DownloadExtras.coverName ||
  166:         name == '$base${DownloadExtras.xmlSuffix}' ||
  167:         name == '$base.xml' ||
  168:         name == '$base${DownloadExtras.commentsSuffix}' ||
  169:         (name.startsWith('$base.') && name.endsWith('.srt'));
  170:     final sideFiles = [
  171:       for (final e in children)
  172:         if (!e.isDir && isSide(e.name)) e,
  173:     ];
  174:     final hasComments = sideFiles.any(
  175:       (e) => e.name == '$base${DownloadExtras.commentsSuffix}',
  176:     );
  177:     return LocalFolderMatch(
