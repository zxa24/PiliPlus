  239:     private fun retrieveFile(documentId: String, check: Boolean = true): File? {
  240:         val path = documentId.substring(packageName.length)
  241:             .removePrefix("/").removeSuffix("/")
  242:         if (path.isEmpty()) return null
  243:         val rootDirLabel = path.substringBefore('/')
  244:         val childPath = path.substringAfter('/', missingDelimiterValue = "")
  245:         val file = if (rootDirLabel.equals(LABEL_DATA_DIR, true) && dataDir != null) {
  246:             File(dataDir, childPath)
  247:         } else if (rootDirLabel.equals(LABEL_DE_DATA_DIR, true) && deDataDir != null) {
  248:             File(deDataDir, childPath)
  249:         } else if (rootDirLabel.equals(LABEL_EX_DATA_DIR, true) && exDataDir != null) {
  250:             File(exDataDir, childPath)
  251:         } else if (rootDirLabel.equals(LABEL_OBB_DIR, true) && obbDir != null) {
  252:             File(obbDir, childPath)
  253:         } else throw FileNotFoundException("$documentId not found")
  254:         if (check) try {
  255:             Os.lstat(file.path)
  256:         } catch (_: Exception) {
  257:             throw FileNotFoundException("$documentId not found")
  258:         }
  259:         return file
  260:     }
