  453:           break;
  454:         case Type2 mediaFileInfo:
  455:           _downloadManager = DownloadManager(
  456:             url: mediaFileInfo.video.first.baseUrl,
  457:             backupUrls: mediaFileInfo.video.first.backupUrl ?? const [],
  458:             path: path.join(videoDir.path, PathUtils.videoNameType2),
  459:             onReceiveProgress: _onReceive,
  460:             onDone: _onDone,
  461:           );
  462:           final audio = mediaFileInfo.audio;
  463:           if (audio != null && audio.isNotEmpty) {
  464:             _audioDownloadManager = DownloadManager(
  465:               url: audio.first.baseUrl,
  466:               backupUrls: audio.first.backupUrl ?? const [],
  467:               path: path.join(videoDir.path, PathUtils.audioNameType2),
  468:               onReceiveProgress: null,
  469:               onDone: _onAudioDone,
  470:             );
  471:           }
  472:           late final first = mediaFileInfo.video.first;
  473:           entry.pageData
  474:             ?..width = first.width
  475:             ..height = first.height;
  476:           entry.ep
  477:             ?..width = first.width
  478:             ..height = first.height;
  479:           _updateBiliDownloadEntryJson(entry);
  480:           break;
  481:         default:
  482:           break;
  483:       }
  484:     } catch (e) {
  485:       _updateCurStatus(DownloadStatus.failPlayUrl);
  486:       if (kDebugMode) {
  487:         debugPrint('get download url error: $e');
  488:       }
  489:     }
  490:   }
