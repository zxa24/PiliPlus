   22: class MainActivity : AudioServiceActivity() {
   23:     override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
   24:         super.configureFlutterEngine(flutterEngine)
   25:         // LibrePili: index files written to shared storage (e.g. finished
   26:         // downloads in Download/LibrePili) so galleries / players list them.
   27:         MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "librepili/media")
   28:             .setMethodCallHandler { call, result ->
   29:                 when (call.method) {
   30:                     "scanFile" -> {
   31:                         val path = call.argument<String>("path")
   32:                         if (path == null) {
   33:                             result.error("ARG", "path is required", null)
   34:                         } else {
   35:                             MediaScannerConnection.scanFile(
   36:                                 applicationContext,
   37:                                 arrayOf(path),
   38:                                 arrayOf(call.argument<String>("mimeType") ?: "video/mp4"),
   39:                             ) { _, uri -> runOnUiThread { result.success(uri?.toString()) } }
   40:                         }
   41:                     }
   42:                     // Local player: files / folders the user grants through the
   43:                     // system picker (Storage Access Framework). No storage
   44:                     // permission, and the video is never copied.
   45:                     "pickVideoFile" -> pick(result, REQUEST_PICK_FILE) {
   46:                         // some providers label MKV / FLV as untyped: offer those
   47:                         // too, Dart rejects what is not a video
   48:                         Intent(Intent.ACTION_OPEN_DOCUMENT)
   49:                             .addCategory(Intent.CATEGORY_OPENABLE)
   50:                             .setType("*/*")
   51:                             .putExtra(
   52:                                 Intent.EXTRA_MIME_TYPES,
   53:                                 arrayOf(
   54:                                     "video/*",
   55:                                     "video/x-matroska",
   56:                                     "video/x-flv",
   57:                                     "application/octet-stream",
   58:                                 ),
   59:                             )
   60:                     }
   61:                     "pickVideoFolder" -> pick(result, REQUEST_PICK_FOLDER) {
   62:                         Intent(Intent.ACTION_OPEN_DOCUMENT_TREE)
   63:                     }
   64:                     "listTree" -> {
   65:                         val uri = call.argument<String>("uri")
   66:                         val docId = call.argument<String>("docId")
   67:                         if (uri == null) {
   68:                             result.error("ARG", "uri is required", null)
   69:                         } else {
   70:                             background(result) { listChildren(Uri.parse(uri), docId) }
   71:                         }
   72:                     }
   73:                     "copyDocuments" -> {
   74:                         val items = call.argument<List<Map<String, String>>>("items")
   75:                         if (items == null) {
   76:                             result.error("ARG", "items is required", null)
   77:                         } else {
   78:                             background(result) { copyDocuments(items) }
   79:                         }
   80:                     }
   81:                     "openFd" -> {
   82:                         val uri = call.argument<String>("uri")
   83:                         if (uri == null) {
   84:                             result.error("ARG", "uri is required", null)
   85:                         } else {
   86:                             background(result) {
   87:                                 contentResolver.openFileDescriptor(Uri.parse(uri), "r")
   88:                                     ?.detachFd() ?: -1
   89:                             }
   90:                         }
   91:                     }
   92:                     "closeFd" -> {
   93:                         val fd = call.argument<Int>("fd")
   94:                         if (fd == null) {
   95:                             result.error("ARG", "fd is required", null)
   96:                         } else {
   97:                             // a descriptor from openFd the player did not take
   98:                             try {
   99:                                 ParcelFileDescriptor.adoptFd(fd).close()
  100:                             } catch (_: Exception) {
  101:                             }
  102:                             result.success(null)
  103:                         }
  104:                     }
  105:                     else -> result.notImplemented()
  106:                 }
  107:             }
  108:     }
  109: 
  110:     private fun pick(result: MethodChannel.Result, requestCode: Int, intent: () -> Intent) {
  111:         if (pendingPick != null) {
  112:             result.error("BUSY", "a picker is already open", null)
  113:             return
  114:         }
  115:         pendingPick = result
  116:         try {
  117:             startActivityForResult(
  118:                 intent().addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION),
  119:                 requestCode,
  120:             )
  121:         } catch (e: Exception) {
  122:             pendingPick = null
  123:             result.error("PICKER", e.message, null)
  124:         }
  125:     }
  126: 
  127:     private fun background(result: MethodChannel.Result, work: () -> Any?) {
  128:         io().execute {
  129:             try {
  130:                 val value = work()
  131:                 mainHandler.post { result.success(value) }
  132:             } catch (e: Exception) {
  133:                 mainHandler.post { result.error("IO", e.message, null) }
  134:             }
  135:         }
  136:     }
  137: 
  138:     override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
  139:         if (requestCode != REQUEST_PICK_FILE && requestCode != REQUEST_PICK_FOLDER) {
  140:             super.onActivityResult(requestCode, resultCode, data)
  141:             return
  142:         }
  143:         val result = pendingPick ?: return
  144:         pendingPick = null
  145:         val uri = if (resultCode == RESULT_OK) data?.data else null
  146:         if (uri == null) {
  147:             result.success(null)
  148:             return
  149:         }
  150:         // the grant is not persisted: nothing reopens a document later (the
  151:         // URI is not saved), and the session grant covers playing it now
  152:         background(result) {
  153:             if (requestCode == REQUEST_PICK_FOLDER) {
  154:                 mapOf("uri" to uri.toString(), "children" to listChildren(uri, null))
  155:             } else {
  156:                 describe(uri)
  157:             }
  158:         }
  159:     }
  160: 
  161:     /** Stable identity of a document (the same file picked again). */
  162:     private fun keyOf(uri: Uri): String = try {
  163:         "${uri.authority}/${DocumentsContract.getDocumentId(uri)}"
  164:     } catch (_: Exception) {
  165:         uri.toString()
  166:     }
  167: 
  168:     private fun describe(uri: Uri): Map<String, Any?> {
  169:         var name: String? = null
  170:         var size = 0L
  171:         contentResolver.query(
  172:             uri,
  173:             arrayOf(OpenableColumns.DISPLAY_NAME, OpenableColumns.SIZE),
  174:             null,
  175:             null,
  176:             null,
  177:         )?.use { c ->
  178:             if (c.moveToFirst()) {
  179:                 name = c.getString(0)
  180:                 if (!c.isNull(1)) size = c.getLong(1)
  181:             }
  182:         }
  183:         return mapOf(
  184:             "name" to (name ?: uri.lastPathSegment ?: "video"),
  185:             "uri" to uri.toString(),
  186:             "size" to size,
  187:             "key" to keyOf(uri),
  188:             "mime" to contentResolver.getType(uri),
  189:         )
  190:     }
  191: 
  192:     /** Children of [docId] (null: the granted folder itself) in [treeUri]. */
  193:     private fun listChildren(treeUri: Uri, docId: String?): List<Map<String, Any?>> {
  194:         val parent = docId ?: DocumentsContract.getTreeDocumentId(treeUri)
  195:         val out = mutableListOf<Map<String, Any?>>()
  196:         contentResolver.query(
  197:             DocumentsContract.buildChildDocumentsUriUsingTree(treeUri, parent),
  198:             arrayOf(
  199:                 DocumentsContract.Document.COLUMN_DOCUMENT_ID,
  200:                 DocumentsContract.Document.COLUMN_DISPLAY_NAME,
  201:                 DocumentsContract.Document.COLUMN_MIME_TYPE,
  202:                 DocumentsContract.Document.COLUMN_SIZE,
  203:             ),
  204:             null,
  205:             null,
  206:             null,
  207:         )?.use { c ->
  208:             while (c.moveToNext()) {
  209:                 val id = c.getString(0)
  210:                 val uri = DocumentsContract.buildDocumentUriUsingTree(treeUri, id)
  211:                 out.add(
  212:                     mapOf(
  213:                         "name" to c.getString(1),
  214:                         "uri" to uri.toString(),
  215:                         "isDir" to (c.getString(2) == DocumentsContract.Document.MIME_TYPE_DIR),
  216:                         "size" to (if (c.isNull(3)) 0L else c.getLong(3)),
  217:                         "docId" to id,
  218:                         "key" to "${uri.authority}/$id",
  219:                     ),
  220:                 )
  221:             }
  222:         }
  223:         return out
  224:     }
  225: 
  226:     /** Copies small side files (danmaku, subtitles, comments, cover, images). */
  227:     private fun copyDocuments(items: List<Map<String, String>>): Int {
  228:         var copied = 0
  229:         for (item in items) {
  230:             val from = item["uri"] ?: continue
  231:             val to = item["path"] ?: continue
  232:             // written beside and renamed once complete: a copy that fails
  233:             // part-way never leaves a truncated danmaku / comments file
  234:             val file = File(to)
  235:             val part = File("$to.part")
  236:             try {
  237:                 file.parentFile?.mkdirs()
  238:                 contentResolver.openInputStream(Uri.parse(from))?.use { input ->
  239:                     part.outputStream().use { input.copyTo(it) }
  240:                     file.delete()
  241:                     if (part.renameTo(file)) copied++
  242:                 }
  243:             } catch (_: Exception) {
  244:                 // best-effort: a missing side file only loses that extra
  245:             } finally {
  246:                 part.delete()
  247:             }
  248:         }
  249:         return copied
  250:     }
  251: 
  252:     companion object {
  253:         private const val REQUEST_PICK_FILE = 0x4c50
  254:         private const val REQUEST_PICK_FOLDER = 0x4c51
  255: 
  256:         // The FlutterEngine is cached across activity instances (audio
  257:         // service): a picker result may arrive in a recreated activity, so
  258:         // the pending call and the I/O thread live here, not per instance.
  259:         private var pendingPick: MethodChannel.Result? = null
  260:         private var executor: ExecutorService? = null
  261:         private val mainHandler = Handler(Looper.getMainLooper())
  262: 
  263:         private fun io(): ExecutorService =
  264:             executor?.takeIf { !it.isShutdown }
  265:                 ?: Executors.newSingleThreadExecutor().also { executor = it }
  266:     }
