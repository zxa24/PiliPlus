   51:     @SuppressLint("SdCardPath")
   52:     override fun attachInfo(context: Context, info: ProviderInfo?) {
   53:         super.attachInfo(context, info)
   54:         this.packageName = context.packageName
   55:         val dir = context.filesDir.parentFile
   56:         this.dataDir = dir
   57:         val dirPath = dir?.path.orEmpty()
   58:         if (dirPath.startsWith("/data/user/"))
   59:             deDataDir = File("/data/user_de/" + dirPath.substring(11))
   60:         this.exDataDir = context.getExternalFilesDir(null)?.parentFile
