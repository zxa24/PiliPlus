   89:   static final _contentRangeReg = RegExp(r'bytes\s+(\d+)-\d+/(\d+|\*)');
   90: 
   91:   /// Size of the stream at [url] from a one-byte range request, or null.
   92:   Future<int?> _probeTotal(String url) async {
   93:     try {
   94:       final res = await Request.http11Dio.get<ResponseBody>(
   95:         url.http2https,
   96:         options: Options(
   97:           headers: {'range': 'bytes=0-0'},
   98:           responseType: ResponseType.stream,
