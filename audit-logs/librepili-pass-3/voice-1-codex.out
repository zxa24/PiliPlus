   30:     this.backupUrls = const [],
   31:     required this.path,
   32:     required this.onReceiveProgress,
   33:     required this.onDone,
   34:   }) {
   35:     task = _start();
   36:   }
   37: 
   38:   Future<void> _start() async {
   39:     final urls = [
   40:       url,
   41:       for (final u in backupUrls)
   42:         if (u != url) u,
   43:     ];
   44:     // only consecutive attempts that saved nothing count against the budget:
   45:     // a long transfer that keeps advancing between drops is not failing
   46:     var failures = 0;
   47:     for (var attempt = 0; ; attempt++) {
   48:       final before = _savedBytes;
   49:       final error = await _attempt(urls[attempt % urls.length]);
   50:       if (error == null) return; // completed
   51:       failures = _savedBytes > before ? 1 : failures + 1;
   52:       if (!_canRetry || failures >= _maxAttempts) {
   53:         await _fail(error);
   54:         return;
   55:       }
   56:       // resume from what is on disk, on the next address; pause/delete
   57:       // cuts the wait short
   58:       await Future.any<void>([
   59:         Future.delayed(Duration(seconds: failures)),
   60:         _cancelToken.whenCancel,
   61:       ]);
   62:       if (!_canRetry) {
   63:         await _fail(error);
   64:         return;
   65:       }
   66:     }
   67:   }
   68: 
   69:   int get _savedBytes {
   70:     final file = File(path);
   71:     return file.existsSync() ? file.lengthSync() : 0;
   72:   }
   73: 
   74:   bool get _canRetry =>
