  169:         // size unknown: never throw away the saved bytes on a guess
  170:         return 'range not satisfiable, size unknown (have $received)';
  171:       }
  172:       // what is on disk does not match the stream: start over
  173:       await file.writeAsBytes(const []);
  174:       return 'range not satisfiable ($contentRange, have $received)';
  175:     }
  176: 
  177:     int expected = data.contentLength < 0 ? -1 : data.contentLength + received;
  178:     if (received > 0) {
  179:       if (response.statusCode != 206) {
  180:         // Range ignored: the body is the whole file, rewrite it from 0
  181:         received = 0;
  182:         expected = data.contentLength;
  183:       } else {
  184:         final match = contentRange == null
  185:             ? null
  186:             : _contentRangeReg.firstMatch(contentRange);
  187:         if (match == null || int.parse(match[1]!) != received) {
  188:           await discard();
  189:           return 'unexpected content-range: $contentRange (have $received)';
  190:         }
  191:         expected = int.tryParse(match[2]!) ?? expected;
