  228:   static bool _isBlockServer(String path) {
  229:     // match the host: a raw prefix match would skip every request when the
  230:     // saved address is empty or too short
  231:     final host = Uri.tryParse(blockServer)?.host;
  232:     return host != null &&
  233:         host.isNotEmpty &&
  234:         Uri.tryParse(path)?.host.toLowerCase() == host.toLowerCase();
  235:   }
