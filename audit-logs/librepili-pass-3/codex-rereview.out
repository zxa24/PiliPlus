   41: Future<void> importFromClipBoard<T>(
   42:   BuildContext context, {
   43:   required String title,
   44:   required ValueGetter<String> onExport,
   45:   required FutureOr<void> Function(T json) onImport,
   46:   bool showConfirmDialog = true,
   47: }) async {
   48:   final data = await Clipboard.getData('text/plain');
   49:   if (data?.text case final text? when (text.isNotEmpty)) {
   50:     if (!context.mounted) return;
   51:     final T json;
   52:     final String formatText;
   53:     try {
   54:       json = jsonDecode(text);
   55:       formatText = Utils.jsonEncoder.convert(json);
   56:     } catch (e) {
   57:       SmartDialog.showToast('解析json失败：$e');
   58:       return;
   59:     }
   60:     bool? executeImport;
   61:     if (showConfirmDialog) {
   62:       final highlight = Highlight()..registerLanguage('json', langJson);
   63:       final result = highlight.highlight(
   64:         code: formatText,
   65:         language: 'json',
   66:       );
   67:       late TextSpanRenderer renderer;
   68:       bool? isDarkMode;
   69:       executeImport = await showDialog<bool>(
   70:         context: context,
   71:         builder: (context) {
   72:           final colorScheme = ColorScheme.of(context);
   73:           final isDark = colorScheme.isDark;
   74:           if (isDark != isDarkMode) {
   75:             isDarkMode = isDark;
   76:             renderer = TextSpanRenderer(
   77:               null,
   78:               isDark ? githubDarkTheme : githubTheme,
   79:             );
   80:             result.render(renderer);
   81:           }
   82:           return AlertDialog(
   83:             title: Text('是否导入如下$title？'),
   84:             content: SingleChildScrollView(
   85:               child: Text.rich(renderer.span!),
   86:             ),
   87:             actions: [
   88:               TextButton(
   89:                 onPressed: Get.back,
   90:                 child: Text('取消', style: TextStyle(color: colorScheme.outline)),
   91:               ),
   92:               TextButton(
   93:                 onPressed: () => Get.back(result: true),
   94:                 child: const Text('确定'),
   95:               ),
   96:             ],
   97:           );
   98:         },
   99:       );
  100:     } else {
  101:       executeImport = true;
  102:     }
  103:     if (executeImport ?? false) {
  104:       try {
  105:         await onImport(json);
  106:         SmartDialog.showToast('导入成功');
  107:       } catch (e) {
  108:         SmartDialog.showToast('导入失败：$e');
  109:       }
  110:     }
  111:   } else {
  112:     SmartDialog.showToast('剪贴板无数据');
  113:     return;
  114:   }
  115: }
