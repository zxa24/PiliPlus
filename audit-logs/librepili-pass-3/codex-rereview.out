    4: /// Account-free follows and favorites stored on this device only (LibrePili).
    5: ///
    6: /// Everything is kept as plain maps in Hive so no type adapters are needed.
    7: /// Favorite items use the same JSON shape as the web space-archive API, so
    8: /// they render with the existing [VListItemModel] / `VideoCardH`.
    9: abstract final class LocalLibrary {
   10:   static late final Box<dynamic> _follows; // mid(str) -> LocalFollow json
   11:   static late final Box<dynamic> _folders; // folder id(str) -> folder json
   12:   static late final Box<dynamic> _items; // item key -> item json
   13: 
   14:   static const defaultFolderId = 0;
   15: 
   16:   static Future<void> init() async {
   17:     _follows = await Hive.openBox('localFollows');
   18:     _folders = await Hive.openBox('localFavFolders');
   19:     _items = await Hive.openBox('localFavItems');
   20:     await _ensureDefaultFolder();
   21:   }
   22: 
   23:   static Future<void> _ensureDefaultFolder() async {
   24:     if (_folders.isEmpty) {
   25:       await _folders.put('$defaultFolderId', {
   26:         'id': defaultFolderId,
   27:         'title': '默认收藏夹',
   28:         'order': 0,
   29:         'ctime': _now(),
   30:       });
   31:     }
   32:   }
   33: 
   34:   /// The boxes, for backup / compact / close (see GStorage).
   35:   static List<Box<dynamic>> get boxes => [_follows, _folders, _items];
   36: 
   37:   /// Restores boxes from a backup made with [boxes]; boxes missing from
   38:   /// [map] (older backups) are left as they are.
   39:   /// Throws a [FormatException] before anything is cleared if a box in
   40:   /// [map] is malformed: these boxes are the only copy without an account.
   41:   static Future<void> importAll(Map<String, dynamic> map) async {
   42:     checkImport(map);
   43:     for (final box in boxes) {
   44:       if (map[box.name] case final Map data) {
   45:         await box.clear();
   46:         await box.putAll(
   47:           // follows are looked up by '$mid': key them by their own mid, so a
   48:           // hand-edited backup cannot hold an entry unfollow cannot reach
   49:           identical(box, _follows)
   50:               ? {for (final v in data.values) '${(v as Map)['mid']}': v}
   51:               : data,
   52:         );
   53:       }
   54:     }
   55:     await _ensureDefaultFolder();
   56:   }
   57: 
   58:   /// Checks that every box in [map] parses the way the app reads it.
   59:   static void checkImport(Map<String, dynamic> map) {
   60:     final parsers = <String, Object Function(Map)>{
   61:       _follows.name: LocalFollow.fromJson,
   62:       _folders.name: LocalFavFolder.fromJson,
   63:       _items.name: LocalFavItem.fromJson,
   64:     };
   65:     for (final MapEntry(key: name, value: parse) in parsers.entries) {
   66:       final data = map[name];
   67:       if (data == null) continue;
   68:       try {
   69:         for (final value in (data as Map).values) {
   70:           parse(value as Map);
   71:         }
   72:       } catch (e) {
   73:         throw FormatException('本地关注/收藏数据无效 ($name): $e');
   74:       }
   75:     }
   76:   }
   77: 
   78:   static Future<void> clear() async {
   79:     for (final box in boxes) {
   80:       await box.clear();
   81:     }
   82:     await _ensureDefaultFolder();
   83:   }
   84: 
   85:   static int _now() => DateTime.now().millisecondsSinceEpoch ~/ 1000;
   86: 
   87:   static Stream<BoxEvent> watchFollows() => _follows.watch();
   88:   static Stream<BoxEvent> watchFavs() => _items.watch();
   89:   static Stream<BoxEvent> watchFolders() => _folders.watch();
   90: 
   91:   // ---------------------------------------------------------------- follows
   92: 
   93:   static bool isFollowed(int? mid) =>
   94:       mid != null && _follows.containsKey('$mid');
   95: 
   96:   static Future<void> follow(int mid, {String? name, String? face}) {
   97:     final old = _follows.get('$mid') as Map?;
   98:     return _follows.put('$mid', {
   99:       'mid': mid,
  100:       'name': name ?? old?['name'],
  101:       'face': face ?? old?['face'],
  102:       'time': old?['time'] ?? _now(),
  103:     });
  104:   }
  105: 
  106:   static Future<void> unfollow(int mid) => _follows.delete('$mid');
  107: 
  108:   /// Returns the new follow state.
  109:   static Future<bool> toggleFollow(
  110:     int mid, {
  111:     String? name,
  112:     String? face,
  113:   }) async {
  114:     if (isFollowed(mid)) {
  115:       await unfollow(mid);
  116:       return false;
  117:     }
  118:     await follow(mid, name: name, face: face);
  119:     return true;
  120:   }

