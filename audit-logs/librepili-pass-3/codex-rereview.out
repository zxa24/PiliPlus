  201:       if (settingMap is Map)
  202:         setting
  203:             .clear()
  204:             .then(
  205:               (_) => setting.putAll({
  206:                 for (final e in settingMap.entries)
  207:                   if (importCredentials || !credentialKeys.contains(e.key))
  208:                     e.key: e.value,
  209:               }),
  210:             )
  211:             .then(
  212:               (_) => setting.putAll({
  213:                 SettingBoxKey.loginMode: loginMode,
  214:                 // credentials the backup does not replace stay as they were
  215:                 for (final e in credentials.entries)
