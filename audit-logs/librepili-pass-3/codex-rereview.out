  126:   static Future<String> _saveSnapshot() async {
  127:     final dir = Directory(_snapshotDir);
  128:     await dir.create(recursive: true);
  129:     final now = DateTime.now();
  130:     String two(int v) => v.toString().padLeft(2, '0');
  131:     final name =
  132:         '$_snapshotPrefix${now.year}${two(now.month)}${two(now.day)}_'
  133:         '${two(now.hour)}${two(now.minute)}${two(now.second)}.json';
  134:     final file = File(path.join(dir.path, name));
