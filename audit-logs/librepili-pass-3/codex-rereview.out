  940:   /// Old single-URL (durl) streams. FLV (H.264 / HEVC + AAC) is remuxed into
  941:   /// a real mp4 and MP4 segments are joined, all segments in timeline order,
  942:   /// also when the codec configuration changes between or within segments;
  943:   /// a single mp4 segment is moved as is. Damaged data ([FormatException])
  944:   /// is rethrown: [_repairSegments] has already re-downloaded what it could,
  945:   /// so the merge fails rather than splitting the video. Only what has no
  946:   /// MP4 mapping here ([UnsupportedError]: other codecs, a codec or the set
  947:   /// of tracks changing between segments, FLV and MP4 segments mixed) is
  948:   /// kept with its own extension (several segments: `<base>.flv`,
  949:   /// `<base>.2.flv`, ...). Returns the (first) exported file.
  950:   static Future<String> _exportType1(List<String> inputs, String output) async {
  951:     final allFlv = inputs.every(Mp4Remuxer.isFlv);
  952:     if (!allFlv && inputs.length == 1) {
  953:       final kept = '${path.withoutExtension(output)}${_sniffExt(inputs.first)}';
  954:       await _moveFile(inputs.first, kept);
  955:       return kept;
  956:     }
  957:     if (allFlv || inputs.every(Mp4Remuxer.isMp4)) {
  958:       try {
  959:         await Isolate.run(
  960:           () => allFlv
  961:               ? Mp4Remuxer.remuxFlv(inputs: inputs, output: output)
  962:               : Mp4Remuxer.joinMp4(inputs: inputs, output: output),
  963:         );
  964:         return output;
  965:       } on UnsupportedError catch (e) {
  966:         await File(output).tryDel();
  967:         if (kDebugMode) debugPrint('segments kept as they are: $e');
  968:       }
  969:     }
  970:     final base = path.withoutExtension(output);
  971:     String? first;
  972:     for (var i = 0; i < inputs.length; i++) {
  973:       final ext = _sniffExt(inputs[i]);
  974:       final to = i == 0 ? '$base$ext' : '$base.${i + 1}$ext';
  975:       await _moveFile(inputs[i], to);
  976:       first ??= to;
  977:     }
  978:     if (inputs.length > 1) {
  979:       SmartDialog.showToast('分段无法合并，已按原格式分为${inputs.length}个文件保存');
  980:     }
  981:     return first!;
  982:   }
