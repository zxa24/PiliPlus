  275:   /// account secrets a call site may have put in the params: the app token
  276:   /// and the web csrf (the account's bili_jct)
  277:   static const _accessKeys = [
  278:     'access_key',
  279:     'mobile_access_key',
  280:     'csrf',
  281:     'csrf_token',
  282:     'biliCSRF',
  283:   ];
  284: 
  285:   static void _scrubAccessKey(RequestOptions options) {
  286:     void scrub(Map<String, dynamic> params) {
  287:       var removed = false;
  288:       for (final key in _accessKeys) {
  289:         if (params.containsKey(key)) {
  290:           params.remove(key);
  291:           removed = true;
  292:         }
  293:       }
  294:       if (removed && params.containsKey('sign')) {
  295:         AppSign.appSign(params..remove('sign'));
  296:       }
  297:     }
  298: 
  299:     scrub(options.queryParameters);
  300:     if (options.data case final Map data) {
  301:       scrub(data.cast<String, dynamic>());
  302:     } else if (options.data case final FormData data) {
  303:       data.fields.removeWhere((e) => _accessKeys.contains(e.key));
  304:     }
  305:   }

