  196:   static Future<void> _saveCookies(Account account, Response response) async {
  197:     final setCookies = response.headers[HttpHeaders.setCookieHeader];
  198:     if (setCookies == null || setCookies.isEmpty) {
  199:       return;
  200:     }
  201:     final List<Cookie> cookies = setCookies
  202:         .map((str) => str.split(_setCookieReg))
  203:         .expand((cookie) => cookie)
  204:         .where((cookie) => cookie.isNotEmpty)
  205:         .map(Cookie.fromSetCookieValue)
  206:         .toList();
  207:     final statusCode = response.statusCode ?? 0;
  208:     final locations = response.headers[HttpHeaders.locationHeader] ?? const [];
  209:     final isRedirectRequest = statusCode >= 300 && statusCode < 400;
  210:     final originalUri = response.requestOptions.uri;
  211:     final realUri = originalUri.resolveUri(response.realUri);
  212:     await account.cookieJar.saveFromResponse(realUri, cookies);
  213:     if (isRedirectRequest && locations.isNotEmpty) {
  214:       final originalUri = response.realUri;
  215:       await Future.wait(
  216:         locations.map(
  217:           (location) => account.cookieJar.saveFromResponse(
  218:             // Resolves the location based on the current Uri.
  219:             originalUri.resolve(location),
  220:             cookies,
  221:           ),
  222:         ),
  223:       );
  224:     }
  225:     await account.onChange();
  226:   }
