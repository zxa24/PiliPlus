  143:   }
  144: 
  145:   /// Snapshots taken before imports, newest first.
  146:   static Future<List<File>> _snapshots() async {
  147:     final dir = Directory(_snapshotDir);
  148:     if (!dir.existsSync()) return [];
  149:     final files = [
  150:       await for (final f in dir.list())
  151:         if (f is File && path.basename(f.path).startsWith(_snapshotPrefix)) f,
  152:     ]..sort((a, b) => path.basename(b.path).compareTo(path.basename(a.path)));
  153:     return files;
  154:   }
  155: 
  156:   /// The newest snapshot taken before an import, if any.
  157:   static Future<File?> latestSnapshot() async =>
  158:       (await _snapshots()).firstOrNull;
