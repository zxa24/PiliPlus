    5: class RetryInterceptor extends Interceptor {
    6:   final Dio _client;
    7:   final int _count;
    8:   final int _delay;
    9: 
   10:   RetryInterceptor(this._client, this._count, this._delay);
   11: 
   12:   @override
   13:   void onError(DioException err, ErrorInterceptorHandler handler) {
   14:     if (err.requestOptions.responseType == ResponseType.stream) {
   15:       return handler.next(err);
   16:     }
   17:     if (err.response != null) {
   18:       final options = err.requestOptions;
   19:       if (options.followRedirects && options.maxRedirects > 0) {
   20:         final status = err.response!.statusCode;
   21:         if (status != null && 300 <= status && status < 400) {
   22:           var redirectUrl = err.response!.headers.value('location');
   23:           if (redirectUrl != null) {
   24:             final oldUri = options.uri;
   25:             var uri = Uri.parse(redirectUrl);
   26:             if (!uri.hasScheme) {
   27:               uri = oldUri.resolveUri(uri);
   28:               redirectUrl = uri.toString();
   29:             }
   30:             if (uri.scheme != oldUri.scheme ||
   31:                 uri.host != oldUri.host ||
   32:                 uri.port != oldUri.port) {
   33:               // another origin gets neither the account's cookies nor its
   34:               // headers, nor the old query (access_key...): the location
   35:               // carries its own
   36:               options
   37:                 ..queryParameters = {}
   38:                 ..headers.remove('cookie')
   39:                 ..headers.remove('authorization')
   40:                 ..headers.remove('x-bili-mid')
   41:                 ..headers.remove('x-bili-aurora-eid')
   42:                 ..extra['account'] = const NoAccount();
   43:             }
   44:             (options..path = redirectUrl).maxRedirects--;
   45:             if (status == 303) {
   46:               options
   47:                 ..data = null
   48:                 ..method = 'GET';
   49:             }
   50:             _client
   51:                 .fetch(options)
   52:                 .then(
   53:                   (i) => handler.resolve(
   54:                     i
   55:                       ..redirects.add(
   56:                         RedirectRecord(status, options.method, uri),
   57:                       )
   58:                       ..isRedirect = true,
   59:                   ),
   60:                 )
   61:                 .onError<DioException>((error, _) => handler.next(error));
   62:             return;
   63:           }
   64:         }
   65:       }
   66:       return handler.next(err);
   67:     } else {
   68:       switch (err.type) {
   69:         case DioExceptionType.connectionError:
   70:         case DioExceptionType.connectionTimeout:
   71:         case DioExceptionType.sendTimeout:
   72:         case DioExceptionType.unknown:
   73:           // only idempotent reads are re-sent: a POST (like, coin, comment,
   74:           // follow...) may already have been applied by the server
   75:           final method = err.requestOptions.method.toUpperCase();
   76:           if ((method == 'GET' || method == 'HEAD') &&
   77:               (err.requestOptions.extra['_rt'] ??= 0) < _count &&
   78:               err.error
   79:                   is! TransportConnectionException // 网络中断, 此时请求可能已经被服务器所接收
   80:                   ) {
   81:             Future.delayed(
   82:               Duration(
   83:                 milliseconds: ++err.requestOptions.extra['_rt'] * _delay,
   84:               ),
   85:               () => _client
   86:                   .fetch(err.requestOptions)
   87:                   .then(handler.resolve)
   88:                   .onError<DioException>((error, _) => handler.reject(error)),
   89:             );
   90:           } else {
   91:             handler.next(err);
   92:           }
   93:           return;
   94:         default:
   95:           return handler.next(err);
   96:       }
   97:     }
   98:   }
   99: 
  100:   RetryInterceptor copyWith({Dio? client, int? count, int? delay}) =>
  101:       .new(client ?? _client, count ?? _count, delay ?? _delay);
  102: }

