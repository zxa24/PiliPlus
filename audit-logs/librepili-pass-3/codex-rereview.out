   63:   // 为请求参数进行 wbi 签名
   64:   static void encWbi(Map<String, Object> params, String mixinKey) {
   65:     params['wts'] = DateTime.now().millisecondsSinceEpoch ~/ 1000;
   66:     // 按照 key 重排参数
   67:     final List<String> keys = params.keys.toList()..sort();
   68:     final queryStr = keys
   69:         .map(
   70:           (i) =>
   71:               '${Uri.encodeComponent(i)}=${Uri.encodeComponent(params[i].toString().replaceAll(_chrFilter, ''))}',
   72:         )
   73:         .join('&');
   74:     params['w_rid'] = md5
   75:         .convert(utf8.encode(queryStr + mixinKey))
   76:         .toString(); // 计算 w_rid
   77:   }
