  258:   };
  259: 
  260:   static Account _bindRequestAccount(RequestOptions options) {
  261:     assert(options.extra['account'] is Account?);
  262:     final explicit = options.extra['account'] as Account?;
  263:     if (explicit is LoginAccount &&
  264:         _explicitAccountApis.contains(options.path)) {
  265:       return explicit;
  266:     }
  267:     // LibrePili: no global login. Even in login mode the account is only
  268:     // attached where it is required; everything else goes out anonymously.
  269:     return options.extra['account'] = LoginPolicy.bind(
  270:       explicit ?? _findAccount(options.path),
  271:       options,
  272:     );
  273:   }
